// Stereo 3D: a handheld 3D menu's depth - soft grey planes and rounded panels floating at different
// depths, the far ones sliding slower, each edged with a hint of red/cyan like a stereo image,
// bubbles drifting past the camera, and a slow accent-coloured light.
half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float3 col = mix(float3(0.30, 0.32, 0.36), float3(0.16, 0.17, 0.20), uv.y);
    col = mix(col, BG * 1.6, 0.3);
    col += A * exp(-length(uv - float2(asp * (0.5 + 0.3 * sin(t * 0.07)), 0.2)) * 2.5) * 0.12;
    // Layers of rounded panels.
    for (int l = 0; l < 4; l++) {
        float fl = float(l);
        float depth = 0.3 + fl * 0.25;          // near layers move more
        float sc = 0.6 + fl * 0.35;
        float2 p = uv * (4.0 - fl * 0.6) + float2(t * 0.05 * depth, sin(t * 0.1 + fl) * 0.1);
        float2 id = floor(p);
        float2 f = fract(p) - 0.5;
        float h = hash12(id + fl * 17.0);
        if (h > 0.7) {
            float2 sz = float2(0.25 + 0.15 * hash11(h * 9.0), 0.18 + 0.1 * hash11(h * 3.0));
            float d = sdRoundBox(f - (hash22(id) - 0.5) * 0.3, sz, 0.08);
            float3 pc = mix(float3(0.85, 0.87, 0.9), mix(A, S, h), step(0.85, h) * 0.6);
            float alpha = (0.18 + 0.12 * fl) * (1.0 - smoothstep(-0.01, 0.01, d));
            col = mix(col, pc, alpha);
            // Stereo fringes: red on one side, cyan on the other.
            float off = 0.03 * depth;
            float dl = sdRoundBox(f - (hash22(id) - 0.5) * 0.3 + float2(off, 0.0), sz, 0.08);
            float dr = sdRoundBox(f - (hash22(id) - 0.5) * 0.3 - float2(off, 0.0), sz, 0.08);
            col += float3(0.6, 0.05, 0.1) * (1.0 - smoothstep(0.0, 0.01, abs(dl))) * 0.25 * fl / 3.0;
            col += float3(0.05, 0.45, 0.6) * (1.0 - smoothstep(0.0, 0.01, abs(dr))) * 0.25 * fl / 3.0;
            col += float3(1.0) * (1.0 - smoothstep(0.0, 0.008, abs(d))) * 0.15;
        }
    }
    // Bubbles drifting up, the near ones big and soft.
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float2 bp = uv * (5.0 - fi * 2.5) + float2(fi * 3.1, t * (0.08 + 0.1 * fi));
        float2 bid = floor(bp);
        float2 bf = fract(bp) - 0.5;
        float2 bh = hash22(bid + fi * 9.0);
        float r = 0.12 + 0.1 * bh.y;
        float d = length(bf - (bh - 0.5) * 0.4);
        float bub = step(bh.x, 0.3) * (1.0 - smoothstep(r - 0.04 - fi * 0.04, r, d));
        float rim = step(bh.x, 0.3) * exp(-abs(d - r) * (60.0 - fi * 30.0));
        col = mix(col, float3(0.95), bub * 0.08);
        col += mix(float3(1.0), A, 0.3) * rim * 0.25;
    }
    return half4(finish(col, fc), 1.0);
}
