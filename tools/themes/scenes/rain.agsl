// Digital rain: columns of made-up glyphs falling at their own pace, bright at the head and
// fading behind, with a dimmer, smaller layer further back.
float3 rainLayer(float2 fc, float cw, float seed, float t, float3 A, float3 S) {
    float ch = cw * 1.3;
    float cx = floor(fc.x / cw);
    float cy = floor(fc.y / ch);
    float2 local = float2(fract(fc.x / cw), fract(fc.y / ch));
    float rows = uRes.y / ch;
    float speed = 3.0 + 7.0 * hash11(cx * 1.7 + seed);
    float tail = 8.0 + 14.0 * hash11(cx * 3.1 + seed);
    float cycle = rows + tail + 10.0 * hash11(cx + seed * 2.0);
    float head = mod(t * speed + hash11(cx * 9.1 + seed) * 200.0, cycle);
    float behind = head - cy;
    if (behind < 0.0 || behind > tail) return float3(0.0);
    // Glyph: a 4x6 bit pattern per cell that changes now and then.
    float2 g = floor(local * float2(4.0, 6.0));
    float change = floor(t * (0.5 + 2.0 * hash12(float2(cx, cy) + seed)));
    float bit = step(0.48, hash12(float2(cx * 13.0 + g.x, cy * 7.0 + g.y) + change * 3.7 + seed));
    float inside = step(0.12, local.x) * step(local.x, 0.88) * step(0.08, local.y) * step(local.y, 0.92);
    float on = bit * inside;
    float fade = pow(1.0 - behind / tail, 1.6);
    float3 c = behind < 1.0 ? mix(S, float3(1.0), 0.5) : A;
    return c * on * fade;
}

half4 main(float2 fc) {
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float2 uv = fc / uRes.y;

    float3 col = mix(BG * 1.2 + A * 0.03, BG * 0.8, uv.y);
    float near = max(12.0, floor(uRes.y / 34.0));
    float far = max(8.0, floor(uRes.y / 58.0));
    col += rainLayer(fc + float2(far * 0.5, 0.0), far, 7.0, t * 0.8, A, S) * 0.28;
    col += rainLayer(fc, near, 1.0, t, A, S) * 0.75;
    // Faint glow behind it all.
    col += A * 0.05 * fbm3(float2(uv.x * 3.0, uv.y * 2.0 - t * 0.1));
    return half4(finish(col, fc), 1.0);
}
