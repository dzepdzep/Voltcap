// Poster wall: a long plaster wall covered in game-style posters (original designs: sunbursts, bold
// stripes, mountain sunsets, halftone targets, bolt prints), pinned in three layers at different
// depths. The view drifts slowly along it so the layers slide past each other; posters cast soft
// shadows, the far ones sit in haze, tape corners catch the light and two spotlights sweep across.
// Most posters are the covers of the games in your row (the one you're on among them), printed on the
// same paper; the rest keep the original designs.

uniform shader uCovers;     // the row's covers: 4 x 2 cells of 160 x 224 px (SceneArt), the game you're on first
uniform float2 uCoversSize;
uniform float uCoverN;      // how many cells are filled (0 = only the original designs)

float3 posterArt(float kind, float2 q, float3 A, float3 S, float3 BG) {
    // q: 0..1 across and down the poster.
    float3 ink = float3(0.08, 0.07, 0.1);
    float3 paper = float3(0.95, 0.92, 0.85);
    float3 c;
    float2 m = q - float2(0.5, 0.42);
    if (kind < 0.5) {
        float a = atan(m.y, m.x);
        c = mix(A, mix(A, float3(1.0), 0.3), step(0.0, sin(a * 12.0)));
        c = mix(c, S, 1.0 - step(0.2, length(m)));
    } else if (kind < 1.5) {
        c = mix(S, BG * 1.5, step(0.5, fract((q.x + q.y) * 5.0)));
        c = mix(c, A, step(abs(q.y - 0.35), 0.12));
    } else if (kind < 2.5) {
        c = mix(mix(A, float3(1.0, 0.8, 0.5), 0.3), S, q.y * 1.3);
        c = mix(c, float3(1.0, 0.95, 0.7), 1.0 - step(0.15, length(m - float2(0.0, -0.05))));
        float mtn = 0.55 - 0.2 * (1.0 - abs(fract(q.x * 1.5) - 0.5) * 2.0);
        c = mix(c, BG * 1.2, step(mtn, q.y));
    } else if (kind < 3.5) {
        float r = length(m);
        c = mix(paper, A, step(0.5, fract(r * 9.0)));
        float2 h = fract(q * 30.0) - 0.5;
        c = mix(c, S, step(length(h), 0.45 * q.y) * step(0.6, q.y));
    } else {
        c = BG * 1.4;
        float2 b = m * 1.3;
        float bolt = step(abs(b.x + b.y * 0.6 + 0.06), 0.07) * step(-0.25, b.y) * step(b.y, 0.02) + step(abs(b.x + b.y * 0.6 - 0.06), 0.07) * step(-0.02, b.y) * step(b.y, 0.25);
        c = mix(c, A, sat(bolt));
        float2 dg = fract(q * 12.0) - 0.5;
        c = mix(c, S * 0.8, step(length(dg), 0.18) * (1.0 - sat(bolt)) * 0.5);
    }
    // A bold title block at the bottom and a thin frame line.
    c = mix(c, ink, step(0.8, q.y) * step(abs(q.x - 0.5), 0.38) * step(q.y, 0.88));
    c = mix(c, paper, step(0.815, q.y) * step(q.y, 0.835) * step(abs(q.x - 0.5), 0.3) * step(0.5, fract(q.x * 9.0)));
    c = mix(c, paper, 1.0 - step(0.035, min(min(q.x, 1.0 - q.x), min(q.y, 1.0 - q.y))));
    return c;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float px = 1.5 / uRes.y;
    float pan = t * 0.02 + 0.15 * sin(t * 0.07);

    // Plaster wall with a warm wash.
    float3 col = mix(float3(0.32, 0.28, 0.26), BG * 2.0, 0.5) * (0.85 + 0.15 * fbm3(uv * 6.0));
    // Three layers of posters: far (small, hazy, slow) to near (big, sharp, fast).
    for (int l = 0; l < 3; l++) {
        float fl = float(l);
        float sc = 0.6 + fl * 0.35;
        float off = pan * (0.6 + fl * 0.7);
        float cellW = 0.42 * sc;
        float2 lp = float2(uv.x + off + fl * 0.23, uv.y);
        float ci = floor(lp.x / cellW);
        float h1 = hash11(ci * 3.7 + fl * 11.0);
        if (h1 < 0.25 + 0.15 * fl) continue;              // gaps
        float2 size = float2(0.15, 0.21) * sc * (0.9 + 0.2 * hash11(ci + fl));
        float2 pc = float2((ci + 0.5) * cellW, 0.42 + (hash11(ci * 5.1 + fl) - 0.5) * 0.3);
        float ang = (hash11(ci * 9.3 + fl) - 0.5) * 0.12;
        float2 q = rot(ang) * (lp - pc);
        // Shadow, larger for nearer layers.
        float2 sq = rot(ang) * (lp - pc - float2(0.008, 0.012) * (1.0 + fl));
        float shD = sdRoundBox(sq, size, 0.002);
        col *= 1.0 - 0.35 * (1.0 - smoothstep(-0.01, 0.02 + fl * 0.01, shD));
        float pd = sdRoundBox(q, size, 0.002);
        if (pd < 0.0) {
            float2 pq = q / (2.0 * size) + 0.5;
            float3 art;
            float pick = hash11(ci * 2.3 + fl * 7.0);
            if (uCoverN > 0.5 && fract(pick * 7.3) > 0.18) {
                // A game's cover printed as a poster: a white border, the picture a little faded.
                float k = mod(floor(pick * 97.0) + ci, uCoverN);
                float2 cell = float2(mod(k, 4.0), floor(k / 4.0));
                float2 iq = clamp((pq - 0.045) / 0.91, 0.003, 0.997);
                art = float3(uCovers.eval((cell + iq) * uCoversSize / float2(4.0, 2.0)).rgb);
                art = mix(art, float3(0.96, 0.94, 0.88), 0.07);
                art = mix(art, float3(0.95, 0.92, 0.85), 1.0 - step(0.045, min(min(pq.x, 1.0 - pq.x), min(pq.y, 1.0 - pq.y))));
            } else {
                art = posterArt(floor(pick * 5.0), pq, A, S, BG);
            }
            // Paper: a slight curl shading and grain.
            art *= 0.9 + 0.1 * pq.y + 0.04 * (vnoise(pq * 80.0) - 0.5);
            art *= 1.0 - 0.12 * smoothstep(0.8, 1.0, pq.x) * smoothstep(0.7, 1.0, pq.y);
            // Haze on the far layers.
            art = mix(art, mix(float3(0.3, 0.28, 0.27), BG * 2.0, 0.5), 0.45 - fl * 0.22);
            col = art;
        }
        // Tape on the top corners.
        for (int k = 0; k < 2; k++) {
            float fk = float(k) * 2.0 - 1.0;
            float2 tq = rot(0.7 * fk) * (q - float2(fk * size.x, -size.y));
            float tape = step(abs(tq.x), 0.018 * sc) * step(abs(tq.y), 0.007 * sc);
            col = mix(col, mix(col, float3(0.95, 0.92, 0.75), 0.6), tape);
        }
    }
    // Two spotlights sweeping along the wall.
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float sx = asp * (0.3 + 0.4 * fi) + 0.25 * sin(t * 0.13 + fi * 2.0);
        float2 sq = (uv - float2(sx, 0.42)) * float2(1.0, 0.8);
        col *= 0.75 + 0.55 * exp(-dot(sq, sq) * 9.0) * mix(float3(1.0, 0.9, 0.75), mix(A, float3(1.0), 0.6), fi);
    }
    // Floor strip with a skirting board.
    if (uv.y > 0.86) col = mix(BG * 0.6, float3(0.15, 0.12, 0.1), 0.5) * (0.8 + 0.2 * step(0.5, fract(uv.x * 4.0 + pan * 4.0)));
    col = mix(col, float3(0.1, 0.09, 0.09), step(abs(uv.y - 0.855), 0.008));
    // Dust motes in the light.
    col += float3(1.0, 0.95, 0.8) * 0.25 * dots(uv, 34.0, float2(t * 0.2, -t * 0.1), 0.1, 0.06, 7.0);
    return half4(finish(col, fc), 1.0);
}
