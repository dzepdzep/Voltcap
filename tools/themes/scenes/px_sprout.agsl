// Sprout · 32-bit (grass type): a sunny garden bed. Vines climb their bamboo canes in turn - leaves
// unfurling at each node as the tip passes, a flower opening at the top - while butterflies flit
// between them, sunflowers nod at the back and the grass sways in tiles at the front.
//#include pixel

half4 main(float2 fc) {
    float2 cell = pxCell(fc);
    float2 uv = pxUv(cell);
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Sky with a soft sun and two cloud puffs.
    float3 col = mix(mix(float3(0.45, 0.75, 0.95), S * 0.6 + 0.25, 0.25), float3(0.88, 0.96, 0.9), pxBand(uv.y * 1.4, 4.0, cell));
    float sd = length(uv - float2(asp * 0.15, 0.12));
    col = mix(col, float3(1.0, 0.96, 0.75), step(sd, 0.06));
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float2 c = float2(fract(0.3 + fi * 0.5 + t * 0.006) * (asp + 0.4) - 0.2, 0.1 + fi * 0.08);
        float puff = step(length((uv - c) * float2(0.6, 1.3)), 0.04) + step(length((uv - c - float2(0.04, 0.012)) * float2(0.6, 1.3)), 0.032) + step(length((uv - c + float2(0.04, -0.01)) * float2(0.6, 1.3)), 0.028);
        col = mix(col, float3(1.0), step(0.5, puff));
    }
    // Back hedge and sunflowers.
    float hedge = 0.5 + 0.02 * sin(uv.x * 30.0) * sin(uv.x * 7.0);
    if (uv.y > hedge) col = mix(float3(0.18, 0.42, 0.2), mix(float3(0.28, 0.55, 0.25), A, 0.15), pxBand(vnoise(uv * 40.0), 2.0, cell));
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float x = (fi + 0.7) / 4.3 * asp;
        float nod = 0.008 * sin(t * 0.7 + fi * 1.3);
        float2 head = float2(x + nod, 0.4 + 0.03 * hash11(fi));
        col = mix(col, float3(0.25, 0.5, 0.2), step(abs(uv.x - x - nod * (uv.y - 0.7) / (head.y - 0.7)), PX * 0.8) * step(head.y, uv.y) * step(uv.y, 0.7));
        float r = length(uv - head);
        float ang = atan(uv.y - head.y, uv.x - head.x);
        float petal = step(r, 0.032 + 0.008 * step(0.0, sin(ang * 12.0)));
        col = mix(col, mix(float3(1.0, 0.8, 0.15), S, 0.2), petal);
        col = mix(col, float3(0.4, 0.22, 0.1), step(r, 0.016));
    }
    // Soil bed.
    float soilY = 0.83;
    if (uv.y > soilY) col = mix(float3(0.42, 0.27, 0.16), float3(0.3, 0.18, 0.1), pxBand(hash12(cell) * 0.5 + (uv.y - soilY) * 4.0, 3.0, cell));
    // Vines on canes, each on its own 14 s growth cycle.
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float x = (fi + 0.5) / 5.0 * asp;
        float caneTop = 0.42;
        // Cane.
        col = mix(col, float3(0.75, 0.66, 0.4), pxBox(uv, float2(x, (caneTop + soilY) * 0.5), float2(PX * 0.6, (soilY - caneTop) * 0.5)) * step(0.5, fract(uv.y * 30.0) + 0.3));
        float g = fract(t / 14.0 + fi * 0.21);
        float grow = smoothstep(0.0, 0.7, g);
        float fade = 1.0 - smoothstep(0.92, 1.0, g);
        float tipY = mix(soilY, caneTop + 0.02, grow);
        // The stem winding round the cane.
        float wind = 0.012 * sin(uv.y * 70.0 + fi);
        float stem = step(tipY, uv.y) * step(uv.y, soilY) * step(abs(uv.x - x - wind), PX * 0.9);
        col = mix(col, float3(0.2, 0.55, 0.2), stem * step(0.3, fade));
        // Leaves at the nodes behind the tip.
        for (int j = 0; j < 6; j++) {
            float fj = float(j);
            float ny = soilY - 0.06 - fj * 0.065;
            float side = mod(fj, 2.0) < 0.5 ? 1.0 : -1.0;
            float open = sat((ny - tipY) / 0.04) * fade;
            float2 lc = float2(x + side * (0.012 + 0.012 * open), ny - 0.006 * open);
            float2 q = (uv - lc) / max(open, 0.01);
            float leaf = step(length(q * float2(0.7, 1.4)), 0.016) * step(0.05, open);
            col = mix(col, mix(float3(0.3, 0.7, 0.25), float3(0.45, 0.85, 0.3), step(q.y, -0.003)), leaf);
        }
        // The flower at the top once it's grown.
        float bloom = smoothstep(0.7, 0.8, g) * fade;
        float2 fcn = float2(x + 0.012 * sin(caneTop * 70.0 + fi), caneTop + 0.015);
        float rr = length(uv - fcn);
        float an = atan(uv.y - fcn.y, uv.x - fcn.x) + t * 0.2;
        float pet = step(rr, 0.03 * bloom * (0.7 + 0.3 * step(0.0, sin(an * 5.0))));
        float3 fl = mix(A, float3(1.0, 0.5, 0.7), hash11(fi * 2.0) * 0.6);
        col = mix(col, fl, pet);
        col = mix(col, float3(1.0, 0.9, 0.3), step(rr, 0.009 * bloom));
    }
    // Butterflies.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float2 b = pxSnap(float2(fract(fi * 0.31 + t * 0.03) * asp, 0.55 + 0.12 * sin(t * 0.9 + fi * 2.0) + 0.02 * sin(t * 7.0 + fi)));
        float2 q = (uv - b) / PX;
        float flap = 0.4 + 0.6 * abs(sin(t * 10.0 + fi));
        float wing = step(length((abs(q) - float2(1.8 * flap, 0.9)) * float2(1.0 / max(flap, 0.3), 1.0)), 1.6);
        col = mix(col, mix(S, float3(1.0, 0.6, 0.2), fi * 0.4), wing);
        col = mix(col, float3(0.1), step(abs(q.x), 0.5) * step(abs(q.y), 1.8));
    }
    // Grass tiles at the front, swaying.
    float gy = 0.94;
    float gx = uv.x * 90.0;
    float bl = fract(gx);
    float hgt = 0.03 + 0.02 * hash11(floor(gx));
    float sw = 0.3 * sin(t * 1.5 + floor(gx) * 0.3);
    float yy = (gy - uv.y) / hgt;
    float blade = step(0.0, yy) * step(yy, 1.0) * step(abs(bl - 0.5 - sw * yy), 0.35 * (1.0 - yy) + 0.1);
    if (uv.y > gy) col = mix(float3(0.22, 0.48, 0.18), float3(0.16, 0.38, 0.14), pxBand(hash12(cell), 2.0, cell));
    col = mix(col, mix(float3(0.3, 0.62, 0.22), float3(0.5, 0.8, 0.3), yy), blade);

    col = pxQuant(col, 10.0, cell);
    return half4(finish(col, fc), 1.0);
}
