// Umbra · 32-bit (dark type): city rooftops under an eclipse. The black sun burns with a thin ring of
// fire, water towers and antennas stand against it, a flock of crows lifts off in a gust, eyes blink in
// dark alleys and shadow smoke curls up between the buildings.
//#include pixel

half4 main(float2 fc) {
    float2 cell = pxCell(fc);
    float2 uv = pxUv(cell);
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Sky: deep red-violet bands, darkest round the eclipse.
    float2 sun = float2(asp * 0.62, 0.3);
    float sd = length(uv - sun);
    float3 col = mix(mix(float3(0.35, 0.08, 0.12), A * 0.4, 0.4), BG * 0.6, pxBand(sat(uv.y * 0.6 + 0.6 - sd * 1.2), 5.0, cell));
    // The eclipse: corona rays, a fiery ring, the black disc.
    float ang = atan(uv.y - sun.y, uv.x - sun.x);
    float rays = step(0.6, sin(ang * 14.0 + sin(t * 0.3) * 2.0)) * step(sd, 0.2 + 0.03 * sin(ang * 5.0 + t)) * step(0.11, sd);
    col = mix(col, mix(A, float3(1.0, 0.6, 0.4), 0.4), rays * 0.5 * step(0.5, mod(cell.x + cell.y, 2.0)));
    col = mix(col, mix(float3(1.0, 0.85, 0.6), A, 0.3), step(sd, 0.112) * step(0.098, sd));
    col = mix(col, float3(0.02, 0.0, 0.02), step(sd, 0.1));
    // Rooftops: three rows of buildings, nearer ones darker and taller.
    for (int r = 0; r < 3; r++) {
        float fr = float(r);
        float w = 0.12 - fr * 0.02;
        float id = floor(uv.x / w + fr * 0.37);
        float h = 0.55 + fr * 0.08 + 0.12 * hash11(id + fr * 20.0);
        float3 bc = mix(float3(0.12, 0.08, 0.12), BG, 0.3) * (1.0 - fr * 0.3);
        if (uv.y > h) {
            col = bc;
            // Windows, a few lit.
            float2 wg = float2(fract(uv.x / w + fr * 0.37) * 4.0, (uv.y - h) * 50.0);
            float lit = step(0.9, hash12(floor(wg) + id * 7.0 + fr));
            col = mix(col, mix(float3(1.0, 0.7, 0.4), A, 0.4), lit * step(abs(fract(wg.x) - 0.5), 0.25) * step(abs(fract(wg.y) - 0.5), 0.3) * step(0.02, uv.y - h));
        }
        // Water towers and antennas on some roofs.
        float rx = (id - fr * 0.37 + 0.5) * w;
        if (hash11(id * 3.0 + fr) > 0.6) {
            float tank = pxBox(uv, float2(rx, h - 0.05), float2(0.02, 0.025)) + step(h - 0.085 + abs(uv.x - rx) * 0.6, uv.y) * step(uv.y, h - 0.075) * step(abs(uv.x - rx), 0.022);
            float legs = step(abs(abs(uv.x - rx) - 0.015), PX * 0.5) * step(h - 0.025, uv.y) * step(uv.y, h);
            col = mix(col, bc, sat(tank + legs));
        } else if (hash11(id * 5.0 + fr) > 0.5) {
            col = mix(col, bc, pxBox(uv, float2(rx, h - 0.06), float2(PX * 0.5, 0.06)) + pxBox(uv, float2(rx, h - 0.09), float2(0.012, PX * 0.5)));
            col = mix(col, float3(1.0, 0.2, 0.2), pxDisc(uv, float2(rx, h - 0.12), PX) * step(0.5, sin(t * 3.0 + id)));
        }
    }
    // Eyes blinking in the alleys.
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float2 e = pxSnap(float2((0.15 + fi * 0.24) * asp, 0.86 + 0.06 * hash11(fi * 3.0)));
        float open = step(0.08, fract(t * 0.2 + hash11(fi))) * step(0.5, hash11(fi + floor(t * 0.2)));
        float eye = (step(length((uv - e - float2(-0.012, 0.0)) * float2(1.0, 2.0)), 0.007) + step(length((uv - e - float2(0.012, 0.0)) * float2(1.0, 2.0)), 0.007)) * open;
        col = mix(col, mix(float3(1.0, 0.9, 0.3), S, 0.3), eye);
    }
    // Shadow smoke curling up.
    float sm = fbm3(float2(uv.x * 5.0, uv.y * 3.0 + t * 0.15));
    col = mix(col, mix(float3(0.15, 0.05, 0.2), A * 0.3, 0.3), step(0.6, sm) * step(0.55, uv.y) * step(0.5, mod(cell.x + cell.y, 2.0)) * 0.8);
    // Crows: lift off in a gust every 9 s and wheel away.
    float ct = fract(t / 9.0);
    for (int i = 0; i < 8; i++) {
        float fi = float(i);
        float2 start = float2(asp * 0.3 + fi * 0.025, 0.55);
        float2 p = start + float2(ct * (0.5 + 0.3 * hash11(fi)), -ct * (0.4 + 0.3 * hash11(fi * 2.0))) + float2(0.02 * sin(ct * 20.0 + fi), 0.0);
        p = pxSnap(p);
        float2 q = (uv - p) / PX;
        float f = sin(t * 12.0 + fi);
        float crow = step(abs(q.x), 3.5) * step(abs(q.y - abs(q.x) * 0.45 * f), 0.8) + step(length(q), 1.3);
        col = mix(col, float3(0.02), step(0.5, crow) * step(ct, 0.9));
    }
    col = pxQuant(col, 10.0, cell);
    return half4(finish(col, fc), 1.0);
}
