// Rooftop dusk: the last light of the day over a city. Towers stand in the bottom-left and bottom-right
// corners, windows switching on and off one by one, a water tank on a roof, a red light blinking on an
// antenna; a hazy skyline far off, thin clouds lit pink from below, the first stars, a plane gliding
// over. The middle stays open sky (original design).

// Building height (y of its roof, screen units down) for column id in a layer.
float towerTop(float id, float layer, float xr) {
    float h = hash11(id * 1.73 + layer * 19.1);
    // Taller towards the corners, low in the middle.
    float corner = max(sqf(sat((0.36 - xr) / 0.36)), sqf(sat((xr - 0.6) / 0.4)));
    float tall = layer < 0.5 ? 0.06 + 0.12 * h + 0.12 * corner * h : 0.05 + 0.48 * h * corner + 0.04 * corner;
    return 1.0 - tall - (layer < 0.5 ? 0.1 : 0.0);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;      // warm window / sunset light
    float3 S = uSec.rgb;      // dusk violet
    float3 BG = uBg.rgb;
    float xr = uv.x / asp;

    // Dusk sky.
    float3 col = mix(BG * 0.9, mix(BG, S, 0.45) * 1.3, smoothstep(0.0, 0.6, uv.y));
    col = mix(col, mix(S, A, 0.6) * 0.75, smoothstep(0.45, 0.95, uv.y) * 0.85);
    col += A * exp(-sqf((uv.y - 0.92) / 0.12)) * 0.18;
    col += float3(1.0, 0.95, 0.9) * dots(uv, 60.0, float2(0.0), 0.14, 0.06, 3.0) * 0.55 * smoothstep(0.45, 0.0, uv.y);
    // Thin clouds, lit pink and gold from below.
    float cl = fbm(float2(uv.x * 1.0 + t * 0.006, uv.y * 10.0 + 2.0));
    float cb = smoothstep(0.52, 0.75, cl) * exp(-sqf((uv.y - 0.4) / 0.12));
    col = mix(col, mix(S, A, 0.4) * 0.8 + BG * 0.1, cb * 0.5);
    col += A * smoothstep(0.62, 0.75, cl) * exp(-sqf((uv.y - 0.43) / 0.07)) * 0.08;

    // A plane gliding over, its lights blinking.
    float px = fract(t * 0.008) * (asp + 0.4) - 0.2;
    float2 pp = uv - float2(px, 0.14 + 0.03 * sin(px * 0.8));
    float blink = step(0.85, fract(t * 0.9));
    col += float3(1.0, 0.3, 0.25) * exp(-length(pp) * 900.0) * (0.3 + 0.7 * blink);
    col += float3(1.0) * exp(-length(pp - float2(-0.008, 0.0)) * 1200.0) * 0.6;

    // Far skyline: hazy, all across the bottom, low.
    float fx = uv.x * 22.0;
    float fid = floor(fx);
    float farTop = towerTop(fid, 0.0, xr);
    if (uv.y > farTop) {
        float3 far = mix(S, A, 0.25) * 0.42 + BG * 0.35;
        far *= 0.9 + 0.1 * step(0.5, fract(uv.y * 90.0)) * step(0.2, fract(fx * 3.0));
        // A few lit windows, faint.
        float2 wg = float2(fx * 4.0, uv.y * 120.0);
        float lit = step(0.8, hash12(floor(wg) + fid)) * step(0.3, fract(wg.x)) * step(0.4, fract(wg.y));
        far += A * lit * 0.12;
        col = mix(col, far, 0.85);
    }
    col += mix(A, S, 0.4) * exp(-abs(uv.y - farTop) * 200.0) * 0.04;

    // Near towers in the corners.
    float nx = uv.x * 9.0;
    float nid = floor(nx);
    float nf = fract(nx);
    float top = towerTop(nid, 1.0, (nid + 0.5) / 9.0 / asp);
    float hh = hash11(nid * 5.1 + 2.0);
    // Setback: the top floors are narrower on some towers.
    float setback = step(0.5, hh) * step(uv.y, top + 0.05) * (step(nf, 0.18) + step(0.82, nf));
    float gap = step(nf, 0.04) + step(0.96, nf);
    float inTower = step(top, uv.y) * (1.0 - setback) * (1.0 - gap * step(0.3, hh));
    if (inTower > 0.0) {
        float3 wall = BG * 0.55 + S * 0.03;
        // Faint light on the side facing the sunset.
        wall += mix(S, A, 0.5) * 0.05 * smoothstep(0.5, 0.0, nf);
        // Windows.
        float2 wg = float2(nf * (5.0 + floor(hh * 3.0)), (uv.y - top) * 70.0);
        float2 wid = floor(wg);
        float2 wf = fract(wg);
        float win = step(0.25, wf.x) * step(wf.x, 0.75) * step(0.3, wf.y) * step(wf.y, 0.8) * step(0.6, uv.y - top + 0.6) * step(0.02, uv.y - top);
        float wh = hash12(wid + nid * 13.0);
        // Each window switches on or off slowly at its own time.
        float on = step(0.45, hash12(wid + nid * 13.0 + floor(t * 0.05 + wh * 10.0) * 7.0));
        float3 wc = mix(A, float3(1.0, 0.95, 0.85), 0.3 * wh);
        wc = mix(wc, mix(S, float3(1.0), 0.6), step(0.85, wh));
        wall += wc * win * on * (0.5 + 0.2 * wh);
        col = wall;
        // Roof edge catching the sky.
        col += mix(S, A, 0.5) * exp(-(uv.y - top) * 400.0) * 0.12;
    }
    // Lit windows glow out a little.

    // A water tank on a roof in the bottom-left corner.
    float tankX = (floor(0.12 * asp * 9.0) + 0.5) / 9.0;
    float tankTop = towerTop(floor(0.12 * asp * 9.0), 1.0, (floor(0.12 * asp * 9.0) + 0.5) / 9.0 / asp);
    float2 tq = uv - float2(tankX, tankTop - 0.05);
    float tank = step(abs(tq.x), 0.022) * step(abs(tq.y), 0.022);
    float cone = step(abs(tq.x), 0.026 * sat((tq.y + 0.045) / 0.025)) * step(-0.045, tq.y) * step(tq.y, -0.02);
    float legs = (step(abs(abs(tq.x) - 0.016), 0.002)) * step(0.02, tq.y) * step(tq.y, 0.05);
    col = mix(col, BG * 0.5, max(max(tank, cone), legs));

    // An antenna with a blinking red light on the tallest tower on the right.
    float best = 0.0;
    float bx = 0.0;
    for (int i = 0; i < 4; i++) {
        float id = floor(asp * 9.0) - float(i);
        float tt = 1.0 - towerTop(id, 1.0, (id + 0.5) / 9.0 / asp);
        if (tt > best) { best = tt; bx = (id + 0.5) / 9.0; }
    }
    float aTop = 1.0 - best - 0.09;
    float ant = step(abs(uv.x - bx), 0.0015) * step(aTop, uv.y) * step(uv.y, 1.0 - best);
    col = mix(col, BG * 0.5, ant);
    float red = 0.15 + 0.85 * step(0.6, fract(t * 0.5));
    col += float3(1.0, 0.2, 0.15) * exp(-length(uv - float2(bx, aTop)) * 500.0) * red;
    col += float3(1.0, 0.2, 0.15) * exp(-length(uv - float2(bx, aTop)) * 40.0) * red * 0.06;

    return half4(finish(col, fc), 1.0);
}
