// 32-bit polygons: the look of the first 3D consoles - a low-resolution frame with ordered
// dithering instead of smooth gradients, a checkered floor whose texture swims (affine mapping),
// faceted gems turning with their corners snapping to the pixel grid, and thick distance fog.
float bayer2(float2 a) { a = floor(a); return fract(a.x / 2.0 + a.y * a.y * 0.75); }
float bayer4(float2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }

// Flat-shaded spinning gem (an n-sided bipyramid seen from the side), snapped to the grid.
float3 gem(float2 p, float r, float spin, float3 base, float3 hi, float grid, inout float hit) {
    // Snap the shape's own coordinates: corners jump between pixels like old vertex maths.
    float2 q = floor(p / r * grid) / grid;
    float y = q.y;
    float w = (1.0 - abs(y)) * 0.62;
    if (abs(q.x) > w || abs(y) > 1.0) return float3(0.0);
    hit = 1.0;
    // Which facet: the angle round the spin axis.
    float u = asin(clamp(q.x / max(w, 0.001), -1.0, 1.0));
    float a = u + spin;
    float n = 6.0;
    float f = floor(a / TAU * n);
    float fa = (f + 0.5) / n * TAU - spin;
    float light = 0.45 + 0.55 * sat(cos(fa - 0.6)) * (y < 0.0 ? 1.0 : 0.6);
    return mix(base, hi, light) * light;
}

half4 main(float2 fc) {
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float P = 200.0;
    float2 g = floor(fc / uRes.y * P);
    float2 uv = (g + 0.5) / P;
    float d = bayer4(g) - 0.5;
    float hz = 0.5;
    float3 fogCol = mix(BG * 2.5, float3(0.25, 0.12, 0.3), 0.5);
    float3 col;
    if (uv.y < hz) {
        float k = uv.y / hz;
        col = mix(BG * 0.8, mix(fogCol, S * 0.6, 0.35), pow(k, 1.4));
        // Low-poly mountains: straight segments.
        float mx = uv.x * 5.0 + t * 0.03;
        float seg = fract(mx);
        float h0 = hash11(floor(mx));
        float h1 = hash11(floor(mx) + 1.0);
        float mh = hz - 0.04 - 0.12 * mix(h0, h1, seg);
        float3 mcol = mix(fogCol, BG * 1.6, 0.4) * (0.8 + 0.2 * step(0.5, seg));
        col = mix(col, mcol, step(mh, uv.y));
        // Stars.
        col += float3(1.0) * step(0.997, hash12(g)) * (1.0 - k);
    } else {
        // Floor: perspective depth, but the texture mixes in a screen-linear (affine) term that
        // wobbles - the swimming textures of hardware without perspective correction.
        float dy = max(uv.y - hz, 0.002);
        float z = 0.25 / dy;
        float aff = 0.35 * (0.5 + 0.5 * sin(t * 0.7));
        float2 tp = float2((uv.x - asp * 0.5) * mix(z, 1.0 / (dy + 0.1), aff), mix(z, dy * 6.0, aff * 0.3) + t * 0.6);
        float chk = step(0.5, fract(floor(tp.x * 2.0) * 0.5 + floor(tp.y * 2.0) * 0.5));
        float3 tex = mix(A * 0.55, S * 0.35 + BG, chk);
        // Grout lines.
        float2 tf = fract(tp * 2.0);
        tex *= 0.75 + 0.25 * step(0.06, tf.x) * step(0.06, tf.y);
        float fog = sat(1.0 - exp(-z * 0.18));
        col = mix(tex, fogCol, fog);
    }
    // Gems turning above the floor.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float orbit = t * 0.24 + fi * TAU / 3.0;
        float depth = 2.0 + 0.65 * cos(orbit);
        float projection = 1.0 / depth;
        float2 c = float2(asp * 0.5 + 0.7 * sin(orbit) * projection, hz - (0.32 + 0.035 * sin(t + fi)) * projection);
        float r = 0.23 * projection;
        float hit = 0.0;
        float3 gc = gem(uv - c, r, t * (0.8 + 0.3 * fi) + fi, fi < 0.5 ? A : (fi < 1.5 ? S : mix(A, S, 0.5)), float3(1.0), 22.0, hit);
        col = mix(col, gc, hit);
        // Blob shadow on the floor.
        float2 sh = (uv - float2(c.x, hz + 0.16 * projection)) * float2(1.0, 4.0);
        col *= 1.0 - 0.4 * (1.0 - smoothstep(r * 0.4, r, length(sh))) * step(hz, uv.y);
    }
    // 15-bit colour with ordered dithering.
    col = floor(col * 31.0 + d * 1.6 + 0.5) / 31.0;
    return half4(finish(col, fc), 1.0);
}
