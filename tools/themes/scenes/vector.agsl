// Vector arcade: glowing vector lines on black like an early-80s vector monitor. A ship flies left to
// right every few seconds, weaving through floating Voltcap capsule logos that light up as it passes,
// leaving a dotted beam trail, firing laser dashes and warping in and out; jagged rocks tumble, a
// wireframe mountain range sits on the horizon over a rushing grid, with the bloom and flicker of the beam.
float rockDist(float2 p, float seed, float ang) {
    p = rot(ang) * p;
    float d = 1e3;
    float n = 9.0;
    float2 prev = float2(0.0);
    float2 first = float2(0.0);
    for (int i = 0; i < 10; i++) {
        float fi = float(i);
        float a = fi / n * TAU;
        float r = 0.75 + 0.25 * hash11(seed * 13.0 + mod(fi, n));
        float2 v = float2(cos(a), sin(a)) * r;
        if (i > 0) d = min(d, sdSegment(p, prev, v));
        prev = v;
    }
    return d;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 col = float3(0.0);
    float flick = 0.94 + 0.06 * sin(t * 50.0);
    // Starfield.
    col += float3(0.8, 0.9, 1.0) * dots(uv, 40.0, float2(t * 0.01, 0.0), 0.25, 0.05, 1.0) * 0.5;
    // Wire mountains on the horizon.
    float hz = 0.8;
    float mx = uv.x * 3.0 + t * 0.02;
    float seg = fract(mx);
    float m0 = hash11(floor(mx));
    float m1 = hash11(floor(mx) + 1.0);
    float mh = hz - 0.03 - 0.12 * mix(m0, m1, seg);
    col += S * exp(-abs(uv.y - mh) * 600.0) * 0.9 * step(uv.y, hz + 0.001);
    col += S * exp(-abs(uv.y - hz) * 900.0) * 0.6;
    // Ground grid lines rushing in.
    if (uv.y > hz) {
        float z = 0.1 / (uv.y - hz + 0.001);
        float gl = exp(-abs(fract(z * 2.0 - t * 1.0) - 0.5) * 1.0 / max(0.002, (uv.y - hz) * 0.5) * 0.02);
        col += S * smoothstep(0.96, 1.0, abs(cos((z * 2.0 - t) * PI))) * 0.4 * (uv.y - hz) * 6.0;
        col += S * smoothstep(0.97, 1.0, abs(cos(((uv.x - asp * 0.5) * z) * PI * 2.0))) * 0.35 * (uv.y - hz) * 6.0;
    }
    // Tumbling rocks.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float sp = 0.03 + 0.02 * hash11(fi * 4.0);
        float2 c = float2(mod(hash11(fi * 2.3) * (asp + 0.4) + t * sp * (fract(fi * 0.5) < 0.25 ? 1.0 : -1.0), asp + 0.4) - 0.2,
                          0.12 + 0.55 * hash11(fi * 7.1) + 0.03 * sin(t * 0.3 + fi));
        float R = 0.05 + 0.06 * hash11(fi * 5.7);
        float d = rockDist((uv - c) / R, fi, t * (0.2 + 0.3 * hash11(fi))) * R;
        float3 rc = mix(A, float3(1.0), 0.35);
        col += rc * (exp(-d * 900.0) * 0.9 + exp(-d * 120.0) * 0.15);
    }
    // Floating vector logos: Voltcap's capsule with its bolt, outlined in light, drifting at three depths.
    float pass = fract(t / 9.0);                       // the ship's run across the screen
    float shipX = mix(-0.15, asp + 0.15, smoothstep(0.0, 1.0, pass));
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float sc = 0.05 + 0.03 * fi;
        float2 lc = float2(asp * (0.25 + 0.27 * fi) + 0.04 * sin(t * 0.13 + fi), 0.28 + 0.16 * hash11(fi * 3.3) + 0.03 * sin(t * 0.21 + fi * 2.0));
        float2 lq = rot(0.15 * sin(t * 0.2 + fi)) * (uv - lc) / sc;
        float cap = abs(sdRoundBox(lq, float2(1.6, 0.75), 0.75)) * sc;
        // The bolt: a three-stroke zigzag inside the capsule.
        float bz = min(min(sdSegment(lq, float2(0.25, -0.55), float2(-0.3, 0.05)), sdSegment(lq, float2(-0.3, 0.05), float2(0.3, -0.05))),
                       sdSegment(lq, float2(0.3, -0.05), float2(-0.25, 0.55))) * sc;
        float ld = min(cap, bz);
        // Lights up as the ship flies through it.
        float hit = exp(-abs(uv.x - shipX) * 8.0) * step(0.02, pass) * step(pass, 0.98);
        float3 lcol = mix(mix(S, A, 0.5), float3(1.0), 0.3 + 0.5 * hit);
        col += lcol * (exp(-ld * 900.0) * (0.55 + 0.6 * hit) + exp(-ld * 90.0) * 0.08 * (1.0 + 2.0 * hit)) * (0.6 + 0.2 * fi);
    }

    // The ship: flies left to right every 9 s, weaving through the logos, banking into its turns.
    float sy = 0.42 + 0.12 * sin(pass * TAU * 1.5 + floor(t / 9.0) * 2.1);
    float bank = 0.35 * cos(pass * TAU * 1.5 + floor(t / 9.0) * 2.1);
    float2 sc2 = float2(shipX, sy);
    float2 q = rot(-bank * 0.6) * (uv - sc2) / 0.04;
    float sd = min(min(sdSegment(q, float2(1.3, 0.0), float2(-0.8, 0.7)), sdSegment(q, float2(1.3, 0.0), float2(-0.8, -0.7))),
                   sdSegment(q, float2(-0.5, 0.55), float2(-0.5, -0.55))) * 0.04;
    col += float3(1.0) * exp(-sd * 900.0) * 1.2;
    // Engine flame, flickering.
    float flame = 0.8 + 0.6 * step(0.5, fract(t * 14.0));
    col += mix(S, float3(1.0), 0.4) * exp(-sdSegment(q, float2(-0.6, 0.0), float2(-1.3 - 0.6 * flame, 0.0)) * 0.04 * 700.0) * 0.9;
    // A trail of fading beam dots behind it (its past positions).
    for (int k = 1; k < 8; k++) {
        float fk = float(k);
        float pp = pass - fk * 0.012;
        float tx = mix(-0.15, asp + 0.15, smoothstep(0.0, 1.0, pp));
        float ty = 0.42 + 0.12 * sin(pp * TAU * 1.5 + floor(t / 9.0) * 2.1);
        col += S * exp(-length(uv - float2(tx - 0.03, ty)) * 500.0) * (1.0 - fk / 8.0) * 0.6 * step(0.0, pp);
    }
    // Laser shots: a short dash fired ahead every 0.6 s.
    float shot = fract(t / 0.6);
    float2 lp = sc2 + float2(0.04 + shot * 0.5, 0.0);
    col += mix(A, float3(1.0), 0.5) * exp(-sdSegment(uv, lp, lp + float2(0.05, 0.0)) * 700.0) * (1.0 - shot) * step(0.03, pass) * step(pass, 0.9);
    // Warp streaks where it enters and leaves the screen.
    float warpIn = exp(-pass * 40.0);
    float warpOut = exp(-(1.0 - pass) * 40.0);
    col += float3(1.0) * exp(-abs(uv.y - sy) * 300.0) * (warpIn * step(uv.x, 0.4) + warpOut * step(asp - 0.4, uv.x)) * 0.6;
    col *= flick;
    // Beam bloom.
    col += col * col * 0.3;
    return half4(finish(col, fc), 1.0);
}
