// Fireworks: rockets burst over a dark skyline in time with the music — a big shell on every kick
// (somewhere new each time), smaller ones keeping time between them, sparks falling and fading with
// a twinkle, in the cover's colours. The bursts gather around the equalizer's line, and the river
// below mirrors them.
//#include reactive

// One shell: burst centred at c, `age` seconds old, sparks of colour col. Returns light.
float3 shell(float2 uv, float2 c, float age, float size, float seed, float3 col) {
    if (age < 0.0 || age > 2.6) return float3(0.0);
    float3 acc = float3(0.0);
    float fade = exp(-age * 1.4);
    // Sparks on rings: the pixel's direction picks a spark, its distance checks the ring.
    float2 d = uv - c;
    float g = 0.09 * age * age;                    // gravity pulls the whole burst down
    d.y -= g;
    float r = length(d);
    float a = atan(d.y, d.x);
    float N = 28.0;
    float id = floor((a / TAU + 0.5) * N);
    float sa = ((id + 0.5) / N - 0.5) * TAU;
    float speed = size * (0.85 + 0.3 * hash11(id + seed));
    float rad = speed * (1.0 - exp(-age * 3.0));
    float2 sp = float2(cos(sa), sin(sa)) * rad;
    float ds = length(d - sp);
    // Spark head plus its short trail back towards the centre.
    float trail = sdSegment(d, sp * 0.82, sp);
    float tw = 0.6 + 0.4 * sin(age * 30.0 + id * 3.1);
    acc += col * (exp(-ds * 300.0) * 2.6 + exp(-trail * 650.0) * 1.0 + exp(-ds * 60.0) * 0.12) * fade * tw;
    // Flash at the start.
    acc += mix(col, float3(1.0), 0.6) * exp(-r * 30.0 / max(size, 0.01)) * exp(-age * 9.0) * 0.8;
    return acc;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float k = uIntensity;
    float play = uPlaying;
    float bass = uBass * play;

    float waterY = 0.82;
    float2 p = uv;
    bool below = uv.y > waterY;
    if (below) p.y = 2.0 * waterY - uv.y + 0.004 * sin(uv.x * 60.0 + t * 3.0);

    float3 col = mix(BG * 0.35, mix(BG, A, 0.15), smoothstep(0.0, waterY, p.y));
    col = mix(col, coverField(p, asp, t, bass, 0.6, BG, A, S), 0.2);
    col += float3(1.0) * dots(p, 70.0, float2(t * 0.002, 0.0), 0.1, 0.08, 7.0) * 0.4;
    // Smoke drifting, lit by the bursts.
    float smoke = fbm3(float2(p.x * 1.5 - t * 0.03, p.y * 2.5));

    float3 fw = float3(0.0);
    float room_ = room(0.22);
    // The big shell from the last kick: placed by the kick's own time.
    float kickT = t - uBeatAge;
    float hk = hash11(floor(kickT * 4.0) + 1.0);
    float2 ck = float2(asp * (0.25 + 0.5 * hk), uWaveY - room_ * (0.2 + 0.5 * hash11(floor(kickT * 4.0) + 7.0)));
    float3 colK = mix(A, S, hash11(floor(kickT * 4.0) + 3.0));
    fw += shell(p, ck, uBeatAge, 0.2 + 0.1 * k, floor(kickT * 4.0), colK) * play * (0.8 + 0.6 * k);
    // Smaller shells keeping time on their own (a few slots, each on its own rhythm).
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float per = 1.7 + 0.6 * fi;
        float cyc = floor(t / per + fi * 0.37);
        float age = t - (cyc - fi * 0.37) * per;
        float2 c = float2(asp * (0.1 + 0.8 * hash11(cyc * 1.3 + fi)), uWaveY - room_ * (0.6 * hash11(cyc + fi * 5.0) - 0.1));
        float3 cc = mix(A, S, hash11(cyc + fi * 2.0));
        fw += shell(p, c, age, 0.09 + 0.06 * hash11(cyc + fi), cyc + fi * 10.0, cc) * (0.5 + 0.8 * uMid * play);
    }
    col += fw;
    col += (fw * 0.6 + mix(A, S, 0.5) * 0.02) * smoke;

    // The skyline in silhouette, windows lit.
    float bx = uv.x * 22.0;
    float bid = floor(bx);
    float bh = 0.03 + 0.09 * hash11(bid * 1.7) * hash11(bid + 3.0) + 0.04 * step(0.88, hash11(bid + 8.0));
    float roof = waterY - bh;
    float bld = step(roof, p.y) * step(p.y, waterY);
    float2 wcell = float2(fract(bx) * 5.0, (p.y - roof) * 90.0);
    float win = step(0.45, fract(wcell.x)) * step(0.5, fract(wcell.y)) * step(0.82, hash12(floor(wcell) + bid * 13.0));
    float3 sky = col;
    col = mix(col, BG * 0.08, bld);
    col += mix(float3(1.0, 0.85, 0.5), A, 0.2) * win * bld * 0.2;
    // Bursts light the edges of the roofs.
    col += fw * 0.15 * bld;

    if (below) {
        col *= 0.45;
        col += mix(A, S, 0.5) * exp(-(uv.y - waterY) * 200.0) * 0.15;
    }
    return half4(finish(col, fc), 1.0);
}
