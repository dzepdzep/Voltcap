// Dojo · 32-bit (fighting type): an outdoor training yard at sunset. A wooden practice post spins when
// it's struck, a sandbag swings on its beam, long banners ripple on their poles, lanterns sway under
// the eaves, the sun sinks behind the temple roof and blossom petals blow across the raked earth.
//#include pixel

half4 main(float2 fc) {
    float2 cell = pxCell(fc);
    float2 uv = pxUv(cell);
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Strike rhythm: a hit every 2.5 s.
    float hc = t / 2.5;
    float hk = floor(hc);
    float ha = fract(hc) * 2.5;
    float hit = exp(-ha * 6.0);

    // Sunset sky: banded warm gradient, a big sun behind the temple, streaks of cloud lit from below.
    float3 skyHi = mix(float3(0.42, 0.2, 0.36), BG * 2.5, 0.25);
    float3 skyMid = mix(float3(0.95, 0.45, 0.25), A, 0.35);
    float3 skyLo = mix(float3(1.0, 0.8, 0.45), S, 0.3);
    float sy = pxBand(sat(uv.y * 2.1), 6.0, cell);
    float3 col = sy < 0.5 ? mix(skyHi, skyMid, sy * 2.0) : mix(skyMid, skyLo, sy * 2.0 - 1.0);
    float2 sun = float2(asp * 0.5, 0.36);
    float sd = length(uv - sun);
    col = mix(col, mix(skyLo, float3(1.0, 0.95, 0.75), 0.6), step(sd, 0.15) * 0.9);
    col = mix(col, mix(col, skyLo, 0.5), step(sd, 0.2) * step(0.15, sd) * step(0.5, bayer4(cell)));
    // Clouds: long thin streaks, dark violet with a bright underside.
    for (int c = 0; c < 4; c++) {
        float fc2 = float(c);
        float cy = 0.08 + fc2 * 0.075;
        float cx = fract(hash11(fc2 * 5.0) + t * (0.004 + fc2 * 0.002)) * (asp + 0.8) - 0.4;
        float len = 0.25 + 0.2 * hash11(fc2 * 9.0);
        float thick = 0.012 + 0.006 * hash11(fc2 * 2.0);
        float dx = abs(uv.x - cx) / len;
        float cl = step(dx, 1.0) * step(abs(uv.y - cy), thick * (1.0 - dx * dx));
        col = mix(col, mix(float3(0.4, 0.2, 0.3), BG * 2.0, 0.3), cl);
        col = mix(col, mix(skyLo, float3(1.0, 0.85, 0.6), 0.5), cl * step(cy + thick * (1.0 - dx * dx) - PX * 1.5, uv.y));
    }
    // Far mountains, two layers of violet haze.
    float m1 = 0.47 - 0.07 * vnoise(float2(uv.x * 4.0, 1.0)) - 0.04 * abs(sin(uv.x * 7.0));
    float m2 = 0.53 - 0.05 * vnoise(float2(uv.x * 6.0 + 3.0, 2.0));
    col = mix(col, mix(mix(float3(0.62, 0.36, 0.42), skyMid, 0.35), col, 0.2), step(m1, uv.y));
    col = mix(col, mix(float3(0.48, 0.26, 0.32), BG * 2.0, 0.2), step(m2, uv.y));
    // The yard's wall: pale plaster under a dark tiled cap, shaded by the sunset.
    float3 plaster = mix(float3(0.82, 0.66, 0.52), skyLo, 0.2);
    float3 wallBack = pxRamp(0.85 - (uv.y - 0.6) * 5.0 - 0.15 * step(0.5, fract(uv.x * 9.0)) * 0.0, cell, plaster * 0.5, plaster * 0.68, plaster * 0.82, plaster);
    col = mix(col, wallBack, step(0.6, uv.y));
    col = mix(col, mix(float3(0.26, 0.12, 0.14), BG, 0.2) * (0.8 + 0.4 * step(0.5, fract(uv.x * 55.0))), step(0.588, uv.y) * step(uv.y, 0.604));
    col = mix(col, mix(float3(1.0, 0.75, 0.45), A, 0.3), step(abs(uv.y - 0.588), PX * 0.5) * 0.7);

    // A blossom tree behind the wall on the left: dark trunk, a round pink canopy with lit tufts.
    float2 tc = float2(asp * 0.13, 0.43);
    float trunk = pxBox(uv, float2(tc.x + 0.01 * (uv.y - 0.5) * 3.0, 0.58), float2(0.012, 0.11));
    float canopy = 0.0;
    for (int k = 0; k < 5; k++) {
        float fk = float(k);
        float2 cc = tc + float2((fk - 2.0) * 0.045, -0.02 * sin(fk * 2.0) + abs(fk - 2.0) * 0.02);
        canopy = max(canopy, pxDisc(uv, cc, 0.055 - abs(fk - 2.0) * 0.006));
    }
    float3 pink = mix(float3(0.96, 0.62, 0.7), S, 0.15);
    float tuft = vnoise(cell * 0.35);
    float3 canC = pxRamp(0.35 + 0.5 * tuft - (uv.y - tc.y) * 3.0, cell, pink * 0.45, pink * 0.7, pink, mix(pink, float3(1.0), 0.5));
    col = mix(col, float3(0.24, 0.13, 0.12), trunk);
    col = mix(col, canC, canopy);

    // The temple on its stone platform: two tiled roofs with upturned eaves and a lit edge, shadow under
    // the eaves, red pillars, lanterns glowing either side of the open door.
    float tx = uv.x - asp * 0.5;
    float3 dark = mix(float3(0.16, 0.07, 0.09), BG, 0.3);
    float3 wall = mix(float3(0.36, 0.2, 0.17), BG, 0.2);
    float3 tile = mix(float3(0.26, 0.12, 0.14), BG, 0.2);
    float eave1 = 0.45 - 0.05 * sqf(sat(abs(tx) / 0.36)) * 2.0;
    float ridge1 = 0.36 + 0.02 * sqf(abs(tx) / 0.3);
    float roof1 = step(ridge1, uv.y) * step(uv.y, eave1) * step(abs(tx), 0.36);
    float eave2 = 0.31 - 0.035 * sqf(sat(abs(tx) / 0.22)) * 2.0;
    float ridge2 = 0.25 + 0.015 * sqf(abs(tx) / 0.18);
    float roof2 = step(ridge2, uv.y) * step(uv.y, eave2) * step(abs(tx), 0.22);
    float upper = pxBox(uv, float2(asp * 0.5, 0.36), float2(0.15, 0.05));
    float hall = pxBox(uv, float2(asp * 0.5, 0.56), float2(0.27, 0.11));
    float3 wallC = mix(wall, wall * 0.6, pxBand(sat((uv.y - 0.45) * 6.0), 2.0, cell));
    wallC = mix(wallC, wall * 1.25, step(0.5, fract(tx * 30.0)) * 0.25);              // wooden boards
    col = mix(col, wallC, sat(upper + hall));
    col = mix(col, dark, hall * step(uv.y, 0.47 + PX * 2.0));                         // shadow under the eave
    // Roof tiles: rows of ridges, a lighter band where the sun catches them, the eave line glowing.
    float rows = step(0.5, fract(uv.x * 55.0));
    float3 tileC = pxRamp(0.3 + 0.4 * rows + 0.3 * sat(1.0 - abs(tx) * 3.0), cell, tile * 0.7, tile, tile * 1.35, mix(tile, skyLo, 0.4));
    col = mix(col, tileC, sat(roof1 + roof2));
    col = mix(col, mix(float3(1.0, 0.75, 0.45), A, 0.3), (step(abs(uv.y - eave1), PX * 0.6) * step(abs(tx), 0.36) + step(abs(uv.y - eave2), PX * 0.6) * step(abs(tx), 0.22)) * 0.9);
    col = mix(col, tile * 0.6, (step(abs(uv.y - ridge1), PX * 0.7) * step(abs(tx), 0.3) + step(abs(uv.y - ridge2), PX * 0.7) * step(abs(tx), 0.18)));
    // Pillars: lit on the sun side.
    float pil = step(abs(abs(tx) - 0.22), 0.012) + step(abs(abs(tx) - 0.08), 0.012);
    float pilLit = step(0.0, -sign(tx) * (abs(tx) - 0.22 * step(0.15, abs(tx)) - 0.08 * step(abs(tx), 0.15)));
    float3 red = mix(float3(0.7, 0.15, 0.12), A, 0.3);
    col = mix(col, mix(red * 0.65, red * 1.1, pilLit), pil * step(0.46, uv.y) * step(uv.y, 0.67));
    col = mix(col, mix(float3(1.0, 0.8, 0.45), S, 0.3), pxBox(uv, float2(asp * 0.5, 0.6), float2(0.05, 0.07)) * (0.85 + 0.15 * sin(t * 2.0)));
    col = mix(col, float3(0.35, 0.2, 0.15), pxBox(uv, float2(asp * 0.5, 0.6), float2(PX * 0.5, 0.07)));
    // Lanterns hanging from the eave, swaying a little.
    for (int l = 0; l < 2; l++) {
        float side = float(l) * 2.0 - 1.0;
        float2 lc = pxSnap(float2(asp * 0.5 + side * 0.15 + 0.003 * sin(t * 1.5 + side), 0.51));
        col = mix(col, float3(0.2, 0.12, 0.1), pxBox(uv, lc - float2(0.0, 0.025), float2(PX * 0.5, 0.012)));
        float lan = pxBox(uv, lc, float2(0.014, 0.02)) * step(length((uv - lc) * float2(1.0, 0.75)), 0.017);
        float3 lanC = mix(float3(1.0, 0.55, 0.25), A, 0.3) * (0.9 + 0.1 * sin(t * 3.0 + side));
        col = mix(col, mix(lanC, float3(1.0, 0.9, 0.6), step(abs(uv.x - lc.x), PX * 1.5) * 0.6), lan);
        col += lanC * 0.12 * step(length(uv - lc), 0.045) * step(bayer4(cell), 0.5) * (1.0 - lan);
    }
    // The stone platform and steps.
    float plat = pxBox(uv, float2(asp * 0.5, 0.685), float2(0.3, 0.018));
    float step1 = pxBox(uv, float2(asp * 0.5, 0.705), float2(0.08, 0.008));
    float3 stone = mix(float3(0.55, 0.48, 0.45), BG * 3.0, 0.2);
    col = mix(col, pxRamp(0.6 - (uv.y - 0.667) * 20.0, cell, stone * 0.55, stone * 0.75, stone, stone * 1.15), sat(plat + step1));

    // Hanging banners on tall poles with a crossbar: long cloth in the accent colour with a dark trim and
    // a pale diamond crest, rippling in the wind (one solid colour, so no country's flag).
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float px0 = fi < 0.5 ? asp * 0.27 : asp * 0.83;
        col = mix(col, float3(0.26, 0.16, 0.11), pxBox(uv, float2(px0, 0.5), float2(PX * 0.8, 0.29)));
        col = mix(col, float3(0.26, 0.16, 0.11), pxBox(uv, float2(px0 + 0.03, 0.225), float2(0.035, PX * 0.7)));
        float2 q = uv - float2(px0 + 0.006, 0.23);
        float wave = 0.006 * sin(q.y * 30.0 - t * 4.0 + fi) * sat(q.y / 0.1);
        float bx = q.x - wave;
        float cloth = step(0.0, bx) * step(bx, 0.055) * step(0.0, q.y) * step(q.y, 0.2 - step(0.0275, abs(bx - 0.0275)) * 0.0);
        // A swallow-tail notch at the bottom.
        cloth *= step(q.y, 0.2 - (0.025 - abs(bx - 0.0275)) * 0.8);
        float trim = step(bx, PX * 1.5) + step(0.055 - PX * 1.5, bx) + step(q.y, PX * 2.0);
        float2 dq = float2(bx - 0.0275, q.y - 0.07);
        float crest = step(abs(dq.x) + abs(dq.y) * 0.8, 0.017);
        float crestIn = step(abs(dq.x) + abs(dq.y) * 0.8, 0.008);
        float3 clothC = mix(float3(0.75, 0.2, 0.15), A, 0.55);
        clothC = mix(clothC, clothC * 0.7, step(0.5, sin(q.y * 30.0 - t * 4.0 + fi + 1.2)) * 0.5);  // folds in shade
        clothC = mix(clothC, clothC * 0.45, sat(trim));
        clothC = mix(clothC, mix(float3(0.98, 0.92, 0.8), S, 0.2), crest);
        clothC = mix(clothC, mix(float3(0.75, 0.2, 0.15), A, 0.55) * 0.8, crestIn);
        col = mix(col, clothC, cloth);
    }
    // The yard: packed earth, darker towards us, raked circles round the ring, pebbles.
    if (uv.y > 0.715) {
        float r = length((uv - float2(asp * 0.5, 0.84)) * float2(0.35, 1.0));
        float3 earth = mix(float3(0.62, 0.44, 0.29), float3(0.48, 0.32, 0.21), pxBand((uv.y - 0.715) * 3.5, 3.0, cell));
        earth = mix(earth, earth * 1.12, step(0.5, fract(r * 160.0)) * step(r, 0.13) * 0.6);   // raked rings
        earth = mix(earth, float3(0.72, 0.56, 0.38), step(r, 0.1) * step(0.088, r));
        earth = mix(earth, earth * 0.8, step(0.92, hash12(cell)));                                // pebbles
        earth = mix(earth, earth * 1.15, step(0.95, hash12(cell + 5.0)));
        col = earth;
    }
    // The practice post: spins (arms swing round) after each hit.
    float2 pp = float2(asp * 0.32, 0.9);
    float spin = (1.0 - exp(-ha * 2.5)) * 6.0 + hk * 0.0;
    col = mix(col, float3(0.45, 0.28, 0.15), pxBox(uv, pp - float2(0.0, 0.12), float2(0.016, 0.12)));
    col = mix(col, float3(0.35, 0.2, 0.1), pxBox(uv, pp - float2(0.006, 0.12), float2(0.004, 0.12)));
    for (int a = 0; a < 3; a++) {
        float fa = float(a);
        float ang = spin + fa * 2.1;
        float ay = pp.y - 0.17 + fa * 0.04;
        float ext = 0.05 * cos(ang);
        float front = step(0.0, sin(ang));
        float arm = pxBox(uv, float2(pp.x + ext * 0.5, ay), float2(abs(ext) * 0.5 + PX, 0.006));
        col = mix(col, mix(float3(0.4, 0.25, 0.12), float3(0.62, 0.42, 0.22), front), arm);
    }
    // The sandbag on its beam: swings after a hit.
    float2 beam = float2(asp * 0.7, 0.5);
    col = mix(col, float3(0.3, 0.18, 0.12), pxBox(uv, beam, float2(0.09, 0.008)) + pxBox(uv, beam + float2(0.085, 0.2), float2(0.008, 0.2)));
    float sw = 0.35 * exp(-ha * 0.8) * sin(ha * 4.0) * step(0.5, mod(hk, 2.0)) + 0.03 * sin(t * 1.3);
    float2 bq = rot(sw) * (uv - beam);
    float rope = pxBox(bq, float2(0.0, 0.04), float2(PX * 0.5, 0.04));
    float bag = pxBox(bq, float2(0.0, 0.14), float2(0.028, 0.06)) * step(length(bq - float2(0.0, 0.14)) , 0.075);
    col = mix(col, float3(0.6, 0.55, 0.45), rope);
    col = mix(col, mix(mix(float3(0.7, 0.3, 0.2), A, 0.3), float3(0.5, 0.2, 0.15), step(0.0, bq.x)), bag);
    col = mix(col, float3(0.9, 0.85, 0.7), bag * step(abs(bq.y - 0.11), PX * 0.6));
    // The hit: a starburst with "speed lines".
    float2 hp = mod(hk, 2.0) < 0.5 ? pp - float2(0.0, 0.16) : beam + float2(0.0, 0.14);
    float2 hq = uv - hp;
    float ang = atan(hq.y, hq.x);
    float burst = step(length(hq), (0.03 + 0.05 * (1.0 - hit)) * (0.7 + 0.3 * step(0.0, sin(ang * 8.0)))) * step(0.02 + 0.04 * (1.0 - hit), length(hq));
    col = mix(col, mix(float3(1.0, 0.95, 0.6), A, 0.2), burst * step(ha, 0.35));
    // Petals and dust blowing across.
    for (int i = 0; i < 10; i++) {
        float fi = float(i);
        float2 p = pxSnap(float2(fract(hash11(fi) - t * (0.04 + 0.03 * hash11(fi * 2.0))) * (asp + 0.2) - 0.1, fract(hash11(fi * 3.0) + t * 0.02) * 0.9 + 0.03 * sin(t * 2.0 + fi)));
        float2 q = (uv - p) / PX;
        float pet = step(abs(q.x), 1.0 + step(0.0, sin(t * 5.0 + fi))) * step(abs(q.y), 0.6);
        col = mix(col, mix(float3(1.0, 0.75, 0.82), S, 0.3), pet);
    }
    col = pxQuant(col, 10.0, cell);
    return half4(finish(col, fc), 1.0);
}
