// Cover ripple: the album cover lying under shallow water. Every kick drops into the middle and
// sends a ring of ripples out over the picture, the spectrum runs gentle waves across it, light
// dances on the surface, and the cover's colours glow all round the pool.
//#include reactive

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float k = uIntensity;
    float play = uPlaying;
    float bass = uBass * play;

    float3 col = coverField(uv, asp, t, bass, 0.75, BG, A, S);
    col = mix(col, paletteField(uv, asp, t, bass * k, BG, A, S), 0.35);

    float2 c = float2(waveX(asp), uWaveY);
    float R = room(0.28) * 0.95;
    float2 d = uv - c;
    float r = length(d);

    // Height of the water at this point: the kick's ring plus two older ones, and waves along x
    // from the spectrum.
    float h = 0.0;
    for (int i = 0; i < 3; i++) {
        float age = uBeatAge + float(i) * 0.55;
        float front = age * 0.35;
        float amp = exp(-age * 1.6) * play * (0.6 + 0.6 * k);
        h += sin((r - front) * 70.0) * exp(-abs(r - front) * 22.0) * amp;
    }
    float m = sat(uv.x / asp);
    h += sin(uv.y * 40.0 + t * 1.5 + m * 6.0) * eqAt(m) * play * 0.25 * k;
    h += 0.15 * sin(d.x * 25.0 + t * 0.9) * sin(d.y * 21.0 - t * 0.7);
    // Bend the picture by the slope of the water.
    float2 grad = float2(cos(r * 70.0), sin(uv.y * 40.0 + t * 1.5)) * h;
    float2 refr = d + grad * 0.006;

    float box = sdRoundBox(d, float2(R), R * 0.05);
    // A soft glow around the pool.
    col += mix(A, S, 0.5) * exp(-max(box, 0.0) * 10.0) * (0.25 + 0.6 * bass * k) * step(0.0, box);
    if (box < px) {
        float2 q = refr / (2.0 * R) + 0.5;
        float3 pic = sharpCover(q, A, S);
        // Light dancing on the surface (caustics) and the crests catching the light.
        float2 cp = (d + grad * 0.01) * 18.0;
        float c1 = abs(sin(cp.x + sin(cp.y * 1.3 + t * 0.9) + t * 0.6));
        float c2 = abs(sin(cp.y * 1.2 + sin(cp.x * 1.1 - t * 0.7) - t * 0.5));
        float caus = pow(1.0 - min(c1, c2), 7.0);
        pic += float3(1.0) * caus * 0.18 + float3(1.0) * sat(h) * 0.12;
        pic *= 0.92 + 0.12 * h;
        col = mix(col, pic, 1.0 - smoothstep(-px, px, box));
    }
    col += mix(float3(1.0), S, 0.3) * (1.0 - smoothstep(0.0, px * 2.0, abs(box))) * 0.3;

    return half4(finish(col, fc), 1.0);
}
