// Disc spin: the cover printed on a compact disc spinning in a beam of light. The clear hub and
// the rainbow that a disc throws off stay fixed to the light while the print turns under them; light
// spikes burst outwards with the spectrum and rings roll off on every kick. Colours from the cover.
//#include reactive

float3 hue3(float h) {
    return clamp(abs(fract(h + float3(0.0, 0.6667, 0.3333)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float k = uIntensity;
    float play = uPlaying;
    float bass = uBass * play;
    float high = uHigh * play;
    float kick = exp(-uBeatAge * 5.0) * play;
    float lvl = bass * 0.5 + uMid * play * 0.3 + high * 0.2;

    float3 col = paletteField(uv, asp, t, lvl * k, BG, A, S);
    float2 c = float2(waveX(asp), uWaveY);
    float R = room(0.28) * 0.9;
    float2 d = uv - c;
    float r = length(d);
    float ang = atan(d.y, d.x);
    float a01 = fract(ang / TAU + 0.25);

    // Diagonal beams of light through the room.
    float beam = sin((uv.x - uv.y * 0.6) * 5.0 - t * 0.3);
    col += mix(A, float3(1.0), 0.5) * smoothstep(0.75, 1.0, beam) * 0.08;

    // Light spikes round the disc, following the spectrum (bass at the top, mirrored).
    float m = abs(a01 - 0.5) * 2.0;
    float e = eqAt(m) * play;
    float N = 64.0;
    float fa = fract(a01 * N);
    float spikeLen = R * (0.08 + 0.55 * e * (0.5 + 0.5 * k));
    float spike = (1.0 - smoothstep(0.0, 0.35, abs(fa - 0.5))) * step(R * 1.04, r) * (1.0 - smoothstep(R * 1.04 + spikeLen * 0.6, R * 1.04 + spikeLen, r));
    float3 sc = hue3(a01 + t * 0.05) * 0.5 + mix(A, S, m) * 0.6;
    col += sc * spike * (0.4 + 0.6 * e);
    col += mix(A, S, 0.5) * exp(-max(r - R, 0.0) * 8.0) * (0.1 + 0.4 * bass * k);
    // Rings rolling off on the kick.
    float rr = R + uBeatAge * 0.5;
    col += mix(S, float3(1.0), 0.3) * exp(-abs(r - rr) * 90.0) * exp(-uBeatAge * 2.5) * 0.6 * k * play;
    // Shadow.
    col *= 1.0 - 0.4 * exp(-max(length(d - float2(0.01, 0.016)) - R, 0.0) * 45.0) * step(R, r);

    if (r < R) {
        float rn = r / R;
        float spin = 3.3 * uPlayT + t * 0.16; // a little slower than before: still clearly a disc spinning, easier on the eye
        float la = ang - spin;
        // The print: the cover, turning.
        float2 q = float2(cos(la), sin(la)) * rn;
        float3 print = mix(mix(A, S, q.y * 0.5 + 0.5), float3(1.0), 0.1);
        float3 art = float3(uCover.eval(clamp(q * 0.5 + 0.5, 0.0, 1.0) * uCoverSize).rgb);
        print = mix(print, art, uHasArt);
        // The rainbow: fixed to the light (ang), not to the print; strongest along two opposite bands.
        float band = pow(abs(cos(ang - 0.6 + 0.08 * sin(t * 0.5))), 6.0);
        float3 rainbow = hue3(rn * 1.2 + 0.1 * sin(t * 0.2) + 0.15 * cos(ang - 0.6));
        float3 disc = mix(print, rainbow, 0.06 + 0.32 * band);
        disc += float3(1.0) * pow(band, 8.0) * 0.35;
        // Silver data edge and the clear hub.
        disc = mix(disc, mix(float3(0.85), rainbow, 0.4), smoothstep(0.96, 0.975, rn));
        float hub = smoothstep(0.30, 0.31, rn);
        float3 clear = mix(col * 0.75 + float3(0.12), rainbow * 0.4 + 0.4, 0.3 * smoothstep(0.18, 0.3, rn));
        disc = mix(clear, disc, hub);
        disc = mix(disc, float3(0.9), (1.0 - smoothstep(0.0, 0.006, abs(rn - 0.305))) * 0.6);
        disc = mix(col * 0.6, disc, smoothstep(0.12, 0.13, rn)); // the hole
        disc = mix(disc, float3(0.95), (1.0 - smoothstep(0.0, 0.004, abs(rn - 0.995))) * 0.7);
        col = disc;
    }

    // Glints flying off with the highs.
    col += float3(1.0) * dots(uv, 34.0, float2(-t * 0.06, t * 0.03), 0.1, 0.07, 9.0) * (0.15 + 0.6 * high * k);
    return half4(finish(col, fc), 1.0);
}
