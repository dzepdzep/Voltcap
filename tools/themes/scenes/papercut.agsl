// Paper layers: a diorama of cut paper in a box lit by a lamp from the upper left. Each layer stands
// a little in front of the last, so it throws a soft, offset shadow onto the ones behind; cut edges
// catch the light where they face the lamp; far layers are paler (air between them), near ones rich
// and fibrous. Paper clouds hang on threads and sway, birds glide, the paper sun turns behind it all.

// Hill line of layer i (0 = furthest).
float hillLine(float x, float fi, float t) {
    float speed = 0.006 + fi * 0.012;
    float xx = x + t * speed + fi * 3.7;
    float h = 0.36 + fi * 0.11;
    h -= (0.09 - fi * 0.012) * sin(xx * (2.2 + fi * 0.9) + fi);
    h -= 0.05 * vnoise(float2(xx * (3.0 + fi), fi * 2.0));
    // Little paper trees on the nearer layers.
    float tx = xx * (6.0 + fi * 2.0);
    float tid = floor(tx);
    float tf = fract(tx) - 0.5;
    float tree = step(0.6, hash11(tid + fi * 11.0)) * step(1.5, fi) * max(0.0, 0.06 - abs(tf) * 0.18) * 1.0;
    return h - tree;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float px = 1.5 / uRes.y;

    // Sky: a sheet of paper with a soft gradient.
    float grain = vnoise(uv * 300.0) * 0.03;
    float3 col = mix(mix(BG, S, 0.25) * 1.3, mix(BG, A, 0.2), uv.y) + grain;
    // The paper sun, a scalloped disc turning slowly.
    float2 sc = float2(asp * 0.7, 0.27);
    float2 sd = uv - sc;
    float sa = atan(sd.y, sd.x) + t * 0.05;
    float sr = 0.09 + 0.006 * cos(sa * 12.0);
    float sun = 1.0 - smoothstep(sr - px, sr + px, length(sd));
    float sunSh = 1.0 - smoothstep(sr - 0.01, sr + 0.02, length(sd - float2(0.006, 0.008)));
    col *= 1.0 - 0.25 * sunSh * (1.0 - sun);
    col = mix(col, mix(S, float3(1.0, 0.9, 0.6), 0.4), sun);

    float2 lamp = float2(asp * 0.15, -0.3);
    float2 L = normalize(float2(0.55, 0.85));          // light direction across the box (towards +x, +y)
    // Paper clouds hanging on threads, swaying, each with its shadow on the sky sheet.
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float sw = 0.012 * sin(t * 0.5 + fi * 2.0);
        float2 cc = float2(asp * (0.22 + 0.36 * fi) + sw, 0.17 + 0.05 * fi);
        float cd = min(min(length((uv - cc) * float2(0.8, 1.0)) - 0.045, length(uv - cc - float2(0.045, 0.012)) - 0.032), length(uv - cc - float2(-0.05, 0.015)) - 0.028);
        cd = max(cd, uv.y - cc.y - 0.03);
        float cs = min(min(length((uv - cc - float2(0.012, 0.016)) * float2(0.8, 1.0)) - 0.045, length(uv - cc - float2(0.057, 0.028)) - 0.032), length(uv - cc - float2(-0.038, 0.031)) - 0.028);
        cs = max(cs, uv.y - cc.y - 0.046);
        col *= 1.0 - 0.18 * (1.0 - smoothstep(-0.01, 0.015, cs));
        float thread = (1.0 - smoothstep(0.0, px, abs(uv.x - cc.x - sw * (cc.y - uv.y) * 2.0))) * step(uv.y, cc.y - 0.03);
        col = mix(col, BG * 0.6, thread * 0.5);
        float3 paperW = mix(float3(0.97, 0.96, 0.93), S, 0.08) + grain;
        col = mix(col, paperW * (0.92 + 0.08 * smoothstep(0.02, -0.03, uv.y - cc.y)), 1.0 - smoothstep(-px, px, cd));
    }
    // Paper birds gliding across.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float x = fract(t * (0.02 + 0.01 * fi) + hash11(fi)) * (asp + 0.3) - 0.15;
        float y = 0.15 + 0.12 * hash11(fi + 3.0) + 0.01 * sin(t * 0.8 + fi);
        float2 b = uv - float2(x, y);
        float flap = 0.5 + 0.5 * sin(t * 3.0 + fi * 2.0);
        float wing = abs(b.y + abs(b.x) * (0.4 + 0.5 * flap)) - 0.003;
        float bird = (1.0 - smoothstep(0.0, px, wing)) * step(abs(b.x), 0.018);
        float2 bs = b - float2(0.008, 0.02);
        float wingS = abs(bs.y + abs(bs.x) * (0.4 + 0.5 * flap)) - 0.004;
        col *= 1.0 - 0.15 * (1.0 - smoothstep(0.0, 0.006, wingS)) * step(abs(bs.x), 0.02);
        col = mix(col, BG * 0.6, bird);
    }
    float3 skyCol = mix(mix(BG, S, 0.25) * 1.3, mix(BG, A, 0.2), uv.y) + grain;

    // Five layers, back to front. Each stands a little in front of the one behind: it casts a soft
    // shadow offset away from the lamp, its cut edge is lit where it faces the lamp, and the air
    // between the layers makes the far ones paler.
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float d = fi / 4.0;
        float h = hillLine(uv.x, fi, t);
        // The drop shadow onto what's behind: the hill line shifted down-right, blurred wider for the
        // nearer layers (they stand further off the sheet behind).
        float off = 0.006 + 0.01 * fi;
        float hs = hillLine(uv.x - off * 0.6, fi, t) + off;
        float soft = 0.01 + 0.012 * fi;
        float cut = smoothstep(h - px, h + px, uv.y);
        float drop = smoothstep(hs - soft, hs + soft, uv.y) * (1.0 - cut);
        col *= 1.0 - (0.28 + 0.06 * fi) * drop;
        float3 paper = mix(mix(S, A, d) * (0.55 + 0.1 * fi), BG * (1.2 - fi * 0.15), 0.3 + fi * 0.06);
        paper = mix(skyCol * 0.95 + 0.04, paper, 0.45 + 0.55 * d);   // aerial perspective
        // Paper fibre and a lamp falloff across the sheet.
        float fib = fbm3(uv * float2(90.0, 140.0) + fi * 13.0) - 0.5;
        paper *= 1.0 + fib * 0.07 * (0.5 + d);
        paper *= 0.82 + 0.3 * exp(-length(uv - lamp) * 0.7);
        paper += grain;
        // The cut edge: its slope faces the lamp or turns away from it.
        float dh = (hillLine(uv.x + 0.003, fi, t) - h) / 0.003;
        float2 nrm = normalize(float2(dh, -1.0));
        float facing = sat(dot(nrm, -L) * 0.8 + 0.25);
        float edge = exp(-max(uv.y - h, 0.0) / (0.0025 + 0.001 * fi)) * cut;
        paper += float3(1.0, 0.97, 0.9) * edge * facing * 0.28;
        paper *= 1.0 - edge * (1.0 - facing) * 0.25;
        // The sheet darkens a little lower down, where the next layer shades it.
        paper *= 1.0 - 0.1 * smoothstep(h, h + 0.15, uv.y);
        col = mix(col, paper, cut);
    }
    // The box: a soft vignette, as if looking into it.
    float2 vq = (uv - float2(asp * 0.5, 0.5)) / float2(asp, 1.0);
    col *= 1.0 - 0.35 * smoothstep(0.25, 0.75, length(vq));
    return half4(finish(col, fc), 1.0);
}
