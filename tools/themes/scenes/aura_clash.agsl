// Aura clash: two anime power auras - one in each of the theme's colours - pushing against each
// other from the left and the right. Where they meet, a crackling seam of lightning, shockwave
// rings every few seconds, rocks lifting off the cracked ground and focus lines snapping in.
// Generic battle-anime drawing style only.
//#include anime

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float2 c = float2(asp * 0.5, 0.52);
    // The seam wobbles between them: who's winning changes slowly.
    float push = 0.06 * sin(t * 0.35) + 0.02 * sin(t * 1.3);
    float seamX = c.x + push + 0.015 * (fbm3(float2(uv.y * 6.0, t * 2.0)) - 0.5);
    float side = uv.x - seamX;

    // Background: dark, each half washed in its aura's colour.
    float3 col = BG * 0.6;
    col = mix(col, mix(BG, A, 0.35), smoothstep(0.0, -0.6, side) * 0.8);
    col = mix(col, mix(BG, S, 0.35), smoothstep(0.0, 0.6, side) * 0.8);

    // Auras: flame-like streams flowing towards the seam, cel-banded.
    float dist = abs(side);
    float flow = fbm3(float2(dist * 6.0 - t * 2.5 * sign(side) * 0.0 - t * 2.5, uv.y * 4.0));
    float f = flow - dist * 2.4 + 0.45;
    float3 aura = side < 0.0 ? A : S;
    float b1 = step(0.25, f);
    float b2 = step(0.42, f);
    float b3 = step(0.6, f);
    col = mix(col, aura * 0.7, b1 * 0.8);
    col = mix(col, mix(aura, float3(1.0), 0.3), b2);
    col = mix(col, mix(aura, float3(1.0), 0.5), b3);

    // The seam: crackling lightning straight down the middle, white-hot.
    float bl = bolt(uv, float2(seamX, 0.05), float2(seamX, 0.95), floor(t * 12.0), 0.06);
    col += float3(1.0) * glow(bl, 0.003) * 0.9;
    col += mix(A, S, 0.5) * glow(bl, 0.02) * 0.35;
    // Side branches.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float y = 0.25 + fi * 0.22;
        float dir = mod(fi, 2.0) < 0.5 ? -1.0 : 1.0;
        float br = bolt(uv, float2(seamX, y), float2(seamX + dir * 0.2, y + 0.08), floor(t * 10.0) + fi * 7.0, 0.03);
        col += float3(1.0) * glow(br, 0.002) * 0.5 * step(0.4, hash11(floor(t * 3.0) + fi));
    }

    // Shockwave rings from the seam every few seconds.
    float st = fract(t / 3.0);
    float sr = length((uv - float2(seamX, c.y)) * float2(1.0, 1.6));
    col += float3(1.0) * exp(-abs(sr - st * 1.2) * 70.0) * (1.0 - st) * 0.6;
    col += float3(1.0) * focusLines(uv, float2(seamX, c.y), t, 80.0, 1.0) * (1.0 - smoothstep(0.0, 0.2, st)) * 0.35;

    // Cracked ground with glow, and rocks lifting off.
    if (uv.y > 0.82) {
        float3 ground = BG * 0.4;
        float cr = abs(fbm3(float2(uv.x * 8.0, uv.y * 30.0)) - 0.5);
        ground += mix(A, S, step(0.0, side)) * (1.0 - smoothstep(0.0, 0.03, cr)) * 0.8;
        col = ground;
    }
    float2 rp = uv * float2(6.0, 1.0) + float2(0.0, t * 0.08);
    float2 ri = floor(rp);
    float2 rf = fract(rp) - 0.5;
    float2 rh = hash22(ri + 2.0);
    float rock = sdRoundBox(rot(t * (rh.y - 0.5)) * ((rf - (rh - 0.5) * 0.5) * float2(1.0 / 6.0, 1.0)), float2(0.01 + 0.012 * rh.y), 0.003);
    col = mix(col, BG * 0.25 + mix(A, S, step(0.0, side)) * 0.25, (1.0 - smoothstep(0.0, px, rock)) * step(rh.x, 0.25));

    return half4(finish(col, fc), 1.0);
}
