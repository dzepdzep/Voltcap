// Leaf shade: afternoon sun on a warm plaster wall, the shadows of leaves from a tree you can't see
// gathering in the top-right and bottom-left corners and swaying softly in the breeze, little round
// sunspots dancing in them. The middle stays plain sunny wall (original design).

// Leaves: one layer of rotated ellipses on a jittered grid. Returns coverage 0..1.
float leafLayer(float2 p, float scale, float seed, float t, float blur) {
    float2 g = p * scale;
    float m = 0.0;
    for (int j = 0; j < 4; j++) {
        // Four offset lookups instead of a full neighbour search: enough for overlapping leaves.
        float2 off = float2(float(j / 2), float(j - (j / 2) * 2)) * 0.5;
        float2 id = floor(g + off);
        float2 f = g + off - id - 0.5;
        float2 r = hash22(id + seed);
        float a = r.x * 6.28 + 0.25 * sin(t * (0.6 + r.y) + r.x * 9.0);
        float sc = 0.65 + 0.6 * hash12(id + seed + 3.3);
        float2 q = rot(a) * (f - (r - 0.5) * 0.6) / sc;
        // A pointed leaf: the lens between two circles.
        float d = max(length(q - float2(0.0, 0.3)), length(q + float2(0.0, 0.3))) - 0.44;
        // Leaves come in clumps.
        float clump = smoothstep(0.42, 0.6, vnoise(id * 0.35 + seed));
        m = max(m, smoothstep(blur, -blur, d) * clump);
    }
    return m;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;      // sunlight
    float3 S = uSec.rgb;      // leaf shade
    float3 BG = uBg.rgb;

    // Where the shade gathers: the two corners.
    float2 c1 = uv - float2(asp * 1.02, -0.05);
    float2 c2 = uv - float2(-0.05, 1.05);
    float zone = max(exp(-dot(c1, c1) * 2.2), exp(-dot(c2, c2) * 2.6));
    // The whole canopy sways.
    float2 sway = float2(0.02 * sin(t * 0.35) + 0.01 * sin(t * 0.9), 0.012 * sin(t * 0.27 + 1.0));
    float2 p = uv + sway * (0.5 + zone);
    // Soft far leaves and sharper near ones; shadows blur further from the leaves.
    float far = leafLayer(p + float2(3.1, 1.7), 7.0, 2.0, t, 0.3);
    float mass = smoothstep(0.45, 0.75, fbm3(p * 3.0 + sway * 3.0));
    float near = leafLayer(p + sway * 2.0, 5.0, 7.0, t * 1.3, 0.1);
    float branch = smoothstep(0.02, 0.0, abs(p.y - (0.12 + 0.25 * (asp - p.x) * (asp - p.x)) - 0.01 * sin(p.x * 20.0))) * step(asp * 0.62, p.x);
    float shade = sat(max(max(far * 0.75, mass * 0.6), near) * smoothstep(0.08, 0.5, zone) * 1.15 + branch * 0.8 * smoothstep(0.1, 0.4, zone));

    // Sunspots: round bright spots where light slips through the gaps.
    float spots = dots(p, 9.0, float2(t * 0.01, 0.0), 0.5, 0.18, 5.0) * shade;

    // The wall.
    float plaster = fbm(uv * float2(8.0, 6.0)) * 0.55 + vnoise(uv * 70.0) * 0.45;
    float3 sunny = mix(BG * 2.0 + A * 0.5, BG * 1.8 + A * 0.38, sat(uv.y));
    sunny *= 0.92 + 0.12 * plaster;
    float3 shadow = mix(BG * 1.1 + S * 0.14, BG * 0.95 + S * 0.1, sat(uv.y)) * (0.92 + 0.12 * plaster);
    float3 col = mix(sunny, shadow, shade * 0.88);
    // Warm edge where light meets shade, cool tint deep in the shade.
    col += A * shade * (1.0 - shade) * 0.18;
    col += mix(A, float3(1.0, 0.95, 0.85), 0.5) * spots * 0.25;
    // A warm glow in the open middle.
    col += A * exp(-length(uv - float2(asp * 0.45, 0.5)) * 2.0) * 0.05;

    return half4(finish(col, fc), 1.0);
}
