// Phantom: a haunted ruin under a veiled moon. Layer behind layer - a far castle, a row of broken
// arches, crooked dead trees and leaning gravestones - with fog banks drifting between them. Pale
// wisps float through the ruins on slow looping paths, trailing light and lighting the fog round
// them; the moon rims the stones and a faint shimmer runs over the wet ground.

// One wisp's position at time t (screen heights).
float2 wispPos(float i, float t, float asp) {
    return float2(
        asp * (0.1 + 0.8 * hash11(i * 3.1)) + 0.25 * sin(t * (0.08 + 0.05 * hash11(i)) + i * 1.7),
        0.40 + 0.28 * hash11(i * 7.3) + 0.07 * sin(t * (0.13 + 0.06 * hash11(i + 4.0)) + i * 2.3));
}

// Skyline of the far castle: towers and walls with battlements. Returns the top (y) at x.
float castleTop(float x) {
    float cell = floor(x / 0.09);
    float h = hash11(cell * 1.3);
    float top = 0.47 - 0.05 * h - 0.09 * step(0.72, h);
    // Battlements.
    top += 0.008 * step(0.5, fract(x / 0.018)) * step(h, 0.72);
    // Pointed roofs on the towers.
    float fx = abs(fract(x / 0.09) - 0.5);
    top -= step(0.72, h) * max(0.0, 0.05 - fx * 0.2) * 1.5;
    return top;
}

// The broken arches: negative inside the stone.
float arches(float2 p) {
    float w = 0.34;
    float cell = floor(p.x / w);
    float2 q = float2(fract(p.x / w) - 0.5, p.y) * float2(w, 1.0);
    float h = hash11(cell * 4.1 + 2.0);
    float top = 0.36 + 0.12 * h;
    float wall = max(-q.y + top, q.y - 0.74);
    // The arch opening.
    float open = min(length(float2(q.x, q.y - 0.54)) - 0.115, max(abs(q.x) - 0.115, -(q.y - 0.54)));
    float d = max(wall, -open);
    // Broken top: a jagged line.
    float brk = top + 0.05 * hash11(floor(p.x / 0.03) + cell) * step(0.4, h);
    d = max(d, -(p.y - brk));
    return d;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Sky: deep violet, lighter round the moon, thin clouds sliding over it.
    float2 mc = float2(asp * 0.72, 0.2);
    float md = length(uv - mc);
    float3 col = mix(BG * 2.2 + A * 0.06, BG * 0.8, sat(uv.y * 1.3));
    col += mix(A, float3(0.9, 0.9, 1.0), 0.5) * 0.18 * exp(-md * 3.0);
    float moon = smoothstep(0.082, 0.078, md);
    float3 moonCol = float3(0.86, 0.86, 0.95) * (0.85 + 0.15 * vnoise((uv - mc) * 40.0));
    col = mix(col, moonCol, moon);
    float veil = fbm3(float2(uv.x * 2.5 - t * 0.02, uv.y * 7.0));
    col = mix(col, BG * 1.5 + A * 0.05, smoothstep(0.45, 0.8, veil) * 0.7 * (1.0 - smoothstep(0.35, 0.5, uv.y)));
    col += dots(uv, 70.0, float2(0.0), 0.12, 0.04, 3.0) * 0.5 * smoothstep(0.4, 0.0, uv.y) * smoothstep(0.08, 0.2, md);

    float3 fogCol = mix(BG * 2.5, A * 0.3 + S * 0.1, 0.35);
    // Light of the wisps, summed once (they light every layer of fog).
    float3 wl = float3(0.0);
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float2 wp = wispPos(fi, t, asp);
        float3 wc = mix(A, S, step(0.5, hash11(fi * 9.1)));
        wl += wc * exp(-length(uv - wp) * 4.0) * 1.3;
    }

    // Far castle.
    float ct = castleTop(uv.x + t * 0.002);
    float castle = smoothstep(ct, ct + px, uv.y);
    col = mix(col, BG * 1.1 + A * 0.03, castle);
    // Lit windows in the castle, a few.
    float2 wcf = float2(uv.x / 0.013, uv.y / 0.02);
    float2 wcell = floor(wcf);
    float win = step(0.95, hash12(wcell)) * castle * step(ct + 0.02, uv.y) * step(uv.y, 0.52) * step(0.35, fract(wcf.x)) * step(0.3, fract(wcf.y));
    col += float3(1.0, 0.75, 0.4) * win * 0.35 * (0.6 + 0.4 * sin(t * 0.7 + wcell.x));
    // Fog bank 1.
    float f1 = fbm(float2(uv.x * 2.0 - t * 0.03, uv.y * 5.0 + 1.0));
    float band1 = exp(-sqf((uv.y - 0.56) * 8.0));
    col = mix(col, fogCol + wl * 0.3, sat(f1 * band1 * 0.9));

    // The broken arches, rimmed by the moon on their right edges.
    float ad = arches(float2(uv.x * 1.0 + 0.1 + t * 0.004, uv.y));
    float arch = smoothstep(px, -px, ad);
    float rimA = smoothstep(0.0, 0.01, -ad) * (1.0 - smoothstep(0.004, 0.012, -ad));
    float3 stone = BG * 0.7 + uSurf.rgb * 0.25;
    col = mix(col, stone + wl * 0.12, arch);
    col += float3(0.6, 0.6, 0.8) * rimA * arch * 0.12;
    // Fog bank 2, thicker, lower.
    float f2 = fbm(float2(uv.x * 1.6 + t * 0.045, uv.y * 4.0 + 7.0));
    float band2 = smoothstep(0.55, 0.75, uv.y) * (1.0 - smoothstep(0.8, 1.0, uv.y)) + 0.3 * smoothstep(0.75, 1.0, uv.y);
    col = mix(col, fogCol * 1.1 + wl * 0.45, sat(f2 * band2 * 0.95));

    // Ground: wet, a faint shimmer.
    float gy = 0.80 + 0.02 * vnoise(float2(uv.x * 3.0, 2.0));
    if (uv.y > gy) {
        float3 g = BG * 0.4;
        g += wl * 0.25 * (1.0 - (uv.y - gy) * 2.0);
        g += float3(0.6, 0.6, 0.8) * 0.04 * pow(sat(sin(uv.x * 80.0 + vnoise(uv * 30.0) * 5.0 + t)), 8.0);
        col = mix(col, g, smoothstep(gy, gy + px, uv.y));
    }

    // Gravestones and dead trees in front, black against the fog.
    float near = 1.0;
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float x = asp * (0.06 + fi * 0.15 + 0.05 * hash11(fi * 2.7));
        float h = 0.05 + 0.04 * hash11(fi * 5.3);
        float lean = (hash11(fi * 8.1) - 0.5) * 0.3;
        float2 q = uv - float2(x, gy + 0.01);
        q.x += q.y * lean;
        float stoneD = min(sdRoundBox(q + float2(0.0, h * 0.5), float2(0.022, h * 0.5), 0.004), length(q + float2(0.0, h)) - 0.022);
        stoneD = max(stoneD, q.y - 0.02);
        near = min(near, stoneD);
    }
    // Two crooked trees.
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float2 base = float2(asp * (0.12 + fi * 0.72), gy + 0.02);
        float sway = 0.01 * sin(t * 0.4 + fi * 2.0);
        float2 p0 = base;
        float2 p1 = base + float2(0.03 - fi * 0.06, -0.22);
        float2 p2 = p1 + float2(-0.08 + fi * 0.16 + sway, -0.10);
        float2 p3 = p1 + float2(0.07 - fi * 0.14 + sway, -0.13);
        float2 p4 = p2 + float2(-0.05 + fi * 0.1, -0.05);
        float2 p5 = p3 + float2(0.02, -0.08);
        float2 p6 = p1 + float2(0.0, -0.18 + sway);
        float td = sdSegment(uv, p0, p1) - 0.014;
        td = min(td, sdSegment(uv, p1, p2) - 0.007);
        td = min(td, sdSegment(uv, p1, p3) - 0.007);
        td = min(td, sdSegment(uv, p2, p4) - 0.0035);
        td = min(td, sdSegment(uv, p3, p5) - 0.0035);
        td = min(td, sdSegment(uv, p1, p6) - 0.005);
        near = min(near, td);
    }
    col = mix(col, BG * 0.25 + wl * 0.05, smoothstep(px, -px, near));

    // The wisps: bright cores, soft halos, fading tails behind them.
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float3 wc = mix(A, S, step(0.5, hash11(fi * 9.1)));
        float pulseW = 0.75 + 0.25 * sin(t * (1.5 + fi * 0.3) + fi);
        for (int k = 0; k < 6; k++) {
            float fk = float(k);
            float2 wp = wispPos(fi, t - fk * 0.16, asp);
            float d = length(uv - wp);
            float a = (1.0 - fk / 6.0);
            col += wc * (exp(-d * (110.0 + fk * 25.0)) * 1.1 + exp(-d * 22.0) * 0.10) * a * a * pulseW;
        }
        col += float3(1.0) * exp(-length(uv - wispPos(fi, t, asp)) * 220.0) * 0.9 * pulseW;
    }

    // Low mist drifting over everything.
    float m = fbm3(float2(uv.x * 3.0 - t * 0.06, uv.y * 10.0));
    col = mix(col, fogCol * 0.9 + wl * 0.3, sat(m * smoothstep(0.75, 1.0, uv.y)) * 0.55);
    return half4(finish(col, fc), 1.0);
}
