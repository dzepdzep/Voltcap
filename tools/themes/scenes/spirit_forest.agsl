// Spirit forest: an anime forest glade. Giant trunks in layers of mist, shafts of sunlight falling
// through the canopy, soft glowing spirit orbs drifting between the trees with faint trails,
// fireflies blinking, and tall grass swaying in the foreground. Mood only - no characters.

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Green-gold light filtering down.
    float3 col = mix(mix(float3(0.75, 0.9, 0.6), S, 0.3), mix(float3(0.06, 0.2, 0.12), BG * 1.5, 0.3), smoothstep(0.0, 0.9, uv.y));

    // Trunks: three layers, nearer ones darker and wider, mist between.
    for (int l = 0; l < 3; l++) {
        float fl = float(l);
        float sc = 3.0 - fl * 0.8;
        float x = uv.x * sc + fl * 1.7;
        float id = floor(x);
        float f = fract(x) - 0.5;
        float wdt = 0.08 + 0.06 * hash11(id + fl * 5.0) + fl * 0.03;
        float lean = 0.04 * (hash11(id * 2.0 + fl) - 0.5);
        float trunk = step(abs(f - lean * (1.0 - uv.y)), wdt) * step(0.35, hash11(id * 3.1 + fl * 9.0));
        // Roots flaring at the base.
        trunk += step(abs(f), wdt + 0.1 * smoothstep(0.75, 0.95, uv.y)) * step(0.35, hash11(id * 3.1 + fl * 9.0)) * step(0.75, uv.y);
        float3 bark = mix(float3(0.1, 0.08, 0.06), BG, 0.3) * (0.6 + 0.15 * fl);
        bark *= 0.85 + 0.15 * vnoise(float2(f * 40.0, uv.y * 8.0));
        // Lit edge on the sun side.
        bark += mix(S, float3(1.0, 0.95, 0.7), 0.5) * 0.15 * smoothstep(wdt * 0.4, wdt, -f);
        float mist = 0.55 - fl * 0.2;
        bark = mix(bark, col, mist * (1.0 - uv.y * 0.6));
        col = mix(col, bark, sat(trunk));
    }

    // Sun shafts through the canopy.
    float sx = uv.x - uv.y * 0.35;
    float shafts = pow(sat(sin(sx * 7.0 + 0.4 * sin(t * 0.1)) * 0.5 + 0.5), 12.0) + 0.6 * pow(sat(sin(sx * 13.0 + 1.3) * 0.5 + 0.5), 18.0);
    col += mix(float3(1.0, 0.95, 0.7), S, 0.2) * shafts * 0.22 * (1.0 - smoothstep(0.4, 1.0, uv.y));
    // Canopy shade at the top.
    col *= 0.6 + 0.4 * smoothstep(0.0, 0.25, uv.y + 0.08 * fbm3(float2(uv.x * 3.0, t * 0.05)));

    // Spirit orbs: soft glowing balls drifting slowly, each with a faint trail.
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float sp = 0.03 + 0.02 * hash11(fi * 1.3);
        float2 p = float2(fract(hash11(fi * 4.7) + t * sp) * (asp + 0.2) - 0.1,
                          0.3 + 0.45 * hash11(fi * 7.9) + 0.05 * sin(t * 0.5 + fi * 2.0));
        float2 d = uv - p;
        float glowR = 0.012 + 0.006 * sin(t * 1.3 + fi);
        float3 oc = mix(mix(A, float3(0.7, 1.0, 0.95), 0.6), float3(1.0), 0.3);
        col += oc * glow(length(d), glowR) * 0.35;
        // Trail behind (to the left, where it came from).
        float trail = exp(-abs(d.y - 0.01 * sin(d.x * 30.0 + t)) * 120.0) * step(d.x, 0.0) * exp(d.x * 12.0);
        col += oc * trail * 0.12;
    }

    // Fireflies.
    float2 fp = uv + float2(sin(t * 0.4 + uv.y * 4.0) * 0.02, cos(t * 0.3 + uv.x * 3.0) * 0.02);
    float blink = 0.5 + 0.5 * sin(t * 2.5 + hash12(floor(fp * 18.0)) * 40.0);
    col += mix(float3(1.0, 1.0, 0.6), A, 0.3) * dots(fp, 18.0, float2(0.0), 0.1, 0.06, 2.0) * blink * 0.8 * smoothstep(0.35, 0.8, uv.y);

    // Tall grass in front, swaying.
    float gx = uv.x * 90.0;
    float gid = floor(gx);
    float gh = 0.86 - 0.08 * hash11(gid);
    float sway = sin(t * 1.2 + gid * 0.2) * 0.012 * (1.0 - (uv.y - gh) / (1.0 - gh));
    float blade = step(abs(fract(gx + sway * 90.0) - 0.5), 0.22 * (1.0 - sat((gh + 0.14 - uv.y) / 0.14))) * step(gh, uv.y);
    col = mix(col, mix(float3(0.05, 0.16, 0.07), A * 0.25, 0.3) + shafts * 0.05, blade);
    col = mix(col, float3(0.03, 0.08, 0.04), smoothstep(0.93, 1.0, uv.y));

    return half4(finish(col, fc), 1.0);
}
