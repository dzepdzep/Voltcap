// Ink wash: ink dropped into water on rice paper. Blooms of ink unfurl slowly in soft tendrils,
// fade and are replaced by new drops; a brushed mountain range sits in the mist below, and a
// red seal-like sun rests in the corner.

float inkBloom(float2 p, float2 c, float age, float seed) {
    if (age < 0.0) return 0.0;
    // The drop sinks slowly as it spreads.
    float2 d = p - c - float2(0.0, age * 0.006);
    float grow = 0.05 + 0.28 * (1.0 - exp(-age * 0.3));
    // Billowing, folded clouds of ink: warped noise inside a ragged, growing edge.
    float2 w = d * 5.0 + 1.6 * float2(fbm3(d * 3.5 + seed + age * 0.04), fbm3(d * 3.5 + seed + 7.0 - age * 0.04));
    float cloud = fbm3(w + seed);
    float edge = length(d) + (cloud - 0.5) * grow * 0.9;
    float fall = 1.0 - smoothstep(grow * 0.35, grow, edge);
    float dens = fall * smoothstep(0.25, 0.75, cloud + 0.3 * fall);
    // A darker thread where folds of ink overlap.
    dens += fall * exp(-abs(cloud - 0.55) * 30.0) * 0.35;
    return sat(dens) * exp(-age * 0.08);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Paper: warm off-white tinted by the theme, with fibres.
    float fib = vnoise(uv * float2(220.0, 40.0)) * 0.5 + vnoise(uv * float2(40.0, 260.0)) * 0.5;
    float3 paper = mix(float3(0.93, 0.9, 0.84), S, 0.12) * (0.92 + 0.06 * fib);
    // Dark mode: the paper is dimmed so the home screen stays readable.
    paper = mix(paper, BG * 1.8, 0.62);
    float3 inkCol = mix(BG * 0.25, A * 0.4, 0.25);

    float3 col = paper;
    // Mountains brushed in layers, fading into the mist.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float base = 0.62 + fi * 0.1;
        float h = base - (0.16 - fi * 0.04) * fbm3(float2(uv.x * (1.5 + fi) + fi * 7.0, fi));
        float brush = 0.04 * vnoise(float2(uv.x * 30.0, uv.y * 4.0 + fi));
        float m = smoothstep(h + brush, h - 0.01 + brush, uv.y) * 0.0 + smoothstep(h - 0.005, h + 0.03, uv.y + brush * 0.5);
        float mist = smoothstep(h + 0.02, h + 0.16, uv.y);
        col = mix(col, inkCol, m * (1.0 - mist * 0.85) * (0.35 + fi * 0.2));
    }
    // Seal-red sun.
    float2 sc = float2(asp * 0.82, 0.26);
    float sd = length(uv - sc) - 0.07 * (1.0 + 0.03 * vnoise(float2(atan(uv.y - sc.y, uv.x - sc.x) * 6.0, 0.0)));
    col = mix(col, mix(A, float3(0.8, 0.15, 0.12), 0.5) * 0.9, (1.0 - smoothstep(-0.003, 0.003, sd)) * 0.85);

    // Ink drops blooming one after another.
    float ink = 0.0;
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float per = 13.0;
        float off = fi * per / 4.0;
        float cyc = floor((t + off) / per);
        float age = mod(t + off, per) * 1.6;
        float2 c = float2(asp * (0.12 + 0.76 * hash11(cyc * 3.1 + fi)), 0.15 + 0.4 * hash11(cyc * 1.7 + fi + 5.0));
        ink = max(ink, inkBloom(uv, c, age, cyc + fi * 3.0));
    }
    float3 tint = mix(BG * 0.15, A * 0.35, 0.3);
    col = mix(col, tint, sat(ink * 1.25));
    // A wet sheen at the edges of fresh ink.
    col += float3(1.0) * 0.03 * smoothstep(0.3, 0.6, ink) * (1.0 - smoothstep(0.6, 0.9, ink));

    return half4(finish(col, fc), 1.0);
}
