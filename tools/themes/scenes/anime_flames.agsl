// Blaze: anime fire. Big flame tongues drawn in flat, hard-edged colour bands with a dark outline
// (no soft gradients), a burst of light turning behind them, manga halftone dots in the shadows,
// diamond sparks with star glints and speed lines rushing upwards. Every few seconds the fire
// surges higher.
//#include anime

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float yb = 1.0 - uv.y;

    float surge = 0.5 + 0.5 * sin(t * 0.9);
    surge = surge * surge * surge;

    // Background: dark, warmer towards the fire, halftone dots growing towards the bottom.
    float3 col = mix(BG * 0.8, BG + A * 0.12, smoothstep(0.0, 1.0, uv.y));
    float ht = halftone(uv, 70.0, 0.12 + 0.5 * smoothstep(0.25, 1.0, uv.y));
    col = mix(col, BG + A * 0.22, ht * 0.35);

    // Light burst behind the fire: turning wedges from below the centre.
    float2 bc = float2(asp * 0.5, 1.2);
    float2 bd = uv - bc;
    float ba = atan(bd.x, -bd.y);
    float br = length(bd);
    float rays = step(0.5, fract(ba * 3.8197 + t * 0.04));
    col += mix(A, S, 0.5) * rays * exp(-br * 1.4) * (0.1 + 0.08 * surge);

    // Flame field: noise scrolled up and warped, cut off with height, then posterised.
    float warp = fbm3(float2(uv.x * 2.0, yb * 1.5 - t * 0.9));
    // Tongues lick upwards and sway; their sides lean in so the tips come to a point.
    float sx = uv.x + (warp - 0.5) * 0.12 * (0.3 + yb * 2.0);
    float2 fp = float2(sx * 4.0, yb * 2.6 - t * 1.7);
    float n = fbm(fp);
    float t1 = pow(abs(sin(sx * 6.0 + t * 0.7)), 5.0);
    float t2 = pow(abs(sin(sx * 11.0 - t * 1.1 + 1.3)), 7.0);
    float height = 0.13 + 0.3 * t1 + 0.16 * t2 + 0.05 * vnoise(float2(sx * 2.0 + t * 0.3, 1.0)) + 0.1 * surge;
    float f = n * 0.9 - yb / height + 0.62;
    float b1 = step(0.18, f);
    float b2 = step(0.36, f);
    float b3 = step(0.55, f);
    float b4 = step(0.74, f);
    float rim = step(0.13, f) - b1;
    float3 deep = A * float3(0.8, 0.28, 0.12);
    col = mix(col, BG * 0.3, rim * 0.9);
    col = mix(col, deep, b1);
    col = mix(col, A, b2);
    col = mix(col, mix(A, S, 0.6), b3);
    col = mix(col, mix(S, float3(1.0), 0.6), b4);
    // Halftone shading inside the darkest band.
    col = mix(col, deep * 0.6, (b1 - b2) * halftone(uv, 110.0, 0.45) * 0.5);
    // Glow over the fire.
    col += A * 0.12 * exp(-yb * 4.0);

    // Speed lines rushing up.
    float lx = floor(uv.x * 60.0);
    float hl = hash11(lx + 3.0);
    float ly = fract(uv.y * 0.6 + t * (1.0 + hl) + hl * 7.0);
    float thin = 1.0 - smoothstep(0.0, 0.25, abs(fract(uv.x * 60.0) - 0.5) * 2.0 - 0.55);
    float sl = step(0.82, hl) * smoothstep(0.0, 0.3, ly) * (1.0 - smoothstep(0.3, 0.42, ly)) * thin;
    col += mix(S, float3(1.0), 0.5) * sl * (0.2 + 0.2 * surge) * smoothstep(0.05, 0.7, uv.y);

    // Diamond sparks rising and swaying, with a four-point glint.
    for (int k = 0; k < 2; k++) {
        float fk = float(k);
        float scale = 9.0 + fk * 7.0;
        float2 p = (uv + float2(sin(uv.y * 6.0 + t * 0.9 + fk) * 0.02, 0.0)) * scale + float2(fk * 3.7, t * (1.3 + fk * 0.6));
        float2 id = floor(p);
        float2 g = fract(p) - 0.5;
        float2 rr = hash22(id + 11.0 * fk);
        if (rr.x < 0.32) {
            float2 q = g - (hash22(id + 5.3 + fk) - 0.5) * 0.5;
            float tw = 0.5 + 0.5 * sin(t * (3.0 + 4.0 * rr.y) + rr.x * 40.0);
            float dia = abs(q.x) + abs(q.y) * 0.65;
            float body = 1.0 - smoothstep(0.05, 0.065, dia);
            float glint = exp(-abs(q.x) * 70.0) * exp(-abs(q.y) * 7.0) + exp(-abs(q.y) * 70.0) * exp(-abs(q.x) * 7.0);
            float fade = smoothstep(0.0, 0.8, uv.y);
            col += (mix(S, float3(1.0), 0.5) * body + mix(A, float3(1.0), 0.6) * glint * tw * 0.6) * fade * (0.8 - 0.3 * fk);
        }
    }

    return half4(finish(col, fc), 1.0);
}
