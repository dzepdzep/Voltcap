// Tape deck: a cassette sits where the equalizer is set, its reels turning while the song plays and
// its label showing the cover. Two backlit VU meters either side swing with the lows and the highs,
// peak lights flash on the loud bits, and the warm glow of the deck breathes with the bass.
//#include reactive

float fillAA(float d, float px) { return 1.0 - smoothstep(-px, px, d); }

// One VU meter centred at the origin of p, s = its scale. lv 0..1.
float3 vuMeter(float3 col, float2 p, float s, float lv, float3 A, float3 S, float px) {
    float face = sdRoundBox(p, float2(0.15, 0.095) * s, 0.012 * s);
    float bezel = sdRoundBox(p, float2(0.162, 0.107) * s, 0.016 * s);
    col = mix(col, float3(0.06, 0.055, 0.05), fillAA(bezel, px));
    // Warm backlit face, brighter when it's loud.
    float3 paper = mix(float3(1.0, 0.86, 0.6), mix(S, float3(1.0), 0.6), 0.25) * (0.62 + 0.3 * lv);
    float vig = 1.0 - 0.5 * length(p / (float2(0.15, 0.095) * s));
    col = mix(col, paper * (0.75 + 0.35 * vig), fillAA(face, px));
    float inFace = fillAA(face, px);
    // Scale: an arc of ticks around the pivot below the face, red at the top end.
    float2 piv = float2(0.0, 0.085 * s);
    float2 q = p - piv;
    float r = length(q);
    float ang = atan(q.x, -q.y);                // 0 = straight up
    float R = 0.13 * s;
    float onArc = step(abs(ang), 0.82);
    float tick = step(fract(ang / 0.082 + 0.5), 0.16) * (1.0 - smoothstep(0.0, px * 1.5, abs(r - R) - 0.012 * s));
    float arc = 1.0 - smoothstep(0.0, px * 1.5, abs(r - R + 0.016 * s) - 0.0015 * s);
    float red = smoothstep(0.38, 0.42, ang);
    float3 ink = mix(float3(0.12, 0.09, 0.07), float3(0.85, 0.12, 0.08), red);
    col = mix(col, ink, max(tick, arc) * onArc * inFace);
    // The needle, with a little shadow.
    float na = mix(-0.78, 0.78, sat(lv));
    float2 tip = piv + float2(sin(na), -cos(na)) * R * 1.08;
    float nd = sdSegment(p, piv, tip) - 0.0016 * s;
    float sh = sdSegment(p - float2(0.004, 0.004) * s, piv, tip) - 0.003 * s;
    col = mix(col, col * 0.7, fillAA(sh, px * 2.0) * inFace * 0.6);
    col = mix(col, float3(0.08, 0.06, 0.05), fillAA(nd, px) * inFace);
    // Peak light in the corner.
    float led = length(p - float2(0.12, -0.07) * s) - 0.009 * s;
    float on = smoothstep(0.82, 0.9, lv);
    col = mix(col, mix(float3(0.25, 0.02, 0.02), float3(1.0, 0.25, 0.15), on), fillAA(led, px));
    col += float3(1.0, 0.2, 0.1) * glow(max(led, 0.0), 0.01 * s) * on * 0.6;
    // Glass sheen.
    col += float3(1.0) * 0.06 * inFace * smoothstep(0.02 * s, -0.06 * s, p.y + p.x * 0.4);
    return col;
}

// A reel turning by angle a: hub, six teeth, and the wound tape (radius tr).
float3 reel(float3 col, float2 p, float s, float a, float tr, float px) {
    float r = length(p);
    // Wound tape: dark brown with fine rings.
    float tape = fillAA(r - tr, px);
    float3 brown = float3(0.16, 0.09, 0.05) * (0.85 + 0.15 * sin(r * 900.0 / s));
    col = mix(col, brown, tape);
    // White hub with six teeth, turning.
    float2 q = rot(a) * p;
    float ang = atan(q.y, q.x);
    float teeth = 0.0108 * s + 0.0035 * s * step(0.5, fract(ang / TAU * 6.0 + 0.25));
    float hub = fillAA(r - 0.026 * s, px) - fillAA(r - teeth, px);
    col = mix(col, float3(0.92, 0.9, 0.86), sat(hub));
    // Three spokes' holes.
    float holes = 0.0;
    for (int i = 0; i < 3; i++) {
        float2 h = rot(float(i) * TAU / 3.0) * float2(0.0, 0.019 * s);
        holes = max(holes, fillAA(length(q - h) - 0.0045 * s, px));
    }
    col = mix(col, float3(0.1, 0.08, 0.07), holes * fillAA(r - 0.026 * s, px));
    return col;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float k = uIntensity;
    float play = uPlaying;
    float bass = uBass * play;
    float kick = exp(-uBeatAge * 5.0) * play;

    float3 col = coverField(uv, asp, t, bass, 0.55, BG, A, S);
    float2 c = float2(waveX(asp), uWaveY);
    float s = room(0.2) / 0.2;
    float2 p = uv - c;

    // Warm glow of the deck behind it, breathing with the bass.
    col += mix(A, float3(1.0, 0.7, 0.4), 0.4) * exp(-length(p * float2(0.55, 1.0)) * 4.0 / s) * (0.12 + 0.25 * bass * k);

    // ---- The cassette ----
    float2 cs = float2(0.27, 0.17) * s;
    float shadow = sdRoundBox(p - float2(0.008, 0.012) * s, cs, 0.02 * s);
    col *= 1.0 - 0.45 * fillAA(shadow, 0.02 * s);
    float body = sdRoundBox(p, cs, 0.02 * s);
    float3 shell = mix(float3(0.11, 0.105, 0.1), BG * 1.6 + 0.05, 0.4);
    shell *= 1.0 + 0.08 * smoothstep(cs.y, -cs.y, p.y);
    col = mix(col, shell, fillAA(body, px));
    // Screws in the corners.
    float2 sp = abs(p) - cs + 0.022 * s;
    col = mix(col, float3(0.45), fillAA(length(sp) - 0.006 * s, px) * fillAA(body, px));
    // The label: the album cover itself as a square on the left of the label (sharp), the rest of
    // the label printed in the cover's colours with the writing lines.
    float2 lc = float2(0.0, -0.055) * s;
    float2 lh = float2(0.235, 0.085) * s;
    float lbl = sdRoundBox(p - lc, lh, 0.01 * s);
    float2 lp = p - lc;
    float3 label = mix(mix(A, S, 0.5 + 0.5 * lp.x / lh.x) * 0.9, float3(0.95, 0.93, 0.88), 0.55);
    // Colour bands across the label (like a printed tape label).
    label = mix(label, mix(A, S, 0.3), step(abs(lp.y + lh.y * 0.55), lh.y * 0.12) * 0.85);
    // Writing lines on the right part.
    float lines = (1.0 - smoothstep(0.0, px, abs(fract((lp.y + lh.y) / (lh.y * 0.42)) - 0.5) * lh.y * 0.42 - 0.0011 * s)) * step(-lh.x * 0.2, lp.x) * step(abs(lp.y), lh.y * 0.75);
    label = mix(label, float3(0.25), lines * 0.22);
    // The song, written on the label in ink (title, artist under it), right of the cover.
    float wx0 = -lh.x + lh.y * 1.7 + 0.03 * s;
    float wx1 = lh.x - 0.012 * s;
    float2 wq = float2((lp.x - wx0) / (wx1 - wx0), (lp.y + lh.y * 0.82) / (lh.y * 1.64));
    float ink = labelInk(wq);
    label = mix(label, float3(0.09, 0.1, 0.27), ink * 0.92);
    // The cover square, inset at the left.
    float side = lh.y * 1.7;
    float2 cc = float2(-lh.x + side * 0.5 + 0.012 * s, 0.0);
    float2 cq = (lp - cc) / side + 0.5;
    float cov = sdRoundBox(lp - cc, float2(side * 0.5), 0.006 * s);
    float3 coverCol = sharpCover(cq, A, S);
    label = mix(label, coverCol, 1.0 - smoothstep(-px, px, cov));
    label = mix(label, float3(0.1), (1.0 - smoothstep(0.0, px * 1.5, abs(cov))) * 0.6);
    col = mix(col, label, fillAA(lbl, px));
    // The window with the reels.
    float2 wc = float2(0.0, 0.035) * s;
    float win = sdRoundBox(p - wc, float2(0.15, 0.04) * s, 0.035 * s);
    float3 glass = float3(0.05, 0.05, 0.06);
    col = mix(col, glass, fillAA(win, px));
    float inWin = fillAA(win + 0.004 * s, px);
    // Turning reels; the left one empties slowly, the right one fills.
    float wind = 0.5 + 0.5 * sin(t * 0.01);
    float spin = 3.2 * uPlayT;
    float3 reels = reel(glass, p - wc - float2(-0.095, 0.0) * s, s, spin, mix(0.032, 0.05, wind) * s, px);
    reels = reel(reels, p - wc - float2(0.095, 0.0) * s, s, spin * 1.15, mix(0.05, 0.032, wind) * s, px);
    col = mix(col, reels, inWin);
    // Tape running along the bottom between the guides.
    float run = 1.0 - smoothstep(0.0, px, abs(p.y - 0.13 * s) - 0.004 * s);
    col = mix(col, float3(0.14, 0.08, 0.05), run * step(abs(p.x), 0.2 * s) * fillAA(body, px));
    // Edge highlight.
    col += mix(A, float3(1.0), 0.6) * (1.0 - smoothstep(0.0, px * 2.0, abs(body))) * 0.25;

    // ---- VU meters either side (lows on the left, highs on the right) ----
    float lowL = (uEqA.x + uEqA.y + uEqA.z) / 3.0 * play;
    float highL = (uEqB.y + uEqB.z + uEqB.w) / 3.0 * play;
    float gx = 0.47 * s;
    float ms = s * min(1.0, (min(waveX(asp), asp - waveX(asp)) - 0.02) / (gx + 0.17 * s));
    col = vuMeter(col, p - float2(-gx, 0.0) * ms / s, ms, sat(0.08 + lowL * (0.6 + 0.5 * k) + kick * 0.15), A, S, px);
    col = vuMeter(col, p - float2(gx, 0.0) * ms / s, ms, sat(0.05 + highL * (0.7 + 0.5 * k)), A, S, px);

    // Dust in the light.
    col += mix(A, float3(1.0), 0.5) * dots(uv, 24.0, float2(t * 0.02, -t * 0.03), 0.06, 0.1, 3.0) * 0.25 * exp(-length(p) * 2.0);

    return half4(finish(col, fc), 1.0);
}
