// Disco floor: a light-up dance floor rolling away to the horizon, its tiles lighting in the cover's
// colours in a new pattern on every kick (brighter where the spectrum is high), a mirror ball turning
// overhead and throwing specks of light round the room, and coloured spotlights sweeping the haze.
//#include reactive

float3 tileColor(float h, float3 A, float3 S, float3 C) {
    return h < 0.33 ? A : (h < 0.66 ? S : C);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float3 C = float3(S.z, A.x, (A.y + S.y) * 0.5);
    float k = uIntensity;
    float play = uPlaying;
    float bass = uBass * play;
    float high = uHigh * play;
    float kick = exp(-uBeatAge * 4.0) * play;
    float lvl = bass * 0.5 + uMid * play * 0.3 + high * 0.2;
    // A beat counter that steps on every kick (simulated: 112 bpm), for the floor's patterns.
    float beatN = floor(t * 112.0 / 60.0);

    float hz = clamp(uWaveY + room(0.16) * 0.2, 0.3, 0.75);
    float3 col;
    if (uv.y < hz) {
        // The room: a deep haze tinted by the cover, brighter near the floor.
        float v = uv.y / hz;
        col = mix(BG * 1.2, mix(BG, mix(A, S, 0.5), 0.45), pow(v, 1.5));
        col = mix(col, coverField(uv, asp, t, bass, 0.9, BG, A, S), 0.35 * uHasArt);
        // Spotlights from the ceiling, sweeping.
        for (int i = 0; i < 4; i++) {
            float fi = float(i);
            float2 o = float2(asp * (0.15 + 0.23 * fi), -0.02);
            float a = 0.5 * sin(t * (0.35 + 0.1 * fi) + fi * 1.7);
            float2 dir = float2(sin(a), cos(a));
            float2 p = uv - o;
            float along = dot(p, dir);
            float across = abs(p.x * dir.y - p.y * dir.x);
            float cone = (1.0 - smoothstep(0.0, 0.05 + along * 0.22, across)) * step(0.0, along);
            col += tileColor(fract(fi * 0.37 + 0.1), A, S, C) * cone * (0.10 + 0.25 * lvl * k) * exp(-along * 0.8);
        }
        // Mirror ball.
        float2 mb = float2(asp * 0.5, 0.11);
        float mr = 0.085;
        float2 dm = uv - mb;
        float dl = length(dm);
        if (dl < mr) {
            float2 q = dm / mr;
            float z = sqrt(max(1.0 - dot(q, q), 0.0));
            float lon = atan(q.x, z) + t * 0.6;
            float lat = asin(clamp(q.y, -1.0, 1.0));
            float2 facet = float2(floor(lon * 6.0), floor(lat * 6.0));
            float fl = hash12(facet + floor(t * 3.0));
            float3 ball = float3(0.55) * (0.4 + 0.6 * z) + float3(1.0) * step(0.86, fl) * (0.5 + 0.5 * high);
            ball *= 0.75 + 0.25 * step(0.08, fract(lon * 6.0 / TAU * 6.0)) * step(0.08, fract(lat * 6.0 / PI * 6.0));
            col = ball;
        }
        col = mix(col, float3(0.6), (1.0 - smoothstep(0.0, 0.0025, abs(uv.x - mb.x))) * step(uv.y, mb.y - mr));
        // Specks of light thrown round the room, turning with the ball.
        float2 sp = float2(uv.x * 14.0 + t * 0.9, uv.y * 14.0);
        float2 sid = floor(sp);
        float2 sh = hash22(sid);
        float speck = step(sh.x, 0.25) * (1.0 - smoothstep(0.04, 0.12, length(fract(sp) - 0.5 - (sh - 0.5) * 0.5)));
        col += mix(float3(1.0), tileColor(sh.y, A, S, C), 0.5) * speck * (0.2 + 0.5 * high * k) * (0.4 + 0.6 * uv.y / hz);
    } else {
        // The floor: perspective tiles.
        float dy = uv.y - hz;
        float z = 0.35 / max(dy, 0.002);
        float fx = (uv.x - asp * 0.5) * z;
        float2 tp = float2(fx * 1.6, z * 1.6 + 0.4 * uPlayT);
        float2 tid = floor(tp);
        float2 tf = fract(tp);
        float h = hash12(tid + beatN * 7.13);
        float m = clamp(abs(fx) / (asp * 1.8) , 0.0, 1.0);
        float e = eqAt(m) * play;
        float on = step(h, 0.42 + 0.45 * e * k);
        float3 tc = tileColor(hash12(tid + 3.7 + beatN), A, S, C);
        float edge = smoothstep(0.0, 0.06, tf.x) * smoothstep(0.0, 0.06, tf.y) * smoothstep(0.0, 0.06, 1.0 - tf.x) * smoothstep(0.0, 0.06, 1.0 - tf.y);
        float fade = exp(-z * 0.12);
        float3 floorCol = mix(BG, mix(A, S, 0.5), 0.18) * 1.3 + tc * on * edge * (0.55 + 0.7 * kick * k + 0.3 * e);
        floorCol += tc * on * 0.12;
        // Reflections of the room's light in the glossy floor near the horizon.
        floorCol += mix(A, S, 0.5) * exp(-dy * 10.0) * 0.25;
        col = mix(mix(BG, A, 0.2), floorCol, fade * 0.85 + 0.15);
        col += float3(1.0) * exp(-dy * 120.0) * 0.25;
    }
    return half4(finish(col, fc), 1.0);
}
