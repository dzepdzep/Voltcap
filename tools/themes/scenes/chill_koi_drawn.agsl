// Koi pond: looking down into a quiet pond. Light ripples over the pebbles on the bottom, lily pads float
// in the top-left and bottom-right corners (one with a flower), and koi glide slowly round the edges,
// tails swaying, their shadows following on the bottom. Now and then a ring spreads where one surfaces.

// One koi at p: returns colour (rgb) and coverage (a). Head at h, heading dir d, body length L, pattern seed sd.
float4 koi(float2 p, float2 h, float2 d, float L, float sd, float t, float3 A) {
    float2 side = float2(-d.y, d.x);
    float2 rel = p - h;
    float x = -dot(rel, d) / L;            // 0 at the head, 1 at the tail root
    float y = dot(rel, side) / L;
    // The body bends in a wave running to the tail.
    float bend = 0.07 * sin(x * 5.0 - t * 3.0 + sd) * x;
    y -= bend;
    float w = 0.13 * pow(sat(x * 1.6), 0.5) * sat((1.1 - x) * 1.6) + 0.02 * step(0.0, x) * step(x, 1.0);
    float body = smoothstep(0.012, -0.012, abs(y) - w) * step(-0.02, x) * step(x, 1.02);
    // Tail fin: a soft fan past the body.
    float tx = x - 1.0;
    float tw = 0.02 + tx * 0.5;
    float tail = smoothstep(0.02, -0.01, abs(y - 0.06 * sin(t * 3.0 + sd)) - tw) * step(0.0, tx) * step(tx, 0.32) * (1.0 - smoothstep(0.24, 0.32, tx));
    // Pectoral fins.
    float2 fq = float2(x - 0.28, abs(y) - 0.13);
    float fin = smoothstep(0.05, 0.03, length(fq * float2(1.4, 1.0))) * (0.6 + 0.4 * sin(t * 2.0 + sd));
    // Pattern: white with orange patches (or the other way round), a few dark spots on some.
    float pat = vnoise(float2(x * 5.0, y * 9.0) + sd * 13.0);
    float3 white = float3(0.95, 0.93, 0.88);
    float3 orange = mix(A, float3(0.95, 0.35, 0.1), 0.35);
    float3 c = mix(white, orange, smoothstep(0.45, 0.55, pat + 0.25 * sin(sd * 7.0)));
    c = mix(c, float3(0.08, 0.08, 0.1), step(0.82, vnoise(float2(x * 9.0, y * 14.0) + sd * 5.0)) * step(0.5, fract(sd * 3.7)));
    // Rounded shading across the body and a sheen along the back.
    c *= 0.7 + 0.3 * sqrt(sat(1.0 - sqf(y / max(w, 1e-3))));
    c += float3(1.0) * exp(-sqf((y + w * 0.3) / (w * 0.25 + 1e-3))) * 0.12 * body;
    // Eyes.
    float eye = smoothstep(0.022, 0.012, length(float2(x - 0.08, abs(y) - 0.06)));
    c = mix(c, float3(0.05), eye);
    float3 finC = mix(c, float3(1.0), 0.3) * 0.9;
    float a = max(body, 0.0);
    float af = max(tail, fin) * 0.6 * (1.0 - body);
    return float4(c * a + finC * af, max(a, af));
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;      // koi orange
    float3 S = uSec.rgb;      // lotus / highlights
    float3 BG = uBg.rgb;

    // The pond bottom: pebbles and silt, darker towards the middle (deeper).
    float2 g = uv * 16.0 + float2(0.4 * vnoise(uv * 5.0), 0.4 * vnoise(uv * 5.0 + 3.0));
    float2 id = floor(g);
    float2 f = g - id - 0.5;
    float pr = 0.12 + 0.25 * hash12(id + 5.0);
    float peb = smoothstep(pr, pr - 0.1, length((f - (hash22(id) - 0.5) * 0.5) * float2(1.0, 1.0 + 0.6 * hash12(id + 9.0)))) * step(0.55, hash12(id + 2.0));
    peb *= 0.5 + 0.5 * hash12(id + 4.0);
    float depth = smoothstep(0.0, 0.6, 1.0 - length((uv - float2(asp * 0.5, 0.5)) / float2(asp * 0.55, 0.6)));
    float3 col = mix(BG * 2.4 + float3(0.02, 0.05, 0.04), BG * 1.3, depth);
    col *= 0.9 + 0.15 * fbm3(uv * 6.0);
    col += float3(0.05, 0.06, 0.05) * peb * (1.0 - depth * 0.6);
    // Caustics: bright wavy network of light on the bottom.
    float2 cp = uv * 9.0;
    float c1 = abs(sin(cp.x + sin(cp.y * 1.3 + t * 0.6) * 1.2 + t * 0.3));
    float c2 = abs(sin(cp.y * 1.1 + sin(cp.x * 0.9 - t * 0.5) * 1.3 - t * 0.25));
    float caus = pow(sat(1.0 - min(c1, c2)), 6.0);
    col += mix(float3(0.85, 1.0, 0.9), A, 0.1) * caus * 0.09 * (1.0 - depth * 0.5);

    // Koi, each circling near an edge; shadows first.
    float3 fishCol = float3(0.0);
    float fishA = 0.0;
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float2 ctr = i == 0 ? float2(0.2, 0.72) : i == 1 ? float2(0.8, 0.3) : i == 2 ? float2(0.86, 0.82) : float2(0.12, 0.2);
        float2 rad = i == 0 ? float2(0.14, 0.16) : i == 1 ? float2(0.16, 0.14) : i == 2 ? float2(0.1, 0.1) : float2(0.12, 0.1);
        float dir = i == 1 || i == 3 ? -1.0 : 1.0;
        float sp = 0.06 + 0.02 * hash11(fi * 3.1);
        float a = t * sp * dir + fi * 1.7;
        float2 c = float2(ctr.x * asp, ctr.y);
        float2 hp = c + float2(cos(a) * rad.x * asp * 0.75, sin(a) * rad.y);
        float2 hdg = normalize(float2(-sin(a) * rad.x * asp * 0.75, cos(a) * rad.y) * dir);
        float L = i == 2 ? 0.13 : 0.17;
        float4 shadow = koi(uv - float2(0.012, 0.02), hp, hdg, L, fi * 2.3, t, A);
        col *= 1.0 - 0.35 * shadow.a;
        float4 k = koi(uv, hp, hdg, L, fi * 2.3, t, A);
        fishCol = mix(fishCol, k.rgb / max(k.a, 1e-3), k.a);
        fishA = max(fishA, k.a);
    }
    // The water above the fish tints them a little.
    col = mix(col, fishCol * 0.85 + BG * 0.25, fishA);

    // Lily pads in the two corners, floating on top.
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float corner = step(3.5, fi);
        float k = fi - corner * 4.0;
        float2 base = corner < 0.5 ? float2(0.06, 0.08) : float2(asp - 0.07, 0.92);
        float2 off = float2(cos(k * 0.55 + 0.1), sin(k * 0.55 + 0.1)) * (0.13 * k);
        off.y *= corner < 0.5 ? 1.0 : -1.0;
        off.x = abs(off.x) * (corner < 0.5 ? 1.0 : -1.0);
        float2 pc = base + off + 0.004 * float2(sin(t * 0.3 + fi), cos(t * 0.25 + fi));
        float pr = 0.07 + 0.04 * hash11(fi * 5.3);
        float2 q = uv - pc;
        float d = length(q);
        float ang = atan(q.y, q.x) + 0.1 * sin(t * 0.2 + fi) + fi * 2.0;
        // The notch: a narrow slit to the centre.
        float notch = step(abs(fract(ang / 6.2831853) - 0.5), 0.04);
        float pad = smoothstep(pr, pr - 0.003, d) * (1.0 - notch);
        // Shadow on the water.
        col *= 1.0 - 0.3 * smoothstep(pr + 0.02, pr - 0.01, length(q - float2(0.012, 0.018)));
        float3 green = mix(float3(0.18, 0.42, 0.22), float3(0.32, 0.55, 0.28), hash11(fi * 1.3));
        float veins = smoothstep(0.92, 1.0, abs(sin(ang * 9.0))) * 0.25;
        float3 pc3 = green * (0.75 + 0.25 * smoothstep(pr, 0.0, d)) * (1.0 - veins);
        pc3 = mix(pc3 * 0.7, pc3, smoothstep(pr - 0.006, pr - 0.015, d));     // rim
        pc3 += float3(1.0) * exp(-length(q - float2(-0.3, -0.3) * pr) * 30.0 / pr * 0.05) * 0.05;
        col = mix(col, pc3, pad);
    }
    // A lotus flower on the corner pads.
    for (int i = 0; i < 2; i++) {
        float2 fc2 = i == 0 ? float2(0.075, 0.1) : float2(asp - 0.085, 0.9);
        float2 q = uv - fc2;
        float ang = atan(q.y, q.x) + t * 0.02;
        float d = length(q);
        float petals = 0.035 * (0.65 + 0.35 * abs(cos(ang * 4.0)));
        float petals2 = 0.024 * (0.65 + 0.35 * abs(cos(ang * 4.0 + 0.78)));
        float3 pk = mix(S, float3(1.0), 0.35);
        col = mix(col, pk * (0.75 + 0.25 * d / 0.035), smoothstep(petals, petals - 0.003, d));
        col = mix(col, mix(pk, float3(1.0), 0.4), smoothstep(petals2, petals2 - 0.003, d));
        col = mix(col, float3(1.0, 0.85, 0.35), smoothstep(0.008, 0.005, d));
    }

    // Rings spreading where a fish touched the surface.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float cyc = t * 0.12 + fi * 0.33;
        float ph = fract(cyc);
        float2 rp = float2((0.15 + 0.7 * hash11(floor(cyc) * 3.1 + fi)) * asp, 0.15 + 0.7 * hash11(floor(cyc) * 7.7 + fi));
        // Keep them near the edges.
        rp.y = rp.y < 0.5 ? rp.y * 0.5 : 0.75 + (rp.y - 0.5) * 0.5;
        float rr = ph * 0.18;
        float ring = exp(-abs(length(uv - rp) - rr) * 260.0) * (1.0 - ph);
        col += float3(0.8, 0.95, 0.9) * ring * 0.18;
    }
    // Sky reflected on the surface: a soft sheen drifting.
    col += mix(S, float3(1.0), 0.6) * smoothstep(0.55, 0.85, fbm3(uv * 1.5 + float2(t * 0.01, 0.0))) * 0.04;

    return half4(finish(col, fc), 1.0);
}
