// Summer sky: a deep anime-blue sky, big cel-shaded cumulus clouds drifting by (flat bottoms,
// bright tops, one hard shadow tone), a sun with a lens streak and ghosts, a contrail slowly
// drawing itself across, birds now and then, and power lines swaying gently in the foreground.

// Cloud density for one layer: puffy noise in a band standing on a flat base line (nothing
// below it), broken into separate clouds by a slow mask. Inside where it's above 0.5.
float cloudDens(float2 uv, float base, float seed, float t, float speed, float scale) {
    float x = uv.x * scale + t * speed + seed * 13.0;
    float lift = (base - uv.y) * scale;
    float n = fbm(float2(x * 2.2, uv.y * scale * 3.4 + seed * 5.0));
    float shape = n - 0.08 - abs(lift - 0.1) * 3.4;
    shape += (vnoise(float2(x * 0.9, seed * 3.0)) - 0.5) * 1.3;
    return shape - step(lift, 0.0) * 9.0;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Sky: deep at the top, pale near the horizon.
    float3 top = mix(BG, A, 0.5);
    float3 hor = mix(A, float3(1.0), 0.6);
    float3 col = mix(top, hor, pow(sat(uv.y / 0.95), 1.5));

    // Sun up on the right, its glow, a soft streak and lens ghosts towards the middle.
    float2 sc = float2(asp * 0.84, 0.14);
    float sd = length(uv - sc);
    col += mix(S, float3(1.0), 0.5) * exp(-sd * 4.5) * 0.4;
    col += float3(1.0) * exp(-abs(uv.y - sc.y) * 90.0) * exp(-abs(uv.x - sc.x) * 2.5) * 0.18;
    float2 toC = float2(asp * 0.5, 0.5) - sc;
    for (int k = 0; k < 3; k++) {
        float fk = float(k);
        float2 gp = sc + toC * (0.55 + fk * 0.45);
        float gr = 0.025 + fk * 0.02;
        float gd = length(uv - gp);
        col += mix(S, A, fk * 0.4) * (1.0 - smoothstep(gr * 0.85, gr, gd)) * 0.06;
    }
    col = mix(col, float3(1.0), 1.0 - smoothstep(0.042, 0.047, sd));

    // Contrail: a plane drawing a line across over 40 s, the line spreading and fading behind it.
    float cyc = fract(t / 40.0);
    float cx = (cyc * 1.4 - 0.2) * asp;
    float cyl = 0.24 + 0.06 * sin(uv.x * 0.8) - uv.x * 0.04;
    float behind = cx - uv.x;
    float spread = 0.0015 + max(behind, 0.0) * 0.004;
    float trail = step(0.0, behind) * exp(-max(behind, 0.0) * 1.2) * (1.0 - smoothstep(spread, spread * 2.5, abs(uv.y - cyl)));
    col = mix(col, float3(1.0), trail * 0.6);

    // Cloud layers, far to near: farther ones smaller, paler and slower.
    float3 shadeCol = mix(top, hor, 0.45) * 0.9 + mix(A, S, 0.3) * 0.08;
    for (int k = 0; k < 3; k++) {
        float fk = float(k);
        float base = 0.5 + fk * 0.17;
        float scale = 1.6 - fk * 0.45;
        float speed = 0.022 + fk * 0.016;
        float dens = cloudDens(uv, base, fk, t, speed, scale);
        float cover = step(0.5, dens);
        // Cel shadow: a band along the underside (the point a little lower is already outside).
        float below = cloudDens(uv + float2(-0.012, 0.035 / scale), base, fk, t, speed, scale);
        float lit = step(0.5, below);
        float far = 1.0 - fk * 0.35;
        float3 litC = mix(float3(1.0), hor, 0.25 * far);
        float3 sh = mix(shadeCol, hor, 0.4 * far);
        col = mix(col, mix(sh, litC, lit), cover);
    }

    // Birds: a small flock crossing every 25 s.
    float bc = fract(t / 25.0);
    for (int k = 0; k < 5; k++) {
        float fk = float(k);
        float2 bp = float2((bc * 1.5 - 0.25) * asp - fk * 0.035, 0.3 + fk * 0.018 + 0.01 * sin(t + fk));
        float2 q = uv - bp;
        float flap = sin(t * 9.0 + fk * 1.3) * 0.006;
        float wing = abs(q.y + abs(q.x) * 0.55 - flap * (1.0 - abs(q.x) / 0.012));
        float bird = (1.0 - smoothstep(0.0008, 0.0018, wing)) * step(abs(q.x), 0.012);
        col = mix(col, BG * 0.6, bird * 0.8);
    }

    // Power lines and a pole in the foreground, swaying a little.
    float sway = sin(t * 0.6) * 0.004;
    float3 dark = BG * 0.45;
    for (int k = 0; k < 3; k++) {
        float fk = float(k);
        float xx = uv.x / asp;
        float y = 0.8 + fk * 0.035 + 0.07 * (xx - 0.3) * (xx - 0.3) + sway * (1.0 + fk) * sin(xx * PI);
        col = mix(col, dark, 1.0 - smoothstep(0.0012, 0.0024, abs(uv.y - y)));
    }
    float px = asp * 0.92;
    col = mix(col, dark, step(abs(uv.x - px), 0.006) * step(0.74, uv.y));
    col = mix(col, dark, step(abs(uv.y - 0.785), 0.004) * step(abs(uv.x - px), 0.06));

    return half4(finish(col, fc), 1.0);
}
