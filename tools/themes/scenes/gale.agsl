// Gale (flying type): high above a sea of clouds. The sky deepens to blue-violet overhead and burns
// pale gold at the horizon; the cloud tops below roll towards you in three layers, lit on their sunny
// side; wind streaks race past, a flock in a loose V glides and flaps across, and loose feathers
// tumble by on the air.

float cloudTop(float x, float z, float t, float seed) {
    return fbm3(float2(x * 1.6 + seed, z * 0.9 + t * 0.06 + seed * 3.0));
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float horizon = 0.58;
    // Sky.
    float3 top = mix(float3(0.12, 0.2, 0.48), BG * 1.6 + A * 0.1, 0.35);
    float3 low = mix(float3(1.0, 0.86, 0.62), S, 0.2);
    float3 col = mix(top, low, smoothstep(0.0, horizon + 0.05, uv.y));
    float2 sunP = float2(asp * 0.62, horizon - 0.05);
    float sd = length((uv - sunP) * float2(1.0, 1.6));
    col += float3(1.0, 0.9, 0.7) * (exp(-sd * 30.0) * 0.8 + exp(-sd * 5.0) * 0.25);
    // High thin cirrus.
    float ci = fbm(float2(uv.x * 0.8 - t * 0.01, uv.y * 8.0));
    col = mix(col, float3(1.0, 0.95, 0.9), smoothstep(0.55, 0.8, ci) * smoothstep(0.35, 0.05, uv.y) * 0.35);

    // The cloud sea: three layers, far to near; each a rolling top lit from the sun's side.
    for (int L = 0; L < 3; L++) {
        float fl = float(L);
        float y0 = horizon + fl * 0.11;
        float amp = 0.03 + fl * 0.035;
        float x = uv.x / asp * (2.2 - fl * 0.5);
        float n = cloudTop(x, fl * 2.0, t * (1.0 + fl * 0.8), fl * 5.3);
        float topY = y0 - n * amp * 2.0 + 0.01;
        float m = smoothstep(topY - px * (2.0 + fl * 2.0), topY + px * 2.0, uv.y);
        float n2 = cloudTop(x + 0.02, fl * 2.0, t * (1.0 + fl * 0.8), fl * 5.3);
        float slope = (n2 - n) * 50.0;
        float depth = sat((uv.y - topY) / (0.12 + fl * 0.05));
        float3 lit = mix(float3(1.0, 0.95, 0.88), low, 0.3);
        float3 shade = mix(float3(0.55, 0.6, 0.78), top, 0.3);
        float3 cc = mix(lit, shade, sat(depth * 0.9 + slope * 0.3));
        cc = mix(cc, col, (2.0 - fl) * 0.18);                     // the far layers fade into the air
        cc += float3(1.0, 0.85, 0.6) * exp(-(uv.y - topY) * 80.0) * 0.25 * exp(-abs(uv.x - sunP.x) * 1.5);
        col = mix(col, cc, m);
    }

    // Wind streaks racing past.
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float y = 0.08 + 0.75 * hash11(fi * 3.7);
        float len = 0.15 + 0.2 * hash11(fi * 5.1);
        float x = fract(t * (0.35 + 0.25 * hash11(fi)) + hash11(fi * 9.0)) * (asp + len * 2.0) - len;
        float yy = y + 0.01 * sin(uv.x * 6.0 + fi);
        float s = exp(-abs(uv.y - yy) * 900.0) * smoothstep(x - len, x, uv.x) * step(uv.x, x);
        col += float3(1.0) * s * 0.35;
    }

    // A flock in a loose V, gliding and flapping.
    float fx = fract(t * 0.025) * (asp + 0.8) - 0.4;
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float rank = floor((fi + 1.0) * 0.5);
        float side = mod(fi, 2.0) * 2.0 - 1.0;
        float2 bp = float2(fx - rank * 0.045, 0.24 + side * rank * 0.025 + 0.004 * sin(t * 0.7 + fi));
        float2 q = uv - bp;
        float flap = sin(t * 5.0 + fi * 1.3);
        float span = 0.016;
        float wing = abs(q.y + abs(q.x) * (0.55 * flap) - sqf(q.x / span) * 0.004) - 0.0018;
        float bird = (1.0 - smoothstep(0.0, px, wing)) * step(abs(q.x), span);
        col = mix(col, mix(float3(0.12, 0.13, 0.2), top, 0.3), bird);
    }

    // Feathers tumbling by: a curved vane with a quill, turning as it falls.
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float life = fract(t * 0.05 + fi * 0.27);
        float2 p = float2(fract(hash11(fi * 2.0) + life * 0.7) * asp, -0.05 + life * 1.1);
        p.x += 0.04 * sin(life * 9.0 + fi);
        float2 q = rot(sin(t * 0.9 + fi * 2.0) * 1.2) * (uv - p);
        float vane = length(q * float2(1.0, 3.2)) - 0.018;
        float quill = abs(q.y + q.x * q.x * 6.0) - 0.0008;
        float3 fcol = mix(float3(0.98, 0.97, 0.95), S, 0.15);
        col = mix(col, fcol * (0.85 + 0.15 * step(0.0, q.y)), (1.0 - smoothstep(0.0, px, vane)) * 0.9);
        col = mix(col, fcol * 0.6, (1.0 - smoothstep(0.0, px, quill)) * step(abs(q.x), 0.022));
    }
    return half4(finish(col * 0.9, fc), 1.0);
}
