// Dune hour: dusk in the desert. A low sun sits behind the dunes in the bottom-right corner; their sharp
// crests split each dune into a glowing side and a shaded one, wind ripples run over the sand and fine
// sand blows off the crests. The first stars come out in the top corner (original design).

float duneH(float x, float base, float amp, float seed) {
    // Asymmetric swells: a soft windward rise and a steeper lee side (the crest is sharp).
    float u = x * 2.2 + seed + 0.5 * sin(x * 0.9 + seed);
    float crest = 1.0 - abs(sin(u));
    return base - amp * (crest * crest * 1.4 + 0.25 * sin(x * 5.3 + seed * 2.0) * crest);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;      // sun
    float3 S = uSec.rgb;      // rose
    float3 BG = uBg.rgb;
    float xr = uv.x / asp;

    float2 sun = float2(asp * 0.78, 0.62);
    // Sky: dusk gradient, warm at the horizon round the sun.
    float3 col = mix(BG * 1.2 + S * 0.12, mix(S, A, 0.45) * 0.85 + BG * 0.3, smoothstep(0.0, 0.8, uv.y));
    float sd = length((uv - sun) * float2(0.7, 1.0));
    col += A * exp(-sd * 3.0) * 0.35;
    col += mix(A, float3(1.0, 0.95, 0.8), 0.5) * exp(-sd * 14.0) * 0.4;
    col += float3(1.0, 0.95, 0.85) * smoothstep(0.045, 0.04, length(uv - sun)) * 0.8;
    // Long thin clouds lit from below.
    float cl = fbm(float2(uv.x * 0.9 + t * 0.004, uv.y * 9.0));
    float cb = smoothstep(0.55, 0.78, cl) * exp(-sqf((uv.y - 0.5) / 0.09)) * smoothstep(asp * 0.3, asp * 0.75, uv.x);
    col = mix(col, mix(S, A, 0.5) * 0.7 + BG * 0.2, cb * 0.6);
    // Stars in the top-left.
    col += float3(1.0, 0.95, 0.9) * dots(uv, 55.0, float2(0.0), 0.12, 0.06, 2.0) * 0.6 * smoothstep(0.45, 0.05, uv.y) * smoothstep(asp * 0.7, asp * 0.1, uv.x);

    // Dunes: far to near.
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        // Each layer rises towards the corners and stays low in the middle.
        float cornerRise = 0.16 * sqf(sat((xr - 0.45) * 1.9)) + 0.1 * sqf(sat((0.35 - xr) * 2.6)) * (fi > 1.5 ? 1.0 : 0.3);
        float base = 0.8 + 0.06 * fi - cornerRise * (1.0 - 0.15 * fi);
        float amp = 0.04 + 0.015 * fi;
        float h = duneH(uv.x, base, amp, fi * 3.3 + 1.0);
        if (uv.y > h) {
            float e = 0.002;
            float depth0 = uv.y - h;
            float xs = uv.x + depth0 * (0.9 + 0.6 * sin(uv.x * 3.0 + fi));
            float slope = (duneH(xs + e, base, amp, fi * 3.3 + 1.0) - duneH(xs - e, base, amp, fi * 3.3 + 1.0)) / (2.0 * e);
            // Sun from the right: slopes facing right (rising to the left) are lit.
            float litSide = smoothstep(-0.05, 0.25, slope);
            float depth = uv.y - h;
            float3 sand = mix(mix(S, A, 0.65) * 0.85, BG * 1.3 + S * 0.16, 1.0 - litSide);
            sand *= 0.85 + 0.15 * exp(-depth * 10.0);
            // Fade far layers into the haze.
            float haze = 0.6 * (1.0 - fi / 3.0);
            sand = mix(sand, mix(S, A, 0.4) * 0.6 + BG * 0.3, haze);
            // Wind ripples, following the dune.
            float rip = sin((uv.x * 0.4 + depth * 3.0 + slope * 0.05) * 260.0 + vnoise(uv * 20.0) * 4.0);
            sand += mix(A, float3(1.0), 0.3) * smoothstep(0.6, 1.0, rip) * 0.035 * litSide * (1.0 - haze);
            col = mix(col, sand, smoothstep(0.0, 0.0025, depth));
            // The crest line glows where the sun is behind it.
            float rim = exp(-depth * 300.0) * exp(-abs(uv.x - sun.x) * 2.0);
            col += mix(A, float3(1.0, 0.9, 0.7), 0.4) * rim * 0.5 * (1.0 - haze);
        }
    }
    // Sand blowing off the near crests.
    float blow = fbm(float2(uv.x * 8.0 - t * 0.6, uv.y * 30.0));
    float nearCrest = duneH(uv.x, 0.98 - (0.16 * sqf(sat((xr - 0.45) * 1.9)) + 0.1 * sqf(sat((0.35 - xr) * 2.6))) * 0.55, 0.085, 3.0 * 3.3 + 1.0);
    float above = nearCrest - uv.y;
    col += mix(A, S, 0.3) * smoothstep(0.55, 0.8, blow) * exp(-max(above, 0.0) * 40.0) * step(0.0, above) * 0.12;

    return half4(finish(col, fc), 1.0);
}
