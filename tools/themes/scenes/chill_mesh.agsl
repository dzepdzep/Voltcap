// Mesh glow: big soft blooms of colour drifting slowly in the corners, melting into each other, seen
// through a pane of reeded glass — fine vertical flutes that bend the colour and catch a thin highlight
// each. The middle stays a deep, quiet tone (original design).

float3 blooms(float2 p, float asp, float t, float3 A, float3 S, float3 BG) {
    // A gentle warp so the blooms melt into each other.
    float2 w = p + 0.12 * float2(fbm3(p * 1.4 + float2(t * 0.05, 0.0)) - 0.5, fbm3(p * 1.4 + float2(5.2, t * 0.04)) - 0.5);
    float3 c = BG * 0.85;
    float3 sum = float3(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        // Homes near the corners and edges, never the middle.
        float2 home = i == 0 ? float2(0.05, 0.95) : i == 1 ? float2(0.95, 0.05) : i == 2 ? float2(0.82, 1.0) : i == 3 ? float2(0.1, 0.12) : float2(0.55, 1.08);
        float2 ctr = float2(home.x * asp, home.y) + 0.09 * float2(sin(t * (0.05 + 0.01 * fi) + fi * 2.1), cos(t * (0.043 + 0.012 * fi) + fi * 1.3));
        float3 bc = i == 0 ? A : i == 1 ? S : i == 2 ? mix(A, S, 0.5) : i == 3 ? mix(S, float3(1.0), 0.15) : mix(A, float3(1.0), 0.2);
        float rad = i == 4 ? 0.45 : 0.6;
        float d = length(w - ctr) / rad;
        float k = exp(-d * d * 3.2) * (i == 3 ? 0.55 : 1.0);
        sum += bc * k;
        wsum += k;
    }
    float glowAmt = sat(wsum);
    c = mix(c, sum / max(wsum, 1e-3) * 0.95, sat(glowAmt * 1.2) * 0.95);
    return c;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Reeded glass: flutes about 1/45 of the screen height wide.
    float fw = 1.0 / 45.0;
    float fx = fract(uv.x / fw) - 0.5;           // -0.5..0.5 across one flute
    float bend = fx * fw * 1.6;                    // each flute bends the light sideways
    float2 sp = float2(uv.x - bend, uv.y);
    float3 col = blooms(sp, asp, t, A, S, BG);
    // A little chromatic split at the flute edges.
    float3 col2 = blooms(sp + float2(fx * fw * 0.5, 0.0), asp, t, A, S, BG);
    col = mix(col, float3(col.r, col2.g, col2.b), 0.5);
    // Shading across each flute: lighter towards one side, a thin highlight and a dark groove.
    float lum = dot(col, float3(0.3, 0.5, 0.2));
    col *= 0.9 + 0.18 * (0.5 - abs(fx)) * 2.0 - 0.06;
    col += float3(1.0) * exp(-abs(fx + 0.28) * 40.0) * (0.03 + 0.25 * lum);
    col *= 1.0 - 0.25 * exp(-(0.5 - abs(fx)) * 60.0);
    // Fine grain so it reads as a real surface.
    col += (hash12(fc * 0.5 + floor(t * 12.0)) - 0.5) * 0.012;

    return half4(finish(col, fc), 1.0);
}
