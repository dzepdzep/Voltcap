// Cobalt / Orbit: a ringed planet slowly turning at the edge of the screen, its rings catching
// the light, a small moon on its orbit and a deep starfield behind.
half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float3 col = BG * 0.8 + mix(A, S, uv.x / asp) * 0.04;
    // Faint galactic haze and stars.
    col += mix(S, A, 0.5) * 0.06 * smoothstep(0.35, 0.8, fbm3(uv * 2.0 + float2(t * 0.004, 0.0)));
    col += float3(0.9, 0.95, 1.0) * dots(uv, 40.0, float2(t * 0.06, 0.0), 0.35, 0.07, 1.0) * 0.55;
    col += float3(1.0) * dots(uv, 16.0, float2(t * 0.15, 0.0), 0.2, 0.06, 4.0) * 0.8;

    float2 c = float2(asp * 0.8, 0.98);
    float R = 0.5;
    float3 L = normalize(float3(-0.7, -0.55, 0.45));
    float2 rp = (uv - c);
    float d = length(rp);

    // Rings, in their tilted plane.
    float2 rr = rot(0.32) * rp;
    float ry = rr.y / 0.24;
    float rd = length(float2(rr.x, ry));
    float band = smoothstep(1.22 * R, 1.3 * R, rd) * (1.0 - smoothstep(1.85 * R, 1.95 * R, rd));
    float stria = 0.55 + 0.45 * vnoise(float2(rd * 70.0, 0.5));
    float gap = 1.0 - 0.75 * (smoothstep(1.52 * R, 1.55 * R, rd) * (1.0 - smoothstep(1.58 * R, 1.61 * R, rd)));
    float ringA = band * stria * gap;
    float3 ringCol = mix(S, A, 0.35) * (0.45 + 0.35 * sat(-rr.x / (2.0 * R) + 0.5));
    // Behind the planet: only the half above its middle line shows outside the disc.
    float behind = step(ry, 0.0);
    col = mix(col, ringCol, ringA * 0.75 * mix(1.0, step(R, d), behind));

    // The planet.
    if (d < R) {
        float2 n2 = rp / R;
        float z = sqrt(max(1.0 - dot(n2, n2), 0.0));
        float3 n = float3(n2, z);
        float lon = atan(n.x, n.z) + t * 0.025;
        float lat = n.y;
        float bands = fbm(float2(lon * 1.5, lat * 7.0 + fbm3(float2(lon * 3.0, lat * 12.0)) * 0.6));
        float3 surf = mix(uSurf.rgb * 1.4, mix(A, S, 0.4), bands);
        float diff = sat(dot(n, L));
        float3 pc = surf * (0.08 + 0.95 * diff);
        pc += mix(A, S, 0.5) * pow(1.0 - z, 3.0) * (0.25 + 0.6 * diff);
        // The ring's shadow across the planet.
        float sh = 1.0 - 0.5 * band * step(0.0, ry);
        col = pc * sh;
    }
    // Atmosphere glow around the limb, brighter on the lit side.
    float lit = sat(dot(normalize(float3(rp, 0.15)), L) + 0.4);
    col += mix(A, S, 0.5) * exp(-max(d - R, 0.0) * 28.0) * 0.45 * lit * step(R, d);
    // Rings in front of the planet.
    col = mix(col, ringCol * 1.1, ringA * 0.8 * (1.0 - behind));

    // A small moon.
    float ma = t * 0.06;
    float2 mpos = c + rot(-0.32) * float2(cos(ma) * 1.6 * R, sin(ma) * 0.3 * R);
    float mr = 0.035;
    float md = length(uv - mpos);
    float front = step(0.0, sin(ma));
    float hidden = (1.0 - front) * step(d, R);
    if (md < mr && hidden < 0.5) {
        float2 mn = (uv - mpos) / mr;
        float mz = sqrt(max(1.0 - dot(mn, mn), 0.0));
        float md2 = sat(dot(float3(mn, mz), L));
        col = mix(uSurf.rgb, S, 0.5) * (0.05 + md2) * (0.8 + 0.2 * vnoise(mn * 4.0));
    }

    return half4(finish(col, fc), 1.0);
}
