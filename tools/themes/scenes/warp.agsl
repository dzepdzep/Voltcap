// Warp drive: stars stretching into streaks as the ship jumps, a tunnel of light rings rushing past,
// a bright core ahead, and every few seconds a surge where everything flares and stretches further.
half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float2 c = float2(asp * 0.5 + 0.05 * sin(t * 0.21), 0.45 + 0.03 * sin(t * 0.17));
    float2 d = uv - c;
    float r = length(d);
    float a = atan(d.y, d.x);
    float surge = pow(0.5 + 0.5 * sin(t * 0.6), 6.0);
    float speed = 1.2 + 2.5 * surge;
    float3 col = BG * 0.8 + mix(A, S, 0.5) * exp(-r * 3.0) * 0.15;
    // Streaks: polar cells, long along the radius.
    for (int l = 0; l < 2; l++) {
        float fl = float(l);
        float N = 90.0 + 70.0 * fl;
        float sa = a / TAU * N;
        float id = floor(sa);
        float fa = fract(sa) - 0.5;
        float h = hash11(id * 1.37 + fl * 11.0);
        float lr = log(r + 0.001) * 1.5 - t * speed * (0.5 + 0.5 * h) - h * 10.0;
        float cell = fract(lr);
        float len = 0.15 + 0.5 * surge;
        float streak = step(h, 0.5) * (1.0 - smoothstep(0.0, 0.12, abs(fa))) * smoothstep(0.0, 0.05, cell) * (1.0 - smoothstep(len * 0.5, len, cell));
        float3 sc = mix(mix(A, S, h), float3(1.0), 0.5);
        col += sc * streak * smoothstep(0.02, 0.3, r) * (0.6 + 0.6 * surge);
    }
    // Rings rushing past.
    float rr = fract(log(r + 0.001) * 0.8 - t * speed * 0.3);
    col += A * exp(-abs(rr - 0.5) * 40.0) * 0.12 * smoothstep(0.05, 0.4, r);
    // The core.
    col += mix(float3(1.0), S, 0.3) * exp(-r * 18.0) * (0.6 + 0.8 * surge);
    col += float3(1.0) * surge * 0.08;
    return half4(finish(col, fc), 1.0);
}
