// Blue sky cruise: the sunny arcade racers of the late 90s - a deep, saturated blue sky with bright
// clouds and a sun flare, a glittering sea to the horizon, and a coast road rushing towards you with
// palm trees flicking past on both sides.
// A palm: a gently curving, ringed trunk and a crown of drooping fronds with leaflets. Returns the
// trunk distance in x, the frond distance in y, how far along the frond in z (for shading), and the
// trunk's ring pattern in w. p: 0 at the trunk's foot, y up.
float4 palm(float2 p, float h, float sway) {
    float u = clamp(p.y / max(h, 1e-3), 0.0, 1.0);
    float bend = (0.12 + sway) * h * u * u;              // the trunk curves out towards the top
    float tw = 0.022 * h * (1.25 - 0.5 * u);
    float trunk = max(abs(p.x - bend) - tw, max(-p.y, p.y - h));
    float rings = step(0.5, fract(p.y / (0.045 * h)));
    float2 top = float2((0.12 + sway) * h, h);
    float fr = 1e5;
    float al = 0.0;
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float a = -3.0 + fi * 0.98 + sway * 1.5;
        float2 dir = float2(cos(a), sin(a) * 0.5 + 0.25);
        float len = h * (0.5 + 0.12 * sin(fi * 2.3));
        float2 q = p - top;
        float along = clamp(dot(q, dir) / len, 0.0, 1.0);
        float2 pt = top + dir * along * len - float2(0.0, along * along * 0.35 * h);
        float dd = length(p - pt);
        // Leaflets: a serrated edge that tapers to the tip.
        float serr = 0.5 + 0.5 * sin(along * 46.0);
        float wdt = 0.06 * h * (1.0 - along) * (0.55 + 0.45 * serr) + 0.004 * h;
        float d = dd - wdt;
        if (d < fr) { fr = d; al = along; }
    }
    // A cluster of coconuts under the crown.
    fr = min(fr, length(p - top - float2(0.0, -0.035 * h)) - 0.03 * h);
    return float4(trunk, fr, al, rings);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float hz = 0.5;
    float3 col;
    if (uv.y < hz) {
        float k = uv.y / hz;
        col = mix(float3(0.02, 0.22, 0.75), float3(0.45, 0.80, 1.0), pow(k, 1.5));
        col = mix(col, S, 0.12);
        float cl = fbm(float2(uv.x * 1.6 + t * 0.03, uv.y * 3.5));
        col = mix(col, float3(1.0), smoothstep(0.55, 0.72, cl) * 0.95);
        // Sun and flare.
        float2 sp = float2(asp * 0.8, 0.12);
        float sd = length(uv - sp);
        col += float3(1.0, 0.95, 0.8) * (exp(-sd * 18.0) + 0.3 * exp(-sd * 3.0));
        for (int i = 1; i < 4; i++) {
            float fi = float(i);
            float2 fp = sp + (float2(asp * 0.5, 0.45) - sp) * (0.4 * fi);
            col += mix(A, S, fi / 3.0) * (1.0 - smoothstep(0.02, 0.035 + 0.01 * fi, length(uv - fp))) * 0.12;
        }
    } else {
        float dy = uv.y - hz;
        float z = 0.12 / dy;
        float x = (uv.x - asp * 0.5) * z;
        // Sea with glitter.
        float3 sea = mix(float3(0.0, 0.35, 0.75), float3(0.0, 0.18, 0.45), sat(dy * 3.0));
        float gl = hash12(floor(float2(x * 6.0, z * 3.0 + t * 1.5)));
        sea += float3(1.0) * step(0.93, gl) * exp(-dy * 6.0) * 0.7;
        col = sea;
        // Beach and road (a gentle curve).
        float curve = 0.6 * sin(t * 0.15) * dy * dy * 6.0;
        float rx = x - curve * z;
        float roadW = 0.55;
        float sand = step(abs(rx), roadW + 0.9);
        col = mix(col, float3(0.95, 0.85, 0.6), sand * smoothstep(0.0, 0.02, dy));
        float road = step(abs(rx), roadW);
        float stripe = step(0.5, fract(z * 0.6 + t * 1.8));
        float3 roadCol = mix(float3(0.38, 0.38, 0.42), float3(0.45, 0.45, 0.5), stripe);
        roadCol = mix(roadCol, float3(1.0), step(abs(rx), 0.025) * stripe);
        roadCol = mix(roadCol, mix(float3(1.0), float3(0.9, 0.15, 0.1), stripe), step(roadW - 0.06, abs(rx)));
        col = mix(col, roadCol, road);
        col = mix(col, float3(0.75, 0.9, 1.0), exp(-dy * 30.0) * 0.6);
    }
    // Palms on both sides, coming towards you: lit from the sun's side, with a shadow on the sand.
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float ph = fract(fi / 6.0 + t * 0.18);
        float z = 6.0 * (1.0 - ph) + 0.3;
        float side = fract(fi * 0.5) < 0.25 ? -1.0 : 1.0;
        float sx = asp * 0.5 + side * 1.9 / z;
        float sy = hz + 0.12 / z;
        float h = 0.9 / z;
        float2 p = float2(uv.x - sx, sy - uv.y);
        p.x *= side;
        float fade = smoothstep(0.0, 0.15, ph);
        // Shadow: a squashed dark blot on the ground beside the foot.
        float sh = length((p - float2(-0.25 * h * side, -0.01 * h)) * float2(1.0, 6.0)) - 0.25 * h;
        col *= 1.0 - 0.3 * (1.0 - smoothstep(-0.02 * h, 0.03 * h, sh)) * fade * step(sy - 0.02 * h, uv.y);
        float4 pm = palm(p, h, 0.03 * sin(t * 1.3 + fi * 2.0));
        float aa = max(1.2 / uRes.y, 0.002 * h);
        float lit = side * (p.x) > 0.0 ? 1.0 : 0.0;
        float3 bark = mix(float3(0.42, 0.3, 0.18), float3(0.62, 0.48, 0.3), pm.w) * (0.75 + 0.35 * step(0.0, p.x * side));
        float3 leaf = mix(float3(0.1, 0.42, 0.16), float3(0.35, 0.7, 0.25), sat(1.0 - pm.z * 1.2));
        leaf = mix(leaf, leaf * 0.6, smoothstep(0.0, 1.0, pm.z));
        leaf = mix(leaf, S * 0.4 + leaf * 0.7, 0.12);
        col = mix(col, bark, (1.0 - smoothstep(0.0, aa, pm.x)) * fade);
        col = mix(col, leaf, (1.0 - smoothstep(0.0, aa, pm.y)) * fade);
    }
    return half4(finish(col, fc), 1.0);
}
