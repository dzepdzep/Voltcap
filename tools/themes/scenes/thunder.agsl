// Thunder: an electric-type storm. Heavy clouds roll overhead and light up from inside, lightning
// strikes on the big beats, rain slants down, and the equalizer is a crackling electric arc across
// the screen whose jolts follow the spectrum.
//#include reactive
//#include anime

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float play = uPlaying;
    float k = uIntensity;
    float bass = uBass * play;
    float kick = exp(-uBeatAge * 6.0) * play;
    float rm = room(0.11);

    float3 col = coverField(uv, asp, t, bass, 0.4, BG, A, S) * 0.8;

    // Storm clouds along the top, lit from inside on the kick.
    float cl = fbm(float2(uv.x * 1.8 - t * 0.03, uv.y * 3.0 + t * 0.02));
    float cloud = smoothstep(0.35, 0.7, cl) * (1.0 - smoothstep(0.1, 0.5, uv.y));
    float flashX = asp * hash11(floor(t * 2.0) + 1.0);
    float inner = exp(-abs(uv.x - flashX) * 2.5) * kick * k;
    col = mix(col, mix(BG * 0.5, mix(A, S, 0.5) * 0.8, inner + 0.08), cloud * 0.9);

    // Lightning on the big beats: from the cloud down towards the arc.
    float strike = kick * step(0.55, uBass);
    if (strike > 0.02) {
        float ep = floor(t * 2.0);
        float2 a = float2(flashX, 0.12);
        float2 b = float2(flashX + (hash11(ep + 3.0) - 0.5) * 0.4, uWaveY);
        float bd = bolt(uv, a, b, ep, 0.08);
        float2 bm = mix(a, b, 0.55);
        float bd2 = bolt(uv, bm, bm + float2((hash11(ep + 7.0) - 0.5) * 0.3, 0.18), ep + 9.0, 0.05);
        float br = exp(-min(bd, bd2 * 1.4) * 600.0) + 0.3 * exp(-min(bd, bd2) * 50.0);
        col += mix(S, float3(1.0), 0.7) * br * strike * 1.5;
        col += mix(A, float3(1.0), 0.6) * strike * 0.08;
    }

    // Rain.
    float2 rp = float2(uv.x * 60.0 + uv.y * 12.0, uv.y * 4.0 - t * 6.0);
    float drop = step(0.92, hash12(floor(rp))) * (1.0 - smoothstep(0.0, 0.08, abs(fract(rp.x) - 0.5)));
    col += float3(0.7, 0.8, 1.0) * drop * 0.12;

    // The electric arc: a jagged line whose jolts follow the bands across the width.
    float x = uv.x / asp;
    float m = abs(x - 0.5) * 2.0;
    float e = eqAt(m) * play;
    float edge = smoothstep(1.0, 0.85, m);
    float jitter = floor(t * 14.0);
    float off = (jag(x * 40.0, jitter) * 0.7 + jag(x * 110.0, jitter + 5.0) * 0.3) * rm * 1.6 * (0.08 + e) * edge;
    float dy = abs(uv.y - uWaveY - off);
    float3 arcCol = mix(A, S, 0.5);
    col += mix(arcCol, float3(1.0), 0.6) * exp(-dy * 900.0) * (0.6 + 0.6 * e) * edge;
    col += arcCol * exp(-dy * 60.0) * (0.15 + 0.4 * e) * edge;
    // Sparks thrown off the arc.
    float sp = dots(uv + float2(0.0, t * 0.1), 50.0, float2(t * 3.0, 0.0), 0.08, 0.1, 3.0);
    col += mix(S, float3(1.0), 0.5) * sp * exp(-abs(uv.y - uWaveY) / (rm * 0.6)) * (0.3 + 0.8 * uHigh * play);

    return half4(finish(col, fc), 1.0);
}
