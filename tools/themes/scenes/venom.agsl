// Venom: a poison-type swamp at night. Glowing ooze hangs from the top and drips — each drip
// stretches, its neck thins, the drop snaps off, falls through the haze and splashes into the
// glowing pool. Behind it a dead forest stands in the toxic mist, lit from below by the pool;
// slanted light falls through the haze, motes drift, bubbles pop into rings, and the whole pool
// breathes with a slow sickly glow.

float smin(float a, float b, float k) {
    float h = sat(0.5 + 0.5 * (b - a) / k);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// Lower edge of the ooze hanging from the top, at x (in screen heights).
float oozeEdge(float x, float t) {
    return 0.07 + 0.022 * sin(x * 4.3 + t * 0.21) + 0.012 * sin(x * 11.7 - t * 0.17)
        + 0.045 * vnoise(float2(x * 6.0, 3.1)) + 0.02 * vnoise(float2(x * 17.0, 8.3));
}

// The pool's surface line.
float surfAt(float x, float t) { return 0.72 + 0.006 * sin(x * 14.0 + t * 1.3); }

// A gnarled dead tree: a twisting, tapering trunk with flared roots, four crooked boughs that each
// split into two twigs, and strands of moss hanging from them. q: x from the trunk, y up; th its
// height. Returns the wood distance in x and the moss distance in y.
float tapered(float2 p, float2 a, float2 b, float ra, float rb) {
    float2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - mix(ra, rb, h);
}
float2 deadTree(float2 q, float th, float id, float sc) {
    float h01 = clamp(q.y / th, 0.0, 1.0);
    float2 tq = q;
    tq.x -= 0.012 * th * sin(q.y / th * 5.0 + id) + 0.02 * th * sin(q.y / th * 2.0 + id * 1.7);
    float wood = abs(tq.x) - mix(0.009, 0.0015, sqrt(h01)) * sc;
    wood = max(wood, max(-q.y, q.y - th));
    // Roots flaring out at the foot.
    wood = min(wood, tapered(q, float2(0.0, 0.012), float2(-0.022, -0.004), 0.003 * sc, 0.0006));
    wood = min(wood, tapered(q, float2(0.0, 0.012), float2(0.02, -0.004), 0.003 * sc, 0.0006));
    float moss = 1e5;
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float side = mod(fi + floor(hash11(id) * 2.0), 2.0) * 2.0 - 1.0;
        float y0 = th * (0.38 + 0.17 * fi + 0.06 * hash11(id + fi));
        float2 b0 = float2(0.012 * th * sin(y0 / th * 5.0 + id) + 0.02 * th * sin(y0 / th * 2.0 + id * 1.7), y0);
        float len = th * (0.27 - 0.045 * fi) * (0.7 + 0.5 * hash11(id * 3.0 + fi));
        float2 b1 = b0 + float2(side * len * 0.85, len * (0.35 + 0.3 * hash11(id + fi * 7.0)));
        float2 elbow = mix(b0, b1, 0.5) + float2(0.0, -len * 0.12);
        float rw = mix(0.005, 0.0016, fi / 3.0) * sc;
        wood = min(wood, tapered(q, b0, elbow, rw, rw * 0.7));
        wood = min(wood, tapered(q, elbow, b1, rw * 0.7, 0.0005));
        // Two twigs from the bough's tip.
        float2 t1 = b1 + float2(side * len * 0.35, len * 0.35);
        float2 t2 = b1 + float2(side * len * 0.15, -len * 0.25);
        wood = min(wood, tapered(q, b1, t1, 0.0008, 0.0003));
        wood = min(wood, tapered(q, elbow, t2 + float2(0.0, len * 0.2), 0.0008, 0.0003));
        // Moss hanging from the elbow: a thin strand, swaying a little.
        float ml = len * (0.3 + 0.3 * hash11(id + fi * 11.0));
        float2 m0 = elbow + float2(side * len * 0.1, 0.0);
        float2 mq = q - m0;
        float mu = clamp(-mq.y / ml, 0.0, 1.0);
        moss = min(moss, length(float2(mq.x - 0.004 * sin(mu * 6.0 + id), mq.y + mu * ml)) - 0.0012 * (1.0 - mu) - 0.0003);
    }
    return float2(wood, moss);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.6 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float3 TOX = mix(S, A, 0.15);          // the glowing poison
    float3 HAZE = mix(BG, A, 0.3);

    float breathe = 0.5 + 0.5 * sin(t * 0.6);
    float surf = surfAt(uv.x, t);

    // ---- Sky: deep at the top, a sick haze rising off the pool ----
    float3 col = mix(BG * 0.3, HAZE * 0.9, smoothstep(0.02, surf, uv.y));
    float2 sp = rot(0.38) * (uv - float2(asp * 0.25, 0.0));
    float shafts = smoothstep(0.42, 0.85, fbm3(float2(sp.x * 5.0 + t * 0.03, 0.4 + t * 0.02)));
    col += mix(A, S, 0.35) * shafts * smoothstep(surf, 0.08, uv.y) * smoothstep(0.08, 0.25, uv.y) * 0.2;
    // A sick moon behind the haze, a focal point for the sky.
    float2 mc = float2(asp * 0.76, 0.27);
    float md = length(uv - mc);
    float3 MOON = mix(S, float3(1.0), 0.55);
    float veil = fbm3(float2(uv.x * 3.0 - t * 0.02, uv.y * 6.0));
    float moonDisk = (1.0 - smoothstep(0.068, 0.068 + px, md));
    float crater = smoothstep(0.5, 0.75, fbm3((uv - mc) * 26.0 + 4.0));
    col = mix(col, MOON * (0.75 - 0.25 * crater), moonDisk * (0.85 - 0.5 * smoothstep(0.45, 0.8, veil)));
    col += MOON * glow(max(md - 0.068, 0.0), 0.05) * 0.35;
    col += mix(S, A, 0.5) * exp(-md * 4.0) * 0.08;
    // Far haze clouds drifting.
    float far = fbm3(float2(uv.x * 1.6 - t * 0.012, uv.y * 3.0));
    col = mix(col, HAZE, smoothstep(0.45, 0.8, far) * smoothstep(0.15, 0.6, uv.y) * 0.35);

    // ---- Dead forest standing in the mist (two layers) ----
    for (int layer = 0; layer < 2; layer++) {
        float fl = float(layer);
        float scale = 6.0 + 4.0 * fl;                      // trees per screen height
        float base = surf - 0.015 + 0.012 * fl;           // the nearer layer stands a little lower
        float ridge = base - (0.03 + 0.05 * fl) * fbm3(float2(uv.x * 2.5 + fl * 7.0, fl));
        float cell = uv.x * scale + fl * 3.7;
        float id = floor(cell);
        float present = step(0.3, hash11(id * 1.37 + fl * 9.0));
        float th = (0.18 + 0.2 * hash11(id * 2.11 + fl)) * (1.0 - 0.3 * fl);
        float lean = (hash11(id * 5.3 + fl) - 0.5) * 0.06;
        // Local coordinates in screen heights: x from the cell's trunk, y up from the ridge.
        float2 q = float2((fract(cell) - 0.5 - (hash11(id + 4.0) - 0.5) * 0.4) / scale, ridge - uv.y);
        q.x -= lean * q.y;
        float2 dt = deadTree(q, th, id, 1.4 - 0.4 * fl);
        float sil = max(present * (1.0 - smoothstep(-px, px, dt.x)), step(ridge, uv.y));
        // Far trees fade into the haze; both are lit from below by the pool.
        float3 dark = mix(BG * 0.08, HAZE * 0.6, 0.6 - 0.55 * fl);
        dark += A * exp(-(surf - uv.y) * 14.0) * (0.12 + 0.1 * breathe);
        col = mix(col, dark, sil * step(uv.y, surf));
        // A toxic rim on the wood's underside edges, and faintly glowing moss.
        float rim = present * smoothstep(px * 2.5, 0.0, abs(dt.x + px)) * (1.0 - smoothstep(-px, px, dt.x - px * 2.0));
        col += TOX * rim * 0.18 * fl * exp(-(surf - uv.y) * 5.0) * (0.6 + 0.4 * breathe);
        float mossM = present * (1.0 - smoothstep(-px, px, dt.y)) * step(uv.y, surf);
        col = mix(col, mix(dark, TOX * 0.5, 0.35 + 0.25 * breathe), mossM * (0.5 + 0.5 * fl));
        // Mist band in front of each layer.
        float m = fbm(float2(uv.x * 2.2 - t * (0.03 + 0.03 * fl) + fl * 5.0, uv.y * 5.0 + t * 0.02));
        float band = exp(-abs(uv.y - (ridge + 0.02)) * (14.0 - 4.0 * fl));
        col = mix(col, mix(HAZE, A, 0.3) * 0.85, smoothstep(0.45, 0.85, m) * band * 0.45 * step(uv.y, surf + 0.02));
    }

    // Glow from the pool on everything above it.
    if (uv.y < surf) col += A * exp(-(surf - uv.y) * 7.0) * (0.1 + 0.1 * breathe);

    // ---- The pool ----
    if (uv.y >= surf) {
        float depth = (uv.y - surf) / (1.0 - surf);
        float3 pool = mix(A * (0.48 + 0.25 * breathe), BG * 0.55, depth * 0.8);
        // Upside-down reflection of the haze line and the glowing ooze colour.
        pool += TOX * 0.06 * (1.0 - depth);
        float caust = fbm3(float2(uv.x * 5.0 + t * 0.2, uv.y * 12.0 - t * 0.3));
        pool += S * smoothstep(0.55, 0.8, caust) * 0.16;
        // Slow sickly swirls.
        float swirl = fbm3(float2(uv.x * 2.0 - t * 0.05, uv.y * 4.0 + sin(uv.x * 3.0 + t * 0.2)));
        pool += mix(A, S, 0.5) * smoothstep(0.55, 0.75, swirl) * 0.08;
        col = pool;
        col += mix(A, float3(1.0), 0.4) * exp(-(uv.y - surf) * 160.0) * 0.45;
    }

    // ---- Ooze hanging from the top, and its drips (each pixel checks its own column and the next ones) ----
    float d = uv.y - oozeEdge(uv.x, t);   // < 0 inside the ooze
    float dropD = 1e5;
    float splash = 0.0;
    float cw = 0.105;
    float ci = floor(uv.x / cw);
    for (int k = -1; k <= 1; k++) {
        float id = ci + float(k);
        float h = hash11(id * 3.17 + 0.5);
        if (h > 0.2) {
            float cx = (id + 0.3 + 0.4 * hash11(id + 11.0)) * cw;
            float per = 4.5 + 5.0 * hash11(id + 5.0);
            float ph = fract(t / per + hash11(id + 2.0));
            float top = oozeEdge(cx, t);
            float L = 0.05 + 0.12 * hash11(id + 7.0);           // how far it stretches before snapping
            float rb = 0.009 + 0.007 * hash11(id + 13.0);      // the drop's size
            if (ph < 0.72) {
                float g = ph / 0.72;
                float grow = g * g * (3.0 - 2.0 * g);
                float2 tip = float2(cx + 0.002 * sin(t * 2.0 + id), top + L * grow);
                float neck = sdSegment(uv, float2(cx, top - 0.02), tip) - mix(0.011, 0.0028, grow);
                float bulb = length((uv - tip) * float2(1.0, 0.85)) - rb * (0.55 + 0.45 * grow);
                d = smin(d, smin(neck, bulb, 0.01), 0.022);
            } else {
                float f = (ph - 0.72) / 0.28;
                // The neck springs back up…
                float stub = sdSegment(uv, float2(cx, top - 0.02), float2(cx, top + L * 0.45 * (1.0 - smoothstep(0.0, 0.5, f)))) - 0.006;
                d = smin(d, stub, 0.02);
                // …while the drop falls (stretched a little by the speed) and splashes into the pool.
                float s0 = surfAt(cx, t);
                float y0 = top + L;
                float fall = sat(f / 0.8);
                float y = y0 + (s0 - y0) * fall * fall;
                if (fall < 1.0) {
                    // A teardrop: round below, pointed above, longer the faster it falls.
                    float2 dq = uv - float2(cx, y);
                    float up = sat(-dq.y / (rb * (1.6 + 2.0 * fall)));
                    dropD = min(dropD, length(dq * float2(1.0, mix(1.0, 0.45, up))) - rb * 0.8 * (1.0 - 0.65 * up));
                } else {
                    float sp2 = (f - 0.8) / 0.2;
                    float rd = abs(length((uv - float2(cx, s0)) * float2(1.0, 3.2)) - sp2 * 0.07);
                    splash += exp(-rd * 260.0) * (1.0 - sp2);
                    // A few flecks thrown up.
                    float2 fp = float2(cx + (sp2 * 0.03), s0 - sp2 * 0.05 * (1.0 - sp2) * 3.0);
                    float2 fq = float2(cx - (sp2 * 0.025), s0 - sp2 * 0.04 * (1.0 - sp2) * 3.0);
                    splash += (1.0 - smoothstep(0.0, 0.004, length(uv - fp))) * (1.0 - sp2);
                    splash += (1.0 - smoothstep(0.0, 0.0035, length(uv - fq))) * (1.0 - sp2);
                }
            }
        }
    }

    // Shading of the ooze: dark poison with a glowing skin, lit from the pool below, with a wet sheen.
    float inside = 1.0 - smoothstep(-px, px, d);
    float skin = exp(min(d, 0.0) * 70.0);
    float depthIn = sat(-d * 12.0);
    float3 goo = mix(TOX * 0.55, BG * 0.25 + TOX * 0.08, depthIn);
    goo += TOX * skin * (0.35 + 0.15 * breathe);
    // Sheen: a thin bright line just inside the lower edge.
    goo += mix(TOX, float3(1.0), 0.6) * exp(-abs(d + 0.0035) * 900.0) * 0.35;
    // Slow bubbles of light moving inside the ooze.
    float inner = fbm3(float2(uv.x * 9.0 + t * 0.15, uv.y * 14.0 - t * 0.1));
    goo += TOX * smoothstep(0.62, 0.8, inner) * 0.22 * depthIn;
    col = mix(col, goo, inside);
    // Soft halo round it.
    col += TOX * glow(max(d, 0.0), 0.006) * 0.16 * (0.75 + 0.25 * breathe);

    // Falling drops: bright, with a halo.
    float dropIn = 1.0 - smoothstep(-px, px, dropD);
    col = mix(col, mix(TOX, float3(1.0), 0.35), dropIn);
    col += TOX * glow(max(dropD, 0.0), 0.004) * 0.25;
    col += mix(TOX, float3(1.0), 0.4) * splash * 0.8;

    // ---- Bubbles: rise inside the pool, pop into a ring on the surface ----
    for (int k = 0; k < 7; k++) {
        float fk = float(k);
        float per = 3.0 + 2.0 * hash11(fk * 1.9);
        float ph = fract(t / per + hash11(fk + 7.0));
        float x = asp * (0.05 + 0.9 * hash11(fk * 5.1 + floor(t / per + hash11(fk + 7.0))));
        float s0 = surfAt(x, t);
        if (ph < 0.8) {
            float y = 1.0 - (ph / 0.8) * (1.0 - s0);
            float rr = 0.006 + 0.01 * hash11(fk + 3.0);
            float bd = abs(length(uv - float2(x + sin(t * 3.0 + fk) * 0.004, y)) - rr);
            col += mix(S, float3(1.0), 0.5) * (1.0 - smoothstep(0.0, 0.0025, bd)) * 0.55;
        } else {
            float pp = (ph - 0.8) / 0.2;
            float rd = abs(length((uv - float2(x, s0)) * float2(1.0, 3.5)) - pp * 0.06);
            col += mix(A, float3(1.0), 0.5) * exp(-rd * 300.0) * (1.0 - pp) * 0.8;
        }
    }

    // ---- Toxic mist rolling low over the surface ----
    float mist = fbm(float2(uv.x * 2.0 - t * 0.08, uv.y * 4.0 + t * 0.03));
    float low = exp(-abs(uv.y - (surf - 0.04)) * 9.0);
    col = mix(col, mix(A, S, 0.4) * 0.7, smoothstep(0.4, 0.75, mist) * low * (0.32 + 0.2 * breathe));

    // ---- Glowing motes drifting up through the haze ----
    float motes = dots(uv, 16.0, float2(t * 0.04, t * 0.12), 0.07, 0.16, 4.0);
    motes += 0.6 * dots(uv, 28.0, float2(-t * 0.03, t * 0.2), 0.08, 0.12, 9.0);
    col += TOX * motes * 0.7 * smoothstep(0.05, 0.25, uv.y);

    return half4(finish(col, fc), 1.0);
}
