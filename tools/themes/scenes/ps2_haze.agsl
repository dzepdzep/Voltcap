// 128-bit haze: towers of light rising and sinking out of a deep blue mist, row behind row, their
// tops glowing white; slow beams from above and particles drifting through - the mood of a
// late-90s / early-2000s console's start-up, in the theme's colours.
half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float3 col = mix(BG * 1.6, mix(BG, A, 0.35), pow(uv.y, 1.3));
    // Light from above.
    float beam = sin((uv.x - 0.3 * uv.y) * 7.0 + t * 0.1) * sin(uv.x * 3.0 - t * 0.07);
    col += mix(A, S, 0.5) * smoothstep(0.5, 1.0, beam) * 0.08 * (1.0 - uv.y);
    // Three rows of towers, far to near.
    for (int l = 0; l < 3; l++) {
        float fl = float(l);
        if (uLod > 1.5 && l == 0) continue;
        float depth = 1.0 - fl * 0.3; // 1 far .. 0.4 near
        float sc = 0.6 + fl * 0.5;
        float horizon = 0.62 + fl * 0.12;
        float x = (uv.x - asp * 0.5 + sin(t * 0.08) * 0.045 * sc) / sc + asp * 0.5 + t * 0.01 * (fl + 1.0);
        float cw = 0.11;
        float id = floor(x / cw);
        float fx = fract(x / cw);
        float h = hash11(id * 7.3 + fl * 31.0);
        float present = step(0.25, h);
        float th = (0.08 + 0.38 * h) * (0.75 + 0.25 * sin(t * (0.25 + 0.3 * h) + id * 2.0)) * sc;
        float top = horizon - th;
        float w = 0.28 + 0.2 * hash11(id + fl * 5.0);
        float inX = step(abs(fx - 0.5), w * 0.5);
        float body = inX * step(top, uv.y) * present;
        // A darker right face and sloping cap give each pillar real volume.
        float side = step(0.5 + w * 0.3, fx) * step(fx, 0.5 + w * 0.8) * step(top + 0.012 * sc, uv.y) * present;
        float cap = inX * (1.0 - smoothstep(0.0, 0.009 * sc, abs(uv.y - top + (fx - 0.5) * 0.02 * sc))) * present;
        float3 tower = mix(A * 0.5, mix(S, float3(1.0), 0.4), sat(1.0 - (uv.y - top) / max(th, 0.01)));
        tower *= 0.55 + 0.45 * smoothstep(0.0, w * 0.5, w * 0.5 - abs(fx - 0.5));
        float fog = depth * 0.65;
        col = mix(col, mix(tower, col, fog), body * (1.0 - smoothstep(horizon, horizon + 0.25, uv.y) * 0.5));
        col = mix(col, mix(tower * 0.32, col, fog), side * (1.0 - smoothstep(horizon, horizon + 0.2, uv.y)));
        col += mix(S, float3(1.0), 0.5) * cap * (1.0 - fog) * 0.55;
        // Glowing tops.
        float topGlow = exp(-abs(uv.y - top) * 140.0) * inX * present;
        col += mix(S, float3(1.0), 0.6) * topGlow * (0.5 - fog * 0.3);
        col += A * exp(-max(top - uv.y, 0.0) * 25.0) * step(uv.y, top) * inX * present * 0.12;
    }
    // Ground mist.
    col = mix(col, mix(BG * 2.2, A * 0.4, 0.3), smoothstep(0.55, 1.0, uv.y) * (0.5 + 0.2 * fbm3(uv * 3.0 + float2(t * 0.04, 0.0))));
    // Particles.
    col += mix(float3(1.0), S, 0.3) * dots(uv, 24.0, float2(t * 0.012, -t * 0.03), 0.18, 0.06, 2.0) * 0.6;
    col += mix(float3(1.0), A, 0.3) * dots(uv, 48.0, float2(-t * 0.02, -t * 0.05), 0.12, 0.08, 7.0) * 0.35;
    return half4(finish(col, fc), 1.0);
}
