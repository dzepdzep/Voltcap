// 64-bit plains: a slow flight over a low-polygon world, the way the first 3D consoles drew it -
// big flat-shaded triangles of hills in saturated greens with chunky, blurry checker "textures",
// grey rock up the slopes and snow on the peaks, a lake of flat blue water, thick bright fog that
// swallows the draw distance, a huge soft sun, puffy low-res clouds - and gold coins spinning in
// the air ahead.

// Height of the faceted terrain: a grid of random corner heights, split into triangles (each one
// flat, so the light shades it as one face).
float cornerH(float2 c) {
    float big = sin(c.x * 0.23) * cos(c.y * 0.19) * 1.1 + sin(c.x * 0.07 + c.y * 0.05) * 1.6;
    return big + hash12(c) * 0.55;
}
float terrain(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float h00 = cornerH(i);
    float h11 = cornerH(i + 1.0);
    if (f.x > f.y) {
        float h10 = cornerH(i + float2(1.0, 0.0));
        return h00 + (h10 - h00) * f.x + (h11 - h10) * f.y;
    }
    float h01 = cornerH(i + float2(0.0, 1.0));
    return h00 + (h01 - h00) * f.y + (h11 - h01) * f.x;
}

// A 5-point coin-star outline, for the spinning coins.
float coin(float2 p, float r) { return length(p) - r; }

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Camera: flying forward, gently banking.
    float2 sp = (fc - 0.5 * uRes) / uRes.y;
    sp.y = -sp.y;
    float z0 = t * 1.1;
    float3 ro = float3(sin(t * 0.07) * 3.0, 0.0, z0);
    ro.y = max(terrain(ro.xz * 0.5) * 1.2, 0.3) + 1.7;
    float bank = 0.06 * sin(t * 0.07 + 1.0);
    float2 rs = rot(bank) * sp;
    float3 rd = normalize(float3(rs.x, rs.y - 0.18, 1.0));

    float3 sunDir = normalize(float3(-0.5, 0.45, 0.8));
    float3 skyTop = float3(0.18, 0.42, 0.95);
    float3 skyLow = float3(0.72, 0.86, 1.0);
    float3 fogCol = float3(0.80, 0.89, 1.0);
    float3 sky = mix(skyLow, skyTop, sat(rd.y * 2.2 + 0.1));
    float sun = max(dot(rd, sunDir), 0.0);
    sky += float3(1.0, 0.95, 0.75) * (pow(sun, 64.0) * 0.9 + pow(sun, 6.0) * 0.18);
    // Clouds: low-res and blurry, like a stretched texture.
    if (rd.y > 0.06) {
        float2 cp = rd.xz / rd.y * 0.35 + float2(t * 0.02, 0.0);
        float2 cg = floor(cp * 6.0) / 6.0;
        float2 cf = fract(cp * 6.0);
        float cl = mix(mix(hash12(cg * 6.0), hash12(cg * 6.0 + float2(1.0, 0.0)), cf.x),
                       mix(hash12(cg * 6.0 + float2(0.0, 1.0)), hash12(cg * 6.0 + 1.0), cf.x), cf.y);
        sky = mix(sky, float3(1.0), smoothstep(0.62, 0.85, cl) * sat((rd.y - 0.06) * 8.0) * 0.85);
    }

    // March the heightfield.
    float tt = 0.0;
    float hit = 0.0;
    float3 p = ro;
    int steps = uLod > 0.5 ? 40 : 64;
    for (int i = 0; i < 64; i++) {
        if (i >= steps) break;
        p = ro + rd * tt;
        float h = max(terrain(p.xz * 0.5) * 1.2, 0.3);
        float dh = p.y - h;
        if (dh < 0.02) { hit = 1.0; break; }
        tt += max(0.04 + tt * 0.025, dh * 0.7);
        if (tt > 40.0) break;
    }
    // A ray that ran out of steps before leaving the world is ground lost in the fog, not sky:
    // without this, gaps of sky showed through the hills near the horizon.
    float far = 1.0 - hit;
    if (hit < 0.5 && tt <= 40.0) { hit = 1.0; }
    float3 col = sky;
    // Below the horizon the far terrain dissolves into fog (no sky colour under the land).
    col = mix(col, fogCol, smoothstep(0.02, -0.04, rd.y));
    if (hit > 0.5) {
        float h = terrain(p.xz * 0.5) * 1.2;
        float water = step(h, 0.3);
        // Flat normal of the triangle (finite differences stay on one face).
        float e = 0.01;
        float hx = terrain((p.xz + float2(e, 0.0)) * 0.5) * 1.2;
        float hz = terrain((p.xz + float2(0.0, e)) * 0.5) * 1.2;
        float3 n = normalize(float3(h - hx, e, h - hz));
        n = mix(n, float3(0.0, 1.0, 0.0), water);
        float dif = sat(dot(n, sunDir)) * 0.95 + 0.22;
        // Blurry checker texture on the grass (bilinear-looking).
        float2 tc = p.xz * 0.9;
        float chk = 0.5 + 0.5 * sin(tc.x * 3.14159) * sin(tc.y * 3.14159);
        float3 grass = mix(float3(0.13, 0.58, 0.18), float3(0.30, 0.78, 0.22), chk);
        grass = mix(grass, A * 0.6 + float3(0.05, 0.25, 0.05), 0.12);
        float3 rock = mix(float3(0.48, 0.45, 0.42), float3(0.62, 0.58, 0.52), chk);
        float3 snow = float3(0.95, 0.97, 1.0);
        float3 ground = mix(grass, rock, smoothstep(1.6, 2.1, h) + smoothstep(0.55, 0.35, n.y) * 0.8);
        ground = mix(ground, snow, smoothstep(2.4, 2.7, h));
        // Sandy shore by the water.
        ground = mix(ground, float3(0.9, 0.82, 0.55), smoothstep(0.42, 0.32, h) * (1.0 - water));
        float3 wat = mix(float3(0.10, 0.35, 0.85), float3(0.35, 0.65, 1.0), 0.5 + 0.5 * sin(p.x * 2.0 + t) * sin(p.z * 2.3 - t * 0.8));
        col = mix(ground * dif, wat + float3(1.0) * pow(sun, 24.0) * 0.4, water);
        // Thick bright fog.
        float fog = 1.0 - exp(-tt * 0.05);
        col = mix(col, fogCol, sat(fog * 1.05 + far));
    }

    // Gold coins spinning in the air ahead (screen-space, drifting towards the camera).
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float life = fract(t * 0.08 + fi * 0.25);
        float sc = 0.012 + 0.05 * life * life;
        float2 cp = float2(asp * 0.5 + (hash11(fi + floor(t * 0.08 + fi * 0.25) * 3.1) - 0.5) * asp * 0.9 * (0.3 + life),
                           0.35 - 0.1 * life + 0.03 * sin(t * 1.5 + fi));
        float2 q = uv - cp;
        float sx = cos(t * 2.4 + fi * 1.3);
        q.x /= max(abs(sx), 0.1);
        float d = coin(q, sc);
        float3 gold = mix(float3(0.95, 0.68, 0.1), float3(1.0, 0.95, 0.45), sat(0.5 - q.y / sc * 0.6)) * (0.85 + 0.15 * abs(sx));
        float alive = smoothstep(0.0, 0.1, life) * (1.0 - smoothstep(0.85, 1.0, life));
        col = mix(col, gold, (1.0 - smoothstep(0.0, 0.003, d)) * alive);
        col = mix(col, float3(0.55, 0.36, 0.02), (1.0 - smoothstep(0.0, 0.003, abs(d + sc * 0.35))) * 0.6 * alive);
    }
    col = mix(col, BG * 3.0, 0.04);
    return half4(finish(col, fc), 1.0);
}
