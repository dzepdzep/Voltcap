// Planet rise: a huge planet fills the lower-right corner, the sun just coming up behind its rim — a thin
// bright crescent, a soft atmosphere, cloud bands sliding slowly over the night side with a few city lights.
// A small moon up in the far corner, a satellite drifting over the rim. The middle stays open space.

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Deep space: a little lighter towards the planet, a faint dust veil up in the top-right.
    float3 col = BG * (0.75 + 0.35 * sat(uv.y));
    float2 nv = uv * float2(1.6, 2.2) + float2(t * 0.004, 0.0);
    float veil = fbm(nv) * smoothstep(asp * 0.35, asp, uv.x) * smoothstep(0.75, 0.0, uv.y);
    col += mix(S, A, 0.35) * sqf(veil) * 0.09;

    // Stars (fewer close to the planet's glow).
    float st = dots(uv, 62.0, float2(t * 0.0015, 0.0), 0.16, 0.06, 3.0) * 0.55
             + dots(uv, 31.0, float2(t * 0.003, 0.0), 0.07, 0.07, 9.0) * 0.8;

    float2 C = float2(asp * 0.80, 2.08);
    float R = 1.47;
    float2 dp = uv - C;
    float r = length(dp);
    float d = r - R;
    float2 n2 = dp / max(r, 1e-4);
    // The sun sits just behind the rim, up and to the left of the planet's top.
    float2 sunDir = normalize(float2(-0.36, -1.0));
    float2 sunPos = C + sunDir * (R - 0.012);
    float facing = sat(dot(n2, sunDir));
    float nearSun = exp(-(1.0 - facing) * 9.0);

    float3 air = mix(A, float3(0.85, 0.95, 1.0), 0.25);
    float3 warm = mix(S, float3(1.0, 0.92, 0.75), 0.35);
    if (d > 0.0) {
        // Atmosphere outside the rim: a thin bright skin and a wide soft glow, warm where the sun comes up.
        float skin = exp(-d * 90.0);
        float halo = exp(-d * 7.0);
        float3 ac = mix(air, warm, nearSun * 0.8);
        col += ac * (skin * (0.18 + 0.85 * nearSun) + halo * (0.05 + 0.20 * nearSun));
        col += float3(1.0) * st * sat(1.0 - halo * 1.6);
    } else {
        // The planet: a sphere seen from above its night side.
        float2 q = dp / R;
        float z = sqrt(max(1.0 - dot(q, q), 0.0));
        float3 n = float3(q, z);
        // Slow spin round the axis pointing at you: the cloud bands slide along the rim.
        float lon = atan(n.y, n.x) + t * 0.004;
        float2 tex = float2(lon * 7.0, acos(sat(z)) * 7.0);
        float land = fbm(tex * 2.2 + 3.1);
        float clouds = fbm(tex * float2(1.4, 3.2) + float2(t * 0.012, 0.0));
        clouds = smoothstep(0.48, 0.8, clouds);
        // Light from the sun behind the planet: only a crescent along the rim is lit.
        float3 L = normalize(float3(sunDir * 0.42, -0.9));
        float lit = sat(dot(n, L) * 2.2 + 0.05);
        float ocean = smoothstep(0.52, 0.47, land);
        float3 day = mix(mix(float3(0.16, 0.2, 0.14), float3(0.32, 0.27, 0.2), smoothstep(0.55, 0.75, land)), A * 0.5, ocean * 0.7);
        day = mix(day, float3(0.95), clouds * 0.85);
        float3 night = BG * 0.55 + A * 0.025;
        // City lights on land in the dark, in small clusters.
        float2 cid = floor(tex * 26.0);
        float city = step(0.8, hash12(cid)) * smoothstep(0.5, 0.56, land) * (1.0 - clouds);
        float2 cf = fract(tex * 26.0) - 0.5;
        city *= exp(-dot(cf, cf) * 22.0);
        night += warm * city * 0.7 * sat(1.0 - lit * 3.0) * (0.75 + 0.25 * sin(t * 0.7 + cid.x));
        night += float3(0.55, 0.6, 0.7) * clouds * 0.05;
        col = mix(night, day * (0.4 + 0.9 * lit), sat(lit * 1.3));
        // Rim light inside the edge and a little atmosphere over the disc.
        float rim = exp(d * 120.0);
        col += mix(air, warm, nearSun) * rim * (0.12 + 0.95 * nearSun);
        col += air * exp(d * 14.0) * 0.06;
    }

    // The sun's flare as it clears the rim: a bright point, a glow and a long thin streak along the horizon.
    float2 sp = uv - sunPos;
    float2 tng = float2(-sunDir.y, sunDir.x);
    float along = dot(sp, tng);
    float across = dot(sp, sunDir);
    float breathe = 0.88 + 0.12 * sin(t * 0.25);
    col += float3(1.0, 0.97, 0.9) * exp(-length(sp) * 70.0) * 0.9 * breathe;
    col += warm * exp(-length(sp) * 9.0) * 0.16 * breathe;
    col += mix(warm, float3(1.0), 0.5) * exp(-abs(across) * 260.0) * exp(-abs(along) * 4.5) * 0.22 * breathe;

    // A satellite gliding over the rim, its light blinking.
    float sa = fract(t * 0.012) * 1.6 - 0.8;
    float2 satPos = C + float2(sin(sa), -cos(sa)) * (R + 0.07);
    float blink = 0.35 + 0.65 * step(0.92, fract(t * 0.7));
    col += float3(1.0, 0.9, 0.8) * exp(-length(uv - satPos) * 900.0) * blink * 0.9;

    // A small moon far away, lit from the same sun.
    float2 mc = float2(asp * 0.11, 0.17);
    float mr = 0.032;
    float2 mp = uv - mc;
    float md = length(mp);
    if (md < mr) {
        float2 mq = mp / mr;
        float3 mn = float3(mq, sqrt(max(1.0 - dot(mq, mq), 0.0)));
        float ml = sat(dot(mn, normalize(float3(0.75, -0.35, 0.55))));
        float crater = fbm(mq * 3.0 + 7.0);
        col = mix(col, float3(0.8, 0.82, 0.86) * (0.35 + 0.65 * crater) * ml + BG * 0.6, smoothstep(mr, mr - 0.0025, md));
    }
    col += air * exp(-max(md - mr, 0.0) * 60.0) * 0.06;

    return half4(finish(col, fc), 1.0);
}
