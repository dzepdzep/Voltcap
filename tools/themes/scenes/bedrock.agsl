// Bedrock (rock type): a deep canyon at golden hour. Layered sandstone walls close in from both sides,
// every stratum its own colour and grain, carved into ledges; a natural arch and a far mesa stand in
// the haze down the canyon; dust hangs in the low sun, and now and then a pebble breaks loose and
// bounces down a wall, leaving a little puff behind it.

// A canyon wall's edge (distance from the screen side, in screen heights) at height y: ledges where
// harder layers stick out.
float wallEdge(float y, float seed) {
    float layer = floor(y * 14.0 + seed);
    float hard = hash11(layer + seed * 7.0);
    float base = 0.32 + 0.12 * sin(y * 2.3 + seed) + 0.06 * sin(y * 6.1 + seed * 2.0);
    return base + 0.035 * hard + 0.012 * vnoise(float2(y * 60.0, seed));
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float cx = asp * 0.5;

    // Sky strip above the canyon and the warm haze down it.
    float3 sky = mix(mix(float3(0.35, 0.5, 0.75), BG * 2.0, 0.3), mix(float3(1.0, 0.78, 0.5), S, 0.2), smoothstep(0.0, 0.6, uv.y));
    float3 col = sky;
    float2 sunP = float2(cx + 0.15, 0.3);
    col += float3(1.0, 0.85, 0.6) * exp(-length(uv - sunP) * 6.0) * 0.35;
    // The far mesa and the arch, flat and hazy.
    float mesa = step(0.48 - 0.05 * step(abs(uv.x - cx - 0.25), 0.18) - 0.012 * vnoise(float2(uv.x * 30.0, 1.0)), uv.y);
    float3 far = mix(mix(float3(0.75, 0.45, 0.3), A, 0.15), sky, 0.55);
    col = mix(col, far, mesa);
    float2 aq = uv - float2(cx - 0.12, 0.6);
    float archOuter = sdRoundBox(aq + float2(0.0, 0.07), float2(0.1, 0.09), 0.08);
    float archInner = sdRoundBox(aq + float2(0.0, 0.02), float2(0.065, 0.08), 0.06);
    float arch = max(archOuter, -archInner);
    col = mix(col, mix(far * 0.85, sky, 0.25), (1.0 - smoothstep(-px, px, arch)) * step(uv.y, 0.62));
    // Canyon floor: a dry wash with stones.
    float3 ground = mix(float3(0.55, 0.36, 0.22), A * 0.4, 0.1) * (0.8 + 0.2 * vnoise(uv * float2(40.0, 120.0)));
    col = mix(col, mix(ground, sky, 0.3 * smoothstep(0.8, 0.6, uv.y)), smoothstep(0.6, 0.62, uv.y));

    // The two walls: strata in bands, lit on the left wall's face by the low sun, the right in shade.
    for (int s = 0; s < 2; s++) {
        float side = s == 0 ? -1.0 : 1.0;
        float seed = s == 0 ? 1.3 : 4.7;
        float xd = side < 0.0 ? uv.x : asp - uv.x;         // distance from this side
        float e = wallEdge(uv.y, seed) * (0.9 + 0.25 * smoothstep(0.7, 0.2, uv.y)) * asp / 1.78;
        float m = 1.0 - smoothstep(e - px, e + px, xd);
        float layer = floor(uv.y * 14.0 + seed);
        float3 strata = mix(float3(0.72, 0.38, 0.22), float3(0.88, 0.66, 0.42), hash11(layer * 3.1));
        strata = mix(strata, float3(0.55, 0.3, 0.22), step(0.8, hash11(layer * 1.7)) * 0.6);
        strata = mix(strata, strata * A * 1.6, 0.08);
        // Grain inside each band, and darker cracks between them.
        strata *= 0.85 + 0.2 * vnoise(float2(uv.x * 30.0 * side, uv.y * 140.0 + layer));
        strata *= 1.0 - 0.3 * exp(-abs(fract(uv.y * 14.0 + seed) - 0.0) * 30.0);
        // Light: the face near the edge catches the sun (left wall), the rest falls into shade.
        float edgeLight = exp(-(e - xd) * 25.0);
        float lit = side < 0.0 ? 0.75 + 0.45 * edgeLight : 0.45 + 0.2 * edgeLight;
        strata *= lit;
        // Ledges: the top of each hard layer catches a line of light.
        strata += float3(1.0, 0.85, 0.6) * 0.12 * exp(-fract(uv.y * 14.0 + seed) * 40.0) * edgeLight;
        strata = mix(strata, sky, 0.12);
        col = mix(col, strata, m);
    }

    // Dust hanging in the light.
    col += float3(1.0, 0.85, 0.6) * dots(uv + float2(t * 0.003, t * 0.001), 110.0, float2(0.0), 0.08, 0.05, 6.0) * 0.4;
    float haze = fbm3(float2(uv.x * 2.0 + t * 0.02, uv.y * 4.0));
    col = mix(col, mix(float3(1.0, 0.82, 0.6), S, 0.2), smoothstep(0.45, 0.8, haze) * 0.12 * smoothstep(0.2, 0.7, uv.y));

    // A pebble bouncing down a wall every few seconds, with a puff at each bounce.
    float cyc = mod(t, 6.0);
    float ps = floor(t / 6.0);
    float side = hash11(ps) > 0.5 ? 1.0 : -1.0;
    float py = 0.12 + cyc * 0.14;
    float ex = wallEdge(py, side < 0.0 ? 1.3 : 4.7) * (0.9 + 0.25 * smoothstep(0.7, 0.2, py)) * asp / 1.78;
    float bounce = abs(sin(cyc * 4.0)) * 0.025;
    float2 pp = float2(side < 0.0 ? ex + bounce : asp - ex - bounce, py);
    float alive = step(cyc, 3.5);
    col = mix(col, float3(0.4, 0.26, 0.18), (1.0 - smoothstep(0.0, px, length(uv - pp) - 0.006)) * alive);
    float lastHit = fract(cyc * 4.0 / PI);
    float2 puffP = float2(side < 0.0 ? ex : asp - ex, 0.12 + (cyc - lastHit * PI / 4.0) * 0.14);
    float puff = exp(-length(uv - puffP) / (0.01 + lastHit * 0.03)) * (1.0 - lastHit) * alive;
    col = mix(col, float3(0.85, 0.7, 0.55), puff * 0.5);
    return half4(finish(col * 0.92, fc), 1.0);
}
