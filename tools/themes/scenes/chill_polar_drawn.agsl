// Polar veil: northern lights hang from the top-left corner in slow folded curtains — green at their hem,
// violet higher up, fine rays shimmering through them — over a starry sky. A snowy ridge with a few pines
// fills the bottom-right corner, its snow catching the aurora's light. The middle stays quiet sky.

// The far mountains' skyline (y, down) at x: two snowy peaks in the right corner, falling away to the left.
float ridgeH(float x, float asp) {
    float xr = x / asp;
    float h = 0.9 - 0.30 * exp(-sqf((xr - 0.84) / 0.11)) - 0.2 * exp(-sqf((xr - 0.67) / 0.08));
    h -= 0.05 * (1.0 - abs(2.0 * vnoise(float2(x * 9.0, 1.3)) - 1.0));
    h -= 0.012 * vnoise(float2(x * 40.0, 4.1));
    return h + 0.5 * sqf(sat((0.6 - xr) / 0.6));
}
// The same skyline without its fine detail: what the light follows.
float ridgeSmooth(float x, float asp) {
    float xr = x / asp;
    float h = 0.9 - 0.30 * exp(-sqf((xr - 0.84) / 0.11)) - 0.2 * exp(-sqf((xr - 0.67) / 0.08));
    h -= 0.05 * (1.0 - abs(2.0 * vnoise(float2(x * 9.0, 1.3)) - 1.0));
    return h + 0.5 * sqf(sat((0.6 - xr) / 0.6));
}
float hillH(float x, float asp) {
    float xr = x / asp;
    return 0.9 + 0.035 * sin(x * 3.0 + 1.0) + 0.012 * vnoise(float2(x * 14.0, 2.0)) + 0.6 * sqf(sat((0.62 - xr) / 0.5));
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime * 0.12;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float3 col = mix(BG * 1.6 + A * 0.015, BG * 0.8, sat(uv.y * 1.2));
    // Stars, hidden behind bright aurora.
    float st = dots(uv, 70.0, float2(0.0), 0.18, 0.06, 2.0) * 0.5 + dots(uv, 33.0, float2(0.0), 0.06, 0.07, 5.0);

    // Aurora: three draped curtains hanging from the top-left corner, nearest brightest.
    float glowSum = 0.0;
    float xx = uv.x / asp;
    for (int k = 0; k < 3; k++) {
        float fk = float(k);
        float c0 = 0.2 + 0.11 * fk;
        float bump = sat(1.0 - sqf((xx - c0) / (0.46 - 0.07 * fk)));
        float hem = -0.06 + (0.5 - 0.1 * fk) * bump
                  + 0.06 * sin(uv.x * 4.1 + t * 0.8 + fk * 2.0) + 0.02 * sin(uv.x * 7.3 - t * 1.1 + fk)
                  + 0.11 * (fbm3(float2(uv.x * 1.9 + t * 0.15, fk * 4.0)) - 0.5);
        float above = hem - uv.y;
        float body = above > 0.0 ? exp(-above * (3.2 + fk)) : exp(above * 70.0);
        // Rays along the curtain, drifting sideways and shimmering.
        float xr = uv.x * (1.0 + 0.15 * fk) + 0.05 * sin(uv.y * 6.0 + t);
        float ray = vnoise(float2(xr * 30.0 + t * 1.4 + fk * 13.0, uv.y * 1.2 - t * 0.25));
        ray = 0.25 + 0.75 * sqf(ray) + 0.35 * sqf(vnoise(float2(xr * 85.0 - t * 2.2, fk)));
        // Folds: bright where the curtain turns towards you.
        float fold = 0.35 + 0.65 * sqf(sat(0.5 + 0.5 * sin(xr * 7.0 + 2.5 * vnoise(float2(xr * 2.0, t * 0.4 + fk)) + t * 0.9)));
        float a = body * ray * fold * smoothstep(0.0, 0.25, bump) * (1.0 - 0.28 * fk);
        float3 ac = mix(A, S, smoothstep(0.08, 0.38, above));
        ac = mix(ac, mix(A, float3(1.0), 0.6), exp(-abs(above) * 40.0) * 0.6);
        col += ac * a * 0.95;
        glowSum += a;
        col += A * exp(-max(-above, 0.0) * 5.0) * smoothstep(0.0, 0.25, bump) * 0.02;
    }
    col += float3(0.9, 0.95, 1.0) * st * sat(1.0 - glowSum * 2.0);

    // Bottom-right: snowy mountains lit from the aurora's side, a near hill with snowy pines.
    float rh = ridgeH(uv.x, asp);
    if (uv.y > rh) {
        float depth = uv.y - rh;
        float e = 0.02;
        float slope = (ridgeSmooth(uv.x + e, asp) - ridgeSmooth(uv.x - e, asp)) / (2.0 * e);
        // Gullies running down the slope break the light up.
        slope += 0.6 * (vnoise(float2(uv.x * 26.0 - depth * 10.0, depth * 3.0)) - 0.5);
        // Faces turned to the upper left catch the light; streaks of rock show on the steep, shaded sides.
        float lit = sat(0.45 - slope * 1.4 + 0.35 * (fbm3(uv * 11.0) - 0.5));
        float rock = smoothstep(0.58, 0.78, fbm3(float2(uv.x * 22.0 + uv.y * 14.0, uv.y * 22.0 - uv.x * 6.0))) * sat(abs(slope) * 0.8);
        float3 shade = BG * 1.6 + float3(0.02, 0.025, 0.04);
        float3 snow = mix(float3(0.62, 0.7, 0.8), A, 0.3) * 0.55;
        float3 m = mix(shade, snow, lit);
        m = mix(m, BG * 0.9, rock * 0.7);
        // Darker and hazier towards the foot.
        m = mix(m, BG * 1.3 + A * 0.02, sat(depth * 2.5));
        col = mix(col, m, smoothstep(0.0, 0.002, depth));
        // Aurora light along the crest.
        col += mix(A, float3(1.0), 0.4) * exp(-depth * 260.0) * 0.18 * sat(0.6 - slope);
    }
    float hh = hillH(uv.x, asp);
    float pines = 0.0;
    float pineLit = 0.0;
    for (int i = 0; i < 10; i++) {
        float fi = float(i);
        float px = asp * (0.58 + 0.043 * fi + 0.015 * hash11(fi * 3.1));
        float base = hillH(px, asp) + 0.006;
        float hgt = 0.07 + 0.08 * hash11(fi * 7.7) * sat((px / asp - 0.55) * 4.0);
        float2 q = uv - float2(px, base);
        float rel = sat(-q.y / hgt);                 // 0 at the foot, 1 at the tip
        float tier = fract(rel * 4.0 + 0.1 * sin(q.x * 300.0));
        float w = hgt * 0.36 * (1.0 - rel) * (0.6 + 0.4 * tier);
        float tree = step(-hgt, q.y) * step(q.y, 0.0) * smoothstep(w + 0.0015, w - 0.0015, abs(q.x));
        // Snow on each tier's top and on the lit (left) side.
        float snowy = smoothstep(-w * 0.55, -w * 0.95, q.x) * 0.55 + smoothstep(0.1, 0.0, tier) * smoothstep(0.0, -w * 0.7, q.x) * 0.35;
        pineLit = max(pineLit, tree * sat(snowy));
        pines = max(pines, tree);
    }
    float near = smoothstep(hh, hh + 0.002, uv.y);
    float nd = max(uv.y - hh, 0.0);
    float3 nearCol = mix(mix(float3(0.5, 0.58, 0.68), A, 0.25) * 0.4, BG * 0.8, sat(nd * 5.0));
    nearCol += 0.05 * (vnoise(float2(uv.x * 30.0, uv.y * 120.0)) - 0.5) * (1.0 - sat(nd * 9.0));
    float3 pineCol = mix(BG * 0.45 + float3(0.01, 0.025, 0.025), mix(float3(0.7, 0.78, 0.86), A, 0.25) * 0.45, pineLit);
    col = mix(col, nearCol, near);
    col = mix(col, pineCol, pines);
    col += mix(A, float3(1.0), 0.6) * exp(-abs(uv.y - hh) * 400.0) * 0.12 * (1.0 - pines);
    col += float3(0.85, 0.95, 1.0) * dots(uv, 170.0, float2(0.0), 0.1, 0.08, 11.0) * near * 0.5 * (1.0 - sat(nd * 6.0));

    return half4(finish(col, fc), 1.0);
}
