// Nebula: a gas cloud drifting very slowly, folded by its own currents, with dark dust lanes,
// a field of stars and a few bright ones with soft diffraction spikes.
half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float2 p = uv * 1.5 + float2(t * 0.006, t * 0.002);
    float2 q = float2(fbm(p + float2(0.0, t * 0.01)), fbm(p + float2(5.2, 1.3) - t * 0.008));
    float r = fbm(p + 2.2 * q + float2(1.7, 9.2));
    float gas = smoothstep(0.3, 0.9, r);
    float3 col = BG;
    col += mix(A, S, sat(q.x * 1.4 - 0.2)) * gas * 0.55;
    col += mix(S, float3(1.0), 0.3) * pow(gas, 3.0) * 0.25;
    // Dust lanes.
    float dust = smoothstep(0.5, 0.75, fbm3(p * 2.4 + q * 1.5 + 3.0));
    col *= 1.0 - dust * 0.55;

    // Stars.
    col += float3(1.0) * dots(uv, 55.0, float2(t * 0.02, 0.0), 0.4, 0.08, 1.0) * 0.45;
    col += mix(S, float3(1.0), 0.6) * dots(uv, 24.0, float2(t * 0.03, 0.0), 0.25, 0.07, 5.0) * 0.7;
    // Bright stars with spikes.
    float2 bp = uv * 3.0 + float2(t * 0.012, 0.0);
    float2 id = floor(bp);
    float2 f = fract(bp) - 0.5;
    float2 rr = hash22(id + 21.0);
    if (rr.x < 0.35) {
        float2 g = f - (hash22(id + 4.0) - 0.5) * 0.5;
        float tw = 0.75 + 0.25 * sin(t * (0.8 + rr.y) + rr.x * 30.0);
        float spike = (exp(-abs(g.x) * 220.0) * exp(-abs(g.y) * 14.0) + exp(-abs(g.y) * 220.0) * exp(-abs(g.x) * 14.0));
        float core = exp(-length(g) * 60.0);
        col += mix(S, float3(1.0), 0.7) * (spike * 0.35 + core) * tw * 0.9;
    }
    return half4(finish(col, fc), 1.0);
}
