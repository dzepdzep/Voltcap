// Moon tide: a big detailed moon in the top-right corner with a soft halo, thin clouds drifting past it,
// silver at their edges. Below, a calm sea: slow swell, a glittering path under the moon, and in the
// bottom-left corner a small lighthouse on its rock, its beam sweeping slowly. The middle stays open sky.

float seaWave(float2 p, float t) {
    return vnoise(p * float2(1.0, 3.0) + float2(t * 0.25, 0.0)) * 0.6 + vnoise(p * float2(2.3, 7.0) - float2(t * 0.4, 0.0)) * 0.4;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;      // moonlight
    float3 S = uSec.rgb;      // night blue
    float3 BG = uBg.rgb;

    float hz = 0.79;          // horizon
    float2 mc = float2(asp * 0.84, 0.21);
    float mr = 0.115;

    // Sky: deep at the top, lighter and bluer at the horizon, a wide glow round the moon.
    float3 col = mix(BG * 0.9, mix(BG, S, 0.35) * 1.4, smoothstep(0.0, hz, uv.y));
    float2 mp = uv - mc;
    float md = length(mp);
    col += mix(S, A, 0.5) * exp(-md * 3.2) * 0.22;
    col += A * exp(-max(md - mr, 0.0) * 22.0) * 0.16;
    // A faint ring in the haze.
    col += mix(A, S, 0.4) * exp(-abs(md - mr * 2.6) * 60.0) * 0.035;
    col += float3(0.9, 0.95, 1.0) * dots(uv, 60.0, float2(0.0), 0.12, 0.06, 4.0) * 0.45 * smoothstep(0.25, 0.6, md) * step(uv.y, hz);

    // Long low strata of haze above the horizon.
    float strata = fbm(float2(uv.x * 1.2 + t * 0.006, uv.y * 14.0));
    col += mix(S, A, 0.2) * smoothstep(0.5, 0.8, strata) * exp(-sqf((uv.y - hz + 0.06) / 0.05)) * 0.12;
    // The moon: shaded sphere, maria, craters.
    if (md < mr + 0.003) {
        float2 q = mp / mr;
        float z = sqrt(max(1.0 - dot(q, q), 0.0));
        float3 n = float3(q, z);
        float lit = sat(dot(n, normalize(float3(-0.25, -0.15, 0.95))));
        float maria = smoothstep(0.42, 0.62, fbm(q * 1.5 + 3.3));
        float3 surf = mix(float3(0.86, 0.87, 0.88), float3(0.55, 0.57, 0.62), maria * 0.8);
        // Craters: rings of light and shade in a few cells.
        float cr = 0.0;
        for (int i = 0; i < 2; i++) {
            float sc = 5.0 + 6.0 * float(i);
            float2 g = q * sc;
            float2 id = floor(g);
            float2 f = fract(g) - 0.5;
            float2 o = (hash22(id + float(i) * 7.0) - 0.5) * 0.5;
            float rr = 0.18 + 0.2 * hash12(id + 3.0);
            float d = length(f - o);
            float on = step(0.78, hash12(id + 11.0 + float(i)));
            cr += on * (smoothstep(rr, rr * 0.6, d) * -0.07 + exp(-abs(d - rr) * 30.0) * 0.07 * sat(dot(normalize(f - o + 1e-4), float2(-0.6, -0.5))));
        }
        surf *= 0.88 + 0.12 * fbm(q * 6.0);
        surf += cr;
        float3 moon = mix(surf, surf * A, 0.25) * (0.25 + 0.85 * lit) * (0.8 + 0.2 * z);
        col = mix(col, moon, smoothstep(mr + 0.002, mr - 0.002, md));
    }

    // Thin clouds drifting across the top-right, silver at the edges near the moon.
    float2 cp = uv * float2(1.1, 3.4) + float2(t * 0.012, 0.0);
    float cl = fbm(cp + float2(0.0, 2.0));
    float band = exp(-sqf((uv.y - 0.3) / 0.12)) * smoothstep(asp * 0.4, asp * 0.7, uv.x);
    float cloud = smoothstep(0.42, 0.7, cl) * band;
    float edgeL = smoothstep(0.42, 0.52, cl) - smoothstep(0.52, 0.7, cl);
    float nearMoon = exp(-md * 3.0);
    col = mix(col, BG * 1.3 + S * 0.05 + A * nearMoon * 0.22, cloud * 0.8);
    col += A * edgeL * band * nearMoon * 0.6;
    col += A * cloud * nearMoon * 0.12;

    // The sea.
    if (uv.y > hz) {
        float dy = uv.y - hz;
        float z = 0.05 / (dy + 0.004);           // distance
        float2 sp = float2((uv.x - mc.x) * z, z * 1.4);
        float w = seaWave(sp * float2(3.0, 1.0), t);
        float3 sea = mix(mix(BG, S, 0.25) * 1.2, BG * 0.6, sat(dy * 3.5));
        sea += mix(S, A, 0.3) * (w - 0.5) * 0.14 * exp(-dy * 3.0);
        // Long swell lines catching the sky.
        float swell = smoothstep(0.6, 0.95, vnoise(float2(uv.x * 2.0 * z * 0.3 + t * 0.05, z * 2.5 - t * 0.12)));
        sea += mix(S, A, 0.4) * swell * 0.07 * exp(-dy * 2.0);
        // The moon's path: a column of glitter widening towards you.
        float col0 = abs(uv.x - mc.x) / (0.04 + dy * 1.3);
        float path = exp(-sqf(col0) * 1.4);
        float glit = smoothstep(0.72, 0.9, seaWave(sp * float2(9.0, 2.5) + 5.0, t * 1.6));
        glit *= 0.6 + 0.4 * sin(t * 2.0 + uv.x * 300.0);
        sea += A * path * (0.14 + glit * 1.1) * (1.0 - sat(dy * 2.0) * 0.5);
        // Horizon line catching light.
        sea += mix(A, S, 0.5) * exp(-dy * 260.0) * 0.18;
        col = sea;
    }

    // Bottom-left: a rock with a small lighthouse; its beam sweeps slowly.
    float2 lh = float2(asp * 0.1, hz - 0.005);
    float rockH = hz + 0.035 - 0.065 * exp(-sqf((uv.x - lh.x) / 0.1)) - 0.03 * exp(-sqf((uv.x - lh.x - 0.16) / 0.07))
                - 0.012 * vnoise(float2(uv.x * 30.0, 1.0)) + 0.4 * smoothstep(asp * 0.12, asp * 0.32, uv.x);
    float rock = smoothstep(rockH, rockH + 0.002, uv.y);
    float2 tq = uv - float2(lh.x, rockH);
    float towerTop = hz - 0.2;
    float2 tp = uv - float2(lh.x, 0.0);
    float tw = mix(0.012, 0.018, sat((uv.y - towerTop) / (hz - 0.05 - towerTop)));
    float tower = step(towerTop, uv.y) * step(abs(tp.x), tw) * step(uv.y, hz - 0.03);
    float stripe = step(0.5, fract((uv.y - towerTop) * 22.0));
    float lampY = towerTop - 0.012;
    float lamp = step(lampY - 0.012, uv.y) * step(uv.y, towerTop) * step(abs(tp.x), 0.009);
    float roof = step(abs(tp.x), 0.016 * sat((uv.y - (lampY - 0.03)) / 0.02)) * step(lampY - 0.03, uv.y) * step(uv.y, lampY - 0.012);
    // The beam: a slow rotation, brightest when it points at you.
    float ang = t * 0.35;
    float2 bdir = float2(cos(ang), sin(ang) * 0.12);
    float2 bp = uv - float2(lh.x, lampY - 0.006);
    float along = dot(bp, normalize(bdir));
    float across = abs(bp.x * normalize(bdir).y - bp.y * normalize(bdir).x);
    float beam = step(0.0, along) * exp(-across / (0.004 + max(along, 0.0) * 0.06)) * exp(-max(along, 0.0) * 1.6);
    float facing = sqf(sat(sin(ang)));
    col += mix(A, float3(1.0, 0.9, 0.7), 0.6) * beam * 0.5;
    float3 silh = BG * 0.45;
    col = mix(col, silh, max(rock * step(uv.y, 1.2), 0.0));
    float3 towerCol = mix(float3(0.16, 0.17, 0.2), float3(0.3, 0.1, 0.1), stripe) * 0.8;
    col = mix(col, towerCol, tower);
    col = mix(col, silh, roof);
    float3 lampCol = float3(1.0, 0.92, 0.7);
    col = mix(col, lampCol * (0.7 + 0.3 * facing), lamp);
    col += lampCol * exp(-length(bp) * 60.0) * (0.25 + 0.6 * facing);

    return half4(finish(col, fc), 1.0);
}
