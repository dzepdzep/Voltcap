// Wyrm · 32-bit (dragon type): castle ruins on a crag under a stormy moon. A long sky serpent winds
// round the moon in a loop, its scaled body rippling and its fins flickering, lightning lights the
// clouds, and banners on the broken towers whip in the wind.
//#include pixel

half4 main(float2 fc) {
    float2 cell = pxCell(fc);
    float2 uv = pxUv(cell);
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float flash = step(0.96, fract(t * 0.18)) * step(0.5, fract(t * 6.0));

    float3 col = mix(BG * 0.8, mix(BG * 2.0, A * 0.3, 0.5), pxBand(uv.y * 1.3, 4.0, cell)) + flash * 0.15;
    float2 moon = float2(asp * 0.5, 0.36);
    float md = length(uv - moon);
    col = mix(col, mix(float3(0.95, 0.9, 0.8), S, 0.15), step(md, 0.15));
    col = mix(col, mix(float3(0.85, 0.8, 0.72), S, 0.2), step(md, 0.15) * step(0.6, vnoise((uv - moon) * 25.0)));
    // Storm clouds.
    float cl = fbm3(float2(uv.x * 2.0 + t * 0.03, uv.y * 5.0));
    if (cl > 0.62 - uv.y * 0.2 && md > 0.16) col = mix(BG * 1.6 + S * 0.05, float3(0.5, 0.5, 0.65) + flash * 0.3, step(0.66, cl));
    // The serpent: a chain of scaled segments along a loop round the moon (body behind the moon on the far side).
    float body = 0.0;
    float bodyLit = 0.0;
    float fin = 0.0;
    float headD = 9.0;
    float front = 0.0;
    for (int i = 0; i < 34; i++) {
        float fi = float(i);
        float s = t * 0.35 - fi * 0.06;
        float2 p = moon + float2(cos(s) * 0.33 * asp / 1.78 * 1.4, sin(s) * 0.16 + 0.04 * sin(s * 3.0 + t));
        float depth = sin(s);                        // > 0 in front of the moon
        float r = (0.036 - fi * 0.0008);
        float d = length(uv - pxSnap(p));
        if (d < r && (depth > -0.2 || md > 0.15)) {
            body = 1.0;
            bodyLit = step(0.0, (uv - p).y * -1.0) ;
            front = depth;
            float sc = step(0.5, fract((uv.x - p.x) * 120.0 + (uv.y - p.y) * 120.0));
            bodyLit = max(bodyLit * 0.6, sc * 0.3 + bodyLit * 0.5);
        }
        if (mod(fi, 3.0) < 0.5 && i > 1) {
            float2 fp = p + float2(0.0, -r * 1.3 - 0.01 * (0.5 + 0.5 * sin(t * 8.0 + fi)));
            fin = max(fin, step(length((uv - pxSnap(fp)) * float2(1.6, 1.0)), 0.012) * step(depth, 9.0));
        }
        if (i == 0) headD = length(uv - pxSnap(p));
    }
    float3 scale0 = mix(float3(0.15, 0.4, 0.3), A, 0.45);
    float3 scale1 = mix(float3(0.35, 0.7, 0.45), A, 0.35);
    col = mix(col, mix(S, float3(1.0, 0.4, 0.3), 0.4), fin);
    col = mix(col, mix(scale0, scale1, bodyLit), body);
    // Head: a wedge with horns and a glowing eye.
    float hs = t * 0.35;
    float2 hp = moon + float2(cos(hs) * 0.33 * asp / 1.78 * 1.4, sin(hs) * 0.16 + 0.04 * sin(hs * 3.0 + t));
    float2 dir = normalize(float2(-sin(hs) * 0.33 * asp / 1.78 * 1.4, cos(hs) * 0.16));
    float2 hq = float2(dot(uv - hp, dir), dot(uv - hp, float2(-dir.y, dir.x)));
    float head = step(0.0, hq.x + 0.02) * step(hq.x, 0.06) * step(abs(hq.y), 0.038 * (1.0 - hq.x / 0.075));
    float horn = pxLine(uv, hp - dir * 0.01 + float2(-dir.y, dir.x) * 0.02, hp - dir * 0.05 + float2(-dir.y, dir.x) * 0.05, 2.0);
    col = mix(col, scale1, head);
    col = mix(col, float3(0.9, 0.85, 0.7), horn);
    col = mix(col, mix(float3(1.0, 0.9, 0.3), S, 0.3), step(length(hq - float2(0.02, 0.01)), PX * 1.2) * head);
    // Ruins on a crag in front.
    float crag = 0.78 - 0.1 * exp(-sqf((uv.x - asp * 0.25) * 3.0)) + 0.02 * sin(uv.x * 23.0);
    float t1 = pxBox(uv, float2(asp * 0.2, 0.6), float2(0.035, 0.14)) * step(0.48 + 0.03 * step(0.5, fract(uv.x * 40.0)), uv.y);
    float t2 = pxBox(uv, float2(asp * 0.32, 0.64), float2(0.03, 0.1)) * step(0.55 + 0.04 * sin(uv.x * 80.0), uv.y);
    float wall = pxBox(uv, float2(asp * 0.26, 0.7), float2(0.1, 0.04)) * step(0.66 + 0.02 * step(0.5, fract(uv.x * 30.0)), uv.y);
    float ruin = sat(t1 + t2 + wall);
    col = mix(col, mix(float3(0.12, 0.1, 0.16), BG, 0.3) + flash * 0.1, max(ruin, step(crag, uv.y)));
    col = mix(col, mix(float3(1.0, 0.8, 0.4), A, 0.3), ruin * step(abs(fract(uv.y * 20.0) - 0.5), 0.2) * step(abs(fract(uv.x * 30.0) - 0.5), 0.15) * step(0.8, hash12(floor(uv * float2(30.0, 20.0)))));
    // Banners on the towers.
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float2 bp = fi < 0.5 ? float2(asp * 0.2, 0.42) : float2(asp * 0.32, 0.5);
        col = mix(col, float3(0.2), pxBox(uv, bp + float2(0.0, 0.03), float2(PX * 0.5, 0.04)));
        float2 q = uv - bp;
        float w = 0.008 * sin(q.x * 50.0 - t * 8.0);
        col = mix(col, mix(float3(0.7, 0.15, 0.2), A, 0.3), step(0.0, q.x) * step(q.x, 0.06) * step(abs(q.y - w), 0.012));
    }
    // Lightning bolt now and then.
    float2 lb = float2(asp * (0.75 + 0.1 * hash11(floor(t * 0.18))), 0.05);
    float zig = lb.x + 0.03 * sign(sin(uv.y * 40.0)) * fract(uv.y * 6.0);
    col = mix(col, float3(1.0), flash * step(abs(uv.x - zig), PX) * step(uv.y, 0.55));
    col = pxQuant(col, 10.0, cell);
    return half4(finish(col, fc), 1.0);
}
