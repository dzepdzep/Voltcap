// Jellyfish drift: the open sea at dusk, light falling in soft rays from the surface. A few glowing
// jellyfish drift in the corners — bells pulsing slowly, frilled edges, long tentacles swaying behind —
// while specks of sea snow float past. The middle stays deep, quiet water (original design).

// One jellyfish at c (bell radius r), pulsing with phase ph, heading up (tilt a). Returns glow (rgb) and alpha.
float4 jelly(float2 p, float2 c, float r, float ph, float a, float3 tint, float t) {
    float2 q = rot(a) * (p - c) / r;
    float pulse = 0.5 + 0.5 * sin(t * 1.3 + ph);
    // Bell: a dome, wider when it opens, taller when it squeezes.
    float2 bq = q * float2(1.0 / (1.0 + 0.12 * pulse), 1.0 / (1.0 - 0.1 * pulse));
    float dome = length(bq * float2(1.0, 1.25)) - 1.0;
    float below = step(0.0, bq.y);
    float hem = 0.05 * sin(atan(bq.x, 0.2) * 9.0 + t * 2.0);
    float bell = max(dome, (bq.y - 0.15 - hem)) ;
    float inBell = smoothstep(0.04, -0.04, bell);
    // Inner pattern: four soft lobes and radial lines.
    float ang = atan(bq.x, -bq.y + 0.4);
    float lobes = exp(-sqf(length(bq - float2(0.0, -0.25)) - 0.35) * 30.0) * (0.6 + 0.4 * sin(ang * 4.0));
    float lines = smoothstep(0.85, 1.0, sin(ang * 16.0)) * 0.4;
    float rim = exp(-abs(bell) * 18.0);
    float3 jc = tint * (inBell * (0.22 + 0.45 * sat(-bq.y)) + lobes * inBell * 0.5 + lines * inBell * 0.25 + rim * 0.8);
    // Glowing dots round the bell's edge.
    float2 ep = float2(atan(bq.x, bq.y - 0.1) * 6.0, bell * 12.0);
    jc += mix(tint, float3(1.0), 0.5) * exp(-dot(fract(ep) - 0.5, fract(ep) - 0.5) * 30.0) * exp(-abs(bell) * 25.0) * (0.4 + 0.6 * pulse);
    float alpha = inBell * 0.65 + rim * 0.3;
    // Tentacles: a few wavy threads trailing below the bell.
    float tent = 0.0;
    for (int k = 0; k < 5; k++) {
        float fk = float(k) - 2.0;
        float x0 = fk * 0.28 * (1.0 + 0.1 * pulse);
        float y = q.y - 0.15;
        float wave = 0.12 * sin(y * 3.0 - t * 1.6 + fk * 1.3 + ph) * sat(y * 0.6);
        float d = abs(q.x - x0 - wave - fk * 0.05 * y);
        tent += smoothstep(0.035, 0.0, d) * step(0.0, y) * exp(-y * 0.3) * smoothstep(5.0, 3.5, y);
    }
    // Oral arms: two thicker frilly ribbons in the middle.
    float y2 = q.y - 0.1;
    float arm = smoothstep(0.12, 0.0, abs(abs(q.x) - 0.1 - 0.06 * sin(y2 * 5.0 - t * 1.2 + ph))) * step(0.0, y2) * exp(-y2 * 0.9);
    jc += mix(tint, float3(1.0), 0.2) * (tent * 0.45 + arm * 0.5);
    alpha = max(alpha, sat(tent * 0.35 + arm * 0.5));
    return float4(jc, alpha);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Water: lighter towards the surface, light rays slanting down from the top.
    float3 col = mix(BG * 2.2 + A * 0.04, BG * 0.7, smoothstep(0.0, 1.0, uv.y));
    float rx = uv.x + uv.y * 0.35;
    float rays = fbm3(float2(rx * 5.0 + t * 0.03, t * 0.05)) * smoothstep(0.9, 0.0, uv.y);
    col += mix(A, float3(0.8, 0.95, 1.0), 0.5) * sqf(rays) * 0.12;
    // Surface shimmer at the very top.
    col += A * smoothstep(0.6, 0.9, vnoise(float2(uv.x * 14.0 + t * 0.2, t * 0.3))) * exp(-uv.y * 18.0) * 0.12;

    // Sea snow drifting.
    col += float3(0.8, 0.9, 1.0) * dots(uv, 45.0, float2(t * 0.004, -t * 0.006), 0.12, 0.05, 4.0) * 0.18;
    col += float3(0.8, 0.9, 1.0) * dots(uv, 90.0, float2(t * 0.002, -t * 0.003), 0.15, 0.06, 9.0) * 0.1;

    // Jellyfish: two near the bottom-left, two near the top-right, one small far away.
    for (int i = 0; i < 5; i++) {
        if (uLod > 1.5 && i > 2) break;
        float fi = float(i);
        float2 home = i == 0 ? float2(0.1, 0.58) : i == 1 ? float2(0.24, 0.8) : i == 2 ? float2(0.87, 0.14) : i == 3 ? float2(0.72, 0.1) : float2(0.95, 0.6);
        float r = i == 0 ? 0.11 : i == 1 ? 0.07 : i == 2 ? 0.1 : i == 3 ? 0.055 : 0.04;
        // A slow rise and drift, then sink back: they never leave their corner.
        float2 c = float2(home.x * asp, home.y) + float2(0.03 * sin(t * 0.05 + fi * 2.0), 0.04 * sin(t * 0.07 + fi * 1.4));
        float a = 0.25 * sin(t * 0.06 + fi * 1.7);
        float3 tint = mix(A, S, hash11(fi * 3.3 + 1.0));
        float4 j = jelly(uv, c, r, fi * 1.9, a, tint, t);
        // Far ones fade into the water.
        float fade = i == 4 ? 0.55 : 1.0;
        col = mix(col, col * 0.85 + j.rgb, j.a * fade);
        col += tint * exp(-length(uv - c) / r * 0.9) * 0.1 * fade;
    }

    return half4(finish(col, fc), 1.0);
}
