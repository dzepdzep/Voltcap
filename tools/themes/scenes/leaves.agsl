// Matcha / Sprout: a quiet forest clearing. Sun filters through the canopy in shafts, soft
// out-of-focus light hangs in the air and leaves tumble down at three depths.
//#include falling

float bokeh(float2 uv, float scale, float2 drift, float seed, float soft) {
    float2 p = uv * scale + drift;
    float2 id = floor(p);
    float2 f = fract(p) - 0.5;
    float2 r = hash22(id + seed);
    if (r.x > 0.45) return 0.0;
    float2 o = (hash22(id + seed + 1.3) - 0.5) * 0.4;
    float rad = 0.12 + 0.16 * r.y;
    float d = length(f - o);
    float pulse = 0.6 + 0.4 * sin(uTime * 0.4 + r.y * 20.0);
    return (1.0 - smoothstep(rad - soft, rad, d)) * (0.6 + 0.4 * smoothstep(rad * 0.4, rad, d)) * pulse;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float3 col = mix(BG + A * 0.12, BG * 0.85, smoothstep(0.0, 1.0, uv.y));

    // Light shafts slanting in from the top left.
    float s = uv.x * 0.8 + uv.y * 0.55;
    float shafts = vnoise(float2(s * 9.0, t * 0.04)) * 0.6 + vnoise(float2(s * 21.0, t * 0.06 + 3.0)) * 0.4;
    shafts = smoothstep(0.5, 0.95, shafts) * (1.0 - smoothstep(0.0, 0.9, uv.y));
    col += mix(S, float3(1.0), 0.3) * shafts * 0.13;

    // Out-of-focus light: two depths.
    col += mix(A, S, 0.5) * bokeh(uv, 3.0, float2(t * 0.02, -t * 0.01), 2.0, 0.05) * 0.07;
    col += S * bokeh(uv, 5.5, float2(-t * 0.03, -t * 0.015), 8.0, 0.03) * 0.06;

    // Leaves: far (small, soft), middle, near (larger, sharp).
    float4 l = fallingLayer(uv, 11.0, float2(0.25, 0.55), 0.35, 1.0, 0.0, 0.04, A * 0.7, S * 0.7);
    col = mix(col, l.rgb * 0.6, l.a * 0.45);
    l = fallingLayer(uv, 7.0, float2(0.2, 0.45), 0.3, 5.0, 0.0, 0.02, A, mix(A, S, 0.6));
    col = mix(col, l.rgb * 0.85, l.a * 0.7);
    l = fallingLayer(uv, 4.2, float2(0.15, 0.32), 0.25, 9.0, 0.0, 0.01, A * 1.05, S);
    col = mix(col, l.rgb, l.a * 0.85);

    return half4(finish(col, fc), 1.0);
}
