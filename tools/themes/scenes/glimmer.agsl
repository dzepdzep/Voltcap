// Glimmer (fairy type): a twilight glade wrapped in a soft pink-lilac haze. A ring of glowing
// mushrooms circles the clearing; little lights swirl in spirals around it, trailing sparkles that
// fade behind them; blossom petals and dreamy bokeh drift; a halo surrounds the pale moon and the
// mushroom caps pulse gently, one after another.

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float cx = asp * 0.5;

    // Haze: lilac above, rose near the ground.
    float3 col = mix(mix(BG * 1.6, A * 0.35, 0.35), mix(S, float3(1.0, 0.7, 0.85), 0.4) * 0.6, smoothstep(0.0, 0.85, uv.y));
    // Moon with a rainbow-tinged halo.
    float2 mp = float2(asp * 0.2, 0.18);
    float md = length(uv - mp);
    float halo = exp(-abs(md - 0.11) * 50.0);
    col += (0.5 + 0.5 * cos(TAU * (md * 6.0 + float3(0.0, 0.33, 0.67)))) * halo * 0.12;
    col += float3(1.0, 0.95, 1.0) * exp(-md * 10.0) * 0.25;
    col = mix(col, float3(1.0, 0.97, 0.99), 1.0 - smoothstep(0.04 - px, 0.04 + px, md));
    // Bokeh: soft discs drifting.
    for (int k = 0; k < 2; k++) {
        float fk = float(k);
        float2 bp = uv * (5.0 + fk * 3.0) + float2(t * 0.03, -t * 0.02 * (1.0 + fk));
        float2 id = floor(bp);
        float2 h = hash22(id + fk * 5.0);
        float2 f = fract(bp) - 0.5 - (h - 0.5) * 0.5;
        float disc = 1.0 - smoothstep(0.12, 0.2, length(f));
        col += mix(A, float3(1.0, 0.8, 0.95), h.y) * disc * step(0.75, h.x) * 0.08;
    }
    // Trees around the glade: soft rounded crowns, darker with nearness.
    float tr = 0.55 + 0.06 * sin(uv.x * 7.0) + 0.04 * sin(uv.x * 17.0 + 1.0) + 0.05 * smoothstep(0.3, 0.0, abs(uv.x - cx) / asp) ;
    col = mix(col, mix(BG * 0.9, A * 0.25, 0.3), smoothstep(tr - px, tr + px, uv.y) * 0.85);
    // The glade floor: soft moss.
    float gy = 0.72;
    float3 moss = mix(mix(float3(0.3, 0.42, 0.34), BG * 1.5, 0.4), mix(A, S, 0.5) * 0.45, 0.3) * (0.85 + 0.15 * vnoise(uv * float2(30.0, 90.0)));
    col = mix(col, moss, smoothstep(gy - px, gy + px, uv.y));
    // Glow pooled on the floor inside the ring.
    col += mix(A, S, 0.5) * exp(-length((uv - float2(cx, 0.8)) * float2(0.5, 2.0)) * 4.0) * 0.25;

    // The mushroom ring: an ellipse of glowing caps, the far ones smaller; caps pulse in a wave.
    for (int i = 0; i < 10; i++) {
        float fi = float(i);
        float a = fi / 10.0 * TAU + 0.3;
        float2 p = float2(cx + cos(a) * asp * 0.28, 0.8 + sin(a) * 0.07);
        float sc = (0.75 + 0.35 * (sin(a) * 0.5 + 0.5)) * 1.9;
        float pulse = 0.5 + 0.5 * sin(t * 1.2 - fi * 0.63);
        float2 q = (uv - p) / sc;
        float stem = sdRoundBox(q - float2(0.0, -0.012), float2(0.005, 0.014), 0.003);
        float cap = max(length((q - float2(0.0, -0.026)) * float2(1.0, 1.6)) - 0.02, q.y + 0.024);
        float3 capC = mix(A, float3(1.0, 0.75, 0.9), 0.35) * (0.8 + 0.5 * pulse);
        col = mix(col, float3(0.9, 0.86, 0.82) * 0.7, 1.0 - smoothstep(-px, px, stem * sc));
        col = mix(col, capC, 1.0 - smoothstep(-px, px, cap * sc));
        col += capC * exp(-length(q - float2(0.0, -0.03)) * 30.0) * (0.15 + 0.25 * pulse);
    }

    // Swirling lights with sparkle trails: each follows a spiral around the ring; the trail is the
    // same path a moment earlier, fading.
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float sp = 0.5 + 0.15 * fi;
        float acc = 0.0;
        for (int j = 0; j < 8; j++) {
            float fj = float(j);
            float tt = t - fj * 0.08;
            float a = tt * sp + fi * 1.26;
            float rad = 0.18 + 0.08 * sin(tt * 0.4 + fi);
            float2 p = float2(cx + cos(a) * rad * asp * 0.8, 0.55 + sin(a) * rad * 0.45 - 0.08 * sin(tt * 0.3 + fi * 2.0));
            float d = length(uv - p);
            float w = 1.0 - fj / 8.0;
            float twinkle = 0.6 + 0.4 * sin(t * 12.0 + fj * 3.0 + fi);
            acc += (exp(-d * mix(240.0, 700.0, fj / 8.0)) + exp(-d * 40.0) * 0.04) * w * w * (fj > 0.5 ? twinkle * 0.8 : 1.6);
        }
        col += mix(float3(1.0, 0.92, 0.98), mix(A, S, fi / 4.0), 0.35) * acc;
    }

    // Petals drifting and turning.
    for (int i = 0; i < 8; i++) {
        float fi = float(i);
        float life = fract(t * (0.04 + 0.01 * hash11(fi)) + hash11(fi * 3.7));
        float2 p = float2(fract(hash11(fi * 1.3) + life * 0.5) * asp, life * 1.1 - 0.05);
        p.x += 0.04 * sin(life * 10.0 + fi);
        float2 q = rot(t * (0.8 + hash11(fi)) + fi) * (uv - p);
        float petal = length(q * float2(1.0, 2.2)) - 0.008;
        col = mix(col, mix(float3(1.0, 0.8, 0.88), S, 0.2), (1.0 - smoothstep(0.0, px, petal)) * 0.85);
    }
    return half4(finish(col, fc), 1.0);
}
