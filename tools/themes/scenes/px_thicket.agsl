// Thicket · 32-bit (bug type): down in the undergrowth at dusk, bug-sized. Giant leaves and stems lit
// from behind, a ladybird plodding up a stalk, a dragonfly hovering and darting, dew drops glinting on a
// web, and fireflies blinking in the dark gaps.
//#include pixel

half4 main(float2 fc) {
    float2 cell = pxCell(fc);
    float2 uv = pxUv(cell);
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // The warm dusk light behind everything.
    float3 col = mix(mix(float3(0.95, 0.7, 0.35), S, 0.25), mix(float3(0.25, 0.35, 0.2), BG, 0.4), pxBand(length(uv - float2(asp * 0.6, 0.25)) * 1.4, 5.0, cell));
    // Far leaves: dark shapes.
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float2 c = float2((fi + 0.5) / 6.0 * asp + 0.05 * sin(t * 0.3 + fi), 0.25 + 0.4 * hash11(fi));
        float2 q = rot(hash11(fi * 3.0) * 3.0 + 0.1 * sin(t * 0.5 + fi)) * (uv - c);
        float leaf = step(length(q * float2(1.0, 2.2)), 0.12 + 0.03 * hash11(fi));
        col = mix(col, mix(float3(0.15, 0.3, 0.12), BG, 0.4), leaf);
    }
    // Big near leaves, backlit: veins show.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float2 c = float2(fi < 0.5 ? asp * 0.12 : (fi < 1.5 ? asp * 0.88 : asp * 0.45), fi < 1.5 ? 0.35 + fi * 0.2 : 0.95);
        float ang = fi < 0.5 ? 0.6 : (fi < 1.5 ? -0.7 : 0.1);
        float2 q = rot(ang + 0.05 * sin(t * 0.7 + fi)) * (uv - c);
        float shape = length(q * float2(1.0, 2.0)) - 0.24;
        if (shape < 0.0) {
            float vein = step(abs(q.y), PX * 0.7) + step(abs(abs(q.y) - abs(q.x - 0.0) * 0.4 + 0.0 - fract(q.x * 12.0) * 0.04), PX * 0.5) * 0.0;
            float side = step(abs(fract(q.x * 14.0 + abs(q.y) * 10.0) - 0.5), 0.06);
            float3 lc = mix(mix(float3(0.4, 0.7, 0.2), A, 0.15), float3(0.65, 0.85, 0.3), pxBand(sat(0.5 - shape * -2.0 + q.y), 2.0, cell));
            col = mix(lc, mix(float3(0.85, 0.95, 0.5), S, 0.2), sat(vein + side * 0.7));
            col = mix(col, float3(0.25, 0.45, 0.12), step(-PX * 1.2, shape));
        }
    }
    // The stalk with the ladybird walking up it.
    float sx = asp * 0.3 + 0.02 * sin(uv.y * 6.0);
    col = mix(col, mix(float3(0.35, 0.55, 0.2), float3(0.25, 0.42, 0.15), step(sx, uv.x)), step(abs(uv.x - sx), 0.008));
    float lyT = fract(t * 0.05);
    float2 lb = pxSnap(float2(asp * 0.3 + 0.02 * sin((1.0 - lyT) * 6.0), 1.0 - lyT * 1.1));
    float2 lq = (uv - lb) / PX;
    float shell = step(length(lq * float2(1.0, 0.85)), 4.0);
    float head = step(length(lq - float2(0.0, -4.5)), 2.0);
    col = mix(col, float3(0.08), head);
    col = mix(col, mix(float3(0.9, 0.15, 0.1), A, 0.2), shell);
    col = mix(col, float3(0.05), shell * (step(abs(lq.x), 0.5) + step(length(lq - float2(-2.0, 1.0)), 1.0) + step(length(lq - float2(2.0, -1.0)), 1.0) + step(length(lq - float2(1.5, 2.5)), 0.8)));
    col = mix(col, float3(1.0), shell * step(length(lq - float2(-1.5, -2.0)), 0.7));
    // A web in a gap with dew drops glinting.
    float2 wc = float2(asp * 0.68, 0.42);
    float2 wq = uv - wc;
    float wr = length(wq);
    float wa = atan(wq.y, wq.x);
    float spokes = step(abs(fract(wa / TAU * 8.0) - 0.5), 0.012 / max(wr * 8.0, 0.1)) * step(wr, 0.13);
    float rings = step(abs(fract(wr * 30.0) - 0.5), 0.08) * step(wr, 0.13) * step(0.015, wr);
    col = mix(col, float3(0.95, 0.95, 0.85), sat(spokes + rings) * 0.55);
    float drop = step(0.93, hash12(floor(wq * 60.0))) * step(wr, 0.13) * sat(spokes + rings);
    col = mix(col, mix(float3(0.8, 0.95, 1.0), float3(1.0), step(0.5, sin(t * 3.0 + hash12(floor(wq * 60.0)) * 20.0))), drop);
    // The dragonfly: hovers, then darts to a new spot.
    float dk = floor(t / 3.0);
    float da = fract(t / 3.0);
    float2 p0 = float2(0.2 + 0.6 * hash11(dk), 0.2 + 0.3 * hash11(dk + 0.5)) * float2(asp, 1.0);
    float2 p1 = float2(0.2 + 0.6 * hash11(dk + 1.0), 0.2 + 0.3 * hash11(dk + 1.5)) * float2(asp, 1.0);
    float2 dp = pxSnap(mix(p0, p1, smoothstep(0.8, 0.95, da)) + float2(0.0, 0.006 * sin(t * 8.0)));
    float2 dq = (uv - dp) / PX;
    float dbody = step(abs(dq.y), 0.8) * step(-9.0, dq.x) * step(dq.x, 2.0);
    float dhead = step(length(dq - float2(2.5, 0.0)), 1.6);
    float wingF = step(0.0, sin(t * 40.0));
    float wings = step(length((abs(dq - float2(0.0, 0.0)) - float2(1.5, 3.0 + wingF)) * float2(1.6, 0.6)), 2.2);
    col = mix(col, mix(col, float3(0.85, 0.95, 1.0), 0.6), wings * step(abs(dq.x), 5.0));
    col = mix(col, mix(float3(0.2, 0.7, 0.75), S, 0.4), sat(dbody + dhead));
    // Fireflies.
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float2 f = pxSnap(float2(fract(hash11(fi) + 0.02 * t * (0.5 + hash11(fi * 2.0))) * asp, 0.3 + 0.55 * hash11(fi * 3.0) + 0.03 * sin(t + fi)));
        float on = step(0.5, sin(t * 2.2 + fi * 2.3));
        col = mix(col, float3(1.0, 1.0, 0.6), step(length(uv - f), PX * 0.8) * on);
        col = mix(col, mix(col, float3(0.9, 1.0, 0.4), 0.4), step(length(uv - f), PX * 2.5) * on * step(0.5, mod(cell.x + cell.y, 2.0)));
    }
    col = pxQuant(col, 10.0, cell);
    return half4(finish(col, fc), 1.0);
}
