// Data stream: racing down a data highway. A perspective grid floor and ceiling run to a bright
// vanishing point; lanes of glowing packets streak towards you along the grid lines, some splitting at
// the nodes, hex blocks of data drift in the distance and pulses ripple out across the grid.

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float2 c = float2(asp * 0.5, 0.5);
    float2 p = uv - c;

    float3 col = BG * 0.6;
    // The glow at the vanishing point.
    col += mix(A, S, 0.5) * 0.35 * exp(-length(p * float2(0.6, 2.5)) * 5.0);
    // Floor (below) and ceiling (above): plane coordinates from the screen.
    float side = p.y > 0.0 ? 1.0 : -1.0;
    float h = abs(p.y);
    if (h > 0.004) {
        float z = 0.14 / h;                            // distance along the road
        float X = p.x * z * 14.0;                      // across, in lanes
        float Z = z + t * 4.0;
        float fade = exp(-z * 0.1);
        float fw = z * 14.0 / uRes.y * 1.5;            // one pixel, in lanes
        float fz = z * z / 0.14 / uRes.y * 4.5;       // one pixel, along
        float dl = abs(fract(X + 0.5) - 0.5);
        float lines = (1.0 - smoothstep(0.0, max(fw, 0.015), dl)) * sat(1.0 - fw * 5.0);
        float dt = abs(fract(Z * 1.5 + 0.5) - 0.5) * 2.0;
        float ties = (1.0 - smoothstep(0.0, max(fz, 0.03), dt)) * sat(1.0 - fz * 4.0);
        float3 gc = mix(A, S, side * 0.5 + 0.5);
        float dim = side > 0.0 ? 0.55 : 1.0;
        col += gc * (lines * 0.6 + ties * 0.3) * fade * dim;
        // A pulse ripple running out across the grid every 3 s.
        float pr = fract(t / 3.0) * 30.0;
        col += gc * 0.5 * exp(-abs(z - pr) * 1.5) * fade * lines * dim;
        // Packets: one per lane, racing towards the viewer, with a trail behind.
        float li = floor(X);
        float lx = fract(X) - 0.5;
        float speed = 8.0 + 6.0 * hash11(li * 3.1 + side);
        float pz = fract(-t * speed / 40.0 + hash11(li * 7.7 + side * 3.0)) * 40.0;
        float dz = z - pz;
        float len = 0.5 + 0.3 * hash11(li);
        float packet = (1.0 - smoothstep(0.12, 0.12 + fw, abs(lx))) * step(0.0, dz) * step(dz, len);
        float trail = (1.0 - smoothstep(0.04, 0.04 + fw, abs(lx))) * step(len, dz) * exp(-(dz - len) * 0.7) * step(dz, 6.0);
        float3 pc = mix(gc, float3(1.0), 0.35 + 0.35 * step(0.7, hash11(li * 5.0)));
        col += pc * (packet * 1.3 + trail * 0.6) * fade * step(0.3, hash11(li * 13.0 + side)) * dim;
        // Nodes where packets split: bright dots at the crossings near the pulse.
        col += gc * (1.0 - smoothstep(0.0, max(fw, 0.02) * 2.0, length(float2(dl, dt * 0.5)))) * fade * 0.6 * dim;
    }
    // Hex blocks drifting in the distance, near the horizon.
    for (int i = 0; i < 8; i++) {
        float fi = float(i);
        float life = fract(t * 0.05 + hash11(fi));
        float sc = 0.01 + life * life * 0.12;
        float2 hp = c + float2((hash11(fi * 3.0) - 0.5) * 1.6, (hash11(fi * 5.0) - 0.5) * 0.5) * life * life;
        float2 q = abs(uv - hp) / sc;
        float hex = max(q.x * 0.866 + q.y * 0.5, q.y) - 1.0;
        float3 hc = mix(A, S, hash11(fi * 2.0));
        col += hc * (1.0 - smoothstep(0.0, 0.08, abs(hex))) * (1.0 - life) * 0.8;
        col += hc * step(hex, 0.0) * 0.08 * (1.0 - life);
    }
    // Binary specks in the air.
    float2 g = floor(uv * float2(90.0, 50.0) + float2(0.0, t * 3.0));
    col += mix(A, S, 0.5) * 0.25 * step(0.99, hash12(g)) * step(0.5, sin(t * 4.0 + hash12(g) * 30.0));
    return half4(finish(col, fc), 1.0);
}
