// Ember / Blaze: a low, slow bed of fire along the bottom, heat shimmer above it, smoke
// curling away at the top and embers rising and fading.
float3 fireRamp(float f, float3 BG, float3 A, float3 S) {
    float3 deep = A * float3(0.75, 0.3, 0.15);
    float3 c = mix(BG, deep, smoothstep(0.0, 0.3, f));
    c = mix(c, A, smoothstep(0.3, 0.65, f));
    c = mix(c, mix(A, float3(1.0, 0.92, 0.7), 0.35), smoothstep(0.7, 0.98, f));
    return c + S * 0.05 * smoothstep(0.85, 1.0, f);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float yb = 1.0 - uv.y; // 0 at the bottom edge

    float3 col = mix(BG * 0.9, BG + A * 0.1, smoothstep(0.2, 1.0, uv.y));

    // Heat shimmer bends what is above the fire.
    float2 hz = uv + float2(vnoise(float2(uv.x * 8.0, uv.y * 6.0 + t * 1.5)) - 0.5, 0.0) * 0.012 * smoothstep(0.1, 0.5, yb);

    // Fire: noise stretched upwards and scrolling up, cut off with height.
    float2 fp = float2(hz.x * 5.0, yb * 1.4 - t * 0.7);
    float warp = fbm3(float2(hz.x * 3.0, yb * 1.2 - t * 0.45));
    float n = fbm(fp + float2(warp * 1.6, 0.0));
    // Tongues: columns of different height that flicker.
    float tongue = 0.5 + 0.5 * sin(hz.x * 14.0 + warp * 5.0 + t * 0.6);
    float height = 0.12 + 0.08 * vnoise(float2(uv.x * 1.3 + t * 0.05, 2.0)) + 0.07 * tongue;
    float f = sat(n * 1.5 - yb / height * 0.7 + 0.05);
    f = pow(f, 1.25) * 1.25;
    col = mix(col, fireRamp(sat(f), BG, A, S) * 0.75, smoothstep(0.0, 0.45, f) * 0.85);
    col += A * 0.18 * exp(-yb * 5.0);

    // Smoke: dim, slow, near the top.
    float sm = fbm3(float2(uv.x * 2.0 + t * 0.02, uv.y * 2.5 + t * 0.07));
    col = mix(col, uSurf.rgb * 1.3, smoothstep(0.45, 0.8, sm) * (1.0 - smoothstep(0.0, 0.55, uv.y)) * 0.35);

    // Embers: rising, swaying, fading as they climb.
    float2 eu = uv + float2(sin(uv.y * 7.0 + t * 0.9) * 0.025, 0.0);
    float e1 = dots(eu, 16.0, float2(0.0, t * 1.1), 0.3, 0.08, 2.0);
    float e2 = dots(eu, 30.0, float2(t * 0.15, t * 1.6), 0.25, 0.1, 7.0);
    float fade = smoothstep(0.0, 0.8, uv.y);
    col += (S * e1 * 0.9 + A * e2 * 0.6) * fade;

    return half4(finish(col, fc), 1.0);
}
