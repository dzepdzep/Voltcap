// Constellation: a deep, clear night far from any town. The galaxy's band arcs over the sky - a
// glowing core, dark lanes of dust, tinted clouds of gas - and the whole sky turns very slowly round
// the pole. Bright stars twinkle with soft spikes, two invented constellations trace themselves in
// and fade away, and now and then a meteor streaks past. Below, hills in silhouette, a lone tree
// and a little observatory with its slit open, a dim light inside.

float conLine(float2 uv, float2 a, float2 b, float prog) {
    float2 e = mix(a, b, sat(prog));
    float d = sdSegment(uv, a, e);
    return ((1.0 - smoothstep(0.0, 1.6 / uRes.y, d)) + exp(-d * 400.0) * 0.4) * step(0.001, prog);
}

float2 conPoint(float i, float seed, float2 center) {
    return center + (float2(hash11(i * 7.7 + seed), hash11(i * 3.3 + seed + 1.0)) - 0.5) * float2(0.42, 0.26);
}

// Bright stars with soft cross-shaped spikes (one per cell, a few cells only).
float bigStars(float2 p, float scale, float seed) {
    float2 q = p * scale;
    float2 id = floor(q);
    float2 f = fract(q) - 0.5;
    float2 r = hash22(id + seed);
    if (r.x > 0.18) return 0.0;
    float2 o = (hash22(id + seed + 3.1) - 0.5) * 0.6;
    float2 d = (f - o) / scale;
    float l = length(d);
    float tw = 0.6 + 0.4 * sin(uTime * (1.0 + 2.0 * r.y) + r.x * 50.0);
    float core = exp(-l * uRes.y * 0.45);
    float spike = exp(-abs(d.x) * uRes.y * 0.9) * exp(-abs(d.y) * 60.0) + exp(-abs(d.y) * uRes.y * 0.9) * exp(-abs(d.x) * 60.0);
    return (core + spike * 0.35 + exp(-l * 90.0) * 0.15) * tw * (0.5 + r.y);
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // The sky turns slowly round a pole above the top of the screen.
    float2 pole = float2(asp * 0.5, -0.6);
    float2 sky = pole + rot(t * 0.004) * (uv - pole);

    float3 col = mix(BG * 0.6, BG * 1.5 + S * 0.03, smoothstep(0.0, 0.9, uv.y));
    // Airglow low down.
    col += mix(A, S, 0.6) * 0.05 * exp(-(0.78 - uv.y) * 6.0) * step(uv.y, 0.8);

    // The galaxy: a band across the sky with a brighter core, gas clouds and dust lanes.
    float2 bdir = normalize(float2(1.0, -0.42));
    float2 bc = sky - float2(asp * 0.5, 0.32);
    float across = dot(bc, float2(-bdir.y, bdir.x));
    float along = dot(bc, bdir);
    float warp = 0.05 * fbm3(float2(along * 3.0, 1.0));
    float band = exp(-sqf((across + warp) * 6.5));
    float coreG = exp(-sqf(along * 1.6 - 0.25)) * exp(-sqf((across + warp) * 9.0));
    float gas = fbm(sky * float2(3.0, 3.0) + float2(7.0, 0.0));
    float dust = fbm(float2(along * 6.0, across * 22.0) + 3.0);
    float lanes = smoothstep(0.45, 0.75, dust) * band;
    float3 milky = mix(float3(0.55, 0.6, 0.8), float3(1.0, 0.85, 0.65), coreG);
    float glowG = band * (0.12 + 0.25 * gas) + coreG * 0.35;
    col += milky * glowG * (1.0 - lanes * 0.8) * 0.9;
    col += mix(A, S, 0.3) * band * smoothstep(0.5, 0.85, gas) * 0.10;
    col += float3(0.8, 0.3, 0.45) * coreG * smoothstep(0.55, 0.8, fbm3(sky * 9.0)) * 0.12;
    // Countless faint stars, thickest along the band.
    col += float3(1.0) * dots(sky, 140.0, float2(0.0), 0.35 + 0.5 * band, 0.12, 2.0) * 0.30 * (0.5 + band);
    col += float3(0.95, 0.97, 1.0) * dots(sky, 60.0, float2(0.0), 0.30, 0.09, 5.0) * 0.45;
    // Bright stars with a hint of colour.
    col += mix(float3(0.8, 0.88, 1.0), S, 0.3) * bigStars(sky, 7.0, 11.0);
    col += mix(float3(1.0, 0.85, 0.7), A, 0.2) * bigStars(sky, 4.5, 23.0) * 0.8;

    // Two constellations drawing themselves in turn (each 26 s).
    float3 lines = float3(0.0);
    for (int c = 0; c < 2; c++) {
        float ci = float(c);
        float ph = fract(t / 26.0 + ci * 0.5);
        float2 center = float2(asp * (0.26 + 0.48 * ci), 0.24 + 0.08 * ci);
        float seed = 3.0 + ci * 11.0;
        float vis = smoothstep(0.0, 0.05, ph) * (1.0 - smoothstep(0.42, 0.5, ph));
        for (int k = 0; k < 5; k++) {
            float kk = float(k);
            float2 a = conPoint(kk, seed, center);
            float2 b = conPoint(kk + 1.0, seed, center);
            float prog = (ph - 0.03 - kk * 0.045) / 0.045;
            lines += mix(A, S, 0.4) * conLine(sky, a, b, prog) * vis * 0.45;
            float sd = length(sky - a);
            lines += mix(S, float3(1.0), 0.6) * (exp(-sd * 300.0) + exp(-sd * 60.0) * 0.25) * (0.35 + 0.65 * vis);
        }
        float ld = length(sky - conPoint(5.0, seed, center));
        lines += mix(S, float3(1.0), 0.6) * (exp(-ld * 300.0) + exp(-ld * 60.0) * 0.25) * (0.35 + 0.65 * vis);
    }
    col += lines;

    // A meteor every ~9 s, with a glowing head and a fading train.
    float sk = floor(t / 9.0);
    float sph = t - sk * 9.0;
    if (sph < 1.1) {
        float2 st = float2(asp * (0.2 + 0.7 * hash11(sk * 5.3)), 0.05 + 0.25 * hash11(sk * 2.1));
        float2 dir = normalize(float2(-0.85, 0.42 + 0.2 * hash11(sk)));
        float2 head = st + dir * sph * 0.7;
        float len = 0.25 * sat(sph * 3.0);
        float2 tailP = head - dir * len;
        float d = sdSegment(uv, tailP, head);
        float al = sat(dot(uv - tailP, dir) / max(len, 1e-3));
        float fade = sat(1.0 - sph / 1.1);
        col += mix(S, float3(1.0), 0.7) * (exp(-d * 1100.0) * al * al + exp(-d * 120.0) * 0.12 * al) * fade;
        col += float3(1.0) * exp(-length(uv - head) * 400.0) * fade;
    }

    // Hills in silhouette, two layers, the far one a little lit by the sky.
    float h1 = 0.74 - 0.06 * fbm3(float2(uv.x * 1.6, 2.0)) - 0.02 * vnoise(float2(uv.x * 9.0, 0.0));
    float h2 = 0.82 - 0.07 * smoothstep(0.0, 1.0, sin(uv.x * 1.3 + 0.6) * 0.5 + 0.5) - 0.015 * vnoise(float2(uv.x * 14.0, 5.0));
    col = mix(col, BG * 0.55 + S * 0.015, smoothstep(h1, h1 + px, uv.y));
    // The observatory on the near hill: a drum, a dome, its slit open and lit.
    float ox = asp * 0.74;
    float oy = 0.82 - 0.07 * smoothstep(0.0, 1.0, sin(ox * 1.3 + 0.6) * 0.5 + 0.5);
    float2 oq = uv - float2(ox, oy - 0.035);
    float drum = sdRoundBox(oq, float2(0.04, 0.03), 0.002);
    float dome = length(oq - float2(0.0, -0.03)) - 0.042;
    dome = max(dome, oq.y + 0.03);
    float obs = min(drum, dome);
    float slit = step(abs(oq.x + (oq.y + 0.03) * 0.25), 0.006) * step(dome, 0.0) * step(oq.y, -0.034);
    float near = min(obs, h2 - uv.y);
    // The lone tree on the left: a trunk and a rounded, ragged crown.
    float2 tq = uv - float2(asp * 0.18, 0.8);
    float trunk = sdRoundBox(tq + float2(0.0, 0.035), float2(0.004, 0.04), 0.002);
    float crown = length((tq + float2(0.0, 0.09)) * float2(1.0, 1.25)) - 0.05 - 0.012 * fbm3(tq * 60.0);
    near = min(near, min(trunk, crown));
    // The near hill catches a little skylight along its top.
    float3 nearCol = BG * 0.3 + mix(S, A, 0.3) * 0.03 * exp(-max(uv.y - h2, 0.0) * 30.0);
    col = mix(col, nearCol, smoothstep(px, -px, near));
    col += float3(1.0, 0.78, 0.45) * slit * 0.8;
    col += float3(1.0, 0.75, 0.4) * 0.05 * exp(-length(uv - float2(ox, oy - 0.07)) * 30.0);

    return half4(finish(col, fc), 1.0);
}
