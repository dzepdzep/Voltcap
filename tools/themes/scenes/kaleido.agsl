// Kaleido cover: the song's cover folded into a kaleidoscope where the equalizer is set. The mirrors
// turn slowly, the pattern zooms in on every kick and breathes with the bass, the number of mirrors
// follows the brightness of the music, and a ring of light at the edge carries the spectrum.
//#include reactive

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float k = uIntensity;
    float play = uPlaying;
    float bass = uBass * play;
    float kick = exp(-uBeatAge * 4.0) * play;

    float3 col = coverField(uv, asp, t, bass, 0.45, BG, A, S);
    float s = room(0.26) / 0.26;
    float2 c = float2(waveX(asp), uWaveY);
    float2 d = uv - c;
    float R = 0.24 * s * (1.0 + 0.04 * bass * k);
    float r = length(d);

    // Folding: polar angle wrapped into one mirrored wedge.
    float segs = 8.0 + 2.0 * floor(uHigh * play * 2.0 + 0.5);
    float wedge = TAU / segs;
    float ang = atan(d.y, d.x) + t * 0.12 * (0.4 + 0.6 * play);
    float a = mod(ang, wedge);
    a = abs(a - wedge * 0.5);
    float rr = r / R;
    // Zoom pulses on the kick, a slow spiral drift.
    float zoom = 0.75 - 0.12 * kick * k + 0.05 * sin(t * 0.2);
    float2 q = float2(cos(a), sin(a)) * rr * zoom * 0.5;
    q = rot(t * 0.05) * q;
    // The window into the cover wanders slowly over it, so every part of it gets its turn.
    q += float2(0.5 + 0.22 * sin(t * 0.07), 0.45 + 0.2 * cos(t * 0.09));
    float3 art = float3(uArt.eval(mirrorUv(q) * uArtSize).rgb);
    // A second, smaller fold turning the other way, for depth.
    float2 q2 = rot(-t * 0.08) * float2(cos(a * 2.0), sin(a * 2.0)) * rr * zoom * 0.3 + float2(0.5, 0.5);
    float3 art2 = float3(uArt.eval(mirrorUv(q2) * uArtSize).rgb);
    art = mix(art, art2, 0.3 * smoothstep(0.2, 0.9, rr));
    // A touch more colour: covers are often darker than they look.
    float lum = dot(art, float3(0.299, 0.587, 0.114));
    art = mix(float3(lum), art, 1.35) * 1.15;
    // Without a cover: a palette pattern so the mirrors still have something to show.
    float pat = fbm3(q * 3.0 + t * 0.05);
    float3 noArt = mix(mix(A, S, pat), float3(1.0), smoothstep(0.65, 0.8, pat) * 0.5) * (0.4 + 0.6 * smoothstep(0.3, 0.7, pat));
    float3 kal = mix(noArt, art, uHasArt);
    // Facets: a faint line along each mirror, brighter in the middle.
    float seam = exp(-a * rr * R / px * 0.9) * 0.1 * smoothstep(0.05, 0.4, rr);
    kal += mix(A, float3(1.0), 0.5) * seam;
    kal *= 0.85 + 0.25 * exp(-rr * 2.0) + 0.3 * kick * k * exp(-rr * 3.0);

    float inside = 1.0 - smoothstep(R - px, R + px, r);
    col = mix(col, kal, inside);

    // The spectrum ring around it: thicker where that band is loud, bass at the top.
    float ringAng = atan(d.x, -d.y);
    float m = abs(ringAng) / PI;
    float e = eqAt(m) * play;
    float ringW = (0.004 + 0.03 * e * (0.5 + 0.5 * k)) * s;
    float ring = 1.0 - smoothstep(0.0, px * 2.0, abs(r - R - ringW * 0.5 - 0.006 * s) - ringW * 0.5);
    float3 rc = mix(A, S, m);
    col = mix(col, mix(rc, float3(1.0), 0.25), ring);
    col += rc * exp(-max(r - R, 0.0) * 18.0 / s) * (0.15 + 0.4 * bass * k) * step(R, r);
    // A thin dark frame between picture and ring.
    col = mix(col, BG * 0.3, (1.0 - smoothstep(0.0, px * 1.5, abs(r - R) - 0.0015 * s)) * 0.8);

    // Shards of light flung out on the kick.
    float2 pp = float2((ringAng / TAU + 0.5) * segs * 4.0, log(max(r, 0.001)) * 8.0 - uBeatAge * 5.0);
    float2 pid = floor(pp);
    float2 pf = fract(pp) - 0.5;
    float shard = step(hash12(pid), 0.08) * (1.0 - smoothstep(0.05, 0.15, length(pf * float2(1.0, 0.5))));
    col += mix(A, S, hash12(pid + 1.0)) * shard * kick * k * step(R + 0.02, r) * exp(-(r - R) * 4.0);

    return half4(finish(col, fc), 1.0);
}
