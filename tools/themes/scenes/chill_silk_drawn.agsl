// Silk folds: a sheet of satin draped across the bottom-right corner (and a smaller one in the top-left),
// its soft folds rolling slowly; the light slides along each fold as a long sheen, deep shade in the
// creases, a bright hem at the edge. The middle stays a calm gradient (original design).

// The fabric's height at p (folds running diagonally, slowly moving).
float silkH(float2 p, float t) {
    p *= 2.6;
    float u = p.x * 0.8 + p.y * 0.6;
    float v = -p.x * 0.6 + p.y * 0.8;
    return sin(u * 7.0 + 1.6 * sin(v * 2.4 + t) + t * 0.6) * 0.5
         + sin(u * 12.0 + 2.0 * sin(v * 3.3 - t * 0.8 + 1.0)) * 0.22
         + sin(v * 4.0 + u * 2.0 + t * 0.4) * 0.15;
}

float3 shadeSilk(float2 p, float t, float3 A, float3 S, float3 BG, float hue) {
    float e = 0.004;
    float h = silkH(p, t);
    float hx = (silkH(p + float2(e, 0.0), t) - h) / e;
    float hy = (silkH(p + float2(0.0, e), t) - h) / e;
    float3 n = normalize(float3(-hx * 0.06, -hy * 0.06, 1.0));
    float3 L = normalize(float3(-0.55, -0.6, 0.6));
    float dif = sat(dot(n, L));
    float3 hv = normalize(L + float3(0.0, 0.0, 1.0));
    float spec = pow(sat(dot(n, hv)), 40.0);
    float3 base = mix(A, S, hue);
    float3 c = base * (0.1 + 0.95 * sqf(dif)) + BG * 0.2;
    c += mix(base, float3(1.0), 0.55) * spec * 0.55;
    // Creases are deeper.
    c *= 0.75 + 0.25 * smoothstep(-0.8, 0.4, h);
    return c;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime * 0.12;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    float xr = uv.x / asp;

    float3 col = mix(BG * 1.3, BG * 0.85, sat(uv.y));
    col += mix(A, S, 0.5) * exp(-length(uv - float2(asp * 0.5, 0.45)) * 2.2) * 0.05;

    // Bottom-right sheet: its edge is a soft wavy curve rising to the right.
    float edge1 = 1.1 - 0.62 * sqf(sat(xr * 1.3 - 0.2)) + 0.03 * sin(uv.x * 4.0 + t * 0.8) + 0.015 * sin(uv.x * 9.0 - t);
    float d1 = uv.y - edge1;
    // Its shadow on the backdrop.
    col *= 1.0 - 0.45 * exp(-max(-d1, 0.0) * 18.0) * step(d1, 0.0);
    if (d1 > -0.004) {
        float3 c = shadeSilk(uv, t, A, S, BG, 0.5 + 0.5 * sin(uv.x * 2.2 - uv.y * 3.0 + t * 0.5));
        // The hem: a rolled edge catching light.
        c += mix(mix(A, S, xr), float3(1.0), 0.5) * exp(-d1 * 160.0) * 0.4;
        c *= 0.8 + 0.2 * exp(-d1 * 3.0);
        col = mix(col, c, smoothstep(-0.003, 0.003, d1));
    }

    // Top-left sheet.
    float edge2 = 0.42 * sqf(sat(1.0 - xr * 1.8)) - 0.01 + 0.025 * sin(uv.x * 5.0 - t * 0.9) + 0.012 * sin(uv.x * 11.0 + t);
    float d2 = edge2 - uv.y;
    col *= 1.0 - 0.4 * exp(-max(-d2, 0.0) * 18.0) * step(d2, 0.0);
    if (d2 > -0.004) {
        float3 c = shadeSilk(uv * float2(-1.0, 1.0) + float2(3.0, 0.0), t * 0.9, A, S, BG, 0.5 + 0.5 * sin(uv.x * 3.0 + uv.y * 2.0 - t * 0.4 + 2.0));
        c += mix(S, float3(1.0), 0.5) * exp(-d2 * 160.0) * 0.35;
        col = mix(col, c, smoothstep(-0.003, 0.003, d2));
    }

    return half4(finish(col, fc), 1.0);
}
