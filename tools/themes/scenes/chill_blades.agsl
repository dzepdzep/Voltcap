// Glass blades: a calm console dashboard. Wide curved blades of tinted glass sweep in from the bottom-left
// and the top-right corners, each with a bright polished edge and a soft sheen gliding along it; a few
// glassy orbs float near them and a soft light breathes behind. The middle stays clear (original design).

// One glass blade: the crescent inside circle (ca, ra) and outside circle (cb, rb). Returns its glass
// colour (rgb) and coverage (a) at p, lit by a sheen that runs along it.
float4 blade(float2 p, float2 ca, float ra, float2 cb, float rb, float3 tint, float sheenPos, float seed) {
    float da = length(p - ca) - ra;
    float db = length(p - cb) - rb;
    float inside = smoothstep(0.004, -0.004, da) * smoothstep(-0.004, 0.004, db);
    // Thickness across the blade: 0 at the outer edge, 1 at the inner one.
    float th = sat(-da / max(-da + db, 1e-4));
    // Where along the arc this point sits (angle round circle a).
    float2 v = normalize(p - ca);
    float ang = atan(v.y, v.x);
    float sheen = exp(-sqf((ang - sheenPos) * 3.2));
    float3 glass = tint * (0.10 + 0.55 * sqf(1.0 - th)) + float3(1.0) * sheen * sqf(1.0 - th) * 0.35;
    // A faint ripple of streaks inside the glass.
    glass += tint * 0.05 * smoothstep(0.6, 1.0, vnoise(float2(ang * 18.0 + seed, th * 3.0)));
    float edge = exp(-abs(da) * 520.0) * (0.55 + 0.9 * sheen) * smoothstep(-0.02, 0.03, db);
    float inner = exp(-abs(db) * 700.0) * 0.25 * smoothstep(0.03, -0.02, da);
    float a = inside * (0.35 + 0.5 * (1.0 - th));
    float3 c = glass + mix(tint, float3(1.0), 0.45) * (edge + inner);
    float halo = exp(-max(da, 0.0) * 22.0) * smoothstep(-0.05, 0.1, db);
    c += tint * halo * 0.07 * (1.0 - inside);
    return float4(c, max(a, sat(edge + inner + halo * 0.5)));
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime * 0.05;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Backdrop: deep colour, a large soft light breathing behind the left blades and a cooler one top-right.
    float3 col = BG;
    float2 l1 = uv - float2(asp * 0.18, 0.92);
    float2 l2 = uv - float2(asp * 0.9, 0.08);
    float breathe = 0.85 + 0.15 * sin(uTime * 0.21);
    col += A * exp(-dot(l1, l1) * 1.6) * 0.30 * breathe;
    col += mix(A, float3(1.0), 0.4) * exp(-dot(l1, l1) * 9.0) * 0.12 * breathe;
    col += mix(A, S, 0.6) * exp(-dot(l2, l2) * 3.0) * 0.12;
    col += BG * 0.5 * smoothstep(1.0, 0.0, uv.y);
    // Fine diagonal light lines across the back, very faint.
    float diag = uv.x * 0.55 + uv.y;
    col += A * smoothstep(0.985, 1.0, sin(diag * 70.0 + t * 2.0)) * 0.02 * smoothstep(0.2, 1.0, abs(uv.y - 0.5) * 2.0);

    // Blades from the bottom-left, three layers sliding slowly.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float wob = sin(t * (0.9 + fi * 0.3) + fi * 2.1);
        float2 ca = float2(asp * (0.05 + 0.06 * fi), 1.92 - 0.04 * fi + 0.015 * wob);
        float ra = 1.02 + 0.05 * fi;
        float2 cb = ca + float2(0.05 + 0.03 * fi + 0.02 * wob, 0.11 + 0.02 * fi);
        float3 tint = mix(mix(A, float3(1.0), 0.15), mix(S, A, 0.4), fi / 2.0);
        float sheenPos = -1.3 + 0.55 * sin(t * 1.3 + fi * 1.7);
        float4 b = blade(uv, ca, ra, cb, ra + 0.02, tint, sheenPos, fi * 9.0);
        col = mix(col, col * 0.75 + b.rgb, b.a);
    }
    // Blades from the top-right.
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float wob = sin(t * (1.1 + fi * 0.4) + fi * 1.3 + 2.0);
        float2 ca = float2(asp * (0.98 - 0.05 * fi), -0.92 + 0.04 * fi + 0.015 * wob);
        float ra = 1.0 + 0.04 * fi;
        float2 cb = ca + float2(-0.05 - 0.03 * fi + 0.02 * wob, -0.10 - 0.02 * fi);
        float3 tint = mix(mix(A, float3(1.0), 0.25), S, 0.3 + 0.4 * fi);
        float sheenPos = 1.95 + 0.5 * sin(t * 1.1 + fi * 2.3 + 1.0);
        float4 b = blade(uv, ca, ra, cb, ra + 0.02, tint, sheenPos, fi * 5.0 + 3.0);
        col = mix(col, col * 0.8 + b.rgb * 0.85, b.a * 0.85);
    }

    // Glass orbs floating near the blades (never in the middle).
    for (int i = 0; i < 7; i++) {
        if (uLod > 1.5 && i > 3) break;
        float fi = float(i);
        float side = step(3.5, fi);
        float2 home = mix(float2(asp * (0.05 + 0.08 * fi), 0.7 + 0.07 * fi),
                          float2(asp * (1.0 - 0.07 * (fi - 4.0)), 0.06 + 0.08 * (fi - 4.0)), side);
        float2 o = home + float2(sin(uTime * 0.05 + fi * 1.9), cos(uTime * 0.043 + fi * 2.7)) * 0.03;
        float rr = 0.012 + 0.022 * hash11(fi * 3.7 + 1.0);
        float2 q = uv - o;
        float d = length(q);
        float body = smoothstep(rr, rr - 0.002, d);
        float3 oc = mix(A, S, hash11(fi + 4.0));
        float rimL = exp(-abs(d - rr) * 900.0 / (rr * 30.0));
        float spec = exp(-length(q - float2(-0.35, -0.4) * rr) * 140.0 / (rr * 30.0));
        col = mix(col, col * 0.85 + oc * 0.08, body * 0.6);
        col += mix(oc, float3(1.0), 0.5) * (rimL * 0.25 + spec * 0.55 * body);
    }

    return half4(finish(col, fc), 1.0);
}
