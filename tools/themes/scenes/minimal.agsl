// Mono / Minimal console: a light sculpture in an endless dark room. Three thin rings of light turn
// slowly inside each other like a gyroscope, floating over a black mirror floor that reflects them,
// and a perspective grid of dots fades away to the horizon. Now and then a soft beam sweeps round the
// floor and lights the dots it passes. Everything else stays pure black (OLED friendly).

// Distance (in screen units) from p to the ellipse c + U cos a + V sin a (a projected circle): a few
// Newton steps on the angle, which stays right even when the ring is seen almost edge-on.
float2 ellipseD(float2 p, float2 c, float2 U, float2 V) {
    float2 d = p - c;
    float det = U.x * V.y - U.y * V.x;
    float sd = abs(det) > 1e-5 ? det : (det < 0.0 ? -1e-5 : 1e-5);
    float2 q = float2(V.y * d.x - V.x * d.y, -U.y * d.x + U.x * d.y) / sd;
    float a = atan(q.y, q.x);
    float best = 1e3;
    float bestA = a;
    for (int i = 0; i < 5; i++) {
        float ca = cos(a);
        float sa = sin(a);
        float2 P = U * ca + V * sa - d;
        float dist = length(P);
        if (dist < best) { best = dist; bestA = a; }
        float2 P1 = V * ca - U * sa;
        float2 P2 = -U * ca - V * sa;
        float f = dot(P, P1);
        float fp = max(dot(P1, P1) + dot(P, P2), dot(P1, P1) * 0.3 + 1e-6);
        a -= clamp(f / fp, -0.6, 0.6);
    }
    float last = length(U * cos(a) + V * sin(a) - d);
    if (last < best) { best = last; bestA = a; }
    return float2(best, bestA);
}

// Projects point w with the camera (ro, basis) to screen units (heights). z = depth.
float3 proj(float3 w, float3 ro, float3 fw, float3 rt, float3 up, float fov) {
    float3 v = w - ro;
    float z = dot(v, fw);
    return float3(dot(v, rt), dot(v, up), z) / float3(z * fov, z * fov, 1.0);
}

// Glow of ring i (centre c, radius r, tilted by its own spin) as seen on screen at sp.
float ring(float2 sp, float3 c, float r, float a, float b, float mirror, float3 ro, float3 fw, float3 rt, float3 up, float fov, float px) {
    float3 u = float3(cos(a), 0.0, sin(a));
    float3 v = float3(-sin(a) * sin(b), cos(b), cos(a) * sin(b));
    float3 cc = c;
    if (mirror > 0.5) { cc.y = -cc.y; u.y = -u.y; v.y = -v.y; }
    float3 pc = proj(cc, ro, fw, rt, up, fov);
    float3 pu = proj(cc + u * r, ro, fw, rt, up, fov);
    float3 pv = proj(cc + v * r, ro, fw, rt, up, fov);
    float2 e = ellipseD(sp, pc.xy, pu.xy - pc.xy, pv.xy - pc.xy);
    float d = e.x;
    float soft = 1.0 + mirror * 4.0;
    // A brighter glint travels round each ring.
    float glint = 0.7 + 0.9 * exp(-sqf(abs(mod(e.y - uTime * 0.9 - a * 3.0 + PI, TAU) - PI)) * 3.0);
    return ((1.0 - smoothstep(0.6 * px * soft, 1.8 * px * soft, d)) * (1.0 - mirror * 0.6) + exp(-d / (0.012 * soft)) * 0.35) * glint + exp(-d / (0.06 * soft)) * 0.08;
}

half4 main(float2 fc) {
    float t = uTime;
    float2 sp = (fc - 0.5 * uRes) / uRes.y;
    sp.y = -sp.y;
    float px = 1.0 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float3 ro = float3(0.45 * sin(t * 0.04), 1.30 + 0.06 * sin(t * 0.05), 3.4);
    float3 ta = float3(0.0, 0.70, 0.0);
    float3 fw = normalize(ta - ro);
    float3 rt = normalize(cross(fw, float3(0.0, 1.0, 0.0)));
    float3 up = cross(rt, fw);
    float fov = 0.62;
    float3 rd = normalize(fw + fov * (sp.x * rt + sp.y * up));

    float3 col = BG;

    // The floor: a mirror-black plane with a grid of dots fading towards the horizon.
    if (rd.y < 0.0) {
        float tf = -ro.y / rd.y;
        float2 f = ro.xz + rd.xz * tf;
        float2 g = f * 2.2;
        float2 gp = fract(g) - 0.5;
        float size = clamp(tf * 0.004 * uRes.y / 540.0, 0.02, 0.2);
        float dotM = 1.0 - smoothstep(0.03, 0.03 + size, length(gp));
        float fade = exp(-tf * 0.16) * smoothstep(0.0, 0.3, -rd.y * 3.0);
        // The beam: a slow turn round the sculpture, every 14 s.
        float ang = atan(f.y, f.x);
        float beamA = t * TAU / 14.0;
        float da = abs(mod(ang - beamA + PI, TAU) - PI);
        float beam = exp(-da * da * 30.0) * exp(-length(f) * 0.25);
        col += S * dotM * fade * 0.16;
        col += A * dotM * beam * 0.9 * fade * 1.5;
        col += A * beam * fade * 0.025;
        // A soft pool of light under the rings.
        col += A * 0.05 * exp(-length(f - float2(0.0, 0.0)) * 2.2) * fade;
    }

    // Three rings, nested, each turning on its own axis; and their reflections in the floor.
    float3 c = float3(0.0, 1.0 + 0.05 * sin(t * 0.6), 0.0);
    float glowSum = 0.0;
    float refl = 0.0;
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float r = 0.62 - fi * 0.16;
        float a = t * (0.11 + fi * 0.05) + fi * 1.9;
        float b = 1.2 + 0.5 * sin(t * (0.07 + fi * 0.03) + fi * 2.0);
        glowSum += ring(sp, c, r, a, b, 0.0, ro, fw, rt, up, fov, px) * (1.0 - fi * 0.18);
        if (rd.y < 0.0) refl += ring(sp, c, r, a, b, 1.0, ro, fw, rt, up, fov, px) * (1.0 - fi * 0.18);
    }
    // The core: a small bright point that breathes.
    float3 pc = proj(c, ro, fw, rt, up, fov);
    float cd = length(sp - pc.xy);
    float core = exp(-cd / 0.006) + exp(-cd / 0.03) * 0.25 * (0.8 + 0.2 * sin(t * 1.3));
    float3 ringCol = mix(A, S, 0.25);
    col += ringCol * glowSum + A * core;
    // Reflections fade with distance from the floor line.
    col += ringCol * refl * 0.30;

    // A few motes of dust in the light.
    float mote = dots(sp + float2(t * 0.003, 0.0), 30.0, float2(0.0, -t * 0.02), 0.25, 0.05, 3.0);
    col += S * mote * 0.18 * exp(-length(sp - pc.xy) * 2.5);

    return half4(finish(col, fc), 1.0);
}
