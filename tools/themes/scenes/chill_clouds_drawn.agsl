// Above the clouds: dawn seen from a mountain top. A sea of clouds fills the bottom of the screen, rolling
// slowly, lit gold by a sun rising at the right corner; two rocky peaks break through it in the bottom-left,
// their snow catching the first light, and the sky fades from night blue to warm (original design).

// Billowy cloud density: folded noise gives round puffs with creases between them.
float billow(float2 p) {
    float v = 0.0;
    float a = 0.55;
    for (int i = 0; i < 4; i++) {
        if (uLod > 1.5 && i > 2) break;
        v += a * abs(2.0 * vnoise(p) - 1.0);
        p = p * 2.1 + float2(3.7, 1.9);
        a *= 0.5;
    }
    return 1.0 - v;
}

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;      // sunrise
    float3 S = uSec.rgb;      // sky blue
    float3 BG = uBg.rgb;

    float hz = 0.74;
    float2 sun = float2(asp * 0.86, hz - 0.1);
    // Sky.
    float3 col = mix(BG * 1.2, mix(S, BG, 0.4) * 0.9, smoothstep(0.0, 0.45, uv.y));
    col = mix(col, mix(A, float3(1.0, 0.85, 0.7), 0.2) * 0.42, smoothstep(0.35, hz, uv.y) * 0.75);
    float sd = length((uv - sun) * float2(0.55, 1.0));
    col += A * exp(-sd * 2.6) * 0.32;
    col += float3(1.0, 0.95, 0.85) * exp(-sd * 18.0) * 0.6;
    col = mix(col, float3(1.4, 1.3, 1.15), smoothstep(0.034, 0.03, length(uv - sun)));
    col += float3(1.0, 0.85, 0.65) * exp(-length(uv - sun) * 22.0) * 0.5;
    col += float3(1.0, 0.85, 0.6) * exp(-abs(uv.y - sun.y) * 90.0) * exp(-abs(uv.x - sun.x) * 3.0) * 0.25;
    col += float3(0.9, 0.95, 1.0) * dots(uv, 55.0, float2(0.0), 0.12, 0.06, 2.0) * 0.5 * smoothstep(0.3, 0.0, uv.y) * smoothstep(asp * 0.5, 0.0, uv.x);
    // High thin streaks catching the sun.
    float hs = fbm(float2(uv.x * 0.8 + t * 0.003, uv.y * 12.0));
    col += mix(A, float3(1.0), 0.3) * smoothstep(0.58, 0.8, hs) * exp(-sqf((uv.y - 0.3) / 0.12)) * smoothstep(asp * 0.3, asp, uv.x) * 0.12;

    // Peaks in the bottom-left, above the clouds.
    float x = uv.x / asp;
    float pk = 0.98 - 0.42 * exp(-sqf((x - 0.12) / 0.09)) - 0.3 * exp(-sqf((x - 0.27) / 0.07));
    pk += 0.012 * (vnoise(float2(uv.x * 30.0, 1.0)) - 0.5) + 0.006 * (vnoise(float2(uv.x * 90.0, 3.0)) - 0.5);
    if (uv.y > pk) {
        float e = 0.01;
        float pkL = 0.98 - 0.42 * exp(-sqf((x - e - 0.12) / 0.09)) - 0.3 * exp(-sqf((x - e - 0.27) / 0.07));
        float pkR = 0.98 - 0.42 * exp(-sqf((x + e - 0.12) / 0.09)) - 0.3 * exp(-sqf((x + e - 0.27) / 0.07));
        float slope = (pkR - pkL) / (2.0 * e);
        // The sun is to the right: faces rising to the left (descending right) are lit.
        float lit = sat(0.5 + slope * 0.45 + 0.3 * (fbm3(uv * float2(30.0, 12.0)) - 0.5));
        float depth = uv.y - pk;
        float snow = smoothstep(0.1, 0.03, depth + 0.06 * fbm3(uv * 20.0)) * smoothstep(0.25, 0.6, lit + 0.3 * vnoise(uv * 40.0));
        float3 rock = mix(BG * 0.7 + S * 0.05, mix(A, float3(0.55, 0.42, 0.38), 0.5) * 0.38, lit * 0.8) * (0.8 + 0.35 * fbm3(uv * float2(40.0, 25.0)));
        float3 snowC = mix(mix(S, BG, 0.4) * 0.55, mix(A, float3(1.0), 0.45) * 0.85, lit);
        col = mix(rock, snowC, snow);
        col += A * exp(-depth * 300.0) * lit * 0.25;
    }

    // The sea of clouds: soft layers of puffy cloud tops, far (warm, hazy) to near (big, blue in shade).
    float sunNear = exp(-abs(uv.x - sun.x) * 0.85);
    for (int r = 0; r < 5; r++) {
        float fr = float(r);
        float sc = 1.0 + fr * 0.7;
        float yRow = hz + 0.02 + 0.045 * fr * (1.0 + 0.3 * fr);
        float u = uv.x * 2.6 / sc + t * 0.012 / sc + fr * 5.1;
        // Puffy profile: rounded bumps from folded noise.
        float n1 = billow(float2(u, fr * 3.7));
        float n2 = billow(float2(u + 0.08, fr * 3.7));
        float topY = yRow - sc * 0.05 * n1;
        float slope = (billow(float2(u + 0.08, fr * 3.7)) - billow(float2(u - 0.08, fr * 3.7))) / 0.16;
        if (uv.y > topY - 0.01 * sc) {
            float dy = (uv.y - topY) / sc;
            // The top faces the sun (right) where the profile rises to the right.
            float face = sat(0.5 + slope * 0.6);
            float3 litC = mix(A, float3(1.0, 0.93, 0.85), 0.4) * (0.7 + 0.6 * sunNear);
            float3 midC = mix(mix(S, A, 0.3), BG, 0.2) * 0.8;
            float3 deepC = mix(S, BG, 0.5) * 0.55;
            float rimW = 0.012 + 0.012 * billow(float2(u * 3.0, fr));
            float3 cc = mix(midC, litC, exp(-dy / rimW) * (0.3 + 0.7 * face));
            cc = mix(cc, deepC, smoothstep(0.015, 0.07, dy));
            // Inner puffs: lighter bumps inside the layer.
            float inner = billow(float2(u * 2.5 + 3.0, dy * 18.0 + fr));
            cc *= 0.85 + 0.25 * inner;
            // Far layers melt into the warm haze at the horizon.
            float haze = (1.0 - fr / 4.0);
            cc = mix(cc, mix(A, S, 0.45) * 0.62 + BG * 0.2, haze * haze * 0.55);
            col = mix(col, cc, smoothstep(-0.004 * sc, 0.005 * sc, uv.y - topY));
            col += mix(A, float3(1.0), 0.4) * exp(-abs(uv.y - topY) / (0.004 * sc)) * face * sunNear * 0.25 * (1.0 - fr / 5.0);
        }
    }

    return half4(finish(col, fc), 1.0);
}
