// Umbra (dark type): a city at the hour of an eclipse. A black sun hangs in a ring of corona with slow
// flares; stars show through the false night; shadow smoke rises between the rooftops with faint rims
// of light; a few windows still burn; crows circle the eclipse, and pairs of eyes open and blink in the
// dark alleys below.

half4 main(float2 fc) {
    float2 uv = fc / uRes.y;
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float px = 1.5 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float3 col = mix(BG * 0.6, BG * 1.4 + A * 0.05, smoothstep(0.0, 0.9, uv.y));
    col += float3(1.0) * dots(uv, 90.0, float2(0.0), 0.2, 0.04, 1.0) * 0.5 * smoothstep(0.7, 0.1, uv.y);

    // The eclipse: a black disc, a corona with streamers turning slowly, a diamond-ring glint.
    float2 ep = float2(asp * 0.66, 0.26);
    float er = 0.09;
    float2 eq = uv - ep;
    float ed = length(eq);
    float ea = atan(eq.y, eq.x);
    float streams = 0.55 + 0.45 * fbm(float2(ea * 2.0 + t * 0.02, ed * 6.0 - t * 0.05));
    float3 corona = mix(mix(S, float3(1.0), 0.5), A, 0.25);
    col += corona * exp(-(ed - er) * 22.0 / streams) * step(er, ed) * 0.9;
    col += corona * exp(-(ed - er) * 6.0) * step(er, ed) * 0.18;
    // A flare loop lifting off the rim now and then.
    float fa = floor(t / 7.0) * 2.3;
    float2 fp = ep + float2(cos(fa), sin(fa)) * er;
    float flare = exp(-abs(length(uv - fp) - 0.018) * 400.0) * step(er, ed) * smoothstep(0.0, 1.0, sin(fract(t / 7.0) * PI));
    col += mix(A, float3(1.0, 0.6, 0.5), 0.5) * flare * 0.8;
    col = mix(col, BG * 0.15, 1.0 - smoothstep(er - px, er + px, ed));
    float ga = 0.6 + t * 0.03;
    col += float3(1.0) * exp(-length(uv - ep - float2(cos(ga), sin(ga)) * er) * 180.0) * (0.6 + 0.4 * sin(t * 1.5));

    // Crows circling the eclipse.
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float a = t * (0.18 + 0.04 * fi) + fi * 1.3;
        float2 bp = ep + float2(cos(a) * (0.2 + 0.06 * fi), sin(a) * (0.06 + 0.02 * fi) + 0.02 * sin(a * 3.0));
        float2 q = uv - bp;
        q.x *= sign(-sin(a));
        float flap = sin(t * 6.0 + fi * 2.0);
        float wing = abs(q.y + abs(q.x) * (0.5 * flap) - sqf(q.x / 0.014) * 0.003) - 0.0015;
        float crow = (1.0 - smoothstep(0.0, px, wing)) * step(abs(q.x), 0.014);
        crow = max(crow, 1.0 - smoothstep(0.0, px, length(q * float2(0.8, 1.4)) - 0.004));
        col = mix(col, BG * 0.1, crow);
    }

    // Rooftops: two rows of blocks, with chimneys, spires and some lit windows.
    for (int r = 0; r < 2; r++) {
        float fr = float(r);
        float w = 0.09 + 0.04 * fr;
        float x = uv.x / w + fr * 0.5;
        float id = floor(x);
        float lx = fract(x);
        float h = 0.52 + 0.12 * fr + 0.12 * hash11(id + fr * 9.0);
        float spire = step(0.8, hash11(id * 3.1 + fr)) * max(0.0, 0.08 - abs(lx - 0.5) * 0.4);
        float chim = step(0.5, hash11(id * 5.7 + fr)) * step(abs(lx - 0.25), 0.05) * 0.03;
        float top = h - spire - chim;
        float m = step(top, uv.y);
        float3 bc = BG * (0.18 + 0.12 * fr) + A * 0.02;
        // Windows: a few warm ones.
        float2 wg = float2(lx * 5.0, (uv.y - h) * 50.0);
        float2 wid = floor(wg);
        float win = step(0.3, fract(wg.x)) * step(fract(wg.x), 0.7) * step(0.35, fract(wg.y)) * step(fract(wg.y), 0.75) * step(h + 0.02, uv.y);
        float on = step(0.93, hash12(wid + id * 13.0 + fr * 7.0));
        bc += mix(float3(1.0, 0.7, 0.35), S, 0.3) * win * on * 0.7;
        col = mix(col, bc, m);
    }

    // Shadow smoke rising between the roofs: dark, with a faint rim where it catches the corona.
    float sm = fbm(float2(uv.x * 2.5 + sin(uv.y * 3.0 + t * 0.1) * 0.3, uv.y * 2.5 + t * 0.06));
    float smM = smoothstep(0.5, 0.75, sm) * smoothstep(0.3, 0.75, uv.y);
    float rim = smoothstep(0.5, 0.55, sm) * (1.0 - smoothstep(0.55, 0.62, sm)) * smoothstep(0.3, 0.75, uv.y);
    col = mix(col, BG * 0.08, smM * 0.75);
    col += mix(mix(S, float3(1.0), 0.5), A, 0.25) * rim * 0.05;

    // Eyes in the alleys: pairs that open, glance and blink.
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float cyc = fract(t * 0.09 + hash11(fi * 7.3));
        float open = smoothstep(0.0, 0.08, cyc) * (1.0 - smoothstep(0.32, 0.4, cyc));
        open *= 1.0 - step(0.18, cyc) * step(cyc, 0.2);
        float2 p = float2((hash11(fi * 3.1) * 0.9 + 0.05) * asp, 0.8 + 0.12 * hash11(fi * 5.3));
        float2 q = uv - p;
        q.x = abs(q.x) - 0.012;
        float eye = length(q * float2(1.0, 1.0 / max(open, 0.05))) - 0.0045;
        float3 ec = mix(A, float3(1.0, 0.9, 0.3), 0.4);
        col += ec * (1.0 - smoothstep(0.0, px, eye)) * open * 1.2 + ec * exp(-length(q) * 120.0) * open * 0.2;
    }
    return half4(finish(col, fc), 1.0);
}
