// Gale · 32-bit (flying type): high above the clouds. Layers of pixel cloud race past at different
// speeds, a floating island drifts by with a waterfall spilling off it, a flock flaps along in a V and
// wind streaks whip across the sky.
//#include pixel

half4 main(float2 fc) {
    float2 cell = pxCell(fc);
    float2 uv = pxUv(cell);
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    float3 col = mix(mix(float3(0.2, 0.45, 0.85), A * 0.5 + 0.1, 0.25), mix(float3(0.75, 0.88, 1.0), S, 0.2), pxBand(uv.y * 1.3, 5.0, cell));
    // Sun high up.
    float sd = length(uv - float2(asp * 0.82, 0.12));
    col = mix(col, float3(1.0, 0.97, 0.85), step(sd, 0.05));
    col = mix(col, mix(col, float3(1.0, 0.95, 0.8), 0.4), step(sd, 0.09) * step(0.5, mod(cell.x + cell.y, 2.0)));
    // Three cloud layers: far (slow, small) to near (fast, big), each lit on top.
    for (int l = 0; l < 3; l++) {
        float fl = float(l);
        float speed = 0.02 + fl * 0.05;
        float scale = 3.0 - fl * 0.8;
        float baseY = 0.55 + fl * 0.15;
        float2 p = float2((uv.x + t * speed) * scale, uv.y * 6.0);
        float puffs = abs(sin(p.x * 3.1 + fl)) * 0.06 + abs(sin(p.x * 1.3 + fl * 2.0)) * 0.08 + abs(sin(p.x * 7.3 + fl * 5.0)) * 0.02;
        float top = baseY - puffs * (0.7 + 0.3 * fl);
        if (uv.y > top) {
            float lit = 1.0 - sat((uv.y - top) * 10.0);
            float3 shade = mix(mix(float3(0.65, 0.72, 0.9), S, 0.15), float3(0.85, 0.9, 1.0), fl / 2.0);
            col = mix(shade * (0.85 + 0.05 * fl), float3(1.0), pxBand(lit, 2.0, cell));
        }
        if (l == 0) {
            // The floating island sits between the far and middle clouds.
            float ix = fract(0.55 - t * 0.008) * (asp + 0.8) - 0.4;
            float2 q = (uv - float2(ix, 0.3 + 0.01 * sin(t * 0.6))) / 1.7;
            float topIs = step(-0.012, q.y) * step(q.y, 0.0) * step(abs(q.x), 0.13);
            float rock = step(0.0, q.y) * step(q.y, 0.12 - abs(q.x) * 0.9) * step(abs(q.x), 0.13);
            col = mix(col, mix(float3(0.45, 0.32, 0.25), float3(0.6, 0.45, 0.32), step(0.5, fract(q.y * 50.0 + q.x * 10.0))), rock);
            col = mix(col, mix(float3(0.3, 0.65, 0.3), A, 0.1), topIs);
            // A tree and a little shrine on it.
            col = mix(col, float3(0.25, 0.55, 0.25), step(length(q - float2(-0.06, -0.04)), 0.03));
            col = mix(col, float3(0.4, 0.28, 0.2), pxBox(q, float2(-0.06, -0.015), float2(PX * 0.8, 0.015)));
            col = mix(col, float3(0.9, 0.88, 0.8), pxBox(q, float2(0.05, -0.022), float2(0.015, 0.01)));
            col = mix(col, mix(float3(0.8, 0.3, 0.25), A, 0.3), step(-0.045 + abs(q.x - 0.05) * 0.8, q.y) * step(q.y, -0.032) * step(abs(q.x - 0.05), 0.022));
            // The waterfall off its edge, breaking into mist.
            float wf = step(abs(q.x - 0.1), 0.006) * step(0.0, q.y) * step(q.y, 0.25);
            col = mix(col, mix(float3(0.7, 0.9, 1.0), float3(1.0), step(0.5, fract(q.y * 40.0 - t * 4.0))), wf * (1.0 - smoothstep(0.15, 0.25, q.y)));
        }
    }
    // A flock in a V, flapping.
    float2 lead = float2(fract(t * 0.03) * (asp + 0.6) - 0.3, 0.25 + 0.02 * sin(t * 0.5));
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        float rank = floor((fi + 1.0) * 0.5);
        float side = mod(fi, 2.0) < 0.5 ? 1.0 : -1.0;
        float2 b = pxSnap(lead - float2(rank * 0.03, -side * rank * 0.02));
        float2 q = (uv - b) / PX;
        float f = sin(t * 9.0 + fi * 0.8);
        float wing = step(abs(q.x), 3.5) * step(abs(q.y - abs(q.x) * 0.5 * f), 0.7);
        col = mix(col, mix(float3(0.15, 0.17, 0.25), BG, 0.3), sat(wing + step(length(q - float2(0.8, 0.0)), 1.0)));
    }
    // Wind streaks.
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float y = 0.1 + 0.8 * hash11(fi * 3.7);
        float x = fract(hash11(fi) - t * (0.25 + 0.15 * hash11(fi * 2.0))) * (asp + 0.6) - 0.3;
        float len = 0.1 + 0.1 * hash11(fi * 5.0);
        float on = step(abs(uv.y - y - 0.01 * sin((uv.x - x) * 20.0)), PX * 0.5) * step(x, uv.x) * step(uv.x, x + len) * step(0.4, fract((uv.x - x) * 25.0));
        col = mix(col, float3(1.0), on * 0.8);
    }
    col = pxQuant(col, 10.0, cell);
    return half4(finish(col, fc), 1.0);
}
