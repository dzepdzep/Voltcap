// Aurora: the northern lights over a frozen lake at night. Four curtains of light hang at different
// depths - each a bright, sharp lower hem with fine rays streaming up from it, green near the hem
// turning violet at the top, waving and rippling slowly while bright patches travel along them.
// Behind them a deep sky full of stars; in front, two ranges of snowy mountains catching the green
// light, a dark pine shore, and the whole sky mirrored in the lake's black ice, broken by soft
// ripples, patches of frost and thin cracks.

const float HZ = -0.14;   // the horizon (y up, 0 = middle of the screen, in screen heights)

// Height of curtain i's hem at x: a slow S-shaped wave with folds travelling along it.
float hemAt(float x, float fi, float t) {
    float base = mix(0.13, -0.03, fi / 3.0);
    float amp = mix(0.085, 0.03, fi / 3.0);
    float sx = x * (1.0 + fi * 0.3) + fi * 3.7;
    float w = fbm3(float2(sx * 0.7 + t * 0.015, fi * 5.1 + t * 0.01));
    float s = sin(sx * 2.1 + w * 5.0 + t * 0.05 + fi * 1.3);
    float fold = sin(sx * 6.5 - t * 0.12 + w * 3.0) * 0.18;
    return base + amp * (s + fold + (w - 0.5) * 1.2);
}

// Light of all curtains at p (y up). blur > 0 softens the rays (the reflection in the ice).
float3 curtains(float2 p, float t, float3 A, float3 S, float blur) {
    float3 acc = float3(0.0);
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float near = 1.0 - fi / 3.0;            // 1 = the nearest (highest, tallest) curtain
        float hem = hemAt(p.x, fi, t);
        float tall = mix(0.1, 0.3, near);
        // Each curtain is a separate arc: it thins out and breaks in places along its length.
        float there = smoothstep(0.28, 0.62, vnoise(float2(p.x * 0.9 + fi * 7.7 + t * 0.01, fi * 2.0)));
        if (there <= 0.0) continue;
        float d = (p.y - hem) / tall;           // 0 at the hem, 1 at the top
        if (d < -0.35 || d > 1.6) continue;
        // Rays: thin vertical streaks, leaning a little with the fold, drifting along the curtain.
        float lean = (p.y - hem) * (0.35 + 0.25 * sin(p.x * 2.0 + fi));
        float rx = p.x + lean;
        float f1 = vnoise(float2(rx * mix(70.0, 120.0, fi / 3.0) + t * 0.35, fi * 13.0 + t * 0.05));
        float f2 = vnoise(float2(rx * 22.0 - t * 0.12, fi * 7.0));
        float rays = mix(0.25 + 0.75 * f1 * f1, 0.55 + 0.45 * f2, 0.35 + 0.5 * blur);
        rays *= 0.55 + 0.45 * f2;
        // Bright patches travelling slowly along each curtain.
        float patch = 0.35 + 0.95 * smoothstep(0.35, 0.8, vnoise(float2(p.x * 2.2 - t * 0.07 * (1.0 + fi * 0.3), fi * 3.3)));
        // Profile: a crisp, bright hem; the light fades upward with the rays; a thin glow just under the hem.
        float edge = 0.012 / tall + blur * 0.05;
        float prof = smoothstep(-edge, edge * 0.5, d) * exp(-max(d, 0.0) * mix(3.2, 2.2, near));
        prof += exp(-abs(d) * 22.0) * 0.6;            // the hem line itself
        prof += exp(min(d, 0.0) * 14.0) * step(d, 0.0) * 0.12; // faint glow below
        float3 hemC = mix(A, float3(0.85, 1.0, 0.92), 0.45);
        float3 c = mix(hemC, A, smoothstep(0.0, 0.25, d));
        c = mix(c, S * 1.15, smoothstep(0.22, 0.85, d));
        // The farther curtains are fainter and a little hazier.
        float k = mix(0.45, 1.0, near);
        acc += c * prof * rays * patch * k * there * 1.5;
        // Each curtain lights the sky around it a little.
        acc += mix(A, S, 0.4) * exp(-abs(d - 0.3) * 2.0) * 0.04 * k * patch * there;
    }
    return acc;
}

// Sky above the horizon: deep blue, lighter and greener towards the horizon, stars and a faint haze band.
float3 skyAt(float2 p, float t, float3 A, float3 S, float3 BG, float refl) {
    float h = p.y - HZ;
    float3 top = BG * 0.55 + float3(0.004, 0.008, 0.02);
    float3 low = mix(BG * 1.6 + float3(0.015, 0.03, 0.05), A * 0.12 + float3(0.02, 0.03, 0.05), 0.35);
    float3 c = mix(low, top, sat(h * 1.7));
    // Stars, fewer and dimmer near the horizon (and in the ice).
    float2 sp = p * float2(1.0, 1.0) + float2(t * 0.0015, 0.0);
    float st = dots(sp, 90.0, float2(0.0), 0.28, 0.06, 3.0) * 0.55 + dots(sp, 34.0, float2(0.0), 0.11, 0.055, 9.0) * 0.9;
    c += float3(0.85, 0.92, 1.0) * st * smoothstep(0.02, 0.25, h) * (1.0 - 0.7 * refl);
    // A faint band of the galaxy behind it all.
    float band = exp(-sqf((p.y - 0.28 - p.x * 0.25) * 4.5)) * fbm3(p * float2(4.0, 9.0) + 2.0);
    c += float3(0.35, 0.38, 0.55) * band * 0.08;
    c += curtains(p, t, A, S, refl);
    return c;
}

// Ridge heights of the two mountain ranges (y up): ridged noise, sharp peaks and gullies.
float ridged(float x, float seed) {
    float v = 0.0;
    float a = 0.5;
    float f = 1.0;
    for (int i = 0; i < 4; i++) {
        float r = 1.0 - abs(2.0 * vnoise(float2(x * f, seed + float(i) * 3.1)) - 1.0);
        v += a * r * r;
        f *= 2.15;
        a *= 0.48;
    }
    return v;
}
// A range of separate peaks: each cell has one peak (height, steepness, place jittered); the highest
// of the neighbours wins, plus ridged detail along the crest.
float peaks(float x, float cells, float hMin, float hMax, float seed) {
    float cx = x * cells;
    float c0 = floor(cx);
    float h = 0.0;
    for (int i = -1; i <= 1; i++) {
        float c = c0 + float(i);
        float at = (c + 0.25 + 0.5 * hash11(c * 1.7 + seed)) / cells;
        float ph = mix(hMin, hMax, hash11(c * 3.1 + seed + 2.0));
        float dx = x - at;
        // Different steepness on each side, so no peak is a neat pyramid.
        float st = dx < 0.0 ? mix(0.3, 0.75, hash11(c * 5.3 + seed + 4.0)) : mix(0.3, 0.75, hash11(c * 6.7 + seed + 8.0));
        h = max(h, ph - abs(dx) * st);
    }
    return h;
}
float farRidge(float x) {
    return HZ + 0.02 + 0.03 * fbm3(float2(x * 2.0, 4.0)) + max(peaks(x, 2.2, 0.05, 0.2, 1.0), 0.0) + 0.045 * ridged(x * 3.4, 7.0);
}
float nearRidge(float x) {
    return HZ + 0.004 + max(peaks(x + 0.37, 2.6, -0.02, 0.085, 9.0), 0.0) + 0.012 * ridged(x * 7.0, 5.0);
}

// Everything above the horizon line at p: sky, curtains, mountains, pines. refl = 1 in the reflection.
float3 above(float2 p, float t, float3 A, float3 S, float3 BG, float3 lightC, float px, float refl) {
    float3 c = skyAt(p, t, A, S, BG, refl);
    // Far range: snowy peaks lit from the upper left by the aurora, dark rock in the shaded gullies,
    // hazier towards the foot.
    float fr = farRidge(p.x);
    if (p.y < fr + px) {
        float e = 0.003;
        float slope = (farRidge(p.x + e) - farRidge(p.x - e)) / (2.0 * e);
        float hgt = sat((p.y - HZ) / max(fr - HZ, 0.01));
        // Faces: the ridge's own slope near the top, gullies (ridged noise of x, sheared by depth) below.
        float g = vnoise(float2((p.x + (fr - p.y) * 0.9 * sign(slope)) * 32.0, 3.0));
        float face = sat(0.5 - slope * 0.6 + (g - 0.5) * 1.1 * (1.0 - hgt * 0.5));
        float snowLine = 0.32 + 0.25 * vnoise(float2(p.x * 9.0, 1.0));
        float snow = smoothstep(snowLine - 0.08, snowLine + 0.08, hgt + (g - 0.5) * 0.35);
        float3 rock = BG * 0.8 + float3(0.018, 0.022, 0.035) + lightC * 0.15 * face;
        float3 sn = mix(float3(0.16, 0.19, 0.26), float3(0.62, 0.68, 0.78), face) + lightC * (0.15 + 0.85 * face);
        float3 m = mix(rock, sn * 0.85, snow);
        m = mix(m, c * 0.55 + BG * 0.45, (1.0 - hgt) * 0.55);   // haze at the foot
        m += lightC * 0.6 * exp(-(fr - p.y) * 260.0) * face;     // the crest catches the light
        c = mix(c, m, smoothstep(fr + px, fr - px, p.y));
    }
    // Near range: darker, snow only in streaks, a cold rim of light along its crest.
    float nr = nearRidge(p.x);
    if (p.y < nr + px) {
        float slope = (nearRidge(p.x + 0.003) - nearRidge(p.x - 0.003)) / 0.006;
        float lit = sat(0.45 - slope * 0.8);
        float hgt = sat((p.y - HZ) / max(nr - HZ, 0.01));
        float streak = vnoise(float2(p.x * 160.0 + p.y * 40.0, p.y * 10.0));
        float snow = smoothstep(0.55, 0.85, streak) * smoothstep(0.1, 0.6, hgt);
        float3 m = BG * 0.45 + float3(0.008, 0.01, 0.016);
        m = mix(m, float3(0.3, 0.34, 0.42) * (0.4 + 0.6 * lit) + lightC * 0.35 * lit, snow);
        m += lightC * 0.5 * exp(-(nr - p.y) * 140.0) * lit;
        c = mix(c, m, smoothstep(nr + px, nr - px, p.y));
    }
    // Pines along the shore: narrow layered cones of different heights, in groups.
    float tx = p.x * 70.0;
    float cell = floor(tx);
    float grove = smoothstep(0.35, 0.55, vnoise(float2(p.x * 3.0, 4.0)));
    float th = (0.01 + 0.026 * hash11(cell + 3.0)) * grove * step(0.15, hash11(cell + 11.0));
    float fx = abs(fract(tx) - 0.5 + (hash11(cell + 5.0) - 0.5) * 0.3) / 70.0;
    float ty = p.y - HZ;
    float rel = ty / max(th, 0.0005);
    float wid = (1.0 - rel) * 0.0062 * (0.7 + 0.3 * fract(rel * 5.0));
    float pine = step(fx, wid) * step(0.0, ty) * step(ty, th);
    pine = max(pine, step(ty, 0.004 + 0.003 * vnoise(float2(p.x * 40.0, 0.0))) * step(0.0, ty));
    c = mix(c, BG * 0.2 + lightC * 0.025, pine);
    return c;
}

half4 main(float2 fc) {
    float t = uTime;
    float2 p = (fc - 0.5 * uRes) / uRes.y;
    p.y = -p.y;
    float px = 1.2 / uRes.y;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;
    // Slow, gentle pan.
    p.x += 0.04 * sin(t * 0.017);
    // How much light the aurora throws on the land right now (it brightens and dims slowly).
    float3 lightC = mix(A, S, 0.25) * (0.16 + 0.05 * sin(t * 0.11) + 0.03 * sin(p.x * 2.0 + t * 0.07));

    float3 col;
    if (p.y >= HZ) {
        col = above(p, t, A, S, BG, lightC, px, 0.0);
    } else {
        // The lake: black ice mirroring everything above, rippled, darker and softer with distance.
        float depth = HZ - p.y;                          // 0 at the shore, grows towards us
        float dist = 1.0 / max(depth, 0.004);
        float2 wp = float2(p.x * dist, dist);
        float rip = (vnoise(wp * float2(2.5, 0.6) + float2(0.0, t * 0.3)) - 0.5);
        float2 q = float2(p.x + rip * 0.012 * sat(depth * 6.0), HZ + depth + rip * 0.004);
        float3 refl = above(q, t, A, S, BG, lightC, px * 2.0, 1.0);
        col = refl * 0.62 + BG * 0.05;
        // Smooth ice with a sheen; patches of frost and thin cracks.
        float frost = smoothstep(0.5, 0.75, fbm3(wp * float2(0.9, 0.35)));
        float3 frostC = float3(0.16, 0.19, 0.25) + lightC * 0.6;
        col = mix(col, frostC * (0.7 + 0.3 * vnoise(wp * 3.0)) + refl * 0.15, frost * 0.7);
        float crack = smoothstep(0.025, 0.0, abs(vnoise(wp * float2(1.4, 0.7)) - 0.5)) * sat(depth * 4.0);
        col = mix(col, col * 0.55 + lightC * 0.4, crack * 0.6);
        // The shoreline: a thin bright edge where the ice meets the snow under the pines.
        col += lightC * 0.6 * exp(-depth * 260.0);
    }
    return half4(finish(col, fc), 1.0);
}
