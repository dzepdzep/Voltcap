// Terra · 32-bit (ground type): a desert canyon at the golden hour, scrolling past in parallax. Mesas
// on the horizon, banded dunes, cacti and a bleached skull; heat shimmer above the sand and every so
// often a dust devil spins across, kicking up pixel grit.
//#include pixel

half4 main(float2 fc) {
    float2 cell = pxCell(fc);
    float2 uv = pxUv(cell);
    float asp = uRes.x / uRes.y;
    float t = uTime;
    float3 A = uAcc.rgb;
    float3 S = uSec.rgb;
    float3 BG = uBg.rgb;

    // Sky: warm bands, a low sun with heat shimmer under it.
    float3 col = mix(mix(float3(0.95, 0.55, 0.3), S, 0.3), mix(float3(1.0, 0.85, 0.55), A, 0.25), pxBand(uv.y * 1.8, 5.0, cell));
    float2 sun = float2(asp * 0.3, 0.32);
    float sd = length(uv - sun);
    col = mix(col, float3(1.0, 0.95, 0.75), step(sd, 0.07));
    col = mix(col, mix(float3(1.0, 0.75, 0.4), A, 0.3), step(sd, 0.1) * step(0.07, sd) * step(0.5, fract(uv.y * 45.0)));
    // Mesas far away (slow), then the canyon walls (faster).
    float x1 = uv.x + t * 0.01;
    float mesa = 0.42 - 0.08 * step(0.45, fract(x1 * 0.9)) * step(fract(x1 * 0.9), 0.75) - 0.05 * step(0.1, fract(x1 * 1.7 + 0.3)) * step(fract(x1 * 1.7 + 0.3), 0.3);
    float shim = step(0.38, uv.y) * step(uv.y, 0.46) * sin(uv.y * 400.0 + t * 8.0) * 0.004;
    if (uv.y > mesa + shim) col = mix(mix(float3(0.75, 0.4, 0.3), S, 0.2), float3(0.85, 0.55, 0.4), step(0.5, fract((uv.y - mesa) * 30.0)) * 0.4);
    float x2 = uv.x + t * 0.025;
    float wall = 0.52 - 0.12 * smoothstep(0.3, 0.32, fract(x2 * 0.6)) * (1.0 - smoothstep(0.6, 0.62, fract(x2 * 0.6)));
    if (uv.y > wall) {
        float strata = floor((uv.y - wall) * 40.0 + 0.6 * sin(x2 * 8.0));
        col = mix(float3(0.6, 0.3, 0.18), mix(float3(0.8, 0.45, 0.25), A, 0.2), step(0.5, fract(strata * 0.5)));
        col *= 0.8 + 0.2 * step(0.0, sin(x2 * 30.0));
    }
    // Dunes in front (fastest), banded light and shade.
    float x3 = uv.x + t * 0.06;
    float dune = 0.66 + 0.05 * sin(x3 * 5.0) + 0.02 * sin(x3 * 13.0 + 1.0);
    if (uv.y > dune) {
        float slopeLit = cos(x3 * 5.0) * 0.5 + 0.5;
        col = pxRamp(slopeLit * 0.8 + 0.1 - (uv.y - dune) * 0.6, cell, float3(0.6, 0.4, 0.2), float3(0.8, 0.58, 0.3), mix(float3(0.95, 0.75, 0.42), A, 0.15), float3(1.0, 0.88, 0.6));
        // Ripples.
        col *= 1.0 - 0.12 * step(0.8, fract((uv.y - dune) * 60.0 + sin(x3 * 20.0) * 2.0));
    }
    // Cacti and a skull, riding with the dunes.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float cx = fract((fi * 0.37 + 0.1) - t * 0.06 / (asp + 0.4) * 1.0) * (asp + 0.4) - 0.2;
        cx = (floor(cx * PX_ROWS) + 0.5) / PX_ROWS;
        float gy = 0.66 + 0.05 * sin((cx + t * 0.06) * 5.0) + 0.02 * sin((cx + t * 0.06) * 13.0 + 1.0) + 0.01;
        float2 q = uv - float2(cx, gy);
        float trunk = pxBox(q, float2(0.0, -0.07), float2(0.009, 0.07));
        float arm1 = pxBox(q, float2(-0.022, -0.08), float2(0.006, 0.025)) + pxBox(q, float2(-0.012, -0.058), float2(0.012, 0.005));
        float arm2 = pxBox(q, float2(0.022, -0.1), float2(0.006, 0.02)) + pxBox(q, float2(0.012, -0.082), float2(0.012, 0.005));
        float cac = sat(trunk + arm1 + arm2);
        col = mix(col, mix(float3(0.2, 0.5, 0.25), float3(0.35, 0.65, 0.3), step(0.0, q.x)), cac);
        col = mix(col, float3(0.9, 0.95, 0.7), cac * step(0.7, fract(q.y * 120.0)) * step(abs(q.x), 0.004));
    }
    float sx = fract(0.75 - t * 0.06 / (asp + 0.4)) * (asp + 0.4) - 0.2;
    float2 sk = uv - float2(sx, 0.9);
    col = mix(col, float3(0.95, 0.92, 0.85), step(length(sk * float2(1.0, 1.3)), 0.018) + pxBox(sk, float2(0.0, 0.014), float2(0.01, 0.006)));
    col = mix(col, float3(0.25, 0.15, 0.1), step(length(sk - float2(-0.007, -0.002)), 0.005) + step(length(sk - float2(0.007, -0.002)), 0.005));
    // A dust devil crossing every 12 s.
    float dt = fract(t / 12.0);
    float dx = mix(-0.2, asp + 0.2, dt);
    float2 dq = uv - float2(dx + 0.02 * sin(uv.y * 30.0 + t * 6.0), 0.0);
    float funnel = step(abs(dq.x), 0.01 + (0.75 - uv.y) * 0.18) * step(0.45, uv.y) * step(uv.y, 0.78);
    float swirl = step(0.5, fract(uv.y * 40.0 + dq.x * 30.0 - t * 5.0));
    col = mix(col, mix(float3(0.85, 0.65, 0.4), float3(0.7, 0.5, 0.3), swirl), funnel * 0.8 * step(0.4, hash12(cell + floor(t * 10.0))));
    // Grit.
    float2 gp = float2(uv.x + t * 0.4, uv.y + 0.05 * sin(uv.x * 5.0 + t)) * float2(80.0, 60.0);
    col = mix(col, float3(0.95, 0.8, 0.55), step(0.992, hash12(floor(gp))) * step(0.6, uv.y));
    col = pxQuant(col, 10.0, cell);
    return half4(finish(col, fc), 1.0);
}
