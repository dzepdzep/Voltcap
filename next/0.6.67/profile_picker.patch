+        assertEquals(0f, PhotoShells.colourDistance(0xFFA3A2A8.toInt(), 0xFFA3A2A8.toInt()), 0.01f)
+        assertTrue(PhotoShells.colourDistance(0xFFA3A2A8.toInt(), 0xFFD4AF37.toInt()) > 80f) // grey vs a gold pak
