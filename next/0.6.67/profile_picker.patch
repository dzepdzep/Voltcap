+                        .border(if (startOn) 3.dp else 1.dp, if (startOn) Color(0xFF39A9FF) else Color.White.copy(alpha = 0.6f), RoundedCornerShape(10.dp))
+                        .pointerInput(Unit) { detectTapGestures { bubblesLiveAct(c, 0) } }
