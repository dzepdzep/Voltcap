diff --git a/tools/qa/device/catparity.sh b/tools/qa/device/catparity.sh
new file mode 100644
index 0000000..f4cd20c
--- /dev/null
+++ b/tools/qa/device/catparity.sh
@@ -0,0 +1,13 @@
+# catparity.sh TAG N — the owner's own layout: category screen tiles vs L2/R2 stops (N x R2), then back with L2; view state
+# saved first and restored + verified after (staging build). Read-only otherwise.
+P=com.shelf.launcher; F=/sdcard/Android/data/$P/files; OUT=/sdcard/pv/$1; rm -rf $OUT; mkdir -p $OUT
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+A --es voltcap_test_snapshot save; sleep 2; cp $F/voltcap_test_snapshot_view.json $OUT/view_before.json
+input keyevent KEYCODE_SCROLL_LOCK; sleep 0.4; logcat -c
+input keyevent KEYCODE_BUTTON_B; sleep 2.5; screencap -p $OUT/screen.png; input keyevent KEYCODE_BUTTON_B; sleep 1.5
+for i in $(seq 1 $2); do input keyevent KEYCODE_BUTTON_R2; sleep 0.6; done
+screencap -p $OUT/after_r2.png
+for i in $(seq 1 $2); do input keyevent KEYCODE_BUTTON_L2; sleep 0.6; done
+logcat -d -s VoltcapQA | grep -E "category|tiles|stop " > $OUT/log.txt
+A --es voltcap_test_snapshot restore; sleep 3; cat $F/voltcap_test_snapshot_verify.txt > $OUT/verify.txt
+echo DONE >> $OUT/log.txt
diff --git a/tools/qa/device/contract462.sh b/tools/qa/device/contract462.sh
new file mode 100644
index 0000000..7c7b037
--- /dev/null
+++ b/tools/qa/device/contract462.sh
@@ -0,0 +1,35 @@
+# Update 462: the controller contract on every layout (simulated input: adb `input keyevent`, not a physical pad).
+# usage: sh contract462.sh "LAYOUT ..." OUTDIR   (needs the voltcap_test_hooks file; the caller saves / restores the snapshot)
+# Per layout: Select → Settings, Start → game options, R1 → quick menu, L1 → shortcuts, B → category picker (themed or
+# plain), R2 / L2 → next / previous category; each closed with B. A game must never start (voltcap_test_nolaunch).
+P=com.shelf.launcher; LAYS=$1; OUT=${2:-/sdcard/c462}; mkdir -p $OUT; R=$OUT/result.txt; : > $R
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+st() { logcat -d -s VoltcapQA | grep " overlay " | tail -1 | sed 's/.* overlay //'; }
+key() { input keyevent $1; sleep ${2:-1.3}; }
+closeall() { for i in 1 2 3; do s=$(st); case "$s" in *menu=true*|*quick=true*|*opts=true*|*short=true*|*cat=true*|*sort=true*|*pq=SYSTEMS*|*pq=DETAILS*|*gc=SYSTEMS*|*pc=CATEGORIES*|*pc=GAMES*) key 97 1.0;; *) return;; esac; done; }
+A --ez voltcap_test_preview true; sleep 2
+A --ez voltcap_test_nolaunch true; sleep 1
+for lay in $LAYS; do
+  A --es voltcap_test_layout $lay; sleep 4
+  input keyevent 224
+  closeall
+  base=$(st | sed 's/.*cat_key=//')
+  line="$lay"
+  for k in 109:Select:menu=true 108:Start:opts=true 103:R1:quick=true 102:L1:short=true; do
+    c=${k%%:*}; rest=${k#*:}; n=${rest%%:*}; want=${rest#*:}
+    logcat -c; key $c; s=$(st)
+    case "$s" in *$want*) line="$line $n=OK";; *) line="$line $n=FAIL[$s]";; esac
+    closeall
+  done
+  logcat -c; key 97; s=$(st)
+  case "$s" in *cat=true*) line="$line B=plain";; *pq=SYSTEMS*|*gc=SYSTEMS*|*pc=CATEGORIES*) line="$line B=themed";; *) line="$line B=none[$s]";; esac
+  closeall
+  logcat -c; key 105; k1=$(st | sed 's/.*cat_key=//'); key 104; k2=$(st | sed 's/.*cat_key=//')
+  if [ -n "$k1" ] && [ "$k1" != "$base" ] && [ "$k2" = "$base" ]; then line="$line R2L2=OK"; else line="$line R2L2=?[$base>$k1>$k2]"; fi
+  # rapid: Select Select B B Start B R1 B (nothing may launch, the app stays in front)
+  for c in 109 109 97 97 108 97 103 97; do input keyevent $c; sleep 0.15; done; sleep 1.2; closeall
+  fg=$(dumpsys activity activities | grep -m1 -E "topResumedActivity|mResumedActivity")
+  case "$fg" in *$P*) line="$line rapid=OK";; *) line="$line rapid=FAIL"; echo "$line" >> $R; echo done > $OUT/DONE; exit 1;; esac
+  echo "$line" >> $R
+done
+echo done > $OUT/DONE
diff --git a/tools/qa/device/cp1.sh b/tools/qa/device/cp1.sh
new file mode 100644
index 0000000..3733096
--- /dev/null
+++ b/tools/qa/device/cp1.sh
@@ -0,0 +1,23 @@
+# cp1.sh — Continue playing on the Thor (update 451): tile launch path, return, first press after return.
+P=com.shelf.launcher/.MainActivity; F=/sdcard/Android/data/com.shelf.launcher/files; O=/sdcard/cp451; mkdir -p $O
+A() { am start -n $P "$@" > /dev/null 2>&1; }
+probe() { A --es voltcap_test_appinfo psplay.grill.com,com.asobi.droid; sleep 2; sed 's/installed.*continue_opt_in=/opt=/' $F/voltcap_qa_appinfo.txt; }
+task() { dumpsys activity activities | grep -E "^ *\* Task\{.*$1" | head -1 | grep -o "#[0-9]*"; }
+top() { dumpsys activity activities | grep -m1 topResumedActivity | sed 's/.*u0 //; s/ t[0-9]*}//'; }
+A; sleep 4; input keyevent KEYCODE_BUTTON_B; sleep 1
+echo "== before"; probe
+A --es voltcap_test_category S:RECENT; sleep 3
+for i in 1 2 3 4; do input keyevent KEYCODE_DPAD_LEFT; sleep 0.6; done
+echo "== tile launch PXPlay (task before $(task psplay))"; logcat -c
+input keyevent KEYCODE_BUTTON_A; sleep 6
+echo "top=$(top) task=$(task psplay) companion=$(dumpsys activity activities | grep -c 'CompanionActivity')"
+logcat -d -s VoltcapQA | grep -o "LAUNCH asked [a-zA-Z.]* [a-z.]*" | sort | uniq -c
+screencap -d 4630946441858561667 -p $O/launched_top.png
+input keyevent KEYCODE_HOME; sleep 4
+echo "== after return"; probe
+screencap -d 4630946482288158084 -p $O/after_bot.png
+echo "== one A press right after return"; logcat -c
+input keyevent KEYCODE_BUTTON_A; sleep 5
+echo "top=$(top)"; logcat -d -s VoltcapQA | grep -o "LAUNCH asked [a-zA-Z.]* [a-z.]*" | sort | uniq -c
+input keyevent KEYCODE_HOME; sleep 3
+echo DONE
