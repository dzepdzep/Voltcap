+class PhotoShells462Test {
+    @Test fun officialPhotosBySystem() {
+        val raw = mapOf(
+            "silver.gbc" to listOf("Disc / cartridge" to "https://x/mediaJeu.php?systemeid=10&jeuid=1&media=support-2D", "Box" to "https://x/b?systemeid=10"),
