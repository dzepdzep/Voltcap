+    Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+        Text("Voltcap", color = ShelfTheme.colors.textPrimary, fontSize = 28.sp, fontWeight = FontWeight.Bold)
+    }
+}
