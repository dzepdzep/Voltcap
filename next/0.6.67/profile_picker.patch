+        ShelfTheme.colors.textPrimary.copy(alpha = 0.05f), ShelfTheme.accent.copy(alpha = 0.25f), 3.dp, ShelfTheme.colors.textPrimary.copy(alpha = 0.22f), 0.5f, 0.64f)
