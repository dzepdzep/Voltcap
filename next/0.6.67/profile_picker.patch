+@Composable
+private fun VideoPage(info: SecondHomeGame, withSound: Boolean) {
+    val game = info.game
+    val url = info.videoUrl
+    if (game == null) {
+        NoGame()
+    } else if (url == null) {
+        Placeholder("No video clip for this game (clips come from ScreenScraper).")
+    } else {
+        Box(
+            Modifier
+                .fillMaxSize()
+                .clip(RoundedCornerShape(18.dp))
+                .background(Color.Black)
+        ) {
+            VideoCrossfade(url, withSound = withSound, modifier = Modifier.fillMaxSize())
+        }
+    }
+}
