diff --git a/app/src/main/java/com/shelf/launcher/data/HackLabels.kt b/app/src/main/java/com/shelf/launcher/data/HackLabels.kt
new file mode 100644
index 0000000..f07e035
--- /dev/null
+++ b/app/src/main/java/com/shelf/launcher/data/HackLabels.kt
@@ -0,0 +1,31 @@
+package com.shelf.launcher.data
+
+/**
+ * Update 461 (owner: "for ROM hacks, never substitute the base game's label"): a ROM hack that ScreenScraper matched to its
+ * base game gets the base game's scans — Pokémon Crystal Kaizo wore Pokémon Crystal's real label (same ScreenScraper game,
+ * jeuid 82606, on the KONKR). A hack whose saved scans are the same ScreenScraper game as an official game in the library
+ * keeps its box but not that game's label scan or cartridge photo ([DROP]): it gets its own label from the Labels folder
+ * (LabelFolder), your pick, or the printed fallback. A hack with its own ScreenScraper entry (Crystal Clear's fan label) is
+ * untouched.
+ */
+object HackLabels {
+    val DROP = setOf("Disc label", "Disc / cartridge")
+    private val JEU = Regex("""[?&]jeuid=(\d+)""")
+
+    /** The ScreenScraper game id the pictures in [list] were taken from, or null (pure — unit-tested). */
+    fun gameIdOf(list: List<Pair<String, String>>): String? = list.firstNotNullOfOrNull { JEU.find(it.second)?.groupValues?.get(1) }
+
+    /** The keys of the hacks in [raw] whose scans are an official game's (same game id as a game that isn't a hack) (pure). */
+    fun baseMatched(raw: Map<String, List<Pair<String, String>>>, isHack: (String) -> Boolean): Set<String> {
+        val official = raw.filterKeys { !isHack(it) }.values.mapNotNull { gameIdOf(it) }.toSet()
+        if (official.isEmpty()) return emptySet()
+        return raw.filter { (k, v) -> isHack(k) && gameIdOf(v)?.let { it in official } == true }.keys
+    }
+
+    /** The hacks found by [baseMatched] for the library (set by the view model). */
+    @Volatile var keys: Set<String> = emptySet()
+
+    /** [list] without the base game's label scan and cartridge photo when [key] is such a hack (pure apart from [keys]). */
+    fun strip(key: String, list: List<Pair<String, String>>): List<Pair<String, String>> =
+        if (key in keys) list.filter { it.first !in DROP } else list
+}
diff --git a/app/src/main/java/com/shelf/launcher/data/LabelFolder.kt b/app/src/main/java/com/shelf/launcher/data/LabelFolder.kt
new file mode 100644
index 0000000..3338fd4
--- /dev/null
+++ b/app/src/main/java/com/shelf/launcher/data/LabelFolder.kt
@@ -0,0 +1,83 @@
+package com.shelf.launcher.data
+
+/**
+ * Update 460: your own cartridge / disc labels, dropped as picture files into the **Voltcap/Labels** folder on the device's
+ * storage (sub-folders per console are fine): `Pokemon Brown.png`, `Pokemon - Crystal Clear (Hack).jpg`… A file is matched
+ * to a game by its name — the file name without its extension against the game's ROM file name and its shown name, with
+ * region tags, punctuation and case ignored.
+ *
+ * This is where a printable fan-made label for a ROM hack (or a label you scanned yourself) goes: Voltcap bundles and
+ * downloads none — the label collections found for ROM hacks carry no licence for redistribution. A label found here is
+ * worn as the game's label scan ("Disc label"): the drawn cartridge prints it on its whole sticker.
+ *
+ * Order (PhysicalOverrides.apply): the label you picked for the game (Artwork & details) → the real label scan
+ * (ScreenScraper) → this folder → the cover. For a ROM hack this folder comes before the scraped scan, since a hack is
+ * matched to its base game and that scan is the base game's label.
+ *
+ * Read once in the background ([index]); nothing is written.
+ */
+object LabelFolder {
+    private val EXT = setOf("png", "jpg", "jpeg", "webp")
+    @Volatile private var byName: Map<String, String> = emptyMap()
+    @Volatile private var indexed = false
+    /** Bumped when the folder has been read (so the games' lists are made again with what it holds). */
+    val version = androidx.compose.runtime.mutableIntStateOf(0)
+
+    private val NON = Regex("[^a-z0-9]+")
+    private val TAGS = Regex("""\s*[(\[][^)\]]*[)\]]""")
+
+    /** The name a label file or a game is matched by (pure — unit-tested). */
+    fun norm(name: String): String = NON.replace(TAGS.replace(name.substringBeforeLast('.').let { if ('/' in it) it.substringAfterLast('/') else it }, "").lowercase(), "")
+
+    /** The folders looked in. */
+    fun roots(): List<java.io.File> = listOf(java.io.File(android.os.Environment.getExternalStorageDirectory(), "Voltcap/Labels"))
+
+    /** Builds the name → file table from [dirs] (two folder levels; pure apart from reading the folders — unit-tested). */
+    fun scan(dirs: List<java.io.File>): Map<String, String> {
+        val out = HashMap<String, String>()
+        fun walk(d: java.io.File, depth: Int) {
+            val list = runCatching { d.listFiles() }.getOrNull() ?: return
+            for (f in list.sortedBy { it.name.lowercase() }) {
+                if (f.isDirectory) { if (depth < 2) walk(f, depth + 1); continue }
+                if (f.extension.lowercase() !in EXT || f.length() <= 0L) continue
+                val k = norm(f.name)
+                if (k.isNotEmpty()) out.putIfAbsent(k, f.absolutePath)
+            }
+        }
+        for (d in dirs) if (d.isDirectory) walk(d, 0)
+        return out
+    }
+
+    /** Reads the folder (off the main thread). */
+    fun index() {
+        byName = scan(roots())
+        indexed = true
+        version.intValue++
+    }
+
+    /** For tests: the table to use. */
+    fun setForTest(map: Map<String, String>) { byName = map; indexed = true }
+
+    /** The label file (as a file:// address) for the game kept under [key] (its ROM path), or null. */
+    fun forKey(key: String, shownName: String? = null): String? {
+        if (!indexed || byName.isEmpty()) return null
+        val path = byName[norm(key)] ?: shownName?.let { byName[norm(it)] } ?: return null
+        return "file://$path"
+    }
+
+    /** Whether [url] is a label from this folder (for where a picture came from). */
+    fun isFolderLabel(url: String?): Boolean = url != null && roots().any { url.startsWith("file://" + it.absolutePath) }
+
+    /**
+     * [list] (a game's scraped real-media pictures) with the folder's label for [key] worn as its "Disc label": where it
+     * has no label scan, or always for a ROM hack ([hack]) — whose scraped label and cartridge photo are its base game's
+     * (pure — unit-tested). A label you picked yourself is applied after this and still wins.
+     */
+    fun merge(list: List<Pair<String, String>>, folderLabel: String?, hack: Boolean): List<Pair<String, String>> {
+        if (folderLabel == null) return list
+        val hasReal = list.any { it.first == "Disc label" }
+        if (hasReal && !hack) return list
+        val drop = if (hack) setOf("Disc label", "Disc / cartridge") else setOf("Disc label")
+        return list.filter { it.first !in drop } + ("Disc label" to folderLabel)
+    }
+}
diff --git a/app/src/main/java/com/shelf/launcher/data/LabelIds.kt b/app/src/main/java/com/shelf/launcher/data/LabelIds.kt
new file mode 100644
index 0000000..eead7ba
--- /dev/null
+++ b/app/src/main/java/com/shelf/launcher/data/LabelIds.kt
@@ -0,0 +1,128 @@
+package com.shelf.launcher.data
+
+/**
+ * Update 459: what a generated cartridge label may print to identify a game — never an invented catalogue number.
+ *
+ * - [Id.code]: the real product code, read from the ROM's own header where the format keeps one (Game Boy Advance
+ *   "AGB-AXVE-USA", Nintendo DS "NTR-…", Nintendo 64 "NUS-NSME-USA", newer Game Boy / Color games "CGB-AAUE-USA",
+ *   Mega Drive / Genesis "GM 00001009-00"). Null when the header has none (most original Game Boy, NES, SNES games).
+ * - [Id.unofficial]: "FAN-MADE" for a ROM hack, "HOMEBREW" for homebrew / aftermarket / unlicensed releases — printed
+ *   instead of any code (a hack's header still carries its base game's code, which would claim to be that product).
+ * - [Id.region]: "USA" / "EUR" / "JPN" from the file's region tag (or the header), null when unknown.
+ *
+ * Read once per session in the background ([index]); a label made before its header was read is made again
+ * ([version]). Nothing is written anywhere.
+ */
+object LabelIds {
+    data class Id(val code: String?, val unofficial: String?, val region: String?)
+
+    private val map = java.util.concurrent.ConcurrentHashMap<String, Id>()
+    /** Bumped when header codes come in, so generated labels are drawn again with them. */
+    val version = androidx.compose.runtime.mutableIntStateOf(0)
+    @Volatile private var indexedFor = 0
+
+    private val NON = Regex("[^a-z0-9]+")
+    private fun norm(s: String): String = NON.replace(s.lowercase(), "")
+
+    /** The label facts for a game shown as [title] (its display name or raw name), or null when unknown. */
+    fun of(title: String?): Id? = title?.let { map[norm(it)] ?: map[norm(com.shelf.launcher.ui.gameDisplayName(it))] }
+
+    private val HOMEBREW = Regex("""[(\[](homebrew|aftermarket|unl|unlicensed|pd|public domain)[)\]]""", RegexOption.IGNORE_CASE)
+
+    /** Hack / homebrew tag for a game called [name] from file [path] (pure). */
+    fun unofficialOf(name: String, path: String?): String? = when {
+        RomHacks.isModified(name, path) -> "FAN-MADE"
+        HOMEBREW.containsMatchIn(name) || (path != null && HOMEBREW.containsMatchIn(path.substringAfterLast('/'))) -> "HOMEBREW"
+        else -> null
+    }
+
+    /** Region from No-Intro style tags in a name or file name (pure). */
+    fun regionOf(name: String): String? {
+        val tags = Regex("""\(([^)]*)\)""").findAll(name).map { it.groupValues[1].lowercase() }.toList()
+        for (t in tags) {
+            val parts = t.split(',').map { it.trim() }
+            if ("usa" in parts || "us" in parts) return "USA"
+            if ("europe" in parts || "eu" in parts || "germany" in parts || "france" in parts || "uk" in parts || "spain" in parts || "italy" in parts) return "EUR"
+            if ("japan" in parts || "jp" in parts) return "JPN"
+            if ("world" in parts) return "USA"
+        }
+        return null
+    }
+
+    /** Region letter in Nintendo product codes (the code's last character) → its suffix; null when unknown (pure). */
+    fun nintendoRegion(letter: Char): String? = when (letter) {
+        'E' -> "USA"; 'P' -> "EUR"; 'J' -> "JPN"; 'D' -> "NOE"; 'F' -> "FRA"; 'S' -> "ESP"; 'I' -> "ITA"; 'U' -> "AUS"; 'K' -> "KOR"
+        else -> null
+    }
+
+    private fun alnum4(b: ByteArray, at: Int): String? {
+        if (at + 4 > b.size) return null
+        val s = String(b, at, 4, Charsets.US_ASCII)
+        return s.takeIf { it.all { c -> c in 'A'..'Z' || c in '0'..'9' } }
+    }
+
+    /**
+     * The product code in a ROM [head] (its first 512 bytes at least) for file extension [ext], or null (pure — unit-tested).
+     */
+    fun codeFromHeader(ext: String, head: ByteArray): String? = runCatching {
+        when (ext.lowercase()) {
+            "gba" -> alnum4(head, 0xAC)?.let { c -> "AGB-$c-" + (nintendoRegion(c[3]) ?: return@runCatching null) }
+            "nds" -> alnum4(head, 0x0C)?.let { c -> "NTR-$c-" + (nintendoRegion(c[3]) ?: return@runCatching null) }
+            "gb", "gbc" -> {
+                if (head.size < 0x150) return@runCatching null
+                val cgb = head[0x143].toInt() and 0xFF
+                if (cgb != 0x80 && cgb != 0xC0) return@runCatching null
+                alnum4(head, 0x13F)?.let { c -> (if (cgb == 0xC0) "CGB-" else "DMG-") + c + "-" + (nintendoRegion(c[3]) ?: return@runCatching null) }
+            }
+            "z64", "n64", "v64" -> {
+                if (head.size < 0x40) return@runCatching null
+                val b = when {
+                    head[0] == 0x80.toByte() && head[1] == 0x37.toByte() -> head
+                    head[0] == 0x37.toByte() && head[1] == 0x80.toByte() -> ByteArray(head.size) { i -> head[i xor 1] }
+                    head[0] == 0x40.toByte() && head[3] == 0x80.toByte() -> ByteArray(head.size) { i -> head[(i and 3.inv()) + 3 - (i and 3)] }
+                    else -> return@runCatching null
+                }
+                val s = String(b, 0x3B, 4, Charsets.US_ASCII)
+                if (!s.all { it in 'A'..'Z' || it in '0'..'9' }) return@runCatching null
+                "NUS-$s-" + (nintendoRegion(s[3]) ?: return@runCatching null)
+            }
+            "md", "gen", "bin" -> {
+                if (head.size < 0x18E || String(head, 0x100, 4, Charsets.US_ASCII) != "SEGA") return@runCatching null
+                String(head, 0x180, 14, Charsets.US_ASCII).trim().takeIf { it.length >= 6 && it.startsWith("GM") && it.any { c -> c.isDigit() } }
+            }
+            else -> null
+        }
+    }.getOrNull()
+
+    /** Reads what the labels need for [games], once per library, in the background. */
+    suspend fun index(games: List<Game>) {
+        val tag = games.size * 31 + (games.firstOrNull()?.romPath?.hashCode() ?: 0)
+        if (tag == indexedFor) return
+        indexedFor = tag
+        kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.IO) {
+            for (g in games) {
+                if (g.sourceType != SourceType.ROM) continue
+                val path = g.romPath
+                val un = unofficialOf(g.name, path)
+                val region = regionOf(path?.substringAfterLast('/') ?: g.name) ?: regionOf(g.name)
+                val ext = path?.substringAfterLast('.', "")?.lowercase().orEmpty()
+                val code = if (un != null || path == null || ext !in HEADER_EXT) null else readHead(path)?.let { codeFromHeader(ext, it) }
+                val id = Id(code, un, region ?: code?.substringAfterLast('-')?.takeIf { it.length == 3 })
+                if (id.code != null || id.unofficial != null || id.region != null) {
+                    map[norm(g.name)] = id
+                    map[norm(com.shelf.launcher.ui.gameDisplayName(g.name))] = id
+                }
+            }
+            // (Once, at the end: each bump makes the cartridges on screen draw their fronts again.)
+            kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.Main) { version.intValue++ }
+        }
+    }
+
+    private val HEADER_EXT = setOf("gba", "nds", "gb", "gbc", "z64", "n64", "v64", "md", "gen", "bin")
+
+    private fun readHead(path: String): ByteArray? = runCatching {
+        val f = java.io.File(path)
+        if (!f.isFile || f.length() < 0x200) return@runCatching null
+        java.io.RandomAccessFile(f, "r").use { r -> ByteArray(0x200).also { r.readFully(it) } }
+    }.getOrNull()
+}
