-                    0f to Color.Transparent, 0.07f to Color.White.copy(alpha = 0.11f), 0.15f to Color.Transparent,
-                    0.5f to Color.Transparent, 0.57f to Color.White.copy(alpha = 0.08f), 0.65f to Color.Transparent,
