+                val startOn = l == 0
+                val glow by animateFloatAsState(if (startOn) 1f else 0f, tween(180), label = "laStart")
+                Box(
+                    Modifier.width(if (compact) 170.dp else 220.dp).height(if (compact) 50.dp else 64.dp)
