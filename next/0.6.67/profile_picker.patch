+        // Every home clip pauses (keeps its place) rather than being removed.
+        assertEquals(2, Regex("HomeIdle.rest \\|\\| panelHold \\|\\| \\(com.shelf.launcher.data.Features.clipIdlePause").findAll(s).count())
