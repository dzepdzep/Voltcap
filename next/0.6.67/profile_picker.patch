+package com.shelf.launcher.ui
+
+import com.shelf.launcher.data.Features
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * v0.6.67 "Who's playing?" looks: picture sizes for 1–9 choices on the GT78 (640×427 dp) and the Odin 2 Portal (834×469 dp),
+ * D-pad steps, sample profiles that never touch the real ones, the looks list, and that switching / storage stay as they were.
+ */
+class ProfilePicker445Test {
+    private fun src(name: String): String {
+        val roots = listOf("src_copy/", "../src_copy/", "app/src/main/java/com/shelf/launcher/", "src/main/java/com/shelf/launcher/")
+        return roots.map { File(it + name) }.first { it.exists() }.readText().replace("\r\n", "\n")
+    }
+
+    private val screens = listOf(Triple(640f, 427f, false), Triple(834f, 469f, false), Triple(480f, 320f, true), Triple(1280f, 720f, false))
+
+    @Test fun picturesNeverTinyAndNamesNeverOverlap() {
+        for ((w, h, compact) in screens) for (n in 1..9) {
+            val p = PickerGrid.plan(n, w, h, compact)
+            val min = if (compact) 64f else 76f
+            assertTrue("$w×$h n=$n avatar ${p.avatar}", p.avatar >= min - 0.01f || p.avatar >= h * 0.34f - 0.01f)
+            assertTrue("name slot wider than the picture", p.slot > p.avatar)
+            // Either the whole row fits between the side margins, or it scrolls.
+            assertTrue("$w×$h n=$n fits or scrolls", p.scroll || p.rowWidth <= w - 2 * PickerGrid.SIDE + 0.5f)
+            assertTrue("picture fits the height", p.avatar <= h * 0.34f + 0.01f)
+        }
+    }
+
+    @Test fun fewProfilesGetBigPictures() {
+        val p = PickerGrid.plan(2, 834f, 469f, false)
+        assertEquals(128f, p.avatar, 0.01f)
+        assertTrue(!p.scroll)
+        assertTrue("8 profiles + Add on the GT78 scroll instead of shrinking", PickerGrid.plan(9, 640f, 427f, false).scroll)
+    }
+
+    @Test fun dpadSteps() {
+        assertEquals(0, PickerGrid.step(0, 5, 5, -1, 0))
+        assertEquals(4, PickerGrid.step(4, 5, 5, 1, 0))
+        assertEquals(3, PickerGrid.step(2, 5, 5, 1, 0))
+        assertEquals(2, PickerGrid.step(2, 5, 5, 0, 1)) // one row: ▼ stays
+        assertEquals(4, PickerGrid.step(1, 5, 3, 0, 1)) // two rows: same column, clamped to the shorter row
+    }
+
+    @Test fun sampleProfilesAreSeparateFromYours() {
+        val (list, active) = TestHooks.demoProfiles("8:long:locked:active=2")
+        assertEquals(8, list.size)
+        assertTrue(list.all { it.id >= 900 })
+        assertEquals(902, active)
+        assertTrue(list[1].locked && !list[0].locked)
+        assertEquals(3, TestHooks.demoProfiles("x").first.size)
+        assertEquals(1, TestHooks.demoProfiles("0").first.size)
+    }
+
+    @Test fun sixLooksIncludingTodaysMidnightBlue() {
+        val names = Features.PickerLook.values().map { it.name }
+        assertEquals(listOf("AURORA", "CONSOLE", "NEON", "OLED", "THEME", "MIDNIGHT"), names)
+        assertEquals("picker_look", Features.pickerLook.key)
+    }
+
+    @Test fun existingInstallsKeepMidnightBlue() {
+        // Update 447 (owner): existing installs keep today's look, new ones start on Aurora glass; a saved one is never overwritten.
+        assertEquals(Features.PickerLook.MIDNIGHT, Features.firstPickerLook(existingInstall = true))
+        assertEquals(Features.PickerLook.AURORA, Features.firstPickerLook(existingInstall = false))
+        assertEquals("unsaved default before init", Features.PickerLook.MIDNIGHT, Features.pickerLook.default)
+        val f = src("data/Features.kt")
+        assertTrue(f.contains("if (!p.contains(\"picker_look\")) pickerLook.value = firstPickerLook(FirstRun.isDone("))
+    }
+
+    @Test fun pickerTellsQaWhenItIsUp() {
+        // D144: QA reads the app's own mark, not the picker's colours.
+        val s = src("ui/ProfileSelect.kt")
+        assertTrue(s.contains("TestHooks.markScreen(markCtx, \"PICKER\")") && s.contains("TestHooks.markScreen(markCtx, \"HOME\")"))
+        assertTrue(src("ui/TestHooks.kt").contains("if (!enabled(context)) return"))
+    }
+
+    @Test fun colourPresetsKeepASavedColour() {
+        val s = src("ui/ProfileSelect.kt")
+        assertTrue("a saved hue that is no preset is offered as it is", s.contains("else listOf(hue) + PickerGrid.PRESETS"))
+        assertTrue(PickerGrid.PRESETS.size == 12 && PickerGrid.PRESETS.all { it in 0f..360f })
+    }
+
+    @Test fun switchingAndStorageUnchanged() {
+        // Profile storage keeps its fields (no new ones): id, name, pic, hue, ra, pin.
+        val p = src("data/Profiles.kt")
+        assertTrue(p.contains("put(\"id\", p.id).put(\"name\", p.name).put(\"pic\", p.picture.name).put(\"hue\", p.hue.toDouble())"))
+        // The pick still only hands the id to the caller (LauncherScreen switches the profile and starts the rollout).
+        val s = src("ui/ProfileSelect.kt")
+        assertTrue(s.contains("onPick(id)") && !s.contains("Profiles.setActive("))
+        // Previews never save: Add, picture, PIN and remove are skipped in demo.
+        assertTrue(s.contains("if (demo) return") && s.contains("if (!demo) Profiles.update(context, np)") && s.contains("if (!demo) Profiles.remove(context, p.id)"))
+        val l = src("ui/LauncherScreen.kt")
+        assertTrue(l.contains("viewModel.switchProfile(id)"))
+    }
+
+    @Test fun longNamesBreakBetweenWordsOnly() {
+        assertEquals(listOf("Maximilian-", "Alexander"), PickerGrid.words("Maximilian-Alexander"))
+        assertEquals(listOf("The", "Very", "Long"), PickerGrid.words("The Very Long"))
+        assertEquals(listOf("Toni"), PickerGrid.words("Toni"))
+        assertEquals("Anastasia-\u200BKatharina", PickerGrid.breakable("Anastasia-Katharina"))
+        assertEquals("End-", PickerGrid.breakable("End-"))
+    }
+
+    @Test fun namesNeverEndInEllipsis() {
+        val s = src("ui/ProfileSelect.kt")
+        val bubble = s.substring(s.indexOf("private fun ProfileBubble("), s.indexOf("private fun ProfileBubble(") + 6000)
+        assertTrue(!bubble.contains("TextOverflow.Ellipsis"))
+    }
+}
diff --git a/app/src/test/java/com/shelf/launcher/ui/RealScans464Test.kt b/app/src/test/java/com/shelf/launcher/ui/RealScans464Test.kt
new file mode 100644
index 0000000..9979c2a
--- /dev/null
+++ b/app/src/test/java/com/shelf/launcher/ui/RealScans464Test.kt
@@ -0,0 +1,93 @@
+package com.shelf.launcher.ui
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Update 464 (owner: "do not change the appearance of my existing real cartridge scans"): PhotoShells only ever replaces the
+ * DRAWN (procedural) shell's front; the real-photo path — which picture is chosen, how it's drawn, turned and inspected —
+ * never touches it. Guarded at the source, as the device comparison (qa464, RC vs staging pixel diffs) can't run in CI.
+ */
+class RealScans464Test {
+    private val root = File("src/main/java/com/shelf/launcher")
+    private fun src(n: String) = File(root, n).readText()
+
+    /** The body of the function named [name] in [text]: its block `{ … }`, or for `= …` up to the next top-level declaration. */
+    private fun body(text: String, name: String): String {
+        val m = Regex("""fun (<[^>]*> )?$name\(""").find(text) ?: error("no fun $name")
+        var k = m.range.last; var d = 0
+        while (true) { val c = text[k]; if (c == '(') d++ else if (c == ')') { d--; if (d == 0) break }; k++ }
+        var j = k + 1
+        while (text[j] != '{' && text[j] != '=') j++
+        if (text[j] == '=') {
+            val n = Regex("""\n(internal |private |public |@Composable|fun |/\*\*|object |class )""").find(text, j)
+            return text.substring(m.range.first, n?.range?.first ?: text.length)
+        }
+        d = 0; k = j
+        while (true) { if (text[k] == '{') d++ else if (text[k] == '}') { d--; if (d == 0) break }; k++ }
+        return text.substring(m.range.first, k + 1)
+    }
+
+    @Test fun realPhotoChoiceNeverConsultsPhotoShells() {
+        // Which picture a cartridge shows: the game's own photo (or your pick) is chosen here, before any drawn shell exists.
+        val card = src("ui/GameCard.kt")
+        for (f in listOf("typedArtFor", "drawnLabelScan")) assertFalse(f, body(card, f).contains("PhotoShells"))
+        assertFalse(body(src("ui/PhysicalMedia.kt"), "realScanOf").contains("PhotoShells"))
+        assertFalse(src("data/PhysicalOverrides.kt").contains("PhotoShells"))
+        // The own photo is still the last word for CARTRIDGE_DISC when nothing was picked.
+        assertTrue(body(card, "typedArtFor").contains("""physical?.firstOrNull { it.first == "Disc / cartridge" }?.second"""))
+    }
+
+    @Test fun realPhotoDrawingNeverConsultsPhotoShells() {
+        assertFalse(body(src("ui/PhysicalMedia.kt"), "RealMediaPicture").contains("PhotoShells"))
+        assertFalse(body(src("ui/SolidPiece.kt"), "rememberPhotoSolid").contains("PhotoShells"))
+        assertFalse(src("ui/RealMedia.kt").contains("PhotoShells"))
+        assertFalse(src("ui/LaunchThrow.kt").contains("PhotoShells"))
+    }
+
+    @Test fun photoShellsOnlyInTheDrawnShellPath() {
+        val users = root.walkTopDown().filter { it.isFile && it.extension == "kt" && it.name != "PhotoShells.kt" && it.readText().contains("PhotoShells.") }
+            .map { it.name }.toSortedSet()
+        assertEquals(sortedSetOf("CartShells.kt", "Features.kt", "LauncherViewModel.kt", "MediaInspectView.kt", "SettingsDialog.kt", "SolidPiece.kt", "TestHooks.kt"), users)
+        // SolidPiece: only the drawn shell's solid (rememberShellSolid), never the photo's.
+        val solid = src("ui/SolidPiece.kt")
+        val inShell = body(solid, "rememberShellSolid")
+        assertEquals(solid.split("PhotoShells.").size - 1, inShell.split("PhotoShells.").size - 1)
+        // Inspect: only for a drawn shell pick ("~sh:"), never a real scan.
+        val insp = src("ui/MediaInspectView.kt")
+        assertTrue(insp.contains("p.pick?.platform?.takeIf { it.startsWith(SHELL_PREFIX) }?.let { pp ->"))
+        assertTrue(insp.contains("pp.startsWith(SHELL_PREFIX) && photoTone != null -> Color(photoTone)"))
+        // CartShells: only from the drawn front (frontFor / cachedFrontFor / photoFront) and the art's cache key.
+        val cs = src("ui/CartShells.kt")
+        val inFront = listOf("frontFor", "cachedFrontFor", "photoFront").sumOf { body(cs, it).split("PhotoShells.").size - 1 }
+        val inKey = cs.lines().count { it.contains("PhotoShells.version.intValue") && it.contains("labelsV") }
+        assertEquals(cs.split("PhotoShells.").size - 1, inFront + inKey)
+    }
+
+    @Test fun aMissingOrFailedTemplateFallsBackToTheDrawnShell() {
+        val cs = src("ui/CartShells.kt")
+        assertTrue(cs.contains("return photo ?: drawn"))
+        assertTrue(body(cs, "photoFront").contains("if (PhotoShells.template(s, colour) == null) return null"))
+        val ps = src("ui/PhotoShells.kt")
+        // No template → no photo front, no photo sides; a failed photo is remembered as failed, never retried in a loop.
+        assertTrue(body(ps, "front").contains("val t = template(shell, colour) ?: return null"))
+        assertTrue(body(ps, "sideTone").contains("val t = template(shell, colour) ?: return null"))
+        assertTrue(ps.contains("if (t != null) { templates[key] = t;") && ps.contains("} else failed += key"))
+        // Loading never throws into drawing: it's caught (runCatching) and off the screen's thread.
+        assertTrue(body(ps, "load").contains("runCatching"))
+        // The setting off: nothing photo-made at all.
+        assertTrue(body(ps, "template").contains("if (!com.shelf.launcher.data.Features.photoShells.value || !supports(shell.id)) return null"))
+    }
+
+    @Test fun customModelsAndPicksComeFirst() {
+        // Your pack / custom model picks are drawn before the drawn shell (and so before any photo-made front).
+        val front = body(src("ui/CartShells.kt"), "frontFor")
+        assertTrue(front.indexOf("packColourParts(key)") < front.indexOf("photoFront("))
+        // Only official games' photos make templates (a hack's photo is its base game's).
+        val p = PhotoShells.photosOf(mapOf("x (Hack).gbc" to listOf("Disc / cartridge" to "https://x/m?systemeid=10&media=support-2D"))) { true }
+        assertTrue(p.isEmpty())
+    }
+}
