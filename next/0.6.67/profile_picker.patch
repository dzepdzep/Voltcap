+                            val s = 1f + 0.1f * lift
+                            scaleX = s; scaleY = s
+                            transformOrigin = androidx.compose.ui.graphics.TransformOrigin(0.5f, if (up) 1f else 0f)
+                            alpha = if (on) 1f else 0.82f
+                        }
+                        .pointerInput(real) { detectTapGestures { if (real == GridHome.focus) open() else select(real) } }
+                ) {
