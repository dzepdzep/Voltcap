-private fun bvHash(i: Int, salt: Int): Float {
-    var h = i * 73856093 + salt * 19349663
-    h = h xor (h ushr 13); h *= 0x5bd1e995; h = h xor (h ushr 15)
-    return ((h ushr 1) % 10000) / 10000f
-}
