+        if (g != null) GcPreview(c, g, w * GC_GAMES_X, h * GC_GAMES_Y, w * 0.3f, h * 0.6f, accent)
+        Column(Modifier.align(Alignment.TopEnd).width(w * 0.64f).fillMaxHeight()) {
