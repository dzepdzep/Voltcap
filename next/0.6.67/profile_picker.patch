-                    Box(
-                        Modifier.offset(boxW * r.x, boxH * r.y).size(boxW * r.w, boxH * r.h)
-                            .clip(RoundedCornerShape(16.dp)).background(Color.Black.copy(alpha = 0.35f)).then(edit("LOGO")),
-                        contentAlignment = Alignment.Center
