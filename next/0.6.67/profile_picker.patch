+@Composable
+private fun CaseArtBody(
+    platform: String?, cover: Any?, scan: Any?, modifier0: Modifier, title: String, detail: Int, caseModifier: Modifier,
+    spine: Any? = null, game: com.shelf.launcher.data.Game? = null, physical: List<Pair<String, String>>? = null
+): Boolean {
+    // Settings › Game look › "Case with its cartridge / disc" (update 93): the case standing still, its cartridge or disc
+    // leaning against its lower right; only the cartridge / disc moves (spin / bounce as set).
+    val shell = platform?.let { MediaShell.of(it) }
+    if (MixConsoles.caseWithMedia(platform) && shell != null) {
+        val cov0 = MediaCovers.used(platform)
+        val box0 = MediaTemplates.of(platform)?.box
+        // (Update 235, #27/#38: Voltcap's plain case too, for a console without a template case.)
+        val plain0 = if (cov0 == null && box0 == null) plainCaseSpec(platform) else null
+        if (cov0 == null && box0 == null && plain0 == null) return false
+        val aspect = cov0?.frontAspectFor(cover ?: scan) ?: box0?.let { if (it.frameRes != null) it.frameAspect else it.aspect } ?: plain0?.aspect ?: 0.7f
+        val round = shell.disc || shell == MediaShell.UMD
+        // The cartridge / disc's height as a share of the case's, and its own width / height.
+        // (Update 325: at its real size against the case — a PS1 CD nearly as tall as its jewel case; a UMD at its own shape.)
+        val mFrac = mediaBesideFrac(shell, realCaseMm(platform), if (round) 0.6f else 0.5f)
+        // (Update 325, Toni: "reuse the real DS model for the drawn ones, they look off": a cartridge / card beside its case
+        // is the game's own piece — its console's real shell, as everywhere else (mediaFor) — not the template's drawing.)
+        val cartPick = if (!round) mediaFor(platform, gameKey = game?.stableKey)?.takeIf { !it.shell.disc && it.shell != MediaShell.UMD } else null
+        val mAspect = cartPick?.aspect ?: if (shell == MediaShell.UMD) shell.aspect else if (round) 1f else shell.aspect
+        BoxWithConstraints(modifier0, contentAlignment = Alignment.Center) {
+            val out = 0.62f
+            // Update 144: the case as big as a case on its own in the same place; its cartridge / disc stuck out to the
+            // right past the slot. (Update 331, Toni: "the CD behind the next game, or cut off half way — fix it": case and
+            // cartridge / disc fit the slot together now, the piece whole beside its case.)
+            val h = minOf(maxHeight, maxWidth / (aspect + mFrac * mAspect * out))
+            val caseW = h * aspect
+            val mH = h * mFrac
+            val mW = mH * mAspect
+            Box(
+                Modifier.align(Alignment.CenterStart).wrapContentSize(Alignment.CenterStart, unbounded = true)
+                    .offset(x = (maxWidth - caseW - mW * out) / 2).size(caseW + mW * out, h)
+            ) {
+                Box(Modifier.align(Alignment.TopStart).size(caseW, h)) {
+                    CaseArtFace(platform, cover, scan, Modifier.fillMaxSize(), title, detail, caseModifier, allowDiscCase = false, spine = spine, game = game, physical = physical)
+                }
+                // The game's own cartridge / disc picture when it has one (update 104), else Voltcap's drawn one.
+                // Update 173: matched to the case — the real cartridge / disc beside the game's real (scanned) case, Voltcap's
+                // own beside its template case — whatever the drawn-media setting says.
+                // (Update 202: not for an Android game — its scraped "cartridge" is store art, androidOwnCase.)
+                val caseReal = com.shelf.launcher.data.Features.originalCases.state.value && scan != null && !LookStyles.caseForAll() && !androidOwnCase(platform)
+                val ownMedia = if (caseReal) BoxTexture.mediaOfFront(scan) else null
+                if (ownMedia != null) RealMediaPicture(ownMedia, round && shell != MediaShell.UMD, Modifier.align(Alignment.BottomEnd).offset(y = -h * 0.03f).size(mW, mH)) // (Update 325: a UMD photo never spins whole)
+                else PhysicalMedia(
+                    cartPick?.shell ?: shell, cover ?: scan, Modifier.align(Alignment.BottomEnd).offset(y = -h * 0.03f).size(mW, mH),
+                    platform = cartPick?.platform ?: platform, caseCover = cover, title = game?.name ?: title
+                )
+            }
+        }
+        return true
+    }
+    // Settings › Game look › Moving discs, cartridges & cases: the box turns left and right and/or hops.
+    val modifier = modifier0.caseMotion((cover?.hashCode() ?: 0) xor (platform?.hashCode() ?: 0))
+    // (Update 325: its wobble turns the case in 3D — the view's own turn isn't handed to it then, only its wobble.)
+    val caseSpin = rememberCaseSpin()
+    if (caseSpin == null) return CaseArtFace(platform, cover, scan, modifier, title, detail, caseModifier, allowDiscCase = true, spine = spine, game = game, physical = physical)
+    var drawn = false
+    ProvidePieceTurn(null) {
+        drawn = CaseArtFace(platform, cover, scan, modifier, title, detail, caseModifier, allowDiscCase = true, spine = spine, game = game, physical = physical, spinOf = caseSpin)
+    }
+    return drawn
+}
