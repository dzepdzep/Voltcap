+                rule(c, p, r, 0.15f * mm, 0x66000000)
+                if (code != null) line(c, code, RectF(W * 0.05f, H - 2.4f * mm, W * 0.95f, H - 0.4f * mm), 1.3f * mm, 0xFF505055.toInt(), Paint.Align.RIGHT)
