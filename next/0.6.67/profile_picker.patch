+        }
+        PickerLook.CONSOLE -> Box(modifier.fillMaxSize().background(Brush.verticalGradient(listOf(Color(0xFF242A32), Color(0xFF15191E), Color(0xFF0E1013))))) {
+            Canvas(Modifier.fillMaxSize()) {
