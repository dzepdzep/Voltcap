@@ -0,0 +1,17 @@
+# Update 464: the REAL cartridge photo path as you open it — game window › Inspect (case) › open › take the cartridge out —
+# then turned by the same slow touch drags. Identical script on the RC and on staging, for pixel comparison.
+# usage: sh real464.sh OUT NAME
+P=com.shelf.launcher; OUT=$1; N=$2; mkdir -p $OUT
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+f=$(echo "$N" | tr -c 'A-Za-z0-9\n' '_')
+input keyevent KEYCODE_WAKEUP
+input keyevent 97; sleep 1; input keyevent 97; sleep 1
+A --es voltcap_test_game "$N"; sleep 4
+A --es voltcap_test_inspect "$N||0|0"; sleep 5
+input keyevent 106; sleep 3; input keyevent 106; sleep 4
+screencap -p "$OUT/${f}_a0.png"
+input swipe 330 290 255 290 450; sleep 4; screencap -p "$OUT/${f}_a1.png"
+input swipe 330 290 255 290 450; sleep 4; screencap -p "$OUT/${f}_a2.png"
+input swipe 330 290 180 290 450; sleep 4; screencap -p "$OUT/${f}_a3.png"
+input swipe 330 290 180 290 450; sleep 4; screencap -p "$OUT/${f}_a4.png"
+input keyevent 97; sleep 1; input keyevent 97; sleep 1
diff --git a/tools/qa/device/twinback.sh b/tools/qa/device/twinback.sh
new file mode 100644
index 0000000..321e9cc
--- /dev/null
+++ b/tools/qa/device/twinback.sh
@@ -0,0 +1,28 @@
+# v0.6.67 (update 447): the way back from the second screen's dashboard on the five two-screen layouts (AYN Thor).
+# usage: sh twinback.sh TAG ["LAYOUTS"] [TAPX TAPY]   — layouts are previews (voltcap_test_preview: nothing saved); the dashboard is
+# opened with voltcap_test_twindash (as the layout's own button does). Per layout: top + bottom stills of the layout, the dashboard,
+# the next page; with TAPX/TAPY (lower-screen px) a tap there, then a still to prove the layout came back. Launches blocked.
+P=com.shelf.launcher; TAG=$1; LAYOUTS=${2:-"TWIN_DESK TWIN_ICONS TWIN_SHOWCASE POCKET_CLASSIC POCKET_RIBBON"}
+TX=$3; TY=$4
+D0=4630946441858561667; D1=4630946482288158084
+OUT=/sdcard/pp/$TAG; rm -rf $OUT; mkdir -p $OUT
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+S() { screencap -d $D0 -p $OUT/${1}_top.png; screencap -d $D1 -p $OUT/${1}_bot.png; }
+A --ez voltcap_test_nolaunch true; sleep 1
+A --ez voltcap_test_preview true; sleep 1
+for L in $LAYOUTS; do
+  A --es voltcap_test_twindash off; sleep 0.5
+  A --es voltcap_test_layout $L; sleep 3.5
+  S ${L}_1layout
+  A --es voltcap_test_twindash on; sleep 2.5
+  S ${L}_2dash
+  input -d 4 swipe 900 600 300 600 250; sleep 1.5
+  screencap -d $D1 -p $OUT/${L}_3page_bot.png
+  if [ -n "$TX" ]; then input -d 4 tap $TX $TY; sleep 2; screencap -d $D1 -p $OUT/${L}_4back_bot.png; fi
+  echo "$L done" >> $OUT/log.txt
+done
+A --es voltcap_test_twindash off; sleep 0.5
+A --ez voltcap_test_preview false; sleep 1.5
+logcat -d | grep -E "FATAL|AndroidRuntime: " | grep -i shelf > $OUT/crash.txt
+logcat -d | grep -E "VoltcapQA.*LAUNCH|blocked launch" | tail -5 > $OUT/launch.txt
+echo done > $OUT/DONE
diff --git a/tools/qa/device/viewstate.sh b/tools/qa/device/viewstate.sh
new file mode 100644
index 0000000..b303a1a
--- /dev/null
+++ b/tools/qa/device/viewstate.sh
@@ -0,0 +1,24 @@
+# Update 451: keep / put back / CHECK the home screen's own state around a test (needs the voltcap_test_hooks file).
+# usage: sh viewstate.sh save      → saves settings (Features), category order / hidden, selected category, focused game, profile
+#        sh viewstate.sh restore   → puts them back and prints the app's own check; exit 0 only on "OK" (the profile is checked, never switched)
+#        sh viewstate.sh show      → the saved view state
+# Never ends a test on an empty category: Voltcap refuses one (voltcap_test_category leaves it as it was) and restore only goes back.
+P=com.shelf.launcher; D=/sdcard/Android/data/$P/files
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+case "$1" in
+  save)
+    rm -f $D/voltcap_test_snapshot_view.json
+    A --es voltcap_test_snapshot save; sleep 2
+    [ -s $D/voltcap_test_snapshot_view.json ] || { echo "FAIL no view state saved (hooks file? old build?)"; exit 1; }
+    echo "SAVED $(cat $D/voltcap_test_snapshot_view.json)";;
+  restore)
+    [ -s $D/voltcap_test_snapshot_view.json ] || { echo "FAIL nothing saved"; exit 1; }
+    rm -f $D/voltcap_test_snapshot_verify.txt
+    A --es voltcap_test_snapshot restore
+    i=0; while [ $i -lt 20 ] && [ ! -s $D/voltcap_test_snapshot_verify.txt ]; do sleep 0.5; i=$((i + 1)); done
+    r=$(cat $D/voltcap_test_snapshot_verify.txt 2>/dev/null)
+    echo "${r:-FAIL no answer from Voltcap}"
+    case "$r" in OK*) exit 0;; *) exit 1;; esac;;
+  show) cat $D/voltcap_test_snapshot_view.json; echo;;
+  *) echo "usage: viewstate.sh save|restore|show"; exit 2;;
+esac
