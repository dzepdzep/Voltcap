-/** The colour of blade [i] (0 the front-most): from the lit front to the deep end. */
-private fun bladeColor(p: BladePalette, i: Int): Color = lerp(p.hi, p.lo, (i / (BladesNav.COUNT - 1f)) * 0.75f)
