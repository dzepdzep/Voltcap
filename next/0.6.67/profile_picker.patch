+/** Update 284: where a tall cover is cut on the plain cartridge — its upper part kept (as on your pack's shells, 0.3 down). */
+internal val PLAIN_CART_CROP = androidx.compose.ui.BiasAlignment(0f, -0.4f)
+
+/**
+ * Cartridge or disc from the template pack, fitted inside [modifier] with its own proportions. [labelScan] is the
+ * game's real label (ScreenScraper's scan), [cover] its cover: with a scan the plain shell is used, with only the
+ * cover the shell with the system's label frame. Returns false when the pack has nothing for this console.
+ */
+@Composable
+internal fun TemplateMedia(tpl: MediaTpl, labelScan: Any?, cover: Any?, modifier: Modifier = Modifier, smallDisc: Boolean = false): Boolean {
+    val disc = tpl.disc
+    // Update 169: never the label versions (tpl_cartl_*): they carry each system's printed brand art (the 3DS / Switch
+    // headers, SEGA / GENESIS bars, ratings, seals). The cover goes into the plain shell's window, which has the console's
+    // logo where its moulded brand was (res tpl_cart_*, cleaned).
+    val useLabelFrame = false
+    // (Update 297, Toni: the Switch card's sticker: without a real label scan, a Switch card wears its label frame — the
+    // template pack's horizontal red NINTENDO SWITCH header across the top of the sticker, as every real Switch game card
+    // has (SwitchLabel) — and the cover is cut into the art window under it. A real label scan is the whole sticker and
+    // keeps the plain shell, as before.)
+    val switchFrame = SwitchLabel.useFrame(tpl, labelScan != null)
+    val cart = if (useLabelFrame || switchFrame) tpl.label else tpl.cart
+    if (disc == null && cart == null) return false
+    val art = labelScan ?: cover
+    BoxWithConstraints(modifier, contentAlignment = Alignment.Center) {
+        if (disc != null) {
+            val side = minOf(maxWidth, maxHeight) * (if (smallDisc) 0.7f else 1f)
+            Box(Modifier.size(side, side)) {
+                // Discs are printed paper-white where the art is thin; the art fills the printable ring.
+                Box(Modifier.fillMaxSize().clip(DiscRing(MediaTemplates.RING_INNER, MediaTemplates.RING_OUTER)).background(Color(0xFFE9E6DF))) {
+                    if (art != null) AsyncImage(mediaArtModel(art), null, contentScale = ContentScale.Crop, modifier = Modifier.fillMaxSize()) // (Update 157)
+                }
+                Image(com.shelf.launcher.ui.cachedPainterResource(disc), null, contentScale = ContentScale.FillBounds, modifier = Modifier.fillMaxSize())
+            }
+        } else if (cart != null) {
+            val w = minOf(maxWidth, maxHeight * cart.aspect)
+            val h = w / cart.aspect
+            val win = cart.win
+            val mask = com.shelf.launcher.ui.cachedImageResource(cart.mask)
+            Box(Modifier.size(w, h)) {
+                Box(
+                    Modifier
+                        .offset(x = w * win[0], y = h * win[1])
+                        .size(w * (win[2] - win[0]), h * (win[3] - win[1]))
+                        // Only inside the shell's window (round for a UMD, notched for others): the mask cuts it.
+                        .graphicsLayer { compositingStrategy = CompositingStrategy.Offscreen }
+                        .drawWithContent {
+                            drawContent()
+                            val mw = mask.width.toFloat(); val mh = mask.height.toFloat()
+                            drawImage(
+                                mask,
+                                srcOffset = IntOffset((win[0] * mw).toInt(), (win[1] * mh).toInt()),
+                                srcSize = IntSize(((win[2] - win[0]) * mw).toInt().coerceAtLeast(1), ((win[3] - win[1]) * mh).toInt().coerceAtLeast(1)),
+                                dstSize = IntSize(size.width.toInt(), size.height.toInt()),
+                                blendMode = BlendMode.DstIn
+                            )
+                        }
+                        .background(Color(0xFFE9E6DF))
+                ) {
+                    // (Update 206: stretched to fill the label window exactly — the art adapts to the label, never cut.)
+                    // (Update 215: a cover at its own shape, fitted in the window, never stretched; a label scan still fills it.)
+                    // (Update 260: a UMD's window is round — its cover cut square round its middle fills it, as a disc's
+                    // label does; fitted, a tall cover left grey bands either side.)
+                    val roundWindow = cart.res == com.shelf.launcher.R.drawable.tpl_cart_psp || cart.res == com.shelf.launcher.R.drawable.tpl_cartl_psp
+                    // (Update 284, Toni: "fill the window but don't stretch the picture": on Voltcap's plain cartridge — the one
+                    // disc games get — a tall cover fills the near-square window, cut to it (its upper part kept, where the
+                    // title usually is) instead of standing in the middle with paper either side. Never stretched.)
+                    val fillCover = cart.res == com.shelf.launcher.R.drawable.tpl_cart_generic
+                    if (art != null) AsyncImage(
+                        mediaArtModel(art), null,
+                        contentScale = if (labelScan != null) ContentScale.FillBounds else if (roundWindow || fillCover || switchFrame) ContentScale.Crop else ContentScale.Fit,
+                        alignment = if (switchFrame) SwitchLabel.CROP else if (fillCover && labelScan == null) PLAIN_CART_CROP else Alignment.Center,
+                        modifier = Modifier.fillMaxSize()
+                    ) // (Update 157)
+                }
+                Image(com.shelf.launcher.ui.cachedPainterResource(cart.res), null, contentScale = ContentScale.FillBounds, modifier = Modifier.fillMaxSize())
+            }
+        }
+    }
+    return true
+}
