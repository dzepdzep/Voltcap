+                val t = tiles[i]
+                val lit = i == selected
+                Row(
+                    Modifier.offset(y = (h - 108.dp) * 0.5f - rowH / 2 + (rowH + gap) * (i - pos.value)).width(listW).height(rowH)
+                        .clip(RoundedCornerShape(12.dp))
