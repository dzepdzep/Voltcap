+                    t.bmp.recycle()
+                }
+                metas[shell.id] = out
+                prefs.edit().putString(shell.id, (listOf(sig) + out.map { "${it.url}\t${it.plastic.toLong() and 0xFFFFFFFFL}\t${if (it.clear) 1 else 0}" }).joinToString("\n")).apply()
