-            val span = size.height + rr * 4f
-            val y = size.height + rr * 2f - ((bvHash(i, 3) * span + t * (6f + 10f * bvHash(i, 4))) % span)
-            drawCircle(w.glow.copy(alpha = 0.05f + 0.07f * bvHash(i, 5)), rr, Offset(x, y))
-        }
-    }
-}
