+                if (bits.isNotEmpty()) FullText(bits.joinToString("  ·  "), color = Color.White, fontSize = 12.sp, maxLines = 1, textAlign = TextAlign.End, style = outline)
+            }
+        } else Spacer(Modifier.weight(0.55f))
+    }
+}
