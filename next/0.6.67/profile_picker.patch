+                // A via beside the pad.
+                drawCircle(col, radius = 3.dp.toPx(), center = Offset(x + stepPx * 0.5f, if (up) y + leadPx * 0.9f else y - leadPx * 0.9f), style = Stroke(1.dp.toPx()))
