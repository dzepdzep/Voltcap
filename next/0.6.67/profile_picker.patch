+  i=0; while [ $i -lt $R ]; do k DPAD_RIGHT 0.5; i=$((i+1)); done; screencap -p $OUT/${L}_2.png
+  k BUTTON_A 1.0; screencap -p $OUT/${L}_3.png; W3=$(W)
+  k BUTTON_B 1.0; screencap -p $OUT/${L}_4.png; W4=$(W)
+  k BUTTON_B 1.2; screencap -p $OUT/${L}_5.png; W5=$(W)
+  echo "$L home=$H open=$W1 more=$W3 afterB=$W4 afterBB=$W5" >> $OUT/log.txt
+  [ "$W5" != "$H" ] && { k BUTTON_B 1; echo "$L extra B" >> $OUT/log.txt; }
+done
+A --ez voltcap_test_nolaunch false; A --ez voltcap_test_preview false
+echo "launch blocked: $(logcat -d -s VoltcapQA | grep -c 'LAUNCH blocked')" >> $OUT/log.txt; echo DONE >> $OUT/log.txt
diff --git a/tools/qa/device/popscan.sh b/tools/qa/device/popscan.sh
new file mode 100644
index 0000000..2d03226
--- /dev/null
+++ b/tools/qa/device/popscan.sh
@@ -0,0 +1,22 @@
+# popscan.sh TAG [LAYOUTS] — update 451 popup clutter audit: each layout (preview only, nothing saved) with its CURRENT popup style
+# (the owner's own choice; never changed here), A opens the window (launches blocked), a settled still, B closes. Main display only.
+P=com.shelf.launcher; TAG=$1; OUT=/sdcard/ps/$TAG; rm -rf $OUT; mkdir -p $OUT
+LAYS=${2:-"CLASSIC TILES HERO GRID TV DASH LIVE SIDE CROSS SPOT BAR SHELF HUB RESUME CHAN CIRCUIT LIBRARY STACKS TIMELINE ARCADE CONSOLES DISCS HERO_TILES TWIN_DESK TWIN_ICONS TWIN_SHOWCASE CRATE CARDS CUSTOM POCKET_CLASSIC POCKET_RIBBON GREENCORE POCKET CUBE MEMCARD CASEFLOW BOX STORAGE FILESELECT ORBIT AIRY NIGHT BLADES BUBBLES CAMERA PANELS MAGAZINE SHOP TERMINAL CINEMA ARCTIC COVERDETAILS ARTLIB"}
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+# (D136, update 452: the app's own screen mark first — uiautomator can't dump an animated home on the RP Classic, so the
+# picker was missed and the moves walked it; the dump stays as the fallback for builds without the mark.)
+picker() { m=/sdcard/Android/data/com.shelf.launcher/files/voltcap_qa_screen; if [ -s $m ] && grep -q "^PICKER $(pidof com.shelf.launcher | cut -d' ' -f1)" $m; then input keyevent KEYCODE_BUTTON_B; sleep 1.5; echo "picker dismissed (mark)"; elif [ ! -s $m ]; then uiautomator dump /sdcard/vqa_ui.xml > /dev/null 2>&1; grep -q "Who.s playing" /sdcard/vqa_ui.xml 2>/dev/null && { input keyevent KEYCODE_BUTTON_B; sleep 1.5; echo "picker dismissed"; }; rm -f /sdcard/vqa_ui.xml; fi; }
+W() { dumpsys window | grep mCurrentFocus | grep -o "Window{[0-9a-f]*" ; }
+A --ez voltcap_test_preview true; A --ez voltcap_test_nolaunch true; sleep 3
+for L in $LAYS; do
+  A --es voltcap_test_layout $L; sleep 3.5; picker
+  screencap -p $OUT/${L}_0home.png
+  H=$(W); input keyevent KEYCODE_BUTTON_A; sleep 1.6
+  [ "$(W)" = "$H" ] && { input keyevent KEYCODE_BUTTON_A; sleep 1.6; echo "$L: A again" >> $OUT/log.txt; }
+  screencap -p $OUT/${L}_1open.png
+  input keyevent KEYCODE_BUTTON_B; sleep 1.2
+  [ "$(W)" != "$H" ] && { input keyevent KEYCODE_BUTTON_B; sleep 1; echo "$L: B again" >> $OUT/log.txt; }
+done
+A --ez voltcap_test_nolaunch false; A --ez voltcap_test_preview false
+logcat -d -s VoltcapQA | grep -c "LAUNCH blocked" >> $OUT/log.txt
+echo DONE >> $OUT/log.txt
diff --git a/tools/qa/device/popverify.sh b/tools/qa/device/popverify.sh
new file mode 100644
index 0000000..9c76f40
--- /dev/null
+++ b/tools/qa/device/popverify.sh
@@ -0,0 +1,27 @@
+# popverify.sh TAG "LAYOUTS" — update 452 D156 check per layout (preview only, launches blocked, the owner's popup style):
+# A opens (c.png) · More opened as its button does (voltcap_test_winmore, e.png) · B → More closes, window stays (b.png) · B → window
+# closes · rapid A B A B (120 ms) → closed, nothing started. PASS line per layout; the app's own "win more=" log lines kept in log.txt.
+P=com.shelf.launcher; OUT=/sdcard/pv/$1; rm -rf $OUT; mkdir -p $OUT
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+W() { dumpsys window | grep mCurrentFocus | grep -o "Window{[0-9a-f]*" | tail -1; }
+k() { input keyevent KEYCODE_$1; sleep ${2:-0.8}; }
+picker() { m=/sdcard/Android/data/com.shelf.launcher/files/voltcap_qa_screen; if [ -s $m ] && grep -q "^PICKER $(pidof com.shelf.launcher | cut -d' ' -f1)" $m; then input keyevent KEYCODE_BUTTON_B; sleep 1.5; echo "picker dismissed (mark)"; elif [ ! -s $m ]; then uiautomator dump /sdcard/vqa_ui.xml > /dev/null 2>&1; grep -q "Who.s playing" /sdcard/vqa_ui.xml 2>/dev/null && { input keyevent KEYCODE_BUTTON_B; sleep 1.5; echo "picker dismissed"; }; rm -f /sdcard/vqa_ui.xml; fi; }
+A --ez voltcap_test_preview true; A --ez voltcap_test_nolaunch true; sleep 2
+for L in $2; do
+  A --es voltcap_test_layout $L; sleep 3.5; picker >> $OUT/log.txt; k SCROLL_LOCK 0.4; H=$(W); logcat -c
+  k BUTTON_A 1.6; W1=$(W); [ "$W1" = "$H" ] && { k BUTTON_A 1.6; W1=$(W); }
+  screencap -p $OUT/${L}_c.png
+  A --es voltcap_test_winmore on; sleep 1.2; screencap -p $OUT/${L}_e.png
+  k BUTTON_B 1.0; W2=$(W); screencap -p $OUT/${L}_b.png
+  k BUTTON_B 1.2; W3=$(W)
+  [ "$W3" != "$H" ] && k BUTTON_B 1.0
+  input keyevent KEYCODE_BUTTON_A; sleep 0.12; input keyevent KEYCODE_BUTTON_B; sleep 0.12; input keyevent KEYCODE_BUTTON_A; sleep 0.12; input keyevent KEYCODE_BUTTON_B; sleep 2; W4=$(W)
+  [ "$W4" != "$H" ] && { k BUTTON_B 1.2; W4b=$(W); }
+  MO=$(logcat -d -s VoltcapQA | grep -o "win more=[a-z/]*" | tr '\n' ' ')
+  LB=$(logcat -d -s VoltcapQA | grep -c "LAUNCH blocked")
+  ok=PASS; [ "$W1" = "$H" ] && ok="FAIL(no window)"; [ "$W2" != "$W1" ] && ok="FAIL(B closed window, not More)"; [ "$W3" != "$H" ] && ok="$ok FAIL(2nd B)"
+  echo "$L $ok rapid_end=$([ "$W4" = "$H" ] && echo closed || echo "open->${W4b:+B}") launches_blocked=$LB | $MO" >> $OUT/log.txt
+  W4b=
+done
+A --ez voltcap_test_nolaunch false; A --ez voltcap_test_preview false
+echo DONE >> $OUT/log.txt
diff --git a/tools/qa/device/rapidab.sh b/tools/qa/device/rapidab.sh
new file mode 100644
index 0000000..f808516
--- /dev/null
+++ b/tools/qa/device/rapidab.sh
@@ -0,0 +1,15 @@
+# rapid.sh TAG "LAYOUTS" N GAP — rapid A B A B (GAP s) N times per layout, preview + launches blocked; end state per try
+P=com.shelf.launcher; OUT=/sdcard/pv/$1; rm -rf $OUT; mkdir -p $OUT; G=${4:-0.12}
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+W() { dumpsys window | grep mCurrentFocus | grep -o "Window{[0-9a-f]*" | tail -1; }
+A --ez voltcap_test_preview true; A --ez voltcap_test_nolaunch true; sleep 2
+for L in $2; do
+  A --es voltcap_test_layout $L; sleep 3.5; input keyevent KEYCODE_SCROLL_LOCK; sleep 0.4; H=$(W); logcat -c; r=""; LB=0
+  for i in $(seq 1 $3); do
+    input keyevent KEYCODE_BUTTON_A; sleep $G; input keyevent KEYCODE_BUTTON_B; sleep $G; input keyevent KEYCODE_BUTTON_A; sleep $G; input keyevent KEYCODE_BUTTON_B; sleep 2.2
+    if [ "$(W)" = "$H" ]; then r="$r C"; LB=$((LB+$(logcat -d -s VoltcapQA | grep -c "LAUNCH blocked"))); logcat -c; else r="$r O"; screencap -p $OUT/${L}_$i.png; logcat -d -s VoltcapQA > $OUT/${L}_$i.log; input keyevent KEYCODE_BUTTON_B; sleep 1.5; [ "$(W)" != "$H" ] && { input keyevent KEYCODE_BUTTON_B; sleep 1.5; }; fi
+  done
+  LB=$((LB+$(logcat -d -s VoltcapQA | grep -c "LAUNCH blocked")))
+  echo "$L$r launches_blocked=$LB" >> $OUT/log.txt
+done
+A --ez voltcap_test_nolaunch false; A --ez voltcap_test_preview false; echo DONE >> $OUT/log.txt
diff --git a/tools/qa/device/twinback.sh b/tools/qa/device/twinback.sh
