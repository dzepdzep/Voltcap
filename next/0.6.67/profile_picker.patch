@@ -0,0 +1,16 @@
+# Update 447 (D144): picker447.sh (the new picker.sh) on every "Who's playing?" look — sample profiles (ids 900+, nothing saved).
+# usage: sh pickdetect.sh TAG   → /sdcard/pp/TAG/result.txt lines "LOOK picker=X home=Y"; PASS only if PICKER / HOME each time.
+P=com.shelf.launcher; OUT=/sdcard/pp/$1; rm -rf $OUT; mkdir -p $OUT
+A() { am start -n $P/.MainActivity "$@" > /dev/null 2>&1; }
+ok=1
+for L in AURORA CONSOLE NEON OLED THEME MIDNIGHT; do
+  A --es voltcap_test_pickerlook $L; sleep 1
+  A --es voltcap_test_profiles "3:active=1"; sleep 2.5
+  a=$(sh /data/local/tmp/vqa/picker447.sh)
+  input keyevent KEYCODE_BUTTON_B; sleep 1.8
+  b=$(sh /data/local/tmp/vqa/picker447.sh)
+  echo "$L picker=$a home=$b" >> $OUT/result.txt
+  [ "$a" = PICKER ] && [ "$b" = HOME ] || ok=0
+done
+A --es voltcap_test_pickerlook off; A --es voltcap_test_profiles off
+[ $ok = 1 ] && echo PASS >> $OUT/result.txt || echo FAIL >> $OUT/result.txt
diff --git a/tools/qa/device/picker.sh b/tools/qa/device/picker.sh
index 7bb6cc6..31de7db 100644
--- a/tools/qa/device/picker.sh
+++ b/tools/qa/device/picker.sh
@@ -1,25 +1,56 @@
-# VoltCap QA — which screen is showing? Prints PICKER, HOME or UNKNOWN (never anything else). "Who's playing?" is deep blue
-# at the top-left corner (uiautomator can't read Voltcap's screen on the Thor). Reads 5 pixels of a raw screencap.
-#   HOME    = the screen is lit AND the corner is not the picker blue
-#   PICKER  = lit and the corner is picker blue
-#   UNKNOWN = black / missing / short / malformed capture (display off, locked, screensaver, failed screencap)
-# A black screen must never read HOME. PK_RAW=<file> reads an existing capture instead of calling screencap (host tests).
+# VoltCap QA — which screen is showing? Prints PICKER, HOME or UNKNOWN (never anything else).
+# Update 447 (D144): "Who's playing?" has six looks now, so the screen is no longer guessed from its colours. Voltcap (with the
+# test hooks file) writes <external files>/voltcap_qa_screen = "PICKER <pid>" while a picker is up, "HOME <pid>" after it.
+#   PICKER  = the display is awake, Voltcap is in front, and its live process says PICKER
+#   HOME    = the same, it says HOME, AND the screen is lit (a black capture is never HOME)
+#   UNKNOWN = display asleep / Voltcap not in front / a stale mark (another pid) / black, missing, short or malformed capture
+# Without a mark (an older build, hooks off) it falls back to the old check: the deep-blue top-left corner of the Midnight look.
+# Host tests: PK_MARK=<file> PK_PID=<pid> PK_AWAKE=1|0 PK_TOP=1|0 PK_RAW=<raw capture> replace the device reads.
+P=com.shelf.launcher
+MARK=${PK_MARK:-/sdcard/Android/data/$P/files/voltcap_qa_screen}
 f=${PK_RAW:-/data/local/tmp/pk.raw}
-[ -n "$PK_RAW" ] || screencap $f 2>/dev/null
-[ -s $f ] || { echo UNKNOWN; exit 0; }
-w=$(od -An -tu4 -N4 $f | tr -d ' '); h=$(od -An -tu4 -j4 -N4 $f | tr -d ' ')
-[ "$w" -gt 64 ] 2>/dev/null && [ "$h" -gt 64 ] 2>/dev/null || { echo UNKNOWN; exit 0; }
-# the file must hold the whole frame (16-byte header + w*h*4)
-sz=$(wc -c < $f | tr -d ' ')
-[ "$sz" -ge $(( 16 + w * h * 4 )) ] 2>/dev/null || { echo UNKNOWN; exit 0; }
-lit=0
-for pt in "$((w / 2)) $((h / 2))" "$((w / 4)) $((h / 4))" "$((w * 3 / 4)) $((h * 3 / 4))" "$((w / 2)) $((h * 4 / 5))" "60 60"; do
-  set -- $pt
-  set -- $(od -An -tu1 -j $(( 16 + ($2 * w + $1) * 4 )) -N3 $f)
-  [ -n "$3" ] || { echo UNKNOWN; exit 0; }
-  [ $(( $1 + $2 + $3 )) -gt 36 ] && lit=$((lit + 1))
-done
-[ $lit -eq 0 ] && { echo UNKNOWN; exit 0; }
+
+awake() { [ -n "$PK_AWAKE" ] && { [ "$PK_AWAKE" = 1 ]; return; }; dumpsys power 2>/dev/null | grep -q "mWakefulness=Awake"; }
+ontop() { [ -n "$PK_TOP" ] && { [ "$PK_TOP" = 1 ]; return; }
+  dumpsys activity activities 2>/dev/null | grep -E "ResumedActivity" | head -1 | grep -q "$P/"; }
+livepid() { [ -n "$PK_PID" ] && { echo "$PK_PID"; return; }; pidof $P 2>/dev/null | tr ' ' '\n' | head -1; }
+
+# lit: the capture is whole and not black (5 points). Prints nothing; exit 0 = lit, 1 = black, 2 = bad capture.
+lit() {
+  [ -n "$PK_RAW" ] || screencap $f 2>/dev/null
+  [ -s $f ] || return 2
+  w=$(od -An -tu4 -N4 $f | tr -d ' '); h=$(od -An -tu4 -j4 -N4 $f | tr -d ' ')
+  [ "$w" -gt 64 ] 2>/dev/null && [ "$h" -gt 64 ] 2>/dev/null || return 2
+  sz=$(wc -c < $f | tr -d ' ')
+  [ "$sz" -ge $(( 16 + w * h * 4 )) ] 2>/dev/null || return 2
+  n=0
+  for pt in "$((w / 2)) $((h / 2))" "$((w / 4)) $((h / 4))" "$((w * 3 / 4)) $((h * 3 / 4))" "$((w / 2)) $((h * 4 / 5))" "60 60"; do
+    set -- $pt
+    set -- $(od -An -tu1 -j $(( 16 + ($2 * w + $1) * 4 )) -N3 $f)
+    [ -n "$3" ] || return 2
+    [ $(( $1 + $2 + $3 )) -gt 36 ] && n=$((n + 1))
+  done
+  [ $n -gt 0 ] || return 1
+  return 0
+}
+
+if [ -s "$MARK" ]; then
+  set -- $(cat "$MARK" 2>/dev/null)
+  m=$1; mp=$2
+  if [ -n "$m" ] && [ -n "$mp" ] && [ "$mp" = "$(livepid)" ]; then
+    awake || { echo UNKNOWN; exit 0; }
+    ontop || { echo UNKNOWN; exit 0; }
+    if [ "$m" = PICKER ]; then echo PICKER; exit 0; fi
+    if [ "$m" = HOME ]; then lit && echo HOME || echo UNKNOWN; exit 0; fi
+    echo UNKNOWN; exit 0
+  fi
+  # A mark from another process (Voltcap restarted, or a different build): don't trust it; use the fallback below.
+fi
+
+# Fallback (no mark): the old Midnight-blue corner check.
+lit; r=$?
+[ $r -eq 0 ] || { echo UNKNOWN; exit 0; }
+w=$(od -An -tu4 -N4 $f | tr -d ' ')
 set -- $(od -An -tu1 -j $(( 16 + (60 * w + 60) * 4 )) -N3 $f)
 r=$1; g=$2; b=$3
 if [ $b -gt $((r + 25)) ] && [ $b -gt $((g + 15)) ]; then echo PICKER; else echo HOME; fi
diff --git a/tools/qa/device/pickerlooks.sh b/tools/qa/device/pickerlooks.sh
