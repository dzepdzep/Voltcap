+/** A stable small number per game (its loose place in the row). */
+private fun mcJitter(key: String, salt: Int): Float {
+    var h = salt * 31 + 7
+    for (ch in key) h = h * 131 + ch.code
+    return ((h ushr 1) % 1000) / 1000f - 0.5f
+}
