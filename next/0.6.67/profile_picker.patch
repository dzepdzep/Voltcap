+    CardArtType.COVER, CardArtType.CASE, CardArtType.CASE_REAL, CardArtType.DISC -> 0.7f
+    CardArtType.CAPSULE, CardArtType.HERO, CardArtType.SCREENSHOT -> 1.78f
+    CardArtType.CARTRIDGE_DISC -> 1f
