+        for (l in listOf(HomeLayout.POCKET, HomeLayout.POCKET_CLASSIC, HomeLayout.POCKET_RIBBON))
+            assertEquals(InputContract.Route.HOLD, InputContract.route(InputContract.SELECT, l, InputContract.Ctx(launching = true)))
