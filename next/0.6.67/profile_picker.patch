-                }
-            }
-            return take()
-        }
-        BubbleNav.View.BUBBLES -> {
-            val n = c.games.size
-            if (n == 0) return if (k == Key.ButtonX || k == Key.ButtonY) take() else false
-            val per = BubbleNav.perPage()
-            val f = c.focus
-            when (k) {
-                Key.DirectionLeft, Key.DirectionRight -> {
