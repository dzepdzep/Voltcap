+        if (r.use.isNotEmpty()) {
+            val totals = foregroundTotals(c).toMutableMap()
+            r.use.forEach { (pkg, u) -> totals[pkg] = (totals[pkg] ?: 0L) + u.foregroundMs }
+            prefs(c).edit().putString(KEY_FOREGROUND, gson.toJson(totals)).apply()
+        }
