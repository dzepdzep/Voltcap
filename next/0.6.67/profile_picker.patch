+/**
+ * The game's own cartridge / disc picture (update 104), moving like the drawn ones (Settings › Game look › Moving
+ * discs & cartridges). [round]: a disc (kept in its circle).
+ */
+@Composable
+internal fun RealMediaPicture(
+    model: Any, round: Boolean, modifier: Modifier = Modifier,
+    /** Update 204: the game's console and key — a cartridge photo then shows its real shell's researched back when turned. */
+    platform: String? = null, gameKey: String? = null
+) {
+    // (Update 203: the game's own cartridge photo solid when turned; a disc photo turns flat.)
+    // (Update 204: at the photo's own shape, with its console's real back — rememberPhotoSolid.)
+    // (Update 205: its sides in the photo's own plastic colour, read off the photo once it has loaded.)
+    var loaded by androidx.compose.runtime.remember(model) { androidx.compose.runtime.mutableStateOf<android.graphics.drawable.Drawable?>(null) }
+    var tone by androidx.compose.runtime.remember(model) { androidx.compose.runtime.mutableStateOf(PhotoTones.of(model)) }
+    androidx.compose.runtime.LaunchedEffect(loaded) {
+        val d = loaded ?: return@LaunchedEffect
+        if (round || tone != null) return@LaunchedEffect
+        val t = kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.Default) {
+            (d as? android.graphics.drawable.BitmapDrawable)?.bitmap?.let { photoShellTone(it) }
+        }
+        if (t != null) { PhotoTones.put(model, t); tone = t }
+    }
+    val solid = rememberPhotoSolid(platform, gameKey, (model as? String)?.let { CoverAspects.rawOf(it) }, tone)
+    MediaTrace.note(gameKey?.substringAfterLast('/'), "REAL ${if (round) "disc" else "cartridge"} photo")
+    // (Update 317: a cartridge photo's hop round its solid piece — see PhysicalMedia.)
+    // (Update 317: the photo, fitted in the middle as the AsyncImage below draws it, is the piece's front — no picture of
+    // the screen taken for it.)
+    // (Update 317 (2nd go): from the photo's still picture in the shared cache — the same object every time it's asked for.
+    // The first go took the drawable the picture handed back each time it loaded, a new one each time, and the piece rebuilt
+    // itself over and over on the Flip 2.)
+    val photoBmp = if (!round) rememberSoftBitmap(model, 480) else null
+    val photoFace = androidx.compose.runtime.remember(photoBmp) {
+        photoBmp?.takeIf { it.width > 0 && it.height > 0 }?.let { b -> PieceFace(b.asImageBitmap(), b.width.toFloat() / b.height) }
+    }
+    Box(if (round) modifier.followTurn().mediaMotion(true, 0) else modifier.mediaMotion(false, 0).solidPiece(solid, faceArt = photoFace, shotKey = "photo|$model|$platform|$gameKey"), contentAlignment = Alignment.Center) {
+        // (Update 207: a disc photo has its empty margins trimmed and fills its circle — with a margin round it, the disc's
+        // drawn rim and edge in the game window stood out round the smaller photo as a second layer behind the disc.)
+        val shared = mediaArtModel(model)
+        val ctx = androidx.compose.ui.platform.LocalContext.current
+        val roundModel = androidx.compose.runtime.remember(model, round) {
+            if (round && model is String) coil.request.ImageRequest.Builder(ctx).data(model).transformations(TrimToOpaque)
+                // (Update 317: always still on a disc — see mediaArtModel.)
+                .setParameter(com.shelf.launcher.data.AnimatedArt.PARAM_STILL, true, memoryCacheKey = null).build() else null
+        }
+        // (Update 285, Toni: "disc still showing like this": in a slot taller than wide — the Voltcap row, Continue playing —
+        // the disc photo filled the slot and was cut by a circle stretched to it: a tall oval, its foot cut off. A disc photo
+        // is now always round: a square as big as the slot's shorter side, in its middle.)
+        val roundSide = if (round) Modifier.aspectRatio(1f) else Modifier
+        coil.compose.AsyncImage(
+            roundModel ?: shared, null,
+            contentScale = if (round) androidx.compose.ui.layout.ContentScale.Crop else androidx.compose.ui.layout.ContentScale.Fit, // (Update 157)
+            modifier = (if (round) Modifier.fillMaxSize().wrapContentSize().then(roundSide) else Modifier.fillMaxSize())
+                // (Update 325, Toni: "the CD is just a plain disc without the cut in the middle" — PS3 / Xbox disc pictures
+                // are often a flat round print: the real disc's centre hole, Ø 15 mm on 120, cut out of every disc photo.)
+                .then(if (round) Modifier.clip(DiscPhotoShape) else Modifier),
+            // Update 200: its shape noted, so the launch animation (LaunchThrow) sizes the game's own cartridge at it.
+            onSuccess = { r ->
+                (model as? String)?.let { k -> r.painter.intrinsicSize.let { sz -> CoverAspects.note(k, sz.width, sz.height) } }
+                if (!round) loaded = r.result.drawable
+            }
+        )
+    }
+}
+
+/** The frame time all the moving discs and cartridges share (update 104), so the ones on screen move in step. */
+internal object MediaClock {
+    @Composable
+    fun rememberFrameTime(running: Boolean = true): androidx.compose.runtime.MutableLongState {
+        val t = androidx.compose.runtime.remember { androidx.compose.runtime.mutableLongStateOf(System.nanoTime() - shiftNs) }
+        // (Update 456: behind the app drawer / Settings — calmHere in the home's own window — the clock holds where it is, so
+        // every turning disc / wobbling cartridge keeps its pose; afterwards the clock runs on from there for all of them
+        // in step ([hold] shifts the shared time by how long the hold lasted).)
+        val held = calmHere() && !HomeIdle.calm
+        androidx.compose.runtime.LaunchedEffect(running, held) {
+            if (!running || held) return@LaunchedEffect
+            while (true) androidx.compose.runtime.withFrameNanos { t.longValue = it - shiftNs }
+        }
+        return t
+    }
+
+    /** Update 456: how much the shared media time is behind the frame time (the length of the holds so far). */
+    @Volatile var shiftNs = 0L
+        private set
+    @Volatile private var heldSince = 0L
+
+    /** Update 456: the drawer / Settings opened ([on]) or closed over the home screen. */
+    fun hold(on: Boolean) {
+        val now = System.nanoTime()
+        if (on && heldSince == 0L) heldSince = now
+        else if (!on && heldSince != 0L) { shiftNs += now - heldSince; heldSince = 0L }
+    }
+}
+
+/** Update 205: the plastic colour read off each cartridge photo (its address), so it's read once per run. */
+internal object PhotoTones {
+    private val map = java.util.concurrent.ConcurrentHashMap<String, androidx.compose.ui.graphics.Color>()
+    fun of(model: Any?): androidx.compose.ui.graphics.Color? = (model as? String)?.let { map[it] }
+    fun put(model: Any?, c: androidx.compose.ui.graphics.Color) { (model as? String)?.let { if (map.size < 4000) map[it] = c } }
+}
+
+/** Update 279, testing only: the pick for TestHooks.shell ("pack:<shape>", "opt:<file>" or "android"), or null. */
+private fun testShellPick(t: String, platform: String, gameKey: String?): MediaPick? = when {
+    t.startsWith("pack:") -> CartShells.pickOf("$t~opaque", platform, gameKey)
+    t.startsWith("opt:") -> DiscShells.byFile(t.removePrefix("opt:"))?.let { MediaPick(MediaShell.GB, CUSTOM_CART + platform, it.aspect) }
+    // (Update 282: "android" — Voltcap's green Android cartridge, for checking the piece lying in a case.)
+    t == "android" -> MediaPick(MediaShell.GB, ANDROID_CART)
+    // (Update 297, testing only: "real" — every game as its console's own disc / cartridge, past any shell picked, for
+    // checking the insides of disc cases — multi-disc trays — on a device whose console has a shell picked.)
+    t == "real" -> MediaShell.of(platform)?.let { MediaPick(it, platform) }
+    else -> null
+}
