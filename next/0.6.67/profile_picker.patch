+            GcHeader(c, "GAMES · ${c.categoryLabel.uppercase()}", if (c.games.isEmpty()) null else "${c.focus + 1} / ${c.games.size}", accent, compact, tools = true)
+            Spacer(Modifier.height(if (compact) 4.dp else 8.dp))
+            if (c.games.isEmpty()) {
