+                drawLine(col, Offset(x, y), Offset(x, endY), strokeWidth = (if (on) 3.dp else 2.dp).toPx())
+                drawCircle(if (on) Color.White else col, radius = (if (on) 5.dp else 3.5.dp).toPx(), center = Offset(x, y))
