+            PqTool(pal, Icons.Filled.SwapVert, "Sort & filter", inTop && PqNav.index == tabs + 2, toolSize) { live.actions.sort() }
+            // Update 204: the R1 panel (quick tiles), by touch and from the top bar with the D-pad.
