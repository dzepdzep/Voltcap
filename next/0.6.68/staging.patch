+        assertEquals(38.5f, h.value, 0.01f)
+        assertEquals(160f, (h * 4 + 2.dp * 3).value, 0.01f)
+        assertTrue(snapRowHeight(100.dp, 8, 2.dp, 40.dp, 30.dp)!!.value >= 30f)
