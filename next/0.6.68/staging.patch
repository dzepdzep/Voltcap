+        // (Update 474: which game the home screen is on and which one the open window shows — the "wrong game" check.)
+        val vmFocus = runCatching { TestHooks.viewState?.invoke()?.optString("focus") }.getOrNull()?.takeIf { it.isNotEmpty() }
