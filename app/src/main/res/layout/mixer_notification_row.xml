<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the volume-mixer notification: name, −, level bar, +, percent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/mix_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

    <ImageButton
        android:id="@+id/mix_minus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Lower"
        android:src="@drawable/ic_mix_minus" />

    <ProgressBar
        android:id="@+id/mix_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:max="100" />

    <ImageButton
        android:id="@+id/mix_plus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Raise"
        android:src="@drawable/ic_mix_plus" />

    <TextView
        android:id="@+id/mix_pct"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />
</LinearLayout>
